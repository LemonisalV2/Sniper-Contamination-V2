            function getButtonIconName(button) {
                if (button.dataset.icon) return button.dataset.icon;
                if (button.dataset.lang) return 'online';
                if (button.dataset.perf) return 'power';
                const settingValueIcons = {
                    cross: 'crosshair',
                    dot: 'dot',
                    circle: 'circle',
                    green: 'green',
                    white: 'white',
                    cyan: 'cyan',
                    yellow: 'yellow'
                };
                if (button.dataset.settingValue) return settingValueIcons[button.dataset.settingValue] || 'default';
                const settingToggleIcons = {
                    crosshairOutline: 'outline',
                    crosshairCenterDot: 'dot',
                    toggleSprint: 'sprint',
                    showBatteryInGame: 'battery'
                };
                if (button.dataset.settingToggle) return settingToggleIcons[button.dataset.settingToggle] || 'default';
                if (button.dataset.settingGroup === 'crosshairReset') return 'reset';
                const idIcons = {
                    btnPlay: 'play',
                    btnRumbleTest: 'emp',
                    btnMenuSettings: 'settings',
                    btnMenuQuit: 'close',
                    btnConfirmMainQuit: 'confirm',
                    btnCancelMainQuit: 'cancel',
                    btnPauseSettings: 'settings',
                    btnLoadSavedRun: 'load',
                    btnStartNewRun: 'restart',
                    btnCancelSavedRun: 'cancel',
                    btnSoloMode: 'solo',
                    btnOnlineMode: 'online',
                    btnCancelPlayMode: 'back',
                    btnBattleMode: 'battle',
                    btnTeamMode: 'team',
                    btnOnlineBack: 'back',
                    btnQueueSizeBack: 'back',
                    btnCancelQueue: 'stop',
                    btnCreateRoom: 'create',
                    btnJoinRoom: 'join',
                    btnStartOnline: 'play',
