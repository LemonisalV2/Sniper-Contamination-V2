
{
  "name": "sniper-contamination",
  "productName": "SNIPER CONTAMINATION",
  "version": "1.0.0",
  "private": true,
  "description": "SNIPER CONTAMINATION game with room-based online co-op",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.snipercontamination",
    "productName": "SNIPER CONTAMINATION",
    "directories": {
      "output": "C:/SniperBuild"
    },
    "asarUnpack": [
      "server.js",
      "index.html",
      "*.png",
      "*.mp3",
      "*.svg",
      "*.css",
      "node_modules/ws/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "*.png",
      "*.mp3",
      "icon.ico",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
