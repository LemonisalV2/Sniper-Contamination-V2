                radial-gradient(circle at 12% 24%, #fff 0 1px, transparent 2px),
                radial-gradient(circle at 28% 76%, #9dfbff 0 1.5px, transparent 2.5px),
                radial-gradient(circle at 71% 20%, #fff 0 1px, transparent 2px),
                radial-gradient(circle at 86% 65%, #ffb8ff 0 1.5px, transparent 2.5px),
                radial-gradient(circle at 54% 42%, #fff 0 1px, transparent 2px),
                radial-gradient(ellipse at 50% 50%, rgba(153, 69, 255, .38), transparent 55%),
                radial-gradient(ellipse at 25% 75%, rgba(30, 140, 255, .18), transparent 45%) !important;
        }

        /* 10 SOLAR â€” molten orange corona and a bright white-hot central core. */
        .screenTransition.transitionStyle10 {
            background: radial-gradient(circle at 50% 50%, #fffde6 0, #ffd55c 5%, #ff8a19 17%, #b52b08 35%, #45100b 57%, #10050a 78%, #000 100%) !important;
        }

        .screenTransition.transitionStyle10::before {
            background:
                repeating-conic-gradient(from 0deg at 50% 50%, rgba(255, 242, 166, .72) 0deg 1deg, transparent 2deg 13deg),
                radial-gradient(circle at 50% 50%, transparent 0 20%, rgba(255, 170, 39, .35) 22% 25%, transparent 31%) !important;
