            function applyLanguage() {
                const t = LANG[language] || LANG.en;
                const gameplayText = {
                    ...baseText,
                    ...CROSSHAIR_EXTRA_TRANSLATIONS.en,
                    ...(GAMEPLAY_SETTINGS_TRANSLATIONS[language] || {}),
                    ...(CROSSHAIR_EXTRA_TRANSLATIONS[language] || CROSSHAIR_EXTRA_TRANSLATIONS.en)
                };
                const localizedTitle = TITLE_TRANSLATIONS[language] || t.titleMain || baseText.titleMain;
                document.documentElement.lang = language;
                titleMain.textContent = localizedTitle;
                document.title = localizedTitle;
                const menuBranding = MENU_BRANDING_TRANSLATIONS[language] || MENU_BRANDING_TRANSLATIONS.en;
                document.querySelector('#menu .sc-intro-kicker').textContent = menuBranding[0];
                document.querySelector('#menu .sc-intro-status span').textContent = menuBranding[1];
                playModeTitle.textContent = getOnlineText('playTitle');
                btnSoloMode.textContent = getOnlineText('solo');
                btnOnlineMode.textContent = getOnlineText('online');
                btnCancelPlayMode.textContent = getOnlineText('back');
                onlineLobbyTitle.textContent = getOnlineText('queueTitle');
                onlineMatchTypeTitle.textContent = getOnlineText('chooseMatchType');
                btnBattleMode.textContent = getOnlineText('battleMode');
                btnTeamMode.textContent = getOnlineText('teamMode');
                onlineModeDescription.textContent = `${getOnlineText('battleDescription')}\n${getOnlineText('teamDescription')}`;
                btnOnlineBack.textContent = getOnlineText('back');
                btnQueueSizeBack.textContent = getOnlineText('back');
                btnCancelQueue.textContent = getOnlineText('cancelSearch');
                onlineRoomCodeLabel.textContent = getOnlineText('roomCodeLabel');
                onlineLobbyIntro.textContent = getOnlineText('intro');
                roomCodeInput.setAttribute('aria-label', getOnlineText('roomCodeLabel'));
                roomCodeInput.placeholder = getOnlineText('roomCodePlaceholder');
                btnCreateRoom.textContent = getOnlineText('createRoom');
                btnJoinRoom.textContent = getOnlineText('joinRoom');
                btnStartOnline.textContent = getOnlineText('startTogether');
                btnOnlineBack.textContent = getOnlineText('back');
                btnBattleMainMenu.textContent = getOnlineText('battleMainMenu');
                renderOnlineLobbyStatus();
                if (!onlineLobbyOverlay.classList.contains('hidden') && !queueWaitStep.classList.contains('hidden')) {
                    if (queueElapsedInterval) renderQueueStatus();
                    else queueWaitStatus.textContent = getOnlineText('connecting');
                }
                if (!onlineNotification.classList.contains('hidden') && onlineNotificationKey) {
                    onlineNotificationText.textContent = getOnlineText(onlineNotificationKey);
                }
                settingsTitle.textContent = t.settingsTitle;
                document.getElementById('labelGameplaySettings').textContent = gameplayText.gameplaySettings;
                document.getElementById('labelCrosshairStyle').textContent = gameplayText.crosshairStyle;
                document.getElementById('labelCrosshairColor').textContent = gameplayText.crosshairColor;
                const crosshairSectionText = CROSSHAIR_SECTION_TRANSLATIONS[language] || CROSSHAIR_SECTION_TRANSLATIONS.en;
                document.getElementById('labelCrosshairAdjustments').textContent = crosshairSectionText[0];
                document.getElementById('labelGameplayOptions').textContent = crosshairSectionText[1];
                document.getElementById('labelCrosshairSize').textContent = gameplayText.crosshairSize;
                document.getElementById('labelCrosshairCustomColor').textContent = gameplayText.customColor;
                document.getElementById('labelCrosshairThickness').textContent = gameplayText.thickness;
                document.getElementById('labelCrosshairGap').textContent = gameplayText.gap;
                document.getElementById('labelCrosshairOpacity').textContent = gameplayText.opacity;
                document.getElementById('labelCrosshairPreview').textContent = gameplayText.preview;
                document.getElementById('labelCrosshairOutline').textContent = gameplayText.outline;
                document.getElementById('labelCrosshairOutlineThickness').textContent = gameplayText.outlineThickness;
                document.getElementById('labelCrosshairCenterDot').textContent = gameplayText.centerDot;
                btnResetCrosshair.textContent = gameplayText.reset;
                document.getElementById('labelToggleSprint').textContent = gameplayText.toggleSprint;
                document.getElementById('labelShowBatteryInGame').textContent = gameplayText.showBatteryInGame;
                const gameplayChoiceText = {
                    cross: gameplayText.crosshairCross,
                    dot: gameplayText.crosshairDot,
                    circle: gameplayText.crosshairCircle,
                    green: gameplayText.colorGreen,
                    white: gameplayText.colorWhite,
                    cyan: gameplayText.colorCyan,
                    yellow: gameplayText.colorYellow
                };
                settingsPanel.querySelectorAll('[data-gameplay-text]').forEach(label => {
                    label.textContent = gameplayChoiceText[label.dataset.gameplayText] || '';
                });
                updateGameplaySettingsUI(gameplayText);
                labelLanguage.textContent = t.labelLanguage;
                labelFPS.textContent = t.labelFPS;
                labelEQ.textContent = t.labelEQ;
                labelGraphicsQuality.textContent = GRAPHICS_QUALITY_TITLE[language] || GRAPHICS_QUALITY_TITLE.en;
                labelVolLow.textContent = t.labelVolLow;
                labelVolMid.textContent = t.labelVolMid;
                labelVolHigh.textContent = t.labelVolHigh;
                const graphicsQualityLabels = GRAPHICS_QUALITY_LABELS[language] || GRAPHICS_QUALITY_LABELS.en;
                graphicsQualityLow.textContent = graphicsQualityLabels[0];
                graphicsQualityHigh.textContent = graphicsQualityLabels[1];
                fpsDescription.textContent = t.fpsDescription;
                perfNote.textContent = t.perfNote;
                oxygenWarningText.textContent = t.oxygenWarning;
                pauseTitle.textContent = t.paused;
                btnResume.textContent = t.resume;
                btnPauseSettings.textContent = t.settings;
                const quitLabels = QUIT_TEXT[language] || QUIT_TEXT.en;
                pauseConfirmPrompt.textContent = quitLabels[0];
                mainQuitConfirmPrompt.textContent = quitLabels[0];
                const savedRunLabels = SAVED_RUN_TEXT[language] || SAVED_RUN_TEXT.en;
                btnConfirmMainQuit.textContent = savedRunLabels[1];
                btnCancelMainQuit.textContent = savedRunLabels[3];
                btnMenuQuit.setAttribute('aria-label', quitLabels[1]);
                btnQuit.textContent = quitLabels[1];
                btnConfirmQuit.textContent = quitLabels[1];
                btnSaveAndQuit.textContent = quitLabels[2];
                btnCancelQuit.textContent = quitLabels[3];
                savedRunConfirmPrompt.textContent = savedRunLabels[0];
                btnLoadSavedRun.textContent = savedRunLabels[1];
                btnStartNewRun.textContent = savedRunLabels[2];
                btnCancelSavedRun.textContent = savedRunLabels[3];
                const deathMessage = deathCause === 'electrocuted'
                    ? (ELECTROCUTED_TRANSLATIONS[language] || ELECTROCUTED_TRANSLATIONS.en)
                    : t.youDied;
                deathTitle.textContent = deathMessage;
                deathTitle.classList.toggle('electrocuted', deathCause === 'electrocuted');
                deathOverlay.classList.toggle('electrocutedDeath', deathCause === 'electrocuted');
                btnRestart.textContent = t.restart;
                btnDeathSettings.textContent = t.settings;
                btnMainMenu.textContent = t.mainMenu;
                btnPlay.textContent = t.play;
                btnMenuSettings.textContent = t.menuSettings;
                btnSettingsBack.textContent = t.back;
                btnRumbleTest.textContent = t.rumbleTest;
                const performanceLabels = PERFORMANCE_LABELS[language] || PERFORMANCE_LABELS.en;
                performanceButtons.querySelector('[data-perf="power"]').textContent = performanceLabels[0];
                performanceButtons.querySelector('[data-perf="performance"]').textContent = performanceLabels[1];
                const sprintLabels = SPRINT_LABELS[language] || SPRINT_LABELS.en;
                sprintButton.setAttribute('aria-label', sprintLabels[0]);
                sprintButtonLabel.textContent = sprintLabels[0];
                cooldownLabels = COOLDOWN_LABELS[language] || COOLDOWN_LABELS.en;
                weaponLabels = WEAPON_LABELS[language] || WEAPON_LABELS.en;
                explodeButton.setAttribute('aria-label', weaponLabels[1]);
                explodeButtonLabel.textContent = weaponLabels[1];
                shootButton.setAttribute('aria-label', weaponLabels[0]);
                shootButtonLabel.textContent = weaponLabels[0];
                abilityLabels = ABILITY_LABELS[language] || ABILITY_LABELS.en;
                empButton.setAttribute('aria-label', abilityLabels[0]);
                empButtonLabel.textContent = abilityLabels[0];
                phaseButton.setAttribute('aria-label', abilityLabels[1]);
                phaseButtonLabel.textContent = abilityLabels[1];
                powerSavingText.textContent = t.lowBatteryPowerSavingNotice || t.powerSavingNotice || LANG.en.lowBatteryPowerSavingNotice || LANG.en.powerSavingNotice;
                const chargingText = document.getElementById('batteryChargingText');
                const removedText = document.getElementById('batteryRemovedText');
                const batteryPercent = Math.round(Math.max(0, Math.min(1, batteryLevel)) * 100);
                if (chargingText) chargingText.textContent = getBatteryStatusMessage('charging', batteryPercent);
                if (removedText) removedText.textContent = getBatteryStatusMessage('removed', batteryPercent);
                const seconds = getLocalizedNumber(elapsedGameTime, { maximumFractionDigits: 1, minimumFractionDigits: 1 });
                deathSurvived.textContent = (t.deathSurvived || LANG.en.deathSurvived).replace('{s}', seconds);
                if (!battleEliminatedNotice.classList.contains('hidden')) {
                    battleEliminatedTitle.textContent = getOnlineText('battleEliminated');
                    battleEliminatedWaiting.textContent = getOnlineText('battleEliminatedWaiting');
                }
                progressText.textContent = (t.progress || LANG.en.progress).replace('{s}', seconds);
                updateOxygenUI();
                updateBattleHealthUI();
                updateFPSUI();
                updateAbilityUI();
                renderOnlineLobbyStatus();
                updateNetworkStatus();
            }

            function initAudio() {
                if (audioCtx) return;
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                trebleOsc = audioCtx.createOscillator();
                trebleGain = audioCtx.createGain();
                trebleOsc.frequency.value = 8000;
                trebleGain.gain.value = 0;
                trebleOsc.connect(trebleGain).connect(audioCtx.destination);
                trebleOsc.start();
                heartbeatOsc = audioCtx.createOscillator();
                heartbeatGain = audioCtx.createGain();
                heartbeatOsc.frequency.value = 65;
                heartbeatGain.gain.value = 0;
                heartbeatOsc.connect(heartbeatGain).connect(audioCtx.destination);
                heartbeatOsc.start();
            }
            function startTrebleFadeIn() {
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                trebleGain.gain.cancelScheduledValues(now);
                trebleGain.gain.setValueAtTime(0, now);
                trebleGain.gain.linearRampToValueAtTime(0.4 * volHigh, now + 0.3);
            }
            function stopTreble() {
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                trebleGain.gain.cancelScheduledValues(now);
                trebleGain.gain.setValueAtTime(0, now);
            }
            function startHeartbeat() {
                if (!audioCtx) return;
                stopHeartbeat();
                const period = 0.3;
                heartbeatInterval = setInterval(() => {
                    if (!audioCtx || audioCtx.state !== 'running') return;
                    const now = audioCtx.currentTime;
                    heartbeatGain.gain.cancelScheduledValues(now);
                    heartbeatGain.gain.setValueAtTime(0, now);
                    heartbeatGain.gain.linearRampToValueAtTime(0.6 * volLow, now + 0.05);
                    heartbeatGain.gain.linearRampToValueAtTime(0, now + 0.25);
                    vibrateHeartbeat();
                }, period * 1000);
            }
            function stopHeartbeat() {
                if (!audioCtx) return;
                if (heartbeatInterval) {
                    clearInterval(heartbeatInterval);
                    heartbeatInterval = null;
                }
                const now = audioCtx.currentTime;
                heartbeatGain.gain.cancelScheduledValues(now);
                heartbeatGain.gain.setValueAtTime(0, now);
            }
            function vibrateHeartbeat() {
                if (navigator.vibrate) navigator.vibrate(80);
                const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                for (const gp of gamepads) {
                    if (!gp) continue;
                    const act = gp.vibrationActuator;
                    if (act && act.type === 'dual-rumble') {
                        act.playEffect('dual-rumble', {
                            duration: 120,
                            strongMagnitude: 0.8,
                            weakMagnitude: 0.8
                        });
                    }
                }
            }
            function vibrateHit() {
                if (navigator.vibrate) navigator.vibrate(120);
                const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                for (const gp of gamepads) {
                    if (!gp) continue;
                    const act = gp.vibrationActuator;
                    if (act && act.type === 'dual-rumble') {
                        act.playEffect('dual-rumble', {
                            duration: 150,
                            strongMagnitude: 1.0,
                            weakMagnitude: 1.0
                        });
                    }
                }
            }
            function vibrateCollect() {
                if (navigator.vibrate) navigator.vibrate(60);
                const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                for (const gp of gamepads) {
                    if (!gp) continue;
                    const act = gp.vibrationActuator;
                    if (act && act.type === 'dual-rumble') {
                        act.playEffect('dual-rumble', {
                            duration: 120,
                            strongMagnitude: 0.4,
                            weakMagnitude: 0.7
                        });
                    }
                }
            }
            function playOxygenCollectSound() {
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                const now = audioCtx.currentTime;
                osc.frequency.setValueAtTime(40, now);
                osc.frequency.linearRampToValueAtTime(200, now + 0.25);
                gain.gain.setValueAtTime(0, now);
                gain.gain.linearRampToValueAtTime(0.5 * volMid, now + 0.05);
                gain.gain.linearRampToValueAtTime(0, now + 0.3);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start();
                osc.stop(now + 0.35);
            }
            function playHitSound() {
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'square';
                const now = audioCtx.currentTime;
                osc.frequency.setValueAtTime(55, now);
                osc.frequency.linearRampToValueAtTime(25, now + 0.15);
                gain.gain.setValueAtTime(0.0, now);
                gain.gain.linearRampToValueAtTime(0.6 * volMid, now + 0.03);
                gain.gain.linearRampToValueAtTime(0.0, now + 0.2);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start();
                osc.stop(now + 0.25);
            }
            function playExplodeSound() {
                if (!audioCtx) return;
                const osc1 = audioCtx.createOscillator();
                const osc2 = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc1.type = 'sawtooth';
                osc2.type = 'triangle';
                const now = audioCtx.currentTime;
                osc1.frequency.setValueAtTime(140, now);
                osc1.frequency.exponentialRampToValueAtTime(28, now + 0.45);
                osc2.frequency.setValueAtTime(80, now);
                osc2.frequency.exponentialRampToValueAtTime(22, now + 0.48);
                gain.gain.setValueAtTime(0.0, now);
                gain.gain.linearRampToValueAtTime(0.8 * volHigh, now + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                osc1.connect(gain).connect(audioCtx.destination);
                osc2.connect(gain).connect(audioCtx.destination);
                osc1.start(now);
                osc2.start(now);
                osc1.stop(now + 0.55);
                osc2.stop(now + 0.58);
            }
            function playEmpPulseSound() {
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                const master = audioCtx.createGain();
                const low = audioCtx.createOscillator();
                const high = audioCtx.createOscillator();
                low.type = 'sawtooth';
                high.type = 'triangle';
                low.frequency.setValueAtTime(520, now);
                low.frequency.exponentialRampToValueAtTime(58, now + 0.62);
                high.frequency.setValueAtTime(1480, now);
                high.frequency.exponentialRampToValueAtTime(170, now + 0.38);
                master.gain.setValueAtTime(0.001, now);
                master.gain.linearRampToValueAtTime(0.42 * volHigh, now + 0.025);
                master.gain.exponentialRampToValueAtTime(0.001, now + 0.68);
                low.connect(master);
                high.connect(master);
                master.connect(audioCtx.destination);
                low.start(now);
                high.start(now);
                low.stop(now + 0.7);
                high.stop(now + 0.42);
            }
            function playPhaseShiftSound() {
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, now);
                osc.frequency.exponentialRampToValueAtTime(220, now + 0.32);
                gain.gain.setValueAtTime(0.001, now);
                gain.gain.linearRampToValueAtTime(0.22 * volHigh, now + 0.025);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.36);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.38);
            }
            const queueSoundAudio = new Audio('Queue%20Sound.mp3');
            queueSoundAudio.preload = 'auto';
            function playQueueSound() {
                const sound = queueSoundAudio.cloneNode();
                sound.volume = volHigh;
                sound.play().catch(error => console.error('Unable to play the queue sound:', error));
            }
            const matchFoundAudio = new Audio('Match%20Found.mp3');
            matchFoundAudio.preload = 'auto';
            function playMatchFoundSound() {
                const sound = matchFoundAudio.cloneNode();
                sound.volume = volHigh;
                sound.play().catch(error => console.error('Unable to play the match-found sound:', error));
            }
            function playPewSound(isRed) {
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                const now = audioCtx.currentTime;
                const startFreq = isRed ? 95 : 10000;
                const endFreq = isRed ? 200 : 95;
                osc.frequency.setValueAtTime(startFreq, now);
                osc.frequency.linearRampToValueAtTime(endFreq, now + 0.12);
                gain.gain.setValueAtTime(0.0, now);
                gain.gain.linearRampToValueAtTime(0.5 * volHigh, now + 0.02);
                gain.gain.linearRampToValueAtTime(0.0, now + 0.18);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start();
                osc.stop(now + 0.22);
            }
            const greenSniperShotAudio = new Audio('Verdant%20Gun%20Shot%20sound.mp3');
            greenSniperShotAudio.preload = 'auto';
            const redSniperShotAudio = new Audio('Crimson%20Executioner%20Gun%20shot.mp3');
            redSniperShotAudio.preload = 'auto';
            const orangeSniperShotAudio = new Audio('Assault%20Rifle%20Gun%20sound.mp3');
            orangeSniperShotAudio.preload = 'auto';

            function playGreenSniperSound() {
                const shot = greenSniperShotAudio.cloneNode();
                shot.volume = volHigh * 0.6;
                shot.play().catch(error => console.error('Unable to play the green sniper sound:', error));
            }
            function playRedSniperSound() {
                const shot = redSniperShotAudio.cloneNode();
                shot.volume = volHigh;
                shot.play().catch(error => console.error('Unable to play the red sniper sound:', error));
            }
            function playOrangeSniperSound() {
                const shot = orangeSniperShotAudio.cloneNode();
                shot.volume = volHigh * 0.8;
                shot.play().catch(error => console.error('Unable to play the orange sniper sound:', error));
            }
            function playSniperShotSound(projectileType) {
                if (projectileType === 'green') {
                    playGreenSniperSound();
                    return;
                }
                if (projectileType === 'red') {
                    playRedSniperSound();
                    return;
                }
                if (projectileType === 'orange') {
                    playOrangeSniperSound();
                    return;
                }
                if (!audioCtx) return;

                const now = audioCtx.currentTime;
                const profiles = {
                    red: { type: 'sawtooth', start: 82, end: 48, volume: 0.24, duration: 0.24 },
                    orange: { type: 'square', start: 620, end: 180, volume: 0.13, duration: 0.12 },
                    purple: { type: 'sine', start: 180, end: 55, volume: 0.2, duration: 0.38 },
                    blue: { type: 'triangle', start: 70, end: 24, volume: 0.32, duration: 0.5 },
                    yellowStar: { type: 'sine', start: 1200, end: 420, volume: 0.16, duration: 0.2 }
                };
                const profile = profiles[projectileType];
                if (!profile) return;

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = profile.type;
                osc.frequency.setValueAtTime(profile.start, now);
                osc.frequency.exponentialRampToValueAtTime(profile.end, now + profile.duration);
                gain.gain.setValueAtTime(0.001, now);
                gain.gain.linearRampToValueAtTime(profile.volume * volHigh, now + 0.015);
                gain.gain.exponentialRampToValueAtTime(0.001, now + profile.duration);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + profile.duration + 0.02);

                if (projectileType === 'yellowStar') {
                    const sparkle = audioCtx.createOscillator();
                    const sparkleGain = audioCtx.createGain();
                    sparkle.type = 'triangle';
                    sparkle.frequency.setValueAtTime(1800, now);
                    sparkle.frequency.exponentialRampToValueAtTime(700, now + 0.12);
                    sparkleGain.gain.setValueAtTime(0.001, now);
                    sparkleGain.gain.linearRampToValueAtTime(0.08 * volHigh, now + 0.01);
                    sparkleGain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
                    sparkle.connect(sparkleGain).connect(audioCtx.destination);
                    sparkle.start(now);
                    sparkle.stop(now + 0.16);
                }
            }
            function playButtonHoverSound() {
                initAudio();
                if (!audioCtx) return;
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const now = audioCtx.currentTime;
                osc.type = 'square';
                osc.frequency.setValueAtTime(880, now);
                osc.frequency.linearRampToValueAtTime(1180, now + 0.045);
                gain.gain.setValueAtTime(0.035 * volHigh, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.08);
            }
            function playButtonClickSound() {
                initAudio();
                if (!audioCtx) return;
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const now = audioCtx.currentTime;
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(520, now + 0.12);
                gain.gain.setValueAtTime(0.08 * volMid, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
                osc.connect(gain).connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.17);
            }
            [btnPlay, btnRumbleTest, btnMenuSettings, btnResume, btnPauseSettings, btnQuit, btnConfirmQuit, btnSaveAndQuit, btnCancelQuit, btnLoadSavedRun, btnStartNewRun, btnCancelSavedRun, btnRestart, btnDeathSettings, btnMainMenu, btnSettingsBack, pauseButton, ...gameplayChoiceButtons, ...settingsToggleButtons].forEach(button => {
                button.addEventListener('pointerenter', playButtonHoverSound);
                button.addEventListener('click', playButtonClickSound);
            });

            volLowSlider.addEventListener('input', () => {
                volLow = parseFloat(volLowSlider.value);
                saveSettings();
            });
            volMidSlider.addEventListener('input', () => {
                volMid = parseFloat(volMidSlider.value);
                saveSettings();
            });
            volHighSlider.addEventListener('input', () => {
                volHigh = parseFloat(volHighSlider.value);
                saveSettings();
            });
            graphicsQualitySlider.addEventListener('input', () => {
                graphicsQuality = parseFloat(graphicsQualitySlider.value);
                saveSettings();
            });

            function adjustFocusedVolume(direction, amount = 0.01) {
                const slider = settingsSliderGroups[settingsCurrentGroup];
                if (!slider) return false;
                const isVolumeSlider = slider === volLowSlider || slider === volMidSlider
                    || slider === volHighSlider || slider === graphicsQualitySlider;
                const step = Number(slider.step) || 1;
                const delta = direction * (isVolumeSlider ? amount : step);
                const value = Math.max(Number(slider.min), Math.min(Number(slider.max), Number(slider.value) + delta));
                slider.value = isVolumeSlider ? value.toFixed(2) : String(value);
                slider.dispatchEvent(new Event('input'));
                return true;
            }

            function startKeyboardSliderAdjust(direction) {
                if (settingsKeyboardSliderTimer) clearInterval(settingsKeyboardSliderTimer);
                settingsKeyboardSliderTimer = setInterval(() => {
                    if (settingsScreen.classList.contains('hidden') || !adjustFocusedVolume(direction)) {
                        clearInterval(settingsKeyboardSliderTimer);
                        settingsKeyboardSliderTimer = null;
                    }
                }, 30);
            }

            function sendOnlineMessage(message) {
                if (onlineSocket && onlineSocket.readyState === WebSocket.OPEN) {
                    onlineSocket.send(JSON.stringify(message));
                    return true;
                }
                return false;
            }

            function isMultiplayerSession() {
                return onlineMode || Boolean(onlineRoomCode);
            }

            function isBattleOpponent(state) {
                if (state.id === onlinePlayerId) return false;
                if (onlineRequiredPlayers === 2) return true;
                return state.teamId !== onlinePlayerStates.get(onlinePlayerId)?.teamId;
            }

            function updateOnlinePlayerStates(players) {
                onlinePlayerStates.clear();
                onlineBattleScores.clear();
                const receivedAt = performance.now();
                const receivedPlayerIds = new Set();
                for (const state of players || []) {
                    if (!state || typeof state.id !== 'string'
                        || !Number.isFinite(state.x) || !Number.isFinite(state.y)) continue;
                    receivedPlayerIds.add(state.id);
                    const playerState = {
                        ...state,
                        x: Math.max(0, Math.min(1, state.x)),
                        y: Math.max(0, Math.min(1, state.y)),
                        connected: state.connected !== false,
                        hp: Number.isFinite(state.hp) ? Math.max(0, Math.min(100, state.hp)) : 100
                    };
                    onlinePlayerStates.set(state.id, playerState);
                    if (state.id !== onlinePlayerId) {
                        const history = onlineRemotePositionHistory.get(state.id) || [];
                        history.push({
                            x: playerState.x,
                            y: playerState.y,
                            angle: Number.isFinite(state.angle) ? state.angle : 0,
                            receivedAt
                        });
                        if (history.length > 12) history.splice(0, history.length - 12);
                        onlineRemotePositionHistory.set(state.id, history);
                    }
                    const roundWins = Number.isFinite(state.roundWins) ? state.roundWins : 0;
                    onlineBattleScores.set(state.id, roundWins);
                    if (state.id === onlinePlayerId && Number.isFinite(state.hp)) {
                        onlineBattleHealth = Math.max(0, Math.min(100, state.hp));
                    }
                }
                for (const playerId of eliminatedBattlePlayerIds) {
                    const playerState = onlinePlayerStates.get(playerId);
                    if (playerState) {
                        playerState.hp = 0;
                        playerState.alive = false;
                    }
                }
                updateBattleHealthUI();
                for (const playerId of onlineRemotePositionHistory.keys()) {
                    if (!receivedPlayerIds.has(playerId)) onlineRemotePositionHistory.delete(playerId);
                }
            }

            function getInterpolatedRemotePosition(remote, renderTime) {
                const history = onlineRemotePositionHistory.get(remote.id);
                if (!history?.length) {
                    return {
                        x: remote.x,
                        y: remote.y,
                        angle: Number.isFinite(remote.angle) ? remote.angle : 0
                    };
                }
                const targetTime = renderTime - REMOTE_INTERPOLATION_DELAY_MS;
                let before = history[0];
                let after = null;
                for (const snapshot of history) {
                    if (snapshot.receivedAt <= targetTime) before = snapshot;
                    else {
                        after = snapshot;
                        break;
                    }
                }
                if (!after || after.receivedAt <= before.receivedAt) {
                    return { x: before.x, y: before.y, angle: before.angle };
                }
                const progress = Math.max(0, Math.min(
                    1,
                    (targetTime - before.receivedAt) / (after.receivedAt - before.receivedAt)
                ));
                const angleDelta = Math.atan2(
                    Math.sin(after.angle - before.angle),
                    Math.cos(after.angle - before.angle)
                );
                return {
                    x: before.x + (after.x - before.x) * progress,
                    y: before.y + (after.y - before.y) * progress,
                    angle: before.angle + angleDelta * progress
                };
            }

            function updateMatchHud() {
                const showBattleHud = onlineMode && onlineMatchType === 'battle' && running;
                matchHud.classList.toggle('hidden', !showBattleHud || !battleScoreboardOpen);
                battleHud.classList.toggle('hidden', !showBattleHud);
                if (!showBattleHud) return;

                battleHudRound.textContent = getOnlineText('battleRound', { round: onlineBattleRound });
                const teamPlayersContainers = [battleHudTeamAPlayers, battleHudTeamBPlayers];
                const teamScores = [battleHudTeamAScore, battleHudTeamBScore];
                for (let teamId = 0; teamId < teamPlayersContainers.length; teamId++) {
                    const players = [...onlinePlayerStates.values()]
                        .filter(state => state.teamId === teamId)
                        .sort((left, right) => (left.teamSlot || 0) - (right.teamSlot || 0));
                    const score = players.reduce((maxScore, state) =>
                        Math.max(maxScore, Number.isFinite(state.teamScore) ? state.teamScore : 0), 0);
                    teamScores[teamId].textContent = getLocalizedNumber(score, { maximumFractionDigits: 0 });
                    teamPlayersContainers[teamId].replaceChildren();
                    for (const [index, state] of players.entries()) {
                        const playerLabel = document.createElement('span');
                        playerLabel.className = 'battleHudPlayer';
                        if (!state.connected || state.alive === false || state.hp <= 0) {
                            playerLabel.classList.add('eliminated');
                        }
                        const playerName = document.createElement('span');
                        playerName.textContent = `P${state.teamSlot || index + 1} ${getLocalizedNumber(state.hp, { maximumFractionDigits: 0 })}`;
                        playerLabel.appendChild(playerName);
                        if (!state.connected) {
                            const disconnectedIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                            disconnectedIcon.setAttribute('class', 'battleDisconnectIcon');
                            disconnectedIcon.setAttribute('viewBox', '0 0 20 20');
                            disconnectedIcon.setAttribute('aria-label', 'Wi-Fi disconnected');
                            disconnectedIcon.setAttribute('role', 'img');
                            const wifiArcs = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                            wifiArcs.setAttribute('d', 'M2 7.5a12 12 0 0 1 13.5-1.7M5 10.5a8 8 0 0 1 7-1.3M8 13.5a4 4 0 0 1 2.5-.6M3 3l14 14');
                            wifiArcs.setAttribute('fill', 'none');
                            wifiArcs.setAttribute('stroke', 'currentColor');
                            wifiArcs.setAttribute('stroke-width', '2');
                            wifiArcs.setAttribute('stroke-linecap', 'round');
                            disconnectedIcon.appendChild(wifiArcs);
                            playerLabel.appendChild(disconnectedIcon);
                        }
                        teamPlayersContainers[teamId].appendChild(playerLabel);
                    }
                }
            }

            function getBattleScoreSummary() {
                const opponents = [...onlineBattleScores.entries()]
                    .filter(([playerId]) => playerId !== onlinePlayerId)
                    .map(([, wins]) => wins);
                return {
                    you: getLocalizedNumber(onlineBattleScore, { maximumFractionDigits: 0 }),
                    opponent: getLocalizedNumber(opponents.length ? Math.max(...opponents) : 0, {
                        maximumFractionDigits: 0
                    })
                };
            }

            function clearBattleResultNotification() {
                battleRoundNotificationScore.hidden = true;
                battleRoundNotificationScore.textContent = '';
                if (!onlineNotification.classList.contains('battleResultNotification')) return;
                if (onlineNotificationTimeout) clearTimeout(onlineNotificationTimeout);
                onlineNotificationTimeout = null;
                onlineNotification.classList.remove(
                    'show',
                    'battleResultNotification',
                    'battleResultWon',
                    'battleResultLost',
                    'battleResultDraw'
                );
                onlineNotification.classList.add('hidden');
            }

            function clearBattleRoundCountdown() {
                if (battleRoundCountdownTimeout) clearTimeout(battleRoundCountdownTimeout);
                if (battleRoundCountdownInterval) clearInterval(battleRoundCountdownInterval);
                battleRoundCountdownTimeout = null;
                battleRoundCountdownInterval = null;
                battleRoundCountdown.textContent = '';
                battleRoundCountdown.classList.add('hidden');
                battleRoundCountdown.setAttribute('aria-hidden', 'true');
            }

            function scheduleBattleRoundCountdown() {
                clearBattleRoundCountdown();
                let countdown = 3;
                battleRoundCountdown.textContent = String(countdown);
                battleRoundCountdown.classList.remove('hidden');
                battleRoundCountdown.setAttribute('aria-hidden', 'false');
                battleRoundCountdownInterval = setInterval(() => {
                    countdown -= 1;
                    if (countdown <= 0) {
                        clearBattleRoundCountdown();
                        battleCountdownLocked = false;
                        battleEliminated = false;
                        player.visible = true;
                        if (!running || paused || dead) {
                            paused = false;
                            dead = false;
                            running = true;
                            lastTime = performance.now();
                            requestGameFrame();
                        }
                        return;
                    }
                    battleRoundCountdown.textContent = String(countdown);
                }, 1000);
            }

            function resetBattleRoundPlayers(players) {
                eliminatedBattlePlayerIds.clear();
                if (battleRoundResetApplied) {
                    if (Array.isArray(players)) updateOnlinePlayerStates(players);
                    updateMatchHud();
                    return;
                }
                if (battleRoundCountdownTimeout) clearTimeout(battleRoundCountdownTimeout);
                battleRoundCountdownTimeout = null;
                battleRoundResetApplied = true;
                const restartGameLoop = !running || paused || dead;
                resetGameState();
                paused = false;
                dead = false;
                running = true;
                deathOverlay.classList.add('hidden');
                pauseOverlay.classList.add('hidden');
                deathTitle.classList.remove('show');
                deathSurvived.classList.remove('show');
                battleResultOverlay.classList.add('hidden');
                battleResultOverlay.setAttribute('aria-hidden', 'true');
                cancelOxygenLoss();
                touchDeathActive = false;
                touchDeathTimer = 0;
                deathTriggered = false;
                fadeProgress = 0;
                fadeOverlay.style.opacity = '0';
                oxygenVignette.classList.remove('active');
                oxygenWarningText.classList.add('hidden');
                oxygenWarningSkull.classList.add('hidden');
                setMobileActionButtonsVisible(mobileMode);
                const currentPlayers = [...onlinePlayerStates.values()];
                const connectedPlayers = currentPlayers.filter(state => state.connected !== false);
                const serverPlayers = Array.isArray(players)
                    ? players.map(state => state.connected === false
                        ? { ...state, hp: 0, alive: false }
                        : {
                            ...state,
                            hp: 100,
                            alive: true,
                            touchDeathActive: false,
                            touchDeathTimer: 0
                        })
                    : currentPlayers.map(state => {
                        if (state.connected === false) return { ...state, hp: 0, alive: false };
                        const positionIndex = connectedPlayers.findIndex(candidate => candidate.id === state.id);
                        return {
                            ...state,
                            x: (positionIndex + 1) / (connectedPlayers.length + 1),
                            y: 0.5,
                            hp: 100,
                            alive: true,
                            touchDeathActive: false,
                            touchDeathTimer: 0
                        };
                    });
                updateOnlinePlayerStates(serverPlayers);
                const localState = onlinePlayerStates.get(onlinePlayerId);
                if (localState) {
                    player.x = localState.x * canvas.width;
                    player.y = localState.y * canvas.height;
                    player.swirlAngle = Number.isFinite(localState.angle) ? localState.angle : player.swirlAngle;
                } else {
                    player.x = canvas.width / 2;
                    player.y = canvas.height / 2;
                }
                player.vx = 0;
                player.vy = 0;
                player.knockVx = 0;
                player.knockVy = 0;
                player.knockImpulseX = 0;
                player.knockImpulseY = 0;
                player.knockTime = 0;
                player.knockDuration = 0.5;
                player.visible = true;
                battleEliminated = false;
                battleCountdownLocked = true;
                battleRoundPaused = false;
                onlineBattleHealth = 100;
                oxygen = 100;
                bullets.length = 0;
                mobileShootHeld = false;
                mouseLeftDown = false;
                mobileSprintHeld = false;
                sprintHeld = false;
                sprintToggleActive = false;
                controllerSprintHeld = false;
                sprinting = false;
                stamina = maxStamina;
                staminaDepletedLockout = false;
                updateSprintButtonState();
                updateMatchHud();
                updateOxygenUI();
                updateBattleHealthUI();
                lastTime = performance.now();
                scheduleBattleRoundCountdown();
                if (restartGameLoop) requestGameFrame();
            }

            function showBattleResult(winnerTeamId, finalMatch) {
                clearBattleRoundCountdown();
                const localPlayerState = onlinePlayerStates.get(onlinePlayerId);
                const didWin = Number.isInteger(winnerTeamId) && localPlayerState?.teamId === winnerTeamId;
                const resultKey = finalMatch
                    ? (didWin ? 'battleMatchWon' : 'battleMatchLost')
                    : (didWin ? 'battleRoundWon' : 'battleRoundLost');
                const resultText = getOnlineText(resultKey);
                if (!finalMatch) {
                    setOnlineNotificationMessage(resultText, { disconnect: false, duration: 3000 });
                    battleRoundNotificationScore.textContent = getOnlineText('battleScore', getBattleScoreSummary());
                    battleRoundNotificationScore.hidden = false;
                    onlineNotification.classList.add('battleResultNotification');
                    onlineNotification.classList.add(didWin ? 'battleResultWon' : 'battleResultLost');
                    onlineNotification.classList.remove('show');
                    void onlineNotification.offsetWidth;
                    onlineNotification.classList.add('show');
                } else {
                    clearBattleResultNotification();
                }
                battleResultTitle.textContent = getOnlineText(resultKey);
                battleResultContent.classList.toggle('won', didWin);
                battleResultContent.classList.toggle('lost', !didWin);
                battleResultScore.textContent = getOnlineText('battleFinalScore', getBattleScoreSummary());
                btnBattleMainMenu.classList.toggle('hidden', !finalMatch);
                battleEliminatedNotice.classList.add('hidden');
                battleResultOverlay.classList.toggle('hidden', !finalMatch);
                battleResultOverlay.setAttribute('aria-hidden', String(!finalMatch));
                updateCursorVisibility();
                const wasRoundPaused = battleRoundPaused;
                battleRoundPaused = finalMatch;
                battleCountdownLocked = finalMatch;
                if (finalMatch) player.visible = false;
                else {
                    battleEliminated = false;
                    player.visible = true;
                    battleRoundResetApplied = false;
                    battleRoundCountdownTimeout = setTimeout(() => {
                        battleRoundCountdownTimeout = null;
                        resetBattleRoundPlayers();
                    }, 3000);
                }
                if (finalMatch) {
                    mouseLeftDown = false;
                    mobileShootHeld = false;
                }
                if (!finalMatch && wasRoundPaused && running && !dead) {
                    lastTime = performance.now();
                    requestGameFrame();
                }
                updateMatchHud();
                if (finalMatch) btnBattleMainMenu.focus({ preventScroll: true });
            }

            function beginBattleRound(message) {
                eliminatedBattlePlayerIds.clear();
                const wasRoundPaused = battleRoundPaused;
                clearBattleRoundCountdown();
                clearBattleResultNotification();
                if (battleRoundCountdownTimeout) clearTimeout(battleRoundCountdownTimeout);
                battleRoundCountdownTimeout = null;
                battleEliminated = false;
                battleCountdownLocked = false;
                battleRoundResetApplied = false;
                paused = false;
                dead = false;
                running = true;
                battleEliminatedNotice.classList.add('hidden');
                onlineBattleRound = Number.isInteger(message.round) ? message.round : onlineBattleRound + 1;
                updateOnlinePlayerStates(message.players);
                const localState = onlinePlayerStates.get(onlinePlayerId);
                if (localState) {
                    player.x = localState.x * canvas.width;
                    player.y = localState.y * canvas.height;
                }
                player.vx = 0;
                player.vy = 0;
                player.knockVx = 0;
                player.knockVy = 0;
                player.knockImpulseX = 0;
                player.knockImpulseY = 0;
                player.visible = true;
                touchDeathActive = false;
                touchDeathTimer = 0;
                oxygen = 100;
                bullets.length = 0;
                greenSnipers.length = 0;
                redSnipers.length = 0;
                orangeSnipers.length = 0;
                purpleTriangleSnipers.length = 0;
                blueSnipers.length = 0;
                yellowStarSnipers.length = 0;
                oxygenOrbs.length = 0;
                sniperRewardOrbs.length = 0;
                sniperRewardBurstOrbs.length = 0;
                sniperOrbRewardPopups.length = 0;
                cancelOxygenLoss();
                onlineBattleHealth = 100;
                battleRoundPaused = false;
                battleResultOverlay.classList.add('hidden');
                battleResultOverlay.setAttribute('aria-hidden', 'true');
                updateCursorVisibility();
                updateMatchHud();
                updateOxygenUI();
                updateBattleHealthUI();
                if (wasRoundPaused && running && !dead) {
                    lastTime = performance.now();
                    requestGameFrame();
                }
            }

            function handleBattlePlayerEliminated(message) {
                if (typeof message.playerId !== 'string') return;
                eliminatedBattlePlayerIds.add(message.playerId);
                const playerState = onlinePlayerStates.get(message.playerId);
                const x = Number.isFinite(message.x)
                    ? message.x * canvas.width
                    : playerState ? playerState.x * canvas.width : canvas.width / 2;
                const y = Number.isFinite(message.y)
                    ? message.y * canvas.height
                    : playerState ? playerState.y * canvas.height : canvas.height / 2;
                spawnExplosionEffect(x, y, '#ff334f', 56);
                spawnSniperFragments(x, y, player.radius * 1.2, '#ff334f', '#00aaff');
                shockwaves.push({
                    x, y, radius: 8, startRadius: 8, maxRadius: player.radius * 8,
                    life: 0.7, maxLife: 0.7, color: '#ff334f', lineWidth: 4
                });
                if (playerState) {
                    playerState.hp = 0;
                    playerState.alive = false;
                    if (message.playerId === onlinePlayerId) {
                        onlineBattleHealth = 0;
                        updateBattleHealthUI();
                    }
                }
                if (message.playerId !== onlinePlayerId) return;
                player.visible = false;
                player.vx = 0;
                player.vy = 0;
                player.knockVx = 0;
                player.knockVy = 0;
                battleEliminated = true;
                mouseLeftDown = false;
                mobileShootHeld = false;
                mobileSprintHeld = false;
                sprintHeld = false;
                sprintToggleActive = false;
                controllerSprintHeld = false;
                if (onlineRequiredPlayers > 2) {
                    battleEliminatedTitle.textContent = getOnlineText('battleEliminated');
                    battleEliminatedWaiting.textContent = getOnlineText('battleEliminatedWaiting');
                    battleEliminatedNotice.classList.remove('hidden');
                }
            }

            function applyOnlineOxygenChange(amount) {
                if (onlineMatchType === 'battle') {
                    oxygen = Math.max(0, Math.min(100, oxygen + amount));
                    updateOxygenUI();
                    if (oxygen <= 0 && !oxygenLoss && !touchDeathActive) enterOxygenLoss();
                    else if (oxygen > 0 && oxygenLoss) cancelOxygenLoss();
                    return;
                }
                sendOnlineMessage({ type: 'oxygen-event', amount });
            }

            function getSniperTargetPosition(sniper, targetPlayerId = sniper.targetPlayerId) {
                let target = onlineMode ? onlinePlayerStates.get(targetPlayerId) : null;
                if (onlineMode && !target) {
                    target = [...onlinePlayerStates.values()].find(state => state.alive !== false);
                    if (target) {
                        sniper.targetPlayerId = target.id;
                    }
                }
                if (!onlineMode) {
                    return { x: player.x, y: player.y, id: 'local-player' };
                }
                return target
                    ? { x: target.x * canvas.width, y: target.y * canvas.height, id: target.id }
                    : { x: player.x, y: player.y, id: onlinePlayerId || 'local-player' };
            }

            function broadcastOnlineProjectile(kind, bullet) {
                if (!onlineMode || !canvas.width || !canvas.height) return;
                const message = {
                    type: 'player-projectile',
                    kind,
                    x: bullet.x / canvas.width,
                    y: bullet.y / canvas.height,
                    vx: bullet.vx / canvas.width,
                    vy: bullet.vy / canvas.height,
                    shotId: bullet.shotId
                };
                if (onlineMatchType === 'battle' && kind === 'shot') {
                    message.aspectRatio = canvas.width / canvas.height;
                }
                if (kind === 'grenade') {
                    message.targetX = bullet.targetX / canvas.width;
                    message.targetY = bullet.targetY / canvas.height;
                }
                sendOnlineMessage(message);
            }

            function receiveOnlineProjectile(message) {
                if (!onlineMode || message.shooterId === onlinePlayerId
                    || !Number.isFinite(message.x) || !Number.isFinite(message.y)
                    || !Number.isFinite(message.vx) || !Number.isFinite(message.vy)) return;
                const bullet = {
                    x: message.x * canvas.width,
                    y: message.y * canvas.height,
                    vx: message.vx * canvas.width,
                    vy: message.vy * canvas.height,
                    radius: 5,
                    projectileType: 'whitePlayer',
                    playerShot: true,
                    remotePlayerShot: true,
                    shooterId: message.shooterId,
                    color: '#00aaff',
                    damage: 1,
                    knock: 180,
                    wallBounces: 0
                };
                if (onlineMatchType === 'battle') bullet.shotId = crypto.randomUUID();
                if (message.kind === 'grenade'
                    && Number.isFinite(message.targetX) && Number.isFinite(message.targetY)) {
                    bullet.isGrenade = true;
                    bullet.targetX = message.targetX * canvas.width;
                    bullet.targetY = message.targetY * canvas.height;
                    bullet.speed = Math.hypot(bullet.vx, bullet.vy);
                }
                bullets.push(bullet);
            }

            function updatePauseButtonVisibility() {
                pauseButton.classList.toggle('hidden', !mobileMode || isMultiplayerSession());
            }

            function updateNetworkStatus() {
                networkStatus.classList.toggle('hidden', !onlineMode);
                if (!onlineMode) return;
                const translations = ONLINE_NETWORK_TEXT[language] || ONLINE_NETWORK_TEXT.en;
                const ping = Number.isFinite(onlinePing)
                    ? getLocalizedNumber(onlinePing, { maximumFractionDigits: 0 })
                    : 'â€”';
                networkStatus.textContent = translations.status.replace('{ping}', ping);
                const color = !Number.isFinite(onlinePing)
                    ? '#c8f1ff'
                    : onlinePing < 30
                        ? '#00ff66'
                        : onlinePing <= 100
                            ? '#ffe600'
                            : '#ff334f';
                networkStatus.style.color = color;
            }

            function sendOnlinePing() {
                if (!onlineSocket || onlineSocket.readyState !== WebSocket.OPEN) return;
                const requestId = ++onlinePingRequestId;
                const clientTime = Date.now();
                onlinePingRequests.set(requestId, { clientTime, sentAt: performance.now() });
                for (const [id, request] of onlinePingRequests) {
                    if (performance.now() - request.sentAt > 10000) onlinePingRequests.delete(id);
                }
                sendOnlineMessage({ type: 'ping', requestId, clientTime });
            }

            function syncOnlineElapsed(elapsed, startedAt) {
                if (!Number.isFinite(elapsed)) return;
                const startedAtChanged = Number.isFinite(startedAt)
                    && startedAt !== onlineServerStartedAt;
                if (startedAtChanged) onlineServerStartedAt = startedAt;
                onlineElapsedBase = Math.max(0, elapsed);
                onlineElapsedUpdatedAt = performance.now();
                if (startedAtChanged || !Number.isFinite(onlineServerStartedAt)) {
                    elapsedGameTime = onlineElapsedBase;
                } else {
                    elapsedGameTime = Math.max(elapsedGameTime, onlineElapsedBase);
                }
            }

            function updateOnlineElapsed() {
                if (!onlineMode) return;
                if (Number.isFinite(onlineServerStartedAt) && Number.isFinite(onlineClockOffset)) {
                    elapsedGameTime = Math.max(
                        elapsedGameTime,
                        (Date.now() + onlineClockOffset - onlineServerStartedAt) / 1000,
                        0
                    );
                } else if (onlineElapsedUpdatedAt > 0) {
                    elapsedGameTime = onlineElapsedBase + (performance.now() - onlineElapsedUpdatedAt) / 1000;
                }
            }

            function isLocalGameHost(hostname) {
                if (!hostname) return false;
                const host = hostname.toLowerCase();
                if (host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0' || host === '::1') return true;
                const privatePrefixes = ['10.', '192.168.', '172.16.', '172.17.', '172.18.', '172.19.', '172.20.', '172.21.', '172.22.', '172.23.', '172.24.', '172.25.', '172.26.', '172.27.', '172.28.', '172.29.', '172.30.', '172.31.'];
                return privatePrefixes.some(prefix => host.startsWith(prefix));
            }

            function isOfflineForOnlinePlay() {
                return !navigator.onLine && !isLocalGameHost(window.location.hostname);
            }

            function renderOnlineLobbyStatus() {
                if (!onlineLobbyStatus) return;
                const params = { ...onlineStatus.params };
                if (onlineStatus.key === 'roomStatus') {
                    params.count = getLocalizedNumber(params.count, { maximumFractionDigits: 0 });
                    params.message = getOnlineText(params.messageKey);
                }
                const statusText = getOnlineText(onlineStatus.key, params);
                onlineLobbyStatus.textContent = onlineStatus.key === 'roomStatus'
                    ? statusText.slice(statusText.indexOf('\n') + 1)
                    : statusText;
            }

            function setOnlineLobbyStatus(key, params = {}) {
                onlineStatus = { key, params };
                onlineLobbyIntro.classList.toggle('hidden', Boolean(key));
                renderOnlineLobbyStatus();
            }

            function setOnlineLobbyStep(step) {
                queueModeStep.classList.toggle('hidden', step !== 'mode');
                queueSizeStep.classList.toggle('hidden', step !== 'size');
                queueWaitStep.classList.toggle('hidden', step !== 'wait');
                if (!onlineLobbyOverlay.classList.contains('hidden')) updateActiveMenuFocus();
            }

            function formatMatchTime(milliseconds) {
                const totalSeconds = Math.max(0, Math.ceil(milliseconds / 1000));
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }

            function setOnlineNotificationMessage(text, options = {}) {
                const { green = false, disconnect = true, persistent = false, duration = 2400 } = options;
                onlineNotificationKey = '';
                onlineNotificationText.textContent = text;
                battleRoundNotificationScore.hidden = true;
                battleRoundNotificationScore.textContent = '';
                onlineNotification.classList.remove(
                    'battleResultNotification',
                    'battleResultWon',
                    'battleResultLost',
                    'battleResultDraw'
                );
                onlineNotification.classList.toggle('green', green);
                onlineNotification.classList.toggle('disconnect', disconnect && !green);
                onlineNotification.classList.remove('hidden');
                onlineNotification.classList.add('show');
                if (onlineNotificationTimeout) clearTimeout(onlineNotificationTimeout);
                onlineNotificationTimeout = null;
                if (persistent) return;
                onlineNotificationTimeout = setTimeout(() => {
                    onlineNotification.classList.remove('show');
                    onlineNotificationTimeout = setTimeout(() => {
                        onlineNotification.classList.add('hidden');
                        onlineNotificationTimeout = null;
                    }, 250);
                }, duration);
            }

            function renderQueueStatus(queuedPlayers = queuedPlayerCount) {
                queuedPlayerCount = queuedPlayers;
                const elapsed = Date.now() - queueStartedAt;
                const text = getOnlineText('queued', {
                    time: formatMatchTime(elapsed),
                    players: getLocalizedNumber(queuedPlayers, { maximumFractionDigits: 0 }),
                    required: getLocalizedNumber(onlineRequiredPlayers, { maximumFractionDigits: 0 })
                });
                queueWaitStatus.textContent = onlineMatchType === 'battle'
                    ? `${text}\n${getOnlineText('battleDescription')}`
                    : `${text}\n${getOnlineText('teamDescription')}`;
                setOnlineNotificationMessage(text, { disconnect: false, persistent: true });
            }

            function clearMatchmakingTimers() {
                if (queueElapsedInterval) clearInterval(queueElapsedInterval);
                if (matchLaunchTimeout) clearTimeout(matchLaunchTimeout);
                if (matchCountdownInterval) clearInterval(matchCountdownInterval);
                queueElapsedInterval = null;
                matchLaunchTimeout = null;
                matchCountdownInterval = null;
            }

            function showOnlineNotification(key) {
                onlineNotificationKey = key;
                setOnlineNotificationMessage(getOnlineText(key));
                onlineNotificationKey = key;
            }

            function clearOnlineConnectionTimeout() {
                if (onlineConnectionTimeout) {
                    clearTimeout(onlineConnectionTimeout);
                    onlineConnectionTimeout = null;
                }
            }

            function updateOnlineLobby(players = []) {
                const playerCount = players.length;
                const isHost = onlinePlayerId && onlinePlayerId === onlineHostId;
                onlineRoomCodeDisplay.classList.toggle('hidden', !onlineRoomCode);
                onlineRoomCodeValue.textContent = onlineRoomCode;
                btnCreateRoom.classList.toggle('hidden', Boolean(onlineRoomCode));
                roomCodeInput.classList.toggle('hidden', Boolean(onlineRoomCode));
                btnJoinRoom.classList.toggle('hidden', Boolean(onlineRoomCode));
                btnStartOnline.classList.toggle('hidden', !onlineRoomCode || !isHost);
                btnStartOnline.disabled = playerCount < 2;
                if (!deathOverlay.classList.contains('hidden')) updateMenuFocus();
                updateActiveMenuFocus();
                if (!onlineRoomCode) return;
                setOnlineLobbyStatus('roomStatus', {
                    code: onlineRoomCode,
                    count: playerCount,
                    messageKey: playerCount < 2 ? 'waitingPlayers' : 'readyPlayers'
                });
            }

            function enterOnlineGame(sharedOxygen, elapsed, startedAt) {
                onlineMode = true;
                startGame();
                oxygen = onlineMatchType === 'battle'
                    ? 100
                    : Math.max(0, Math.min(100, Number(sharedOxygen) || 0));
                syncOnlineElapsed(Math.max(0, Number(elapsed) || 0), startedAt);
                updateNetworkStatus();
                updateOxygenUI();
                updateSurvivedStopwatchUI();
                updateMatchHud();
                if (onlineMatchType !== 'battle' && oxygen <= 0) enterOxygenLoss();
            }

            function handleOnlineMessage(message) {
                if (message.type === 'queue-status') {
                    clearOnlineConnectionTimeout();
                    renderQueueStatus(message.queuedPlayers);
                    return;
                }
                if (message.type === 'match-found') {
                    clearOnlineConnectionTimeout();
                    clearMatchmakingTimers();
                    playMatchFoundSound();
                    onlineRoomCode = message.code;
                    onlineMatchType = message.mode;
                    onlineRequiredPlayers = message.requiredPlayers;
                    onlinePlayerId = message.playerId;
                    onlineHostId = message.hostId;
                    onlineBattleScore = 0;
                    onlineBattleRemaining = 0;
                    onlineBattleRound = 0;
                    onlineBattleHealth = 100;
                    battleRoundPaused = false;
                    battleCountdownLocked = false;
                    onlineBattleScores.clear();
                    onlineRemotePositionHistory.clear();
                    updateOnlinePlayerStates(message.players);
                    onlineMode = true;
                    updateNetworkStatus();
                    matchLoadingTitle.textContent = getOnlineText('loadingMatch');
                    matchLoadingCountdown.classList.add('hidden');
                    matchLoadingSpinner.classList.remove('hidden');
                    setOnlineNotificationMessage(getOnlineText('matchFound'), { green: true, persistent: true });
                    matchLaunchTimeout = setTimeout(() => {
                        matchLaunchTimeout = null;
                        onlineNotification.classList.remove('show');
                        onlineNotification.classList.add('hidden');
                        onlineLobbyOverlay.classList.add('hidden');
                        onlineLobbyOverlay.setAttribute('aria-hidden', 'true');
                        matchLoadingOverlay.classList.remove('hidden');
                        matchLoadingOverlay.setAttribute('aria-hidden', 'false');
                        sendOnlineMessage({ type: 'loading-ready' });
                        matchLoadingStatus.textContent = getOnlineText('loadingPlayers', {
                            loaded: '0',
                            required: getLocalizedNumber(onlineRequiredPlayers, { maximumFractionDigits: 0 }),
                            remaining: getLocalizedNumber(onlineRequiredPlayers, { maximumFractionDigits: 0 })
                        });
                    }, 5000);
                    return;
                }
                if (message.type === 'loading-status') {
                    const loaded = Math.max(0, Number(message.loadedPlayers) || 0);
                    const remaining = Math.max(0, onlineRequiredPlayers - loaded);
                    matchLoadingStatus.textContent = getOnlineText('loadingPlayers', {
                        loaded: getLocalizedNumber(loaded, { maximumFractionDigits: 0 }),
                        required: getLocalizedNumber(onlineRequiredPlayers, { maximumFractionDigits: 0 }),
                        remaining: getLocalizedNumber(remaining, { maximumFractionDigits: 0 })
                    });
                    return;
                }
                if (message.type === 'match-countdown') {
                    if (matchCountdownInterval) clearInterval(matchCountdownInterval);
                    matchLoadingTitle.textContent = getOnlineText('countdown');
                    matchLoadingSpinner.classList.add('hidden');
                    matchLoadingCountdown.classList.remove('hidden');
                    const updateCountdown = () => {
                        const serverNow = Date.now() + (Number.isFinite(onlineClockOffset) ? onlineClockOffset : 0);
                        const count = Math.max(0, Math.ceil((message.countdownEndsAt - serverNow) / 1000));
                        matchLoadingCountdown.textContent = String(count);
                    };
                    updateCountdown();
                    matchCountdownInterval = setInterval(updateCountdown, 100);
                    return;
                }
                if (message.type === 'match-cancelled') {
                    clearMatchmakingTimers();
                    matchLoadingOverlay.classList.add('hidden');
                    matchLoadingOverlay.setAttribute('aria-hidden', 'true');
                    onlineMode = false;
                    onlineMatchType = '';
                    onlineRequiredPlayers = 0;
                    queueStartedAt = 0;
                    onlineRoomCode = '';
                    onlinePlayerId = '';
                    onlineHostId = '';
                    onlinePlayerStates.clear();
                    onlineRemotePositionHistory.clear();
                    eliminatedBattlePlayerIds.clear();
                    matchHud.classList.add('hidden');
                    updateNetworkStatus();
                    onlineLobbyOverlay.classList.remove('hidden');
                    onlineLobbyOverlay.setAttribute('aria-hidden', 'false');
                    setOnlineNotificationMessage(getOnlineText('matchCancelled'));
                    setOnlineLobbyStep('mode');
                    return;
                }
                if (message.type === 'pong') {
                    const sample = onlinePingRequests.get(message.requestId);
                    onlinePingRequests.delete(message.requestId);
                    if (!sample || !Number.isFinite(message.serverTime)) return;
                    const roundTrip = Math.max(0, performance.now() - sample.sentAt);
                    const offset = message.serverTime - (sample.clientTime + roundTrip / 2);
                    onlineClockOffset = Number.isFinite(onlineClockOffset)
                        ? onlineClockOffset * 0.75 + offset * 0.25
                        : offset;
                    onlinePing = roundTrip;
                    updateOnlineElapsed();
                    updateSurvivedStopwatchUI();
                    updateNetworkStatus();
                    return;
                }
                if (message.type === 'error') {
                    clearOnlineConnectionTimeout();
                    clearMatchmakingTimers();
                    const errorKeys = {
                        'room-not-found': 'roomNotFound',
                        'room-full': 'roomFull',
                        'invalid-room-code': 'invalidRoomCode',
                        'invalid-match-size': 'invalidResponse'
                    };
                    const errorKey = errorKeys[message.code] || 'serverError';
                    setOnlineLobbyStatus(errorKey, { count: message.maxPlayers || 8 });
                    showOnlineNotification(errorKey);
                    if (onlineMatchType) setOnlineLobbyStep('mode');
                    return;
                }
                if (message.type === 'room-created' || message.type === 'room-joined') {
                    clearOnlineConnectionTimeout();
                    if (!/^[A-Z0-9]{5}$/.test(message.code || '')) {
                        setOnlineLobbyStatus('invalidResponse');
                        return;
                    }
                    onlineRoomCode = message.code;
                    onlinePlayerId = message.playerId || message.hostId;
                    onlineHostId = message.hostId;
                    updateOnlinePlayerStates(message.players);
                    updateOnlineLobby(message.players || []);
                    if (message.started) enterOnlineGame(message.oxygen, message.elapsed, message.startedAt);
                    return;
                }
                if (message.type === 'room-update') {
                    clearOnlineConnectionTimeout();
                    onlineRoomCode = message.code;
                    onlineHostId = message.hostId;
                    updateOnlinePlayerStates(message.players);
                    updateOnlineLobby(message.players || []);
                    if (message.started && !running) enterOnlineGame(35.5, 0, message.startedAt);
                    return;
                }
                if (message.type === 'game-start' || message.type === 'game-restart') {
                    if (matchCountdownInterval) clearInterval(matchCountdownInterval);
                    matchCountdownInterval = null;
                    matchLoadingOverlay.classList.add('hidden');
                    matchLoadingOverlay.setAttribute('aria-hidden', 'true');
                    onlineMatchType = message.mode || onlineMatchType;
                    enterOnlineGame(message.oxygen, message.elapsed, message.startedAt);
                    return;
                }
                if (message.type === 'battle-round-start') {
                    beginBattleRound(message);
                    return;
                }
                if (message.type === 'battle-round-reset') {
                    resetBattleRoundPlayers(message.players);
                    return;
                }
                if (message.type === 'battle-state') {
                    updateOnlinePlayerStates(message.players);
                    updateMatchHud();
                    return;
                }
                if (message.type === 'battle-player-eliminated') {
                    handleBattlePlayerEliminated(message);
                    return;
                }
                if (message.type === 'battle-round-over') {
                    updateOnlinePlayerStates(message.players);
                    updateMatchHud();
                    onlineBattleScore = onlineBattleScores.get(onlinePlayerId) || 0;
                    showBattleResult(message.winnerTeamId, false);
                    return;
                }
                if (message.type === 'battle-match-ended') {
                    updateOnlinePlayerStates(message.players);
                    updateMatchHud();
                    onlineBattleScore = onlineBattleScores.get(onlinePlayerId) || 0;
                    showBattleResult(message.winnerTeamId, true);
                    return;
                }
                if (message.type === 'oxygen-update') {
                    if (!Number.isFinite(message.oxygen) || !Number.isFinite(message.elapsed)) return;
                    oxygen = Math.max(0, Math.min(100, message.oxygen));
                    syncOnlineElapsed(message.elapsed, message.startedAt);
                    if (oxygen <= 0 && !oxygenLoss && !touchDeathActive) enterOxygenLoss();
                    else if (oxygen > 0 && oxygenLoss) cancelOxygenLoss();
                    updateOxygenUI();
                    updateSurvivedStopwatchUI();
                    return;
                }
                if (message.type === 'player-states') {
                    updateOnlinePlayerStates(message.players);
                    updateMatchHud();
                    return;
                }
                if (message.type === 'player-projectile') {
                    receiveOnlineProjectile(message);
                }
            }

            function connectOnline(action, code = '', matchOptions = null) {
                if (isOfflineForOnlinePlay()) {
                    showOnlineNotification('noInternet');
                    setOnlineLobbyStatus('noInternet');
                    return;
                }
                leaveOnlineRoom();
                onlineMatchType = matchOptions ? matchOptions.mode : '';
                onlineRequiredPlayers = matchOptions ? matchOptions.requiredPlayers : 0;
                queueStartedAt = matchOptions ? Date.now() : 0;
                queuedPlayerCount = 1;
                setOnlineLobbyStatus('connecting');
                onlineRoomCode = '';
                onlinePlayerId = '';
                onlineHostId = '';
                onlineServerStartedAt = NaN;
                onlineClockOffset = NaN;
                onlinePing = NaN;
                onlinePingRequests.clear();
                updateNetworkStatus();
                try {
                    const socket = new WebSocket(
                        'wss://sniper-contamination-server.lemonisalgd-86.workers.dev/multiplayer'
                    );
                    onlineSocket = socket;
                    onlineConnectionTimeout = setTimeout(() => {
                        if (onlineSocket !== socket) return;
                        setOnlineLobbyStatus(isOfflineForOnlinePlay() ? 'noInternet' : 'connectionTimeout');
                        showOnlineNotification(isOfflineForOnlinePlay() ? 'noInternet' : 'connectionTimeout');
                        setOnlineLobbyStep('mode');
                        onlineSocket = null;
                        onlineMode = false;
                        socket.close();
                    }, 60000);
                    socket.addEventListener('open', () => {
                        if (onlineSocket !== socket) return;
                        sendOnlinePing();
                        onlinePingInterval = setInterval(sendOnlinePing, 2000);
                        const sent = action === 'queue'
                            ? sendOnlineMessage({
                                type: 'queue-join',
                                mode: matchOptions.mode,
                                requiredPlayers: matchOptions.requiredPlayers
                            })
                            : sendOnlineMessage(action === 'create'
                                ? { type: 'create-room' }
                                : { type: 'join-room', code });
                        if (!sent) {
                            clearOnlineConnectionTimeout();
                            setOnlineLobbyStatus('serverUnavailable');
                            showOnlineNotification('serverUnavailable');
                            onlineSocket = null;
                            socket.close();
                            return;
                        }
                        if (action === 'queue') {
                            renderQueueStatus();
                            queueElapsedInterval = setInterval(renderQueueStatus, 1000);
                        }
                    });
                    socket.addEventListener('message', event => {
                        if (onlineSocket !== socket) return;
                        try {
                            handleOnlineMessage(JSON.parse(event.data));
                        } catch (error) {
                            console.error('Unable to read a multiplayer server message.', error);
                            clearOnlineConnectionTimeout();
                            setOnlineLobbyStatus('invalidResponse');
                            showOnlineNotification('invalidResponse');
                        }
                    });
                    socket.addEventListener('error', () => {
                        if (onlineSocket === socket) {
                            clearOnlineConnectionTimeout();
                            setOnlineLobbyStatus(isOfflineForOnlinePlay() ? 'noInternet' : 'serverUnavailable');
                            showOnlineNotification(isOfflineForOnlinePlay() ? 'noInternet' : 'serverUnavailable');
                        }
                    });
                    socket.addEventListener('close', () => {
                        if (onlineSocket !== socket) return;
                        clearOnlineConnectionTimeout();
                        if (onlinePingInterval) clearInterval(onlinePingInterval);
                        onlinePingInterval = null;
                        onlineSocket = null;
                        onlineMode = false;
                        updateNetworkStatus();
                        updateBattleHealthUI();
                        onlinePlayerStates.clear();
                        onlineRemotePositionHistory.clear();
                        eliminatedBattlePlayerIds.clear();
                        onlineRoomCode = '';
                        if (running || dead) {
                            showOnlineNotification('connectionLost');
                            showMenu();
                        } else {
                            clearMatchmakingTimers();
                            matchLoadingOverlay.classList.add('hidden');
                            matchLoadingOverlay.setAttribute('aria-hidden', 'true');
                            onlineMode = false;
                            onlineMatchType = '';
                            onlineRequiredPlayers = 0;
                            matchHud.classList.add('hidden');
                            onlineLobbyOverlay.classList.remove('hidden');
                            onlineLobbyOverlay.setAttribute('aria-hidden', 'false');
                            setOnlineLobbyStatus(isOfflineForOnlinePlay() ? 'noInternet' : 'connectionClosed');
                            showOnlineNotification(isOfflineForOnlinePlay() ? 'noInternet' : 'connectionClosed');
                            setOnlineLobbyStep('mode');
                        }
                    });
                } catch (error) {
                    console.error('Unable to connect to the multiplayer server.', error);
                    clearOnlineConnectionTimeout();
                    setOnlineLobbyStatus(isOfflineForOnlinePlay() ? 'noInternet' : 'serverUnavailable');
                }
            }

            function leaveOnlineRoom() {
                clearOnlineConnectionTimeout();
                clearMatchmakingTimers();
                clearBattleRoundCountdown();
                battleScoreboardOpen = false;
                if (onlinePingInterval) clearInterval(onlinePingInterval);
                onlinePingInterval = null;
                const socket = onlineSocket;
                onlineSocket = null;
                onlineMode = false;
                updateNetworkStatus();
                onlineRoomCode = '';
                onlineMatchType = '';
                onlineRequiredPlayers = 0;
                onlineBattleScore = 0;
                onlineBattleRemaining = 0;
                onlineBattleScores.clear();
                battleEliminated = false;
                battleCountdownLocked = false;
                battleEliminatedNotice.classList.add('hidden');
                updateBattleHealthUI();
                onlinePlayerId = '';
                onlineHostId = '';
                onlinePlayerStates.clear();
                onlineRemotePositionHistory.clear();
                eliminatedBattlePlayerIds.clear();
                onlineElapsedUpdatedAt = 0;
                onlineServerStartedAt = NaN;
                onlineClockOffset = NaN;
                onlinePingRequests.clear();
                onlinePing = NaN;
                matchLoadingOverlay.classList.add('hidden');
                matchLoadingOverlay.setAttribute('aria-hidden', 'true');
                matchHud.classList.add('hidden');
                if (socket) {
                    if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify({ type: 'leave-room' }));
                    socket.close();
                }
            }

            function showMenu() {
                leaveOnlineRoom();
                clearBattleResultNotification();
                battleResultOverlay.classList.add('hidden');
                battleResultOverlay.setAttribute('aria-hidden', 'true');
                menu.classList.remove('hidden');
                updateBattleHealthUI();
                survivedStopwatch.classList.add('hidden');
                settingsScreen.classList.add('hidden');
                pauseOverlay.classList.add('hidden');
                pauseConfirmOverlay.classList.add('hidden');
                pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                pauseConfirmContent.classList.remove('exiting');
                savedRunConfirmOverlay.classList.add('hidden');
                savedRunConfirmOverlay.setAttribute('aria-hidden', 'true');
                savedRunConfirmContent.classList.remove('exiting');
                playModeOverlay.classList.add('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'true');
                onlineLobbyOverlay.classList.add('hidden');
                onlineLobbyOverlay.setAttribute('aria-hidden', 'true');
                deathOverlay.classList.add('hidden');
                battleResultOverlay.classList.add('hidden');
                battleResultOverlay.setAttribute('aria-hidden', 'true');
                pauseButton.classList.add('hidden');
                gameBatteryWidget.classList.remove('visible');
                setMobileActionButtonsVisible(false);
                fpsDisplay.classList.add('hidden');
                oxygenBarContainer.classList.add('hidden');
                explodeCooldownDisplay.classList.add('hidden');
                staminaBar.classList.remove('visible');
                oxygenWarningText.classList.add('hidden');
                oxygenWarningSkull.classList.add('hidden');
                oxygenVignette.classList.remove('active');
                oxygenBarContainer.classList.remove('oxygenBarFlash');
                battleRoundPaused = false;
                battleEliminated = false;
                battleEliminatedNotice.classList.add('hidden');
                fadeOverlay.style.opacity = '0';
                running = false;
                paused = false;
                dead = false;
                updateCursorVisibility();
                if (audioCtx) audioCtx.suspend();
                mainMenuIndex = 0;
                updateMenuFocus();
                updateSettingsButtonsVisibility();
            }
            function showSettings(fromMenu = true) {
                settingsScreen.classList.remove('hidden');
                drawCrosshairPreview();
                if (fromMenu) {
                    menu.classList.add('hidden');
                    animateMenuSceneEntry(settingsScreen);
                }
                settingsCurrentGroup = 'language';
                syncSettingsIndicesFromDOM();
                updateSettingsFocus();
            }
            function hideSettings() {
                settingsScreen.classList.add('hidden');
                if (!running && !dead) {
                    menu.classList.remove('hidden');
                    animateMenuSceneEntry(menu);
                }
            }
            function animateMenuSceneEntry(screen) {
                screen.classList.remove('menuSceneEntering');
                void screen.offsetWidth;
                screen.classList.add('menuSceneEntering');
                setTimeout(() => screen.classList.remove('menuSceneEntering'), 760);
            }
            function transitionScreen(changeScreen) {
                if (screenTransitioning) return;
                screenTransitioning = true;
                gameContainer.classList.add('screenFading');
                screenTransition.classList.remove('leave');
                screenTransition.classList.remove('active');
                for (let i = 1; i <= 10; i++) screenTransition.classList.remove(`transitionStyle${i}`);
                const transitionStyle = 1 + Math.floor(Math.random() * 10);
                screenTransition.classList.add(`transitionStyle${transitionStyle}`);
                void screenTransition.offsetWidth;
                screenTransition.classList.add('active');
                setTimeout(() => {
                    changeScreen();
                    screenTransition.classList.remove('active');
                    screenTransition.classList.add('leave');
                    setTimeout(() => {
                        screenTransition.classList.remove('leave');
                        gameContainer.classList.remove('screenFading');
                        screenTransitioning = false;
                    }, 520);
                }, 460);
            }

            function getSavedRunPromptButtons() {
                return [btnLoadSavedRun, btnStartNewRun, btnCancelSavedRun];
            }

            function updateSavedRunPromptFocus() {
                const buttons = getSavedRunPromptButtons();
                buttons.forEach(button => button.classList.remove('btnFocused'));
                const focusedButton = buttons[savedRunConfirmIndex];
                if (focusedButton) {
                    focusedButton.classList.add('btnFocused');
                    focusedButton.focus({ preventScroll: true });
                }
            }

            function openSavedRunPrompt() {
                savedRunConfirmContent.classList.remove('exiting');
                savedRunConfirmOverlay.classList.remove('hidden');
                savedRunConfirmOverlay.setAttribute('aria-hidden', 'false');
                savedRunConfirmIndex = 0;
                updateSavedRunPromptFocus();
            }

            function closeSavedRunPrompt() {
                if (savedRunConfirmContent.classList.contains('exiting')) return;
                savedRunConfirmContent.classList.add('exiting');
                let finished = false;
                const finish = () => {
                    if (finished) return;
                    finished = true;
                    savedRunConfirmOverlay.classList.add('hidden');
                    savedRunConfirmOverlay.setAttribute('aria-hidden', 'true');
                    savedRunConfirmContent.classList.remove('exiting');
                    btnPlay.focus({ preventScroll: true });
                };
                const onExitAnimationEnd = (event) => {
                    if (event.animationName !== 'pauseConfirmOut') return;
                    savedRunConfirmContent.removeEventListener('animationend', onExitAnimationEnd);
                    finish();
                };
                savedRunConfirmContent.addEventListener('animationend', onExitAnimationEnd);
                setTimeout(finish, 250);
            }

            function startFromSavedRunChoice(loadSavedRun) {
                const savedRun = loadSavedRun ? getSavedRun() : null;
                if (loadSavedRun && !savedRun) {
                    closeSavedRunPrompt();
                    return;
                }
                if (!clearSavedRun()) return;
                savedRunConfirmOverlay.classList.add('hidden');
                savedRunConfirmOverlay.setAttribute('aria-hidden', 'true');
                savedRunConfirmContent.classList.remove('exiting');
                startGame(savedRun);
            }

            btnPlay.addEventListener('click', () => {
                initAudio();
                playModeOverlay.classList.remove('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'false');
                actionMenuIndex = 0;
                updateMenuFocus();
                updateActiveMenuFocus();
            });
            btnSoloMode.addEventListener('click', () => {
                playModeOverlay.classList.add('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'true');
                updateMenuFocus();
                if (getSavedRun()) openSavedRunPrompt();
                else startGame();
            });
            btnOnlineMode.addEventListener('click', () => {
                if (isOfflineForOnlinePlay()) {
                    showOnlineNotification('noInternet');
                    return;
                }
                playModeOverlay.classList.add('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'true');
                onlineLobbyOverlay.classList.remove('hidden');
                onlineLobbyOverlay.setAttribute('aria-hidden', 'false');
                setOnlineLobbyStep('mode');
                setOnlineLobbyStatus('');
                roomCodeInput.value = '';
                actionMenuIndex = 0;
                updateMenuFocus();
                updateActiveMenuFocus();
            });
            btnCancelPlayMode.addEventListener('click', () => {
                playModeOverlay.classList.add('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'true');
                updateMenuFocus();
                btnPlay.focus({ preventScroll: true });
            });
            function showOnlineSizeOptions(mode) {
                const choices = mode === 'battle'
                    ? [2, 4, 6, 8, 10].map(size => ({ size, label: `${size / 2}v${size / 2}` }))
                    : [2, 3, 4, 5].map(size => ({ size, label: `1+${size - 1}` }));
                queueSizeTitle.textContent = getOnlineText(mode === 'battle' ? 'chooseBattleSize' : 'chooseTeamSize');
                queueSizeButtons.replaceChildren();
                for (const choice of choices) {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn';
                    button.dataset.icon = mode === 'battle' ? 'battle' : 'team';
                    button.textContent = choice.label;
                    button.addEventListener('click', () => startMatchmaking(mode, choice.size));
                    queueSizeButtons.appendChild(button);
                }
                setOnlineLobbyStep('size');
                actionMenuIndex = 0;
                updateActiveMenuFocus();
            }
            function startMatchmaking(mode, requiredPlayers) {
                if (isOfflineForOnlinePlay()) {
                    showOnlineNotification('noInternet');
                    return;
                }
                playQueueSound();
                setOnlineLobbyStep('wait');
                queueWaitStatus.textContent = getOnlineText('connecting');
                connectOnline('queue', '', { mode, requiredPlayers });
                updateActiveMenuFocus();
            }
            function cancelMatchmaking() {
                if (onlineSocket && onlineSocket.readyState === WebSocket.OPEN) {
                    sendOnlineMessage({ type: 'queue-leave' });
                }
                leaveOnlineRoom();
                setOnlineLobbyStep('mode');
                setOnlineNotificationMessage(getOnlineText('queueCancelled'));
            }
            function goBackOnlineMenu() {
                if (!queueWaitStep.classList.contains('hidden')) {
                    cancelMatchmaking();
                } else if (!queueSizeStep.classList.contains('hidden')) {
                    btnQueueSizeBack.click();
                } else {
                    btnOnlineBack.click();
                }
            }
            btnBattleMode.addEventListener('click', () => showOnlineSizeOptions('battle'));
            btnTeamMode.addEventListener('click', () => showOnlineSizeOptions('team'));
            btnQueueSizeBack.addEventListener('click', () => {
                setOnlineLobbyStep('mode');
                actionMenuIndex = 0;
                updateActiveMenuFocus();
            });
            btnCancelQueue.addEventListener('click', cancelMatchmaking);
            btnCreateRoom.addEventListener('click', () => connectOnline('create'));
            btnJoinRoom.addEventListener('click', () => {
                const code = roomCodeInput.value.trim().toUpperCase();
                if (!/^[A-Z0-9]{5}$/.test(code)) {
                    setOnlineLobbyStatus('invalidRoomCode');
                    roomCodeInput.focus({ preventScroll: true });
                    return;
                }
                connectOnline('join', code);
            });
            btnStartOnline.addEventListener('click', () => {
                if (!btnStartOnline.disabled) sendOnlineMessage({ type: 'start-game' });
            });
            btnOnlineBack.addEventListener('click', () => {
                leaveOnlineRoom();
                onlineLobbyOverlay.classList.add('hidden');
                onlineLobbyOverlay.setAttribute('aria-hidden', 'true');
                playModeOverlay.classList.remove('hidden');
                playModeOverlay.setAttribute('aria-hidden', 'false');
                actionMenuIndex = 1;
                updateMenuFocus();
                updateActiveMenuFocus();
                btnOnlineMode.focus({ preventScroll: true });
            });
            window.addEventListener('offline', () => {
                if (!isLocalGameHost(window.location.hostname)) {
                    showOnlineNotification('noInternet');
                    if (!onlineLobbyOverlay.classList.contains('hidden')) setOnlineLobbyStatus('noInternet');
                }
            });
            window.addEventListener('online', () => {
                if (onlineStatus.key === 'noInternet' && !onlineLobbyOverlay.classList.contains('hidden') && navigator.onLine) {
                    setOnlineLobbyStatus('');
                }
            });
            roomCodeInput.addEventListener('input', () => {
                roomCodeInput.value = roomCodeInput.value.replace(/[^a-z0-9]/gi, '').toUpperCase().slice(0, 5);
            });
            btnLoadSavedRun.addEventListener('click', () => startFromSavedRunChoice(true));
            btnStartNewRun.addEventListener('click', () => startFromSavedRunChoice(false));
            btnCancelSavedRun.addEventListener('click', closeSavedRunPrompt);
            btnMenuSettings.addEventListener('click', () => {
                settingsFromDeath = false;
                settingsFromPause = false;
                transitionScreen(() => showSettings(true));
            });
            btnPauseSettings.addEventListener('click', () => {
                settingsFromDeath = false;
                settingsFromPause = true;
                pauseMenuIndex = 1;
                transitionScreen(() => {
                    pauseOverlay.classList.add('hidden');
                    showSettings(false);
                });
            });
            btnSettingsBack.addEventListener('click', () => {
                if (settingsFromPause) {
                    transitionScreen(() => {
                        settingsFromPause = false;
                        settingsScreen.classList.add('hidden');
                        pauseOverlay.classList.remove('hidden');
                        updatePauseMenuFocus();
                    });
                } else if (settingsFromDeath) {
                    transitionScreen(() => {
                        settingsFromDeath = false;
                        settingsScreen.classList.add('hidden');
                        deathOverlay.classList.remove('hidden');
                    });
                } else {
                    transitionScreen(hideSettings);
                }
            });
            btnDeathSettings.addEventListener('click', () => {
                settingsFromDeath = true;
                settingsFromPause = false;
                transitionScreen(() => {
                    deathOverlay.classList.add('hidden');
                    showSettings(false);
                });
            });
            btnMainMenu.addEventListener('click', () => {
                settingsFromDeath = false;
                deathOverlay.classList.add('hidden');
                showMenu();
            });
            btnBattleMainMenu.addEventListener('click', showMenu);

            settingsPanel.addEventListener('click', event => {
                const button = event.target.closest('button[data-setting-group], button[data-setting-toggle]');
                if (!button) return;
                if (button.dataset.settingGroup === 'crosshairStyle') {
                    crosshairStyle = button.dataset.settingValue;
                } else if (button.dataset.settingGroup === 'crosshairColor') {
                    const presetColors = {
                        green: '#00ff66',
                        white: '#ffffff',
                        cyan: '#00ffff',
                        yellow: '#ffe600'
                    };
                    crosshairColor = presetColors[button.dataset.settingValue] || '#00ff66';
                } else if (button.dataset.settingToggle === 'toggleSprint') {
                    toggleSprint = !toggleSprint;
                    sprintHeld = false;
                    sprintToggleActive = false;
                } else if (button.dataset.settingToggle === 'showBatteryInGame') {
                    showBatteryInGame = !showBatteryInGame;
                } else if (button.dataset.settingToggle === 'crosshairOutline') {
                    crosshairOutline = !crosshairOutline;
                } else if (button.dataset.settingToggle === 'crosshairCenterDot') {
                    crosshairCenterDot = !crosshairCenterDot;
                } else if (button.dataset.settingGroup === 'crosshairReset') {
                    resetCrosshairSettings();
                } else {
                    return;
                }
                settingsCurrentGroup = button.dataset.settingGroup || button.dataset.settingToggle;
                updateGameplaySettingsUI();
                saveSettings();
                updateSettingsFocus();
            });
            crosshairSizeSlider.addEventListener('input', () => {
                crosshairSize = Number(crosshairSizeSlider.value);
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairThicknessSlider.addEventListener('input', () => {
                crosshairThickness = Number(crosshairThicknessSlider.value);
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairGapSlider.addEventListener('input', () => {
                crosshairGap = Number(crosshairGapSlider.value);
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairOpacitySlider.addEventListener('input', () => {
                crosshairOpacity = Number(crosshairOpacitySlider.value);
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairOutlineThicknessSlider.addEventListener('input', () => {
                crosshairOutlineThickness = Number(crosshairOutlineThicknessSlider.value);
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairColorPicker.addEventListener('input', () => {
                crosshairColor = crosshairColorPicker.value;
                crosshairColorCode.removeAttribute('aria-invalid');
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairColorCode.addEventListener('input', () => {
                const value = crosshairColorCode.value.trim();
                if (!/^#[\da-f]{6}$/i.test(value)) {
                    crosshairColorCode.setAttribute('aria-invalid', 'true');
                    return;
                }
                crosshairColorCode.removeAttribute('aria-invalid');
                crosshairColor = value.toLowerCase();
                crosshairColorPicker.value = crosshairColor;
                updateGameplaySettingsUI();
                saveSettings();
            });
            crosshairColorCode.addEventListener('blur', () => {
                crosshairColorCode.removeAttribute('aria-invalid');
                crosshairColorCode.value = crosshairColor.toUpperCase();
            });

            languageButtons.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-lang]');
                if (!btn) return;
                language = btn.dataset.lang;
                saveSettings();
                [...languageButtons.querySelectorAll('button')].forEach(b => b.style.outline = 'none');
                btn.style.outline = '2px solid #ffffff';
                applyLanguage();
                updateFPSDescriptionVisibility();
                syncSettingsIndicesFromDOM();
                updateSettingsFocus();
            });

            performanceButtons.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-perf]');
                if (!btn) return;
                performanceMode = btn.dataset.perf || 'performance';
                saveSettings();
                syncPerformanceButtonSelection();
                syncSettingsIndicesFromDOM();
                updateSettingsFocus();
            });

            (function initDefaults() {
                const defaultLangBtn = languageButtons.querySelector(`button[data-lang="${language}"]`)
                    || languageButtons.querySelector('button[data-lang="en"]');
                if (defaultLangBtn) defaultLangBtn.click();
                const defaultPerfBtn = performanceButtons.querySelector(`button[data-perf="${performanceMode}"]`)
                    || performanceButtons.querySelector('button[data-perf="performance"]');
                if (defaultPerfBtn) defaultPerfBtn.click();
                applyLanguage();
            })();

            function resetGameState() {
                player.x = canvas.width / 2;
                player.y = canvas.height / 2;
                player.vx = 0;
                player.vy = 0;
                player.knockVx = 0;
                player.knockVy = 0;
                player.knockImpulseX = 0;
                player.knockImpulseY = 0;
                player.knockTime = 0;
                player.knockDuration = 0.5;
                player.swirlAngle = 0;
                player.swirlSpinSpeed = 0;
                player.visible = true;
                greenSnipers.length = 0;
                redSnipers.length = 0;
                orangeSnipers.length = 0;
                purpleTriangleSnipers.length = 0;
                blueSnipers.length = 0;
                yellowStarSnipers.length = 0;
                oxygenOrbs.length = 0;
                sniperRewardOrbs.length = 0;
                sniperRewardBurstOrbs.length = 0;
                sniperOrbRewardPopups.length = 0;
                clearDeathOrbDrops();
                bullets.length = 0;
                debrisPieces.length = 0;
                shockwaves.length = 0;
                damageNumbers.length = 0;
                greenSpawnTimer = 0;
                redSpawnTimer = 0;
                orangeSpawnTimer = 0;
                purpleSpawnTimer = 0;
                blueSpawnTimer = 0;
                yellowSpawnTimer = 0;
                orbSpawnTimer = 0;
                oxygen = 35.5;
                stamina = maxStamina;
                staminaDepletedLockout = false;
                sprinting = false;
                sprintHeld = false;
                sprintToggleActive = false;
                controllerSprintHeld = false;
                mobileSprintHeld = false;
                mobileSprintToggleEnabled = false;
                updateSprintButtonState();
                staminaBar.classList.remove('visible');
                oxygenLoss = false;
                oxygenLossStartTime = 0;
                fadeProgress = 0;
                deathTriggered = false;
                deathCause = 'normal';
                elapsedGameTime = 0;
                survivedStopwatch.textContent = '00.0';
                survivedStopwatch.classList.add('hidden');
                fadeOverlay.style.opacity = '0';
                oxygenVignette.classList.remove('active');
                oxygenWarningText.classList.add('hidden');
                oxygenWarningSkull.classList.add('hidden');
                oxygenBarContainer.classList.remove('oxygenBarFlash');
                stopTreble();
                stopHeartbeat();
                touchDeathActive = false;
                touchDeathTimer = 0;
                touchBreakTriggered = false;
                playerShotCooldown = 0;
                explodeCooldown = 0;
                empCooldown = 0;
                phaseCooldown = 0;
                phaseShiftTimer = 0;
                empScreenTimer = 0;
                selectedAbility = 0;
                mouseLeftDown = false;
                aimX = player.x + lastMoveDirX * 100;
                aimY = player.y + lastMoveDirY * 100;
                controllerAimActive = false;
                if (explodeButton) {
                    explodeButton.style.setProperty('--cooldown-progress', '360deg');
                }
                if (empButton) empButton.style.setProperty('--cooldown-progress', '360deg');
                if (phaseButton) phaseButton.style.setProperty('--cooldown-progress', '360deg');
                updateAbilityEffects(0);
                updateAbilityUI();
                deathTitle.classList.remove('show');
                deathSurvived.classList.remove('show');
                deathSurvived.textContent = '';
                applyLanguage();
            }
            function startGame(savedRun = null) {
                resetGameState();
                if (savedRun) restoreGameState(savedRun);
                else mobileMode = lastInputMethod === 'touch';
                survivedStopwatch.classList.remove('hidden');
                survivedStopwatch.textContent = getLocalizedNumber(elapsedGameTime, {
                    maximumFractionDigits: 1,
                    minimumFractionDigits: 1
                });
                fpsDisplay.classList.remove('hidden');
                oxygenBarContainer.classList.toggle('soloOxygenBar', !onlineMode);
                oxygenBarContainer.classList.toggle('hidden', onlineMode && onlineMatchType === 'battle');
                updateBattleHealthUI();
                survivedStopwatch.classList.toggle('hidden', onlineMatchType === 'battle');
                explodeCooldownDisplay.classList.toggle('hidden', onlineMatchType === 'battle');
                menu.classList.add('hidden');
                settingsScreen.classList.add('hidden');
                pauseOverlay.classList.add('hidden');
                pauseConfirmOverlay.classList.add('hidden');
                pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                savedRunConfirmOverlay.classList.add('hidden');
                savedRunConfirmOverlay.setAttribute('aria-hidden', 'true');
                deathOverlay.classList.add('hidden');
                updatePauseButtonVisibility();
                explodeButton.classList.toggle('visible', mobileMode);
                sprintButton.classList.toggle('visible', mobileMode);
                shootButton.classList.toggle('visible', mobileMode);
                gameBatteryWidget.classList.toggle('visible', showBatteryInGame);
                gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                running = true;
                paused = false;
                dead = false;
                updateOxygenUI();
                updateBattleHealthUI();
                updateSprintButtonState();
                updateExplodeCooldownUI();
                if (oxygenLoss) {
                    fadeOverlay.style.opacity = String(fadeProgress);
                    oxygenVignette.classList.add('active');
                    oxygenBarContainer.classList.add('oxygenBarFlash');
                    if (mobileMode) {
                        oxygenWarningSkull.classList.remove('hidden');
                        oxygenWarningText.classList.add('hidden');
                    } else {
                        oxygenWarningText.classList.remove('hidden');
                        oxygenWarningSkull.classList.add('hidden');
                    }
                }
                setMobileActionButtonsVisible(mobileMode);
                updateCursorVisibility();
                settingsFromDeath = false;
                if (audioCtx) audioCtx.resume();
                if (mobileMode) {
                    showJoystickAtRest();
                } else {
                    joystickBase.classList.add('hidden');
                    joystickStick.classList.add('hidden');
                }
                if (!savedRun) showTutorialMessage();
                showSkullTransition(() => {
                    if (!savedRun && onlineMatchType !== 'battle') spawnGreenSniper();
                    if (oxygenLoss) {
                        startTrebleFadeIn();
                        startHeartbeat();
                    }
                    lastTime = performance.now();
                    requestGameFrame();
                });
            }
            function restartGame() {
                if (onlineMode) {
                    if (!onlinePlayerId || onlinePlayerId !== onlineHostId) return;
                    sendOnlineMessage({ type: 'restart-game' });
                    return;
                }
                deathOverlay.classList.add('hidden');
                startGame();
            }
            btnRestart.addEventListener('click', restartGame);

            function showSkullTransition(onDone) {
                skullTransition.classList.remove('hidden');
                skullIcon.classList.remove('fade');
                skullIcon.classList.add('show');
                setTimeout(() => {
                    skullIcon.classList.remove('show');
                    skullIcon.classList.add('fade');
                    setTimeout(() => {
                        skullTransition.classList.add('hidden');
                        skullIcon.classList.remove('fade');
                        if (onDone) onDone();
                    }, 500);
                }, 600);
            }

            function setPaused(p) {
                if (isMultiplayerSession()) {
                    paused = false;
                    pauseOverlay.classList.add('hidden');
                    pauseConfirmOverlay.classList.add('hidden');
                    pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                    updateCursorVisibility();
                    return;
                }
                if (!running || dead) return;
                paused = p;
                updateCursorVisibility();
                const t = LANG[language] || LANG.en;
                if (paused) {
                    pauseOverlay.classList.remove('hidden');
                    pauseConfirmOverlay.classList.add('hidden');
                    pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                    pauseConfirmContent.classList.remove('exiting');
                    pauseMenuIndex = 0;
                    updatePauseMenuFocus();
                    const seconds = elapsedGameTime.toFixed(1);
                    progressText.textContent = (t.progress || LANG.en.progress).replace('{s}', seconds);
                    stopTreble();
                    stopHeartbeat();
                } else {
                    pauseOverlay.classList.add('hidden');
                    pauseConfirmOverlay.classList.add('hidden');
                    pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                    pauseConfirmContent.classList.remove('exiting');
                    if (audioCtx) audioCtx.resume();
                    if (oxygenLoss) {
                        startTrebleFadeIn();
                        startHeartbeat();
                    }
                    lastTime = performance.now();
                    requestGameFrame();
                }
            }
            btnResume.addEventListener('click', () => setPaused(false));
            btnQuit.addEventListener('click', () => {
                pauseConfirmContent.classList.remove('exiting');
                pauseConfirmOverlay.classList.remove('hidden');
                pauseConfirmOverlay.setAttribute('aria-hidden', 'false');
                quitConfirmIndex = 0;
                updatePauseMenuFocus();
                btnConfirmQuit.focus({ preventScroll: true });
            });
            btnCancelQuit.addEventListener('click', () => {
                if (pauseConfirmContent.classList.contains('exiting')) return;
                pauseConfirmContent.classList.add('exiting');
                const finishCancel = () => {
                    if (!pauseConfirmContent.classList.contains('exiting')) return;
                    pauseConfirmOverlay.classList.add('hidden');
                    pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                    pauseConfirmContent.classList.remove('exiting');
                    updatePauseMenuFocus();
                    btnQuit.focus({ preventScroll: true });
                };
                const onExitAnimationEnd = (event) => {
                    if (event.animationName !== 'pauseConfirmOut') return;
                    pauseConfirmContent.removeEventListener('animationend', onExitAnimationEnd);
                    finishCancel();
                };
                pauseConfirmContent.addEventListener('animationend', onExitAnimationEnd);
                setTimeout(finishCancel, 250);
            });
            btnMenuQuit.addEventListener('click', openMainQuitConfirm);
            btnCancelMainQuit.addEventListener('click', closeMainQuitConfirm);
            btnConfirmMainQuit.addEventListener('click', () => {
                window.close();
                // Browsers ignore window.close() for tabs the script didn't open,
                // so if we're still here after a moment, show a message instead.
                setTimeout(() => {
                    closeMainQuitConfirm();
                    setOnlineNotificationMessage('You can now close this tab.', {
                        disconnect: false,
                        duration: 3000
                    });
                }, 150);
            });
            btnConfirmQuit.addEventListener('click', () => {
                if (clearSavedRun()) showMenu();
            });
            btnSaveAndQuit.addEventListener('click', () => {
                if (saveCurrentRun()) showMenu();
            });
            pauseButton.addEventListener('click', () => setPaused(!paused));
            document.addEventListener('visibilitychange', () => {
                if (document.hidden && running && !paused && !dead && !isMultiplayerSession()) {
                    setPaused(true);
                }
            });
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Tab' && onlineMode && onlineMatchType === 'battle'
                    && running && !dead && !battleRoundPaused) {
                    e.preventDefault();
                    if (!e.repeat) {
                        battleScoreboardOpen = true;
                        updateMatchHud();
                    }
                    return;
                }
                if (isMultiplayerSession() && running && ['Escape', '+', '-'].includes(e.key)) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return;
                }
                if (e.key === 'Escape' && !onlineLobbyOverlay.classList.contains('hidden')) {
                    goBackOnlineMenu();
                    return;
                }
                if (e.key === 'Escape' && !playModeOverlay.classList.contains('hidden')) {
                    btnCancelPlayMode.click();
                    return;
                }
                if (e.key === 'Escape' && !savedRunConfirmOverlay.classList.contains('hidden')) {
                    btnCancelSavedRun.click();
                    return;
                }
                if (e.key === 'Escape' && !settingsScreen.classList.contains('hidden')) {
                    btnSettingsBack.click();
                    return;
                }
                if (e.key === 'Escape' && !pauseConfirmOverlay.classList.contains('hidden')) {
                    btnCancelQuit.click();
                    return;
                }
                if (e.key === 'Escape' && !mainQuitConfirmOverlay.classList.contains('hidden')) {
                    e.preventDefault();
                    btnCancelMainQuit.click();
                    return;
                }
                if (e.key === 'Escape' && !menu.classList.contains('hidden') && !running && !dead) {
                    e.preventDefault();
                    openMainQuitConfirm();
                    return;
                }
                if (isMultiplayerSession()) return;
                if (e.key === 'Escape' || e.key === '+' || e.key === '-') setPaused(!paused);
            });

            window.addEventListener('keydown', (e) => {
                keys[e.key.toLowerCase()] = true;
                if (e.key === 'Shift') {
                    if (onlineMatchType === 'battle') {
                        sprintHeld = false;
                        sprintToggleActive = false;
                    } else if (toggleSprint) {
                        if (!e.repeat) sprintToggleActive = !sprintToggleActive;
                    } else {
                        sprintHeld = true;
                    }
                }
                controllerMode = false;
                lastInputMethod = 'keyboard';
                const key = e.key.toLowerCase();
                if (!e.repeat && running && !paused && !dead && key >= '1' && key <= '4') {
                    setComputerInputMode();
                    selectAbility(Number(key) - 1);
                }
                if (!e.repeat && !settingsScreen.classList.contains('hidden') && (key === 'a' || key === 'd')) {
                    const direction = key === 'd' ? 1 : -1;
                    if (adjustFocusedVolume(direction)) {
                        startKeyboardSliderAdjust(direction);
                    } else {
                        moveSettingsFocusHorizontally(direction);
                    }
                }
                if (!e.repeat && (key === 'w' || key === 's')) {
                    const direction = key === 's' ? 1 : -1;
                    if (!settingsScreen.classList.contains('hidden')) {
                        cycleSettingsGroup(direction);
                    }
                }
                if (['w', 'a', 's', 'd', 'arrowup', 'arrowdown', 'arrowleft', 'arrowright'].includes(e.key.toLowerCase())) {
                    mobileMode = false;
                    lastInputMethod = 'keyboard';
                    hideJoystick();
                    mobileSprintHeld = false;
                    setMobileActionButtonsVisible(false);
                    pauseButton.classList.add('hidden');
                    if (gameBatteryWidget) {
                        gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                    }
                }
                updateFPSDescriptionVisibility();
                updateSettingsButtonsVisibility();
            });
            window.addEventListener('keyup', (e) => {
                keys[e.key.toLowerCase()] = false;
                if (e.key === 'Tab' && battleScoreboardOpen) {
                    battleScoreboardOpen = false;
                    updateMatchHud();
                }
                if (e.key === 'Shift') sprintHeld = false;
                if (['a', 'd'].includes(e.key.toLowerCase()) && settingsKeyboardSliderTimer) {
                    clearInterval(settingsKeyboardSliderTimer);
                    settingsKeyboardSliderTimer = null;
                }
            });
            window.addEventListener('blur', () => {
                if (!battleScoreboardOpen) return;
                battleScoreboardOpen = false;
                updateMatchHud();
            });

            function showJoystick(x, y) {
                joystickActive = true;
                setJoystickPosition(x, y);
                joystickVector.x = 0;
                joystickVector.y = 0;
                joystickStick.style.left = joystickCenter.x + 'px';
                joystickStick.style.top = joystickCenter.y + 'px';
                joystickBase.classList.remove('hidden');
                joystickStick.classList.remove('hidden');
                joystickBase.classList.add('active');
                joystickStick.classList.add('active');
                mobileMode = true;
                lastInputMethod = 'touch';
                updatePauseButtonVisibility();
                updateOxygenUI();
                setMobileActionButtonsVisible(true);
                updateJoystick(x, y);
                gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                sprintButton.classList.toggle('enabled', mobileSprintToggleEnabled);
                sprintButton.classList.toggle('disabled', !mobileSprintToggleEnabled);
                controllerMode = false;
                updateFPSDescriptionVisibility();
                updateSettingsButtonsVisibility();
            }
            function hideJoystick() {
                joystickActive = false;
                joystickTouchId = null;
                setJoystickPosition();
                joystickBase.classList.remove('active');
                joystickStick.classList.remove('active');
                joystickVector.x = 0;
                joystickVector.y = 0;

                if (lastInputMethod === 'keyboard' || lastInputMethod === 'controller') {
                    mobileMode = false;
                    updatePauseButtonVisibility();
                    joystickBase.classList.add('hidden');
                    joystickStick.classList.add('hidden');
                    updateOxygenUI();
                    gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                    setMobileActionButtonsVisible(false);
                    return;
                }

                mobileMode = true;
                lastInputMethod = 'touch';
                updatePauseButtonVisibility();
                updateOxygenUI();
                joystickBase.classList.remove('hidden');
                joystickStick.classList.remove('hidden');
                gameBatteryWidget.classList.toggle('mobilePosition', true);
                setMobileActionButtonsVisible(true);
            }
            function setMobileActionButtonsVisible(visible) {
                const shouldShow = visible && mobileMode && running && !dead && !touchDeathActive;
                [explodeButton, empButton, phaseButton, sprintButton, shootButton].forEach(button => {
                    const restrictedInBattle = onlineMatchType === 'battle'
                        && button !== shootButton;
                    button.classList.toggle('visible', shouldShow && !restrictedInBattle);
                });
                updateAbilityUI();
                if (!shouldShow) {
                    mobileSprintToggleEnabled = false;
                    mobileSprintHeld = false;
                    updateSprintButtonState();
                    mobileShootHeld = false;
                    shootButton.classList.remove('active');
                    shootButton.setAttribute('aria-pressed', 'false');
                }
            }
            function setComputerInputMode() {
                controllerMode = false;
                gameContainer.classList.remove('controllerMode');
                mobileMode = false;
                lastInputMethod = 'keyboard';
                hideJoystick();
                mobileSprintHeld = false;
                setMobileActionButtonsVisible(false);
                updatePauseButtonVisibility();
                if (gameBatteryWidget) {
                    gameBatteryWidget.classList.remove('mobilePosition');
                }
                updateFPSDescriptionVisibility();
                updateSettingsButtonsVisibility();
            }
            function setJoystickPosition(clientX = null, clientY = null) {
                const rect = gameContainer.getBoundingClientRect();
                const width = gameContainer.clientWidth || rect.width;
                const height = gameContainer.clientHeight || rect.height;
                const hasTouchPosition = Number.isFinite(clientX) && Number.isFinite(clientY);
                const localX = hasTouchPosition ? clientX - rect.left : 88;
                const localY = hasTouchPosition ? clientY - rect.top : Math.max(170, height - 170);
                const maxX = Math.max(60, width - 60);
                const maxY = Math.max(60, height - 60);

                joystickCenter.x = Math.max(Math.min(60, width / 2), Math.min(maxX, localX));
                joystickCenter.y = Math.max(Math.min(60, height / 2), Math.min(maxY, localY));
                joystickBase.style.left = (joystickCenter.x - 60) + 'px';
                joystickBase.style.top = (joystickCenter.y - 60) + 'px';
                joystickStick.style.left = joystickCenter.x + 'px';
                joystickStick.style.top = joystickCenter.y + 'px';
            }
            function showJoystickAtRest() {
                joystickActive = false;
                joystickTouchId = null;
                setJoystickPosition();
                joystickBase.classList.remove('hidden', 'active');
                joystickStick.classList.remove('hidden', 'active');
                joystickVector.x = 0;
                joystickVector.y = 0;
            }
            function updateJoystick(clientX, clientY) {
                const rect = gameContainer.getBoundingClientRect();
                const localX = clientX - rect.left;
                const localY = clientY - rect.top;
                const dx = localX - joystickCenter.x;
                const dy = localY - joystickCenter.y;
                const maxDist = 50;
                let dist = Math.sqrt(dx * dx + dy * dy);
                let nx = 0, ny = 0;
                if (dist > 0) {
                    const clamped = Math.min(maxDist, dist);
                    nx = dx / dist;
                    ny = dy / dist;
                    joystickStick.style.left = (joystickCenter.x + nx * clamped) + 'px';
                    joystickStick.style.top = (joystickCenter.y + ny * clamped) + 'px';
                    joystickVector.x = nx * (clamped / maxDist);
                    joystickVector.y = ny * (clamped / maxDist);
                } else {
                    joystickStick.style.left = joystickCenter.x + 'px';
                    joystickStick.style.top = joystickCenter.y + 'px';
                    joystickVector.x = 0;
                    joystickVector.y = 0;
                }
            }
            canvas.addEventListener('pointermove', (e) => {
                if (e.pointerType === 'mouse' || e.pointerType === '') setComputerInputMode();
                const rect = canvas.getBoundingClientRect();
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
                aimX = mouseX;
                aimY = mouseY;
                controllerAimActive = false;
            });
            canvas.addEventListener('pointerdown', (e) => {
                if (e.pointerType === 'touch') return;
                if (!running || paused || dead) return;
                const rect = canvas.getBoundingClientRect();
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
                aimX = mouseX;
                aimY = mouseY;
                controllerAimActive = false;
                if (e.button === 0) {
                    mouseLeftDown = true;
                    activateSelectedAbility();
                }
            });
            canvas.addEventListener('pointerup', (e) => {
                if (e.button === 0) mouseLeftDown = false;
            });
            canvas.addEventListener('pointerleave', () => {
                mouseLeftDown = false;
            });
            canvas.addEventListener('contextmenu', (e) => e.preventDefault());
            ['gesturestart', 'gesturechange', 'gestureend'].forEach(type => {
                document.addEventListener(type, (e) => e.preventDefault(), { passive: false });
            });
            canvas.addEventListener('touchstart', (e) => {
                if (!running || paused || dead) return;
                const touch = e.changedTouches[0];
                if (joystickActive && touch.identifier === joystickTouchId) return;
                if (joystickActive) return;
                joystickTouchId = touch.identifier;
                showJoystick(touch.clientX, touch.clientY);
            }, { passive: true });
            canvas.addEventListener('touchmove', (e) => {
                if (!joystickActive) return;
                const touch = [...e.touches].find(item => item.identifier === joystickTouchId);
                if (!touch) return;
                updateJoystick(touch.clientX, touch.clientY);
            }, { passive: true });
            canvas.addEventListener('touchend', (e) => {
                if ([...e.changedTouches].some(touch => touch.identifier === joystickTouchId)) {
                    hideJoystick();
                }
            });
            function updateSprintButtonState() {
                sprintButton.classList.toggle('enabled', mobileSprintToggleEnabled);
                sprintButton.classList.toggle('disabled', !mobileSprintToggleEnabled);
                sprintButton.classList.toggle('active', mobileSprintToggleEnabled && (joystickActive && (Math.abs(joystickVector.x) > 0.08 || Math.abs(joystickVector.y) > 0.08)));
                sprintButton.setAttribute('aria-pressed', String(mobileSprintToggleEnabled));
            }

            explodeButton.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                selectAbility(1);
                triggerGrenade();
            });
            empButton.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                selectAbility(2);
                triggerEmpPulse();
            });
            phaseButton.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                selectAbility(3);
                triggerPhaseShift();
            });

            sprintButton.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                if (onlineMatchType === 'battle') return;
                mobileSprintToggleEnabled = !mobileSprintToggleEnabled;
                updateSprintButtonState();
            });

            function stopMobileShooting() {
                mobileShootHeld = false;
                shootButton.classList.remove('active');
                shootButton.setAttribute('aria-pressed', 'false');
            }
            shootButton.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                if (!running || paused || dead || touchDeathActive) return;
                mobileShootHeld = true;
                shootButton.classList.add('active');
                shootButton.setAttribute('aria-pressed', 'true');
                if (shootButton.setPointerCapture) shootButton.setPointerCapture(e.pointerId);
            });
            shootButton.addEventListener('pointerup', stopMobileShooting);
            shootButton.addEventListener('pointercancel', stopMobileShooting);
            shootButton.addEventListener('lostpointercapture', stopMobileShooting);

            function getDeathMenuButtons() {
                const canRestart = !onlineMode || (onlinePlayerId && onlinePlayerId === onlineHostId);
                btnRestart.classList.toggle('hidden', !canRestart);
                return [
                    ...(canRestart ? [btnRestart] : []),
                    btnDeathSettings,
                    btnMainMenu
                ];
            }

            function updateMenuFocus() {
                btnPlay.classList.remove('btnFocused');
                btnMenuSettings.classList.remove('btnFocused');
                btnMenuQuit.classList.remove('btnFocused');
                btnConfirmMainQuit.classList.remove('btnFocused');
                btnCancelMainQuit.classList.remove('btnFocused');
                btnRestart.classList.remove('btnFocused');
                btnDeathSettings.classList.remove('btnFocused');
                btnMainMenu.classList.remove('btnFocused');
                btnRumbleTest.classList.remove('btnFocused');
                getSavedRunPromptButtons().forEach(button => button.classList.remove('btnFocused'));

                if (!menu.classList.contains('hidden') && !running && !dead
                    && playModeOverlay.classList.contains('hidden')
                    && onlineLobbyOverlay.classList.contains('hidden')) {
                    if (!savedRunConfirmOverlay.classList.contains('hidden')) {
                        updateSavedRunPromptFocus();
                    } else if (!mainQuitConfirmOverlay.classList.contains('hidden')) {
                        updateMainQuitConfirmFocus();
                    } else {
                        const mainButtons = getMainMenuButtons();
                        if (mainMenuIndex >= mainButtons.length) mainMenuIndex = mainButtons.length - 1;
                        if (mainMenuIndex < 0) mainMenuIndex = 0;
                        mainButtons[mainMenuIndex].classList.add('btnFocused');
                    }
                }
                if (!deathOverlay.classList.contains('hidden')) {
                    const deathButtons = getDeathMenuButtons();
                    deathMenuIndex = Math.min(deathMenuIndex, deathButtons.length - 1);
                    deathButtons[deathMenuIndex].classList.add('btnFocused');
                }
            }

            function getMainQuitConfirmButtons() {
                return [btnConfirmMainQuit, btnCancelMainQuit];
            }

            function updateMainQuitConfirmFocus() {
                const buttons = getMainQuitConfirmButtons();
                mainQuitConfirmIndex = Math.max(0, Math.min(mainQuitConfirmIndex, buttons.length - 1));
                buttons.forEach(button => button.classList.remove('btnFocused'));
                const focusedButton = buttons[mainQuitConfirmIndex];
                focusedButton.classList.add('btnFocused');
                focusedButton.focus({ preventScroll: true });
            }

            function openMainQuitConfirm() {
                mainQuitConfirmContent.classList.remove('exiting');
                mainQuitConfirmOverlay.classList.remove('hidden');
                mainQuitConfirmOverlay.setAttribute('aria-hidden', 'false');
                mainQuitConfirmIndex = 0;
                updateMenuFocus();
            }

            function closeMainQuitConfirm() {
                if (mainQuitConfirmContent.classList.contains('exiting')) return;
                mainQuitConfirmContent.classList.add('exiting');
                const finishCancel = () => {
                    if (!mainQuitConfirmContent.classList.contains('exiting')) return;
                    mainQuitConfirmOverlay.classList.add('hidden');
                    mainQuitConfirmOverlay.setAttribute('aria-hidden', 'true');
                    mainQuitConfirmContent.classList.remove('exiting');
                    updateMenuFocus();
                };
                const onExitAnimationEnd = (event) => {
                    if (event.animationName !== 'pauseConfirmOut') return;
                    mainQuitConfirmContent.removeEventListener('animationend', onExitAnimationEnd);
                    finishCancel();
                };
                mainQuitConfirmContent.addEventListener('animationend', onExitAnimationEnd);
                setTimeout(finishCancel, 250);
            }

            function getPauseMenuButtons() {
                return [btnResume, btnPauseSettings, btnQuit];
            }

            function getQuitConfirmButtons() {
                return [btnConfirmQuit, btnSaveAndQuit, btnCancelQuit];
            }

            function updatePauseMenuFocus() {
                const pauseButtons = [...getPauseMenuButtons(), ...getQuitConfirmButtons()];
                pauseButtons.forEach(button => button.classList.remove('btnFocused'));
                const buttons = pauseConfirmOverlay.classList.contains('hidden')
                    ? getPauseMenuButtons()
                    : getQuitConfirmButtons();
                const index = pauseConfirmOverlay.classList.contains('hidden')
                    ? pauseMenuIndex
                    : quitConfirmIndex;
                const focusedButton = buttons[index];
                if (focusedButton) {
                    focusedButton.classList.add('btnFocused');
                    focusedButton.focus({ preventScroll: true });
                }
            }

            function cyclePauseMenuFocus(direction) {
                if (pauseConfirmOverlay.classList.contains('hidden')) {
                    const buttons = getPauseMenuButtons();
                    pauseMenuIndex = (pauseMenuIndex + direction + buttons.length) % buttons.length;
                    updatePauseMenuFocus();
                } else {
                    const buttons = getQuitConfirmButtons();
                    quitConfirmIndex = (quitConfirmIndex + direction + buttons.length) % buttons.length;
                    updatePauseMenuFocus();
                }
            }

            function getMainMenuButtons() {
                return [
                    btnPlay,
                    ...(hadGamepad ? [btnRumbleTest] : []),
                    btnMenuSettings,
                    btnMenuQuit
                ];
            }

            function getActiveMenuControls() {
                const overlay = !onlineLobbyOverlay.classList.contains('hidden')
                    ? onlineLobbyOverlay
                    : !playModeOverlay.classList.contains('hidden')
                        ? playModeOverlay
                        : null;
                if (!overlay) return [];
                return [...overlay.querySelectorAll('button, input')]
                    .filter(control => !control.closest('.hidden') && !control.disabled);
            }

            function updateActiveMenuFocus() {
                const controls = getActiveMenuControls();
                [...playModeOverlay.querySelectorAll('button, input'), ...onlineLobbyOverlay.querySelectorAll('button, input')]
                    .forEach(control => control.classList.remove('btnFocused'));
                if (!controls.length) return;
                actionMenuIndex = Math.max(0, Math.min(actionMenuIndex, controls.length - 1));
                const focusedControl = controls[actionMenuIndex];
                focusedControl.classList.add('btnFocused');
                focusedControl.focus({ preventScroll: true });
            }

            function cycleActiveMenuFocus(direction) {
                const controls = getActiveMenuControls();
                if (!controls.length) return;
                actionMenuIndex = (actionMenuIndex + direction + controls.length) % controls.length;
                updateActiveMenuFocus();
            }

            function activateActiveMenuControl() {
                const control = getActiveMenuControls()[actionMenuIndex];
                if (!control) return;
                if (control instanceof HTMLButtonElement) control.click();
                else control.focus({ preventScroll: true });
            }

            function updateSettingsButtonsVisibility() {
                btnMenuSettings.classList.remove('hidden');
                btnDeathSettings.classList.remove('hidden');
            }

            function showControllerNotification(type, name) {
                const t = LANG[language] || LANG.en;
                if (name) lastGamepadName = name;
                const safeName = lastGamepadName || 'Unknown';

                const connectedTemplate = t.controllerConnected || LANG.en.controllerConnected;
                const disconnectedTemplate = t.controllerDisconnected || LANG.en.controllerDisconnected;

                controllerConnectedText.textContent = connectedTemplate.replace('{name}', safeName);
                controllerDisconnectedText.textContent = disconnectedTemplate.replace('{name}', safeName);

                if (type === 'connected') {
                    controllerDisconnectedNotif.classList.add('hidden');
                    controllerDisconnectedNotif.classList.remove('show');

                    controllerConnectedNotif.classList.remove('hidden');
                    controllerConnectedNotif.classList.add('show');
                    setTimeout(() => {
                        controllerConnectedNotif.classList.remove('show');
                        setTimeout(() => {
                            controllerConnectedNotif.classList.add('hidden');
                        }, 250);
                    }, 1500);
                } else if (type === 'disconnected') {
                    controllerConnectedNotif.classList.add('hidden');
                    controllerConnectedNotif.classList.remove('show');

                    controllerDisconnectedNotif.classList.remove('hidden');
                    controllerDisconnectedNotif.classList.add('show');
                    setTimeout(() => {
                        controllerDisconnectedNotif.classList.remove('show');
                        setTimeout(() => {
                            controllerDisconnectedNotif.classList.add('hidden');
                        }, 250);
                    }, 1500);
                }
            }

            function rumbleAll(strong, weak, duration) {
                const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                for (const gp of gamepads) {
                    if (!gp) continue;
                    const act = gp.vibrationActuator;
                    if (act && act.type === 'dual-rumble') {
                        act.playEffect('dual-rumble', {
                            duration: duration,
                            strongMagnitude: strong,
                            weakMagnitude: weak
                        });
                    }
                }
            }

            function startRumbleTest() {
                if (rumbleTestInterval) return;
                rumbleAll(1.0, 1.0, 200);
                rumbleTestInterval = setInterval(() => {
                    rumbleAll(1.0, 1.0, 200);
                }, 180);
            }

            function stopRumbleTest() {
                if (rumbleTestInterval) {
                    clearInterval(rumbleTestInterval);
                    rumbleTestInterval = null;
                }
                rumbleAll(0.0, 0.0, 50);
            }

            btnRumbleTest.addEventListener('pointerdown', () => {
                startRumbleTest();
            });
            btnRumbleTest.addEventListener('pointerup', () => {
                stopRumbleTest();
            });
            btnRumbleTest.addEventListener('pointerleave', () => {
                stopRumbleTest();
            });

            function syncSettingsIndicesFromDOM() {
                const currentLangIndex = languageBtns.findIndex(b => b.dataset.lang === language);
                if (currentLangIndex >= 0) settingsLanguageIndex = currentLangIndex;
                const currentPerfIndex = perfBtns.findIndex(b => (b.dataset.perf || 'performance') === performanceMode);
                if (currentPerfIndex >= 0) settingsPerfIndex = currentPerfIndex;
            }

            function updateSettingsFocus() {
                settingsPanel.querySelectorAll('.btnFocused').forEach(control => control.classList.remove('btnFocused'));

                if (settingsCurrentGroup === 'language') {
                    if (languageBtns[settingsLanguageIndex]) {
                        languageBtns[settingsLanguageIndex].classList.add('btnFocused');
                    }
                } else if (settingsCurrentGroup === 'perf') {
                    if (perfBtns[settingsPerfIndex]) {
                        perfBtns[settingsPerfIndex].classList.add('btnFocused');
                    }
                } else if (settingsSliderGroups[settingsCurrentGroup]) {
                    settingsSliderGroups[settingsCurrentGroup].classList.add('btnFocused');
                } else if (settingsCurrentGroup === 'back') {
                    btnSettingsBack.classList.add('btnFocused');
                } else if (settingsControlGroups[settingsCurrentGroup]) {
                    const buttons = settingsControlGroups[settingsCurrentGroup];
                    const focused = buttons.find(button => button.classList.contains('selected')
                        || button.getAttribute('aria-pressed') === 'true') || buttons[0];
                    if (focused) focused.classList.add('btnFocused');
                }

                const focused = settingsPanel.querySelector('.btnFocused');
                if (focused) focused.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }

            function moveSettingsFocusHorizontally(direction) {
                const current = settingsCurrentGroup === 'language'
                    ? languageBtns[settingsLanguageIndex]
                    : settingsCurrentGroup === 'perf'
                        ? perfBtns[settingsPerfIndex]
                        : settingsCurrentGroup === 'back'
                            ? btnSettingsBack
                            : settingsPanel.querySelector('.btnFocused');
                if (!current) return;

                const currentRect = current.getBoundingClientRect();
                const currentX = currentRect.left + currentRect.width / 2;
                const currentY = currentRect.top + currentRect.height / 2;
                const buttonGroup = settingsCurrentGroup === 'language'
                    ? languageBtns
                    : settingsCurrentGroup === 'perf'
                        ? perfBtns
                        : settingsControlGroups[settingsCurrentGroup] || [];
                const rowTolerance = Math.max(6, currentRect.height * 0.6);
                const rowButtons = buttonGroup.filter(button => {
                    if (button === current) return false;
                    const rect = button.getBoundingClientRect();
                    const y = rect.top + rect.height / 2;
                    return Math.abs(y - currentY) <= rowTolerance;
                });
                let nearest = null;
                let nearestScore = Infinity;

                rowButtons.forEach(button => {
                    const rect = button.getBoundingClientRect();
                    const x = rect.left + rect.width / 2;
                    const horizontalDistance = (x - currentX) * direction;
                    if (horizontalDistance < 4) return;
                    const score = horizontalDistance;
                    if (score < nearestScore) {
                        nearest = button;
                        nearestScore = score;
                    }
                });

                if (!nearest) {
                    const rows = [];
                    buttonGroup.forEach(button => {
                        const rect = button.getBoundingClientRect();
                        const y = rect.top + rect.height / 2;
                        let row = rows.find(item => Math.abs(item.centerY - y) <= rowTolerance);
                        if (!row) {
                            row = { centerY: y, buttons: [] };
                            rows.push(row);
                        }
                        row.buttons.push(button);
                        row.centerY = row.buttons.reduce((sum, item) => {
                            const itemRect = item.getBoundingClientRect();
                            return sum + itemRect.top + itemRect.height / 2;
                        }, 0) / row.buttons.length;
                    });
                    rows.sort((a, b) => a.centerY - b.centerY);
                    const currentRowIndex = rows.findIndex(row => row.buttons.includes(current));
                    const nextRowIndex = currentRowIndex + (direction > 0 ? 1 : -1);
                    const nextRow = rows[nextRowIndex];
                    if (nextRow) {
                        nearest = nextRow.buttons.reduce((edgeButton, button) => {
                            const buttonRect = button.getBoundingClientRect();
                            const edgeRect = edgeButton.getBoundingClientRect();
                            const buttonX = buttonRect.left + buttonRect.width / 2;
                            const edgeX = edgeRect.left + edgeRect.width / 2;
                            return direction > 0
                                ? (buttonX < edgeX ? button : edgeButton)
                                : (buttonX > edgeX ? button : edgeButton);
                        });
                    }
                }

                if (!nearest) return;
                if (nearest.dataset.lang) {
                    settingsCurrentGroup = 'language';
                    settingsLanguageIndex = languageBtns.indexOf(nearest);
                    nearest.click();
                } else if (nearest.dataset.perf) {
                    settingsCurrentGroup = 'perf';
                    settingsPerfIndex = perfBtns.indexOf(nearest);
                    nearest.click();
                } else if (nearest.dataset.settingGroup) {
                    settingsCurrentGroup = nearest.dataset.settingGroup;
                    nearest.click();
                }
                updateSettingsFocus();
            }

            function toggleSettingsGroup() {
                settingsCurrentGroup = (settingsCurrentGroup === 'language') ? 'perf' : 'language';
                updateSettingsFocus();
            }

            function cycleSettingsGroup(direction) {
                let idx = settingsOrder.indexOf(settingsCurrentGroup);
                if (idx < 0) idx = 0;
                idx = (idx + direction + settingsOrder.length) % settingsOrder.length;
                settingsCurrentGroup = settingsOrder[idx];
                updateSettingsFocus();
            }

            function pollGamepad() {
                const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                let gp = null;
                for (const g of gamepads) {
                    if (g) { gp = g; break; }
                }
                if (!gp) {
                    controllerSprintHeld = false;
                    if (hadGamepad) {
                        hadGamepad = false;
                        controllerMode = false;
                        gameContainer.classList.remove('controllerMode');
                        showControllerNotification('disconnected');
                        btnRumbleTest.classList.add('hidden');
                        mainMenuIndex = Math.min(mainMenuIndex, getMainMenuButtons().length - 1);
                        updateMenuFocus();
                    }
                    prevGamepadButtons = null;
                    return;
                }

                if (!hadGamepad) {
                    hadGamepad = true;
                    lastGamepadName = gp.id || 'Unknown';
                    showControllerNotification('connected', lastGamepadName);
                    btnRumbleTest.classList.remove('hidden');
                    updateMenuFocus();
                }

                controllerMode = true;
                gameContainer.classList.add('controllerMode');
                mobileMode = false;
                lastInputMethod = 'controller';
                hideJoystick();
                pauseButton.classList.add('hidden');
                if (gameBatteryWidget) {
                    gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                }
                updateFPSDescriptionVisibility();
                updateSettingsButtonsVisibility();

                const axX = gp.axes[0] || 0;
                const buttons = gp.buttons.map(b => b.pressed);
                if (!prevGamepadButtons) prevGamepadButtons = buttons.slice();

                const justPressed = (index) => buttons[index] && !prevGamepadButtons[index];

                const BTN_A = 0;
                const BTN_B = 1;
                const BTN_X = 2;
                const BTN_Y = 3;
                const BTN_L = 4;
                const BTN_R = 5;
                const ZR = 7;
                const BTN_MINUS = 8;
                const BTN_PLUS = 9;

                if (buttons.some(b => b)) {
                    lastInputMethod = 'controller';
                }
                controllerSprintHeld = onlineMatchType !== 'battle' && (buttons[BTN_X] || buttons[BTN_Y]);
                const zRHeld = Boolean(buttons[ZR]);
                const rightStickX = gp.axes[2] || 0;
                const rightStickY = gp.axes[3] || 0;
                if (Math.abs(rightStickX) > 0.15 || Math.abs(rightStickY) > 0.15) {
                    const aimSpeed = 18;
                    aimX = Math.max(0, Math.min(canvas.width, aimX + rightStickX * aimSpeed));
                    aimY = Math.max(0, Math.min(canvas.height, aimY + rightStickY * aimSpeed));
                    controllerAimActive = true;
                }
                if (running && !dead && !paused) {
                    if (zRHeld && selectedAbility === 0 && playerShotCooldown <= 0) {
                        activateSelectedAbility();
                    } else if (justPressed(ZR)) {
                        activateSelectedAbility();
                    }
                    if (justPressed(BTN_L)) selectAbility((selectedAbility + 3) % 4);
                    if (justPressed(BTN_R)) selectAbility((selectedAbility + 1) % 4);
                }

                if (isMultiplayerSession() && paused) {
                    paused = false;
                    pauseOverlay.classList.add('hidden');
                    pauseConfirmOverlay.classList.add('hidden');
                    pauseConfirmOverlay.setAttribute('aria-hidden', 'true');
                }
                const pauseMenuWasActive = paused && settingsScreen.classList.contains('hidden');
                if (!isMultiplayerSession() && running && !dead && !paused) {
                    if (justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) setPaused(true);
                } else if (paused && settingsScreen.classList.contains('hidden')) {
                    if (!pauseConfirmOverlay.classList.contains('hidden')) {
                        if (justPressed(BTN_L)) cyclePauseMenuFocus(-1);
                        if (justPressed(BTN_R)) cyclePauseMenuFocus(1);
                        if (justPressed(BTN_A)) getQuitConfirmButtons()[quitConfirmIndex].click();
                        if (justPressed(BTN_B) || justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) {
                            btnCancelQuit.click();
                        }
                    } else {
                        if (justPressed(BTN_L)) cyclePauseMenuFocus(-1);
                        if (justPressed(BTN_R)) cyclePauseMenuFocus(1);
                        if (justPressed(BTN_A)) getPauseMenuButtons()[pauseMenuIndex].click();
                        if (justPressed(BTN_B) || justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) {
                            setPaused(false);
                        }
                    }
                }

                if (pauseMenuWasActive) {
                    prevGamepadButtons = buttons.slice();
                    return;
                }

                if (!running && !dead && !menu.classList.contains('hidden')) {
                    if (!playModeOverlay.classList.contains('hidden') || !onlineLobbyOverlay.classList.contains('hidden')) {
                        if (justPressed(BTN_R)) cycleActiveMenuFocus(1);
                        if (justPressed(BTN_L)) cycleActiveMenuFocus(-1);
                        if (justPressed(BTN_A)) activateActiveMenuControl();
                        if (justPressed(BTN_B) || justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) {
                            if (!onlineLobbyOverlay.classList.contains('hidden')) goBackOnlineMenu();
                            else btnCancelPlayMode.click();
                        }
                    } else if (!mainQuitConfirmOverlay.classList.contains('hidden')) {
                        const quitButtons = getMainQuitConfirmButtons();
                        if (justPressed(BTN_R)) {
                            mainQuitConfirmIndex = (mainQuitConfirmIndex + 1) % quitButtons.length;
                            updateMainQuitConfirmFocus();
                        }
                        if (justPressed(BTN_L)) {
                            mainQuitConfirmIndex = (mainQuitConfirmIndex - 1 + quitButtons.length) % quitButtons.length;
                            updateMainQuitConfirmFocus();
                        }
                        if (justPressed(BTN_A)) quitButtons[mainQuitConfirmIndex].click();
                        if (justPressed(BTN_B) || justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) {
                            btnCancelMainQuit.click();
                        }
                    } else if (!savedRunConfirmOverlay.classList.contains('hidden')) {
                        const savedRunButtons = getSavedRunPromptButtons();
                        if (justPressed(BTN_R)) {
                            savedRunConfirmIndex = (savedRunConfirmIndex + 1) % savedRunButtons.length;
                            updateSavedRunPromptFocus();
                        }
                        if (justPressed(BTN_L)) {
                            savedRunConfirmIndex = (savedRunConfirmIndex - 1 + savedRunButtons.length) % savedRunButtons.length;
                            updateSavedRunPromptFocus();
                        }
                        if (justPressed(BTN_A)) savedRunButtons[savedRunConfirmIndex].click();
                        if (justPressed(BTN_B) || justPressed(BTN_PLUS) || justPressed(BTN_MINUS)) {
                            btnCancelSavedRun.click();
                        }
                    } else {
                        const mainButtons = getMainMenuButtons();

                        if (justPressed(BTN_R)) {
                            mainMenuIndex = (mainMenuIndex + 1) % mainButtons.length;
                            updateMenuFocus();
                        }
                        if (justPressed(BTN_L)) {
                            mainMenuIndex = (mainMenuIndex - 1 + mainButtons.length) % mainButtons.length;
                            updateMenuFocus();
                        }
                        if (justPressed(BTN_MINUS)) openMainQuitConfirm();

                        if (mainButtons[mainMenuIndex] === btnRumbleTest) {
                            if (buttons[BTN_A] || buttons[BTN_B]) {
                                startRumbleTest();
                            } else {
                                stopRumbleTest();
                            }
                        }

                        if (justPressed(BTN_A) || justPressed(BTN_B)) {
                            if (mainButtons[mainMenuIndex] !== btnRumbleTest) {
                                lastInputMethod = 'controller';
                                mainButtons[mainMenuIndex].click();
                            }
                        }
                    }
                }

                if (!deathOverlay.classList.contains('hidden')) {
                    const deathButtons = getDeathMenuButtons();
                    if (justPressed(BTN_R)) {
                        deathMenuIndex = (deathMenuIndex + 1) % deathButtons.length;
                        updateMenuFocus();
                    }
                    if (justPressed(BTN_L)) {
                        deathMenuIndex = (deathMenuIndex - 1 + deathButtons.length) % deathButtons.length;
                        updateMenuFocus();
                    }
                    if (justPressed(BTN_A) || justPressed(BTN_B)) {
                        deathButtons[deathMenuIndex].click();
                    }
                }

                if (!settingsScreen.classList.contains('hidden')) {
                    if (justPressed(BTN_MINUS)) {
                        btnSettingsBack.click();
                    }
                    if (justPressed(BTN_L)) {
                        cycleSettingsGroup(-1);
                    }
                    if (justPressed(BTN_R)) {
                        cycleSettingsGroup(1);
                    }

                    if (Math.abs(rightStickY) > 0.15) {
                        settingsPanel.scrollTop += rightStickY * 14;
                    }

                    const adjustAxis = axX;
                    const threshold = 0.2;
                    if (Math.abs(adjustAxis) > threshold) {
                        if (settingsCurrentGroup === 'language' || settingsCurrentGroup === 'perf' || settingsCurrentGroup === 'back'
                            || settingsControlGroups[settingsCurrentGroup]) {
                            if (!settingsHorizontalStickEngaged) {
                                moveSettingsFocusHorizontally(adjustAxis > 0 ? 1 : -1);
                                settingsHorizontalStickEngaged = true;
                            }
                        } else if (settingsSliderGroups[settingsCurrentGroup]) {
                            const slider = settingsSliderGroups[settingsCurrentGroup];
                            const isVolumeSlider = slider === volLowSlider || slider === volMidSlider
                                || slider === volHighSlider || slider === graphicsQualitySlider;
                            const step = isVolumeSlider ? 0.01 : Number(slider.step) || 1;
                            const value = Math.max(Number(slider.min), Math.min(Number(slider.max),
                                Number(slider.value) + (isVolumeSlider ? step * adjustAxis : step * Math.sign(adjustAxis))));
                            slider.value = isVolumeSlider ? value.toFixed(2) : String(value);
                            slider.dispatchEvent(new Event('input'));
                        }
                    } else {
                        settingsHorizontalStickEngaged = false;
                    }

                    if (justPressed(BTN_A) || justPressed(BTN_B)) {
                        if (settingsCurrentGroup === 'back') {
                            btnSettingsBack.click();
                        } else if (settingsControlGroups[settingsCurrentGroup]) {
                            const focusedControl = settingsPanel.querySelector('.btnFocused');
                            if (focusedControl) focusedControl.click();
                        }
                    }
                }

                prevGamepadButtons = buttons.slice();
            }

            setInterval(pollGamepad, 1000 / 60);

            function getNextSniperTargetPlayerId() {
                const targets = onlineMode
                    ? [...onlinePlayerStates.keys()]
                    : ['local-player'];
                if (!targets.length) return onlinePlayerId || 'local-player';
                const sniperCount = greenSnipers.length + redSnipers.length + orangeSnipers.length
                    + purpleTriangleSnipers.length + blueSnipers.length + yellowStarSnipers.length;
                return targets[sniperCount % targets.length];
            }

            function spawnGreenSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 30 + Math.random() * 20;
                greenSnipers.push({ x: cx, y: cy, radius: 14, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.green, maxHp: SNIPER_MAX_HP.green, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnRedSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 32 + Math.random() * 18;
                redSnipers.push({ x: cx, y: cy, radius: 14, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.red, maxHp: SNIPER_MAX_HP.red, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnOrangeSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 34 + Math.random() * 20;
                orangeSnipers.push({ x: cx, y: cy, radius: 14, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.orange, maxHp: SNIPER_MAX_HP.orange, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnPurpleTriangleSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 22 + Math.random() * 14;
                purpleTriangleSnipers.push({ x: cx, y: cy, radius: 16, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.purpleTriangle, maxHp: SNIPER_MAX_HP.purpleTriangle, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnBlueSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 26 + Math.random() * 15;
                blueSnipers.push({ x: cx, y: cy, radius: 17, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.blue, maxHp: SNIPER_MAX_HP.blue, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnYellowStarSniper() {
                const angle = Math.random() * Math.PI * 2;
                const dist = Math.min(canvas.width, canvas.height) * 0.45;
                const cx = canvas.width / 2 + Math.cos(angle) * dist;
                const cy = canvas.height / 2 + Math.sin(angle) * dist;
                const speed = 24 + Math.random() * 12;
                yellowStarSnipers.push({ x: cx, y: cy, radius: 19, shootTimer: 0, spawnProgress: 0, vx: Math.cos(angle + Math.PI / 2) * speed, vy: Math.sin(angle + Math.PI / 2) * speed, hp: SNIPER_MAX_HP.yellowStar, maxHp: SNIPER_MAX_HP.yellowStar, targetPlayerId: getNextSniperTargetPlayerId() });
            }
            function spawnOxygenOrb() {
                const margin = 40;
                const x = margin + Math.random() * (canvas.width - margin * 2);
                const y = margin + Math.random() * (canvas.height - margin * 2);
                oxygenOrbs.push({ x, y, radius: 14, collected: false, animTime: 0, spawnProgress: 0 });
            }

            function spawnSniperRewardOrb(enemy, value) {
                const size = 42;
                const scale = 0.85;
                const edgeInset = size * scale * 0.45;
                sniperRewardOrbs.push({
                    x: Math.max(edgeInset, Math.min(canvas.width - edgeInset, enemy.x)),
                    y: Math.max(edgeInset, Math.min(canvas.height - edgeInset, enemy.y)),
                    size,
                    scale,
                    opacity: 1,
                    value,
                    rotation: Math.random() * Math.PI * 2,
                    spawnProgress: 0,
                    collected: false
                });
            }

            function spawnSniperRewardBurst(x, y, value) {
                const angleOffset = Math.random() * Math.PI * 2;
                for (let i = 0; i < value; i++) {
                    const angle = angleOffset + (i / value) * Math.PI * 2;
                    const speed = 220 + Math.random() * 240;
                    const size = 14 + Math.random() * 5;
                    sniperRewardBurstOrbs.push({
                        x,
                        y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        size,
                        rotation: Math.random() * Math.PI * 2,
                        spin: (Math.random() - 0.5) * 8,
                        age: 0,
                        life: 1.8
                    });
                }
            }

            function getNearestSniperTarget(sx, sy) {
                const sniper = { x: sx, y: sy };
                const target = getSniperTargetPosition(sniper);
                return { ...target, id: sniper.targetPlayerId };
            }

            function spawnBullet(sx, sy, projectileType = 'green', targetPlayerId) {
                const palette = {
                    green: { speed: 260, radius: 6, damage: 5, knock: 260, color: '#00ff66' },
                    red: { speed: 300, radius: 6, damage: 12, knock: 340, color: '#ff0033' },
                    orange: { speed: 330, radius: 6, damage: 9, knock: 300, color: '#ff9f1a' },
                    purple: { speed: 320, radius: 8, damage: 0, knock: 520, color: '#a855f7' },
                    blue: { speed: 240, radius: 12, damage: 0, knock: 3600, color: '#1d9bf0' },
                    yellowStar: { speed: 230, radius: 7, damage: 0, knock: 420, color: '#ffe066' }
                };
                const cfg = palette[projectileType] || palette.green;
                const target = targetPlayerId
                    ? getSniperTargetPosition({ x: sx, y: sy, targetPlayerId })
                    : getNearestSniperTarget(sx, sy);
                const dx = target.x - sx;
                const dy = target.y - sy;
                const len = Math.hypot(dx, dy) || 1;
                const vx = (dx / len) * cfg.speed;
                const vy = (dy / len) * cfg.speed;
                bullets.push({
                    x: sx,
                    y: sy,
                    vx,
                    vy,
                    radius: cfg.radius,
                    projectileType,
                    damage: cfg.damage,
                    knock: cfg.knock,
                    color: cfg.color,
                    isRed: projectileType === 'red',
                    isOrange: projectileType === 'orange',
                    isPurple: projectileType === 'purple',
                    isBlue: projectileType === 'blue',
                    isYellowStar: projectileType === 'yellowStar',
                    targetPlayerId: target.id
                });
                playSniperShotSound(projectileType);
            }

            function spawnYellowStarBurst(sx, sy) {
                for (let i = 0; i < 5; i++) {
                    const angle = (Math.PI * 2 * i) / 5 + (Math.PI / 10);
                    const speed = 230;
                    const xVel = Math.cos(angle) * speed;
                    const yVel = Math.sin(angle) * speed;
                    bullets.push({
                        x: sx,
                        y: sy,
                        vx: xVel,
                        vy: yVel,
                        radius: 7,
                        projectileType: 'yellowStar',
                        damage: 0,
                        knock: 420,
                        color: '#ffe066',
                        isRed: false,
                        isOrange: false,
                        isPurple: false,
                        isBlue: false,
                        isYellowStar: true
                    });
                }
            }

            function applyGraphicsGlowScale() {
                const glowFactor = getGlowMultiplier();
                if (glowFactor <= 0.01) {
                    ctx.shadowBlur = 0;
                }
                return glowFactor;
            }

            function spawnExplosionEffect(x, y, color = '#ff0033', count = 28) {
                for (let i = 0; i < count; i++) {
                    const angle = (Math.PI * 2 * i) / count + Math.random() * 0.35;
                    const speed = 70 + Math.random() * 120;
                    debrisPieces.push({
                        x,
                        y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        radius: 3 + Math.random() * 5,
                        color,
                        life: 0.45 + Math.random() * 0.35,
                        maxLife: 0.8,
                        glow: i % 4 === 0
                    });
                }
                debrisPieces.push({
                    x,
                    y,
                    vx: 0,
                    vy: 0,
                    radius: 18,
                    color: 'rgba(255,255,255,0.9)',
                    life: 0.18,
                    maxLife: 0.18,
                    glow: true
                });
            }

            function spawnSniperFragments(x, y, radius, color, startColor = '#ff9f1a') {
                const fragmentCount = 7;
                for (let i = 0; i < fragmentCount; i++) {
                    const startAngle = (i / fragmentCount) * Math.PI * 2;
                    const endAngle = ((i + 1) / fragmentCount) * Math.PI * 2;
                    const middleAngle = (startAngle + endAngle) / 2;
                    const innerRadius = radius * (0.08 + Math.random() * 0.08);
                    const outerRadius = radius * (0.72 + Math.random() * 0.16);
                    const points = [
                        { x: Math.cos(startAngle) * innerRadius, y: Math.sin(startAngle) * innerRadius },
                        { x: Math.cos(startAngle) * outerRadius, y: Math.sin(startAngle) * outerRadius },
                        { x: Math.cos(middleAngle) * outerRadius * (0.86 + Math.random() * 0.18), y: Math.sin(middleAngle) * outerRadius * (0.86 + Math.random() * 0.18) },
                        { x: Math.cos(endAngle) * outerRadius, y: Math.sin(endAngle) * outerRadius },
                        { x: Math.cos(endAngle) * innerRadius, y: Math.sin(endAngle) * innerRadius }
                    ];
                    const angle = (startAngle + endAngle) / 2;
                    const speed = 14 + Math.random() * 20;
                    debrisPieces.push({
                        x: x + Math.cos(angle) * radius * 0.08,
                        y: y + Math.sin(angle) * radius * 0.08,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        rotation: 0,
                        rotationSpeed: (Math.random() - 0.5) * 1.5,
                        points,
                        color,
                        startColor,
                        colorTransitionTime: 0,
                        life: 3.8,
                        maxLife: 3.8,
                        shrinkDelay: 1.8,
                        fragment: true,
                        glow: true
                    });
                }
            }

            function drawShockwaves(dt) {
                const glowFactor = getGlowMultiplier();
                for (let i = shockwaves.length - 1; i >= 0; i--) {
                    const wave = shockwaves[i];
                    wave.life -= dt;
                    const progress = 1 - Math.max(0, wave.life / wave.maxLife);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    wave.radius = wave.startRadius + (wave.maxRadius - wave.startRadius) * eased;
                    if (wave.life <= 0) {
                        shockwaves.splice(i, 1);
                        continue;
                    }
                    ctx.save();
                    ctx.translate(wave.x, wave.y);
                    ctx.strokeStyle = wave.color;
                    ctx.lineWidth = wave.lineWidth || 3;
                    ctx.shadowColor = wave.color;
                    ctx.shadowBlur = 20 * glowFactor;
                    ctx.globalAlpha = Math.max(0, 1 - progress) * 0.8;
                    ctx.beginPath();
                    ctx.arc(0, 0, wave.radius, 0, Math.PI * 2);
                    ctx.stroke();
                    ctx.restore();
                }
            }

            function updateEnemyMovement(dt) {
                const enemySets = [
                    greenSnipers,
                    redSnipers,
                    orangeSnipers,
                    purpleTriangleSnipers,
                    blueSnipers,
                    yellowStarSnipers
                ];

                for (const enemySet of enemySets) {
                    for (const enemy of enemySet) {
                        if (!enemy.vx) enemy.vx = 0;
                        if (!enemy.vy) enemy.vy = 0;
                        if (!enemy.knockTime) enemy.knockTime = 0;
                        if (!enemy.knockImpulseX) enemy.knockImpulseX = 0;
                        if (!enemy.knockImpulseY) enemy.knockImpulseY = 0;

                        if (enemy.stunTimer > 0) {
                            enemy.stunTimer = Math.max(0, enemy.stunTimer - dt);
                            enemy.vx = 0;
                            enemy.vy = 0;
                            continue;
                        }

                        if (enemy.knockTime < 0.5) {
                            enemy.knockTime += dt;
                            const t = Math.min(1, enemy.knockTime / 0.5);
                            const easeOut = 1 - Math.pow(1 - t, 3);
                            const decay = 1 - easeOut;
                            enemy.vx = enemy.knockImpulseX * decay;
                            enemy.vy = enemy.knockImpulseY * decay;
                            enemy.x += enemy.vx * dt;
                            enemy.y += enemy.vy * dt;
                        } else {
                            enemy.vx = 0;
                            enemy.vy = 0;
                            enemy.knockImpulseX = 0;
                            enemy.knockImpulseY = 0;
                            enemy.knockTime = 0.5;
                        }

                        if (enemy.knockTime >= 0.5) {
                            const friction = Math.pow(0.72, dt * 60);
                            enemy.vx *= friction;
                            enemy.vy *= friction;
                            if (Math.abs(enemy.vx) < 0.05) enemy.vx = 0;
                            if (Math.abs(enemy.vy) < 0.05) enemy.vy = 0;
                            enemy.x += enemy.vx * dt;
                            enemy.y += enemy.vy * dt;
                        }

                        const edgeMargin = enemy.radius + 4;
                        if (enemy.x < edgeMargin) {
                            enemy.x = edgeMargin;
                            if (enemy.vx < 0) enemy.vx *= -0.82;
                            if (enemy.knockImpulseX < 0) enemy.knockImpulseX *= -0.82;
                        } else if (enemy.x > canvas.width - edgeMargin) {
                            enemy.x = canvas.width - edgeMargin;
                            if (enemy.vx > 0) enemy.vx *= -0.82;
                            if (enemy.knockImpulseX > 0) enemy.knockImpulseX *= -0.82;
                        }
                        if (enemy.y < edgeMargin) {
                            enemy.y = edgeMargin;
                            if (enemy.vy < 0) enemy.vy *= -0.82;
                            if (enemy.knockImpulseY < 0) enemy.knockImpulseY *= -0.82;
                        } else if (enemy.y > canvas.height - edgeMargin) {
                            enemy.y = canvas.height - edgeMargin;
                            if (enemy.vy > 0) enemy.vy *= -0.82;
                            if (enemy.knockImpulseY > 0) enemy.knockImpulseY *= -0.82;
                        }
                    }
                }
            }

            function lerp(a, b, t) {
                return a + (b - a) * t;
            }

            function dist2(a, b, x, y) {
                const dx = a - x;
                const dy = b - y;
                return dx * dx + dy * dy;
            }

            function segmentIntersectsCircle(startX, startY, endX, endY, centerX, centerY, radius) {
                const segmentX = endX - startX;
                const segmentY = endY - startY;
                const segmentLengthSquared = segmentX * segmentX + segmentY * segmentY;
                const projection = segmentLengthSquared === 0
                    ? 0
                    : Math.max(0, Math.min(1,
                        ((centerX - startX) * segmentX + (centerY - startY) * segmentY)
                        / segmentLengthSquared
                    ));
                const closestX = startX + projection * segmentX;
                const closestY = startY + projection * segmentY;
                return dist2(closestX, closestY, centerX, centerY) <= radius * radius;
            }

            function enterOxygenLoss() {
                if (oxygenLoss || touchDeathActive) return;
                oxygenLoss = true;
                oxygenLossStartTime = elapsedGameTime;
                fadeProgress = 0;
                deathTriggered = false;
                oxygenVignette.classList.add('active');
                oxygenBarContainer.classList.add('oxygenBarFlash');
                if (mobileMode) {
                    oxygenWarningSkull.classList.remove('hidden');
                    oxygenWarningText.classList.add('hidden');
                } else {
                    oxygenWarningText.classList.remove('hidden');
                    oxygenWarningSkull.classList.add('hidden');
                }
                startTrebleFadeIn();
                startHeartbeat();
            }
            function cancelOxygenLoss() {
                if (!oxygenLoss) return;
                oxygenLoss = false;
                fadeProgress = 0;
                fadeOverlay.style.opacity = '0';
                oxygenVignette.classList.remove('active');
                oxygenBarContainer.classList.remove('oxygenBarFlash');
                oxygenWarningText.classList.add('hidden');
                oxygenWarningSkull.classList.add('hidden');
                stopTreble();
                stopHeartbeat();
            }

            function setDeathSurvivedText() {
                const t = LANG[language] || LANG.en;
                const seconds = elapsedGameTime.toFixed(1);
                const template = t.deathSurvived || LANG.en.deathSurvived;
                deathOrbMagnifyAt = performance.now() + 3000;
                deathSurvived.textContent = template.replace('{s}', seconds);
                deathSurvived.classList.add('show');
                if (!onlineMode && onlineMatchType !== 'battle' && onlineMatchType !== 'team') {
                    deathOrbReward.textContent = `+${getLocalizedNumber(deathOrbCount, { maximumFractionDigits: 0 })} orbs`;
                    deathOrbReward.classList.add('show');
                } else {
                    deathOrbReward.textContent = '';
                    deathOrbReward.classList.remove('show');
                }
            }

            function clearDeathOrbDrops() {
                if (deathOrbDropFrame !== null) cancelAnimationFrame(deathOrbDropFrame);
                deathOrbDropFrame = null;
                deathOrbDrops.length = 0;
                deathOrbDropsCreated = false;
                deathOrbCount = 0;
                deathOrbMagnifyAt = null;
                deathOrbReward.textContent = '';
                deathOrbReward.classList.remove('show');
                deathOrbCtx.clearRect(0, 0, deathOrbCanvas.width, deathOrbCanvas.height);
            }

            function drawDeathOrbDrops() {
                deathOrbCtx.clearRect(0, 0, deathOrbCanvas.width, deathOrbCanvas.height);
                const glow = getGlowMultiplier();
                for (const orb of deathOrbDrops) {
                    if (orb.age < 0 || orb.opacity <= 0 || !deathOrbImage.complete || !deathOrbImage.naturalWidth) continue;
                    const size = orb.size * orb.scale;
                    deathOrbCtx.save();
                    deathOrbCtx.translate(orb.x, orb.y);
                    deathOrbCtx.rotate(orb.rotation);
                    deathOrbCtx.globalAlpha = orb.opacity;
                    deathOrbCtx.shadowColor = '#39ff14';
                    deathOrbCtx.shadowBlur = 20 * glow * orb.scale;
                    deathOrbCtx.drawImage(deathOrbImage, -size / 2, -size / 2, size, size);
                    deathOrbCtx.restore();
                }
            }

            function animateDeathOrbDrops(timestamp) {
                if (!deathOrbDrops.length) {
                    deathOrbDropFrame = null;
                    drawDeathOrbDrops();
                    return;
                }
                const dt = Math.min(0.05, Math.max(0, (timestamp - (animateDeathOrbDrops.lastTime || timestamp)) / 1000));
                animateDeathOrbDrops.lastTime = timestamp;
                let moving = false;
                const fadeDuration = 1.5;
                const magnetRampDuration = 0.7;
                const floor = deathOrbCanvas.height;
                const targetX = Math.max(24, deathOrbCanvas.width - 24);
                const targetY = 24;
                for (const orb of deathOrbDrops) {
                    orb.age += dt;
                    if (orb.age < 0) {
                        moving = true;
                        continue;
                    }
                    orb.rotation += orb.spin * dt;
                    const animationElapsed = deathOrbMagnifyAt === null
                        ? -Infinity
                        : (timestamp - deathOrbMagnifyAt) / 1000;
                    if (animationElapsed < 0) {
                        orb.vy += ORB_GRAVITY * dt;
                        orb.x += orb.vx * dt;
                        orb.y += orb.vy * dt;
                        orb.scale = 0.85;
                        const edgeInset = orb.size * orb.scale * 0.45;
                        const leftEdge = edgeInset;
                        const rightEdge = Math.max(leftEdge, deathOrbCanvas.width - edgeInset);
                        if (orb.x < leftEdge) {
                            orb.x = leftEdge;
                            orb.vx = Math.abs(orb.vx) * 0.95;
                        } else if (orb.x > rightEdge) {
                            orb.x = rightEdge;
                            orb.vx = -Math.abs(orb.vx) * 0.95;
                        }
                        const topEdge = edgeInset;
                        const bottomEdge = Math.max(topEdge, floor - edgeInset);
                        if (orb.y < topEdge) {
                            orb.y = topEdge;
                            if (orb.vy < -12) {
                                orb.vy = Math.abs(orb.vy) * 0.86;
                                orb.vx *= 0.9;
                                orb.spin *= 0.9;
                            } else {
                                orb.vy = 0;
                            }
                        } else if (orb.y > bottomEdge) {
                            orb.y = bottomEdge;
                            if (orb.vy > 12) {
                                orb.vy *= -0.86;
                                orb.vx *= 0.9;
                                orb.spin *= 0.9;
                            } else {
                                orb.vy = 0;
                                orb.vx *= 0.96;
                                orb.spin *= 0.96;
                            }
                        }
                        moving = true;
                        continue;
                    }
                    if (!orb.collecting) {
                        orb.collecting = true;
                        orb.collectStartX = orb.x;
                        orb.collectStartY = orb.y;
                    }
                    const progress = Math.min(1, animationElapsed / fadeDuration);
                    const rampProgress = Math.min(1, animationElapsed / magnetRampDuration);
                    const rampedPull = animationElapsed < magnetRampDuration
                        ? magnetRampDuration * (rampProgress ** 3 - 0.5 * rampProgress ** 4)
                        : magnetRampDuration * 0.5 + animationElapsed - magnetRampDuration;
                    const pullProgress = Math.min(1, rampedPull / (fadeDuration - magnetRampDuration * 0.5));
                    orb.x = orb.collectStartX + (targetX - orb.collectStartX) * pullProgress;
                    orb.y = orb.collectStartY + (targetY - orb.collectStartY) * pullProgress;
                    orb.scale = 0.85 * (1 - pullProgress);
                    orb.opacity = 1 - progress;
                    if (progress < 1) moving = true;
                }
                drawDeathOrbDrops();
                for (let i = deathOrbDrops.length - 1; i >= 0; i--) {
                    if (deathOrbDrops[i].opacity <= 0) deathOrbDrops.splice(i, 1);
                }
                if (moving) deathOrbDropFrame = requestAnimationFrame(animateDeathOrbDrops);
                else deathOrbDropFrame = null;
            }

            function spawnDeathOrbDrops() {
                if (deathOrbDropsCreated || onlineMode || onlineMatchType === 'battle' || onlineMatchType === 'team') return;
                deathOrbDropsCreated = true;
                deathOrbCount = Math.max(0, Math.floor(elapsedGameTime));
                if (!deathOrbCount) return;
                deathOrbCanvas.width = canvas.width;
                deathOrbCanvas.height = canvas.height;
                const originX = canvas.width / 2;
                for (let i = 0; i < deathOrbCount; i++) {
                    const angle = (Math.random() - 0.5) * 2.7;
                    const launchSpeed = 260 + Math.random() * 220;
                    deathOrbDrops.push({
                        x: originX + (Math.random() - 0.5) * 36,
                        y: 42 * 0.85 * 0.45,
                        vx: Math.sin(angle) * launchSpeed,
                        vy: Math.cos(angle) * launchSpeed,
                        size: 42,
                        scale: 0.85,
                        opacity: 1,
                        rotation: Math.random() * Math.PI * 2,
                        spin: (Math.random() - 0.5) * 2.4,
                        age: 0,
                        collecting: false
                    });
                }
                animateDeathOrbDrops.lastTime = 0;
                deathOrbDropFrame = requestAnimationFrame(animateDeathOrbDrops);
            }

            function triggerDeathFade() {
                if (deathTriggered) return;
                spawnDeathOrbDrops();
                deathTriggered = true;
                dead = true;
                running = false;
                setMobileActionButtonsVisible(false);
                updateCursorVisibility();
                survivedStopwatch.classList.add('hidden');
                pauseButton.classList.add('hidden');
                stopTreble();
                stopHeartbeat();
                if (audioCtx) audioCtx.suspend();
                oxygenVignette.classList.remove('active');
                fadeOverlay.style.opacity = '1';

                setTimeout(() => {
                    setDeathSurvivedText();
                    deathOverlay.classList.toggle('electrocutedDeath', deathCause === 'electrocuted');
                    deathOverlay.classList.remove('hidden');
                    deathMenuIndex = 0;
                    updateMenuFocus();
                    updateSettingsButtonsVisibility();
                    requestAnimationFrame(() => {
                        deathTitle.classList.add('show');
                    });
                }, 300);
            }

            function triggerDeathImmediate() {
                if (deathTriggered) return;
                spawnDeathOrbDrops();
                deathTriggered = true;
                dead = true;
                running = false;
                setMobileActionButtonsVisible(false);
                updateCursorVisibility();
                survivedStopwatch.classList.add('hidden');
                pauseButton.classList.add('hidden');
                oxygenVignette.classList.remove('active');
                fadeOverlay.style.opacity = '1';
                stopTreble();
                stopHeartbeat();
                if (audioCtx) audioCtx.suspend();
                applyLanguage();
                setDeathSurvivedText();
                deathOverlay.classList.toggle('electrocutedDeath', deathCause === 'electrocuted');
                deathOverlay.classList.remove('hidden');
                deathMenuIndex = 0;
                updateMenuFocus();
                updateSettingsButtonsVisibility();
                requestAnimationFrame(() => {
                    deathTitle.classList.add('show');
                });
            }

            function startTouchDeath() {
                if (touchDeathActive || dead) return;
                deathCause = 'electrocuted';
                touchDeathActive = true;
                setMobileActionButtonsVisible(false);
                mouseLeftDown = false;
                touchDeathTimer = 0;
                touchBreakTriggered = false;
                electroFlashTimer = 3;
                debrisPieces.length = 0;
                cancelOxygenLoss();
            }

            function updateElectroFlash(dt) {
                electroFlashTimer = Math.max(0, electroFlashTimer - dt);
                if (!touchDeathActive || electroFlashTimer <= 0) {
                    electroFlash.style.opacity = '0';
                    electroFlash.classList.add('hidden');
                    return;
                }
                const elapsed = 3 - electroFlashTimer;
                const surge = Math.max(0, Math.sin(elapsed * 24 + Math.sin(elapsed * 6.5) * 2));
                const flash = surge > .72 ? ((surge - .72) / .28) ** 2 : 0;
                electroFlash.style.setProperty('--electro-x', `${(player.x / Math.max(1, canvas.width)) * 100}%`);
                electroFlash.style.setProperty('--electro-y', `${(player.y / Math.max(1, canvas.height)) * 100}%`);
                electroFlash.style.opacity = String(flash * .24);
                electroFlash.classList.remove('hidden');
            }

            function drawBackground() {
                const grd = ctx.createRadialGradient(
                    canvas.width / 2, canvas.height / 2, 0,
                    canvas.width / 2, canvas.height / 2, Math.max(canvas.width, canvas.height) / 1.2
                );
                grd.addColorStop(0, '#021b10');
                grd.addColorStop(1, '#000000');
                ctx.fillStyle = grd;
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.save();
                ctx.globalAlpha = 0.08;
                ctx.strokeStyle = '#00ff66';
                const step = 40;
                for (let x = 0; x < canvas.width; x += step) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, canvas.height);
                    ctx.stroke();
                }
                for (let y = 0; y < canvas.height; y += step) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(canvas.width, y);
                    ctx.stroke();
                }
                ctx.restore();
            }

            function fireWhitePlayerBullet(targetX, targetY) {
                if (!running || paused || dead || touchDeathActive || battleEliminated || battleCountdownLocked) return;
                const dx = targetX - player.x;
                const dy = targetY - player.y;
                const len = Math.hypot(dx, dy) || 1;
                const bulletSpeed = 500;
                const dirX = dx / len;
                const dirY = dy / len;
                const bullet = {
                    x: player.x,
                    y: player.y,
                    vx: dirX * bulletSpeed,
                    vy: dirY * bulletSpeed,
                    radius: 4,
                    projectileType: 'whitePlayer',
                    playerShot: true,
                    color: '#ffffff',
                    damage: 1,
                    knock: 180,
                    wallBounces: 0
                };
                if (onlineMatchType === 'battle') {
                    bullet.shotId = crypto.randomUUID();
                }
                bullets.push(bullet);
                broadcastOnlineProjectile('shot', bullet);
                playPewSound(false);
            }

            function updateAbilityCooldownButton(button, cooldown, maxCooldown, label, statusLine) {
                const remaining = Math.max(0, cooldown);
                const progress = Math.max(0, Math.min(1, 1 - remaining / maxCooldown));
                button.style.setProperty('--cooldown-progress', `${(progress * 360).toFixed(2)}deg`);
                button.classList.toggle('cooling', remaining > 0);
                const status = remaining > 0
                    ? `${label}: ${getLocalizedNumber(remaining, { maximumFractionDigits: 1, minimumFractionDigits: 1 })}s`
                    : `${label}: ${cooldownLabels[1]}`;
                statusLine.textContent = status;
                button.setAttribute('aria-label', status);
            }

            function updateAbilityUI() {
                if (!explodeCooldownDisplay) return;
                const battleMode = onlineMatchType === 'battle';
                explodeCooldownDisplay.classList.toggle('hidden', battleMode);
                explodeButton.classList.toggle('hidden', battleMode);
                empButton.classList.toggle('hidden', battleMode);
                phaseButton.classList.toggle('hidden', battleMode);
                if (battleMode) selectedAbility = 0;
                explodeCooldownDisplay.style.display = mobileMode ? 'none' : '';
                explodeCooldownDisplay.style.bottom = oxygenLoss && !mobileMode ? '58px' : '32px';
                shootSlotLine.textContent = `1 Â· ${weaponLabels[0]}`;
                shootSlotLine.classList.toggle('selected', selectedAbility === 0);
                explodeCooldownLine.textContent = explodeCooldown > 0
                    ? `2 Â· ${weaponLabels[1]}: ${getLocalizedNumber(explodeCooldown, { maximumFractionDigits: 1, minimumFractionDigits: 1 })}s`
                    : `2 Â· ${weaponLabels[1]}: ${cooldownLabels[1]}`;
                explodeCooldownLine.classList.toggle('selected', selectedAbility === 1);
                updateAbilityCooldownButton(empButton, empCooldown, 25, `3 Â· ${abilityLabels[0]}`, empCooldownLine);
                updateAbilityCooldownButton(phaseButton, phaseCooldown, 35, `4 Â· ${abilityLabels[1]}`, phaseCooldownLine);
                empCooldownLine.classList.toggle('selected', selectedAbility === 2);
                phaseCooldownLine.classList.toggle('selected', selectedAbility === 3);
                const explodeProgress = Math.max(0, Math.min(1, 1 - explodeCooldown / 30));
                explodeButton.style.setProperty('--cooldown-progress', `${(explodeProgress * 360).toFixed(2)}deg`);
                explodeButton.classList.toggle('cooling', explodeCooldown > 0);
                explodeButton.setAttribute('aria-label', explodeCooldown > 0
                    ? `${weaponLabels[1]}: ${getLocalizedNumber(explodeCooldown, { maximumFractionDigits: 1, minimumFractionDigits: 1 })}s`
                    : `${weaponLabels[1]}: ${cooldownLabels[1]}`);
                [explodeButton, empButton, phaseButton].forEach((button, index) => {
                    const selected = selectedAbility === index + 1;
                    button.classList.toggle('selected', selected);
                    button.setAttribute('aria-pressed', String(selected));
                });
            }

            function updateExplodeCooldownUI() {
                updateAbilityUI();
            }

            function updateAbilityEffects(dt) {
                empScreenTimer = Math.max(0, empScreenTimer - dt);
                phaseShiftTimer = Math.max(0, phaseShiftTimer - dt);
                abilityScreenFx.classList.toggle('emp-active', empScreenTimer > 0);
                abilityScreenFx.classList.toggle('phase-active', phaseShiftTimer > 0);
            }

            function selectAbility(index) {
                if (onlineMatchType === 'battle' && index !== 0) return;
                if (!Number.isInteger(index) || index < 0 || index > 3) return;
                selectedAbility = index;
                updateAbilityUI();
            }

            function activateSelectedAbility() {
                if (battleEliminated || battleCountdownLocked) return;
                if (onlineMatchType === 'battle' && selectedAbility !== 0) return;
                if (selectedAbility === 0) {
                    if (playerShotCooldown > 0) return;
                    fireWhitePlayerBullet(aimX, aimY);
                    playerShotCooldown = 0.06;
                } else if (selectedAbility === 1) triggerGrenade();
                else if (selectedAbility === 2) triggerEmpPulse();
                else triggerPhaseShift();
            }

            function triggerEmpPulse() {
                if (!running || paused || dead || onlineMatchType === 'battle' || touchDeathActive || empCooldown > 0) return;
                empCooldown = 25;
                empScreenTimer = 0.42;
                const pulseRadius = 360;
                const enemySets = [greenSnipers, redSnipers, orangeSnipers, purpleTriangleSnipers, blueSnipers, yellowStarSnipers];
                for (const enemySet of enemySets) {
                    for (const enemy of enemySet) {
                        if (Math.hypot(enemy.x - player.x, enemy.y - player.y) <= pulseRadius + enemy.radius) {
                            enemy.stunTimer = 3.5;
                            enemy.vx = 0;
                            enemy.vy = 0;
                            spawnExplosionEffect(enemy.x, enemy.y, '#00eaff', 10);
                        }
                    }
                }
                for (let i = bullets.length - 1; i >= 0; i--) {
                    const bullet = bullets[i];
                    if (!bullet.playerShot && Math.hypot(bullet.x - player.x, bullet.y - player.y) <= pulseRadius) {
                        spawnExplosionEffect(bullet.x, bullet.y, '#68f7ff', 5);
                        bullets.splice(i, 1);
                    }
                }
                shockwaves.push({ x: player.x, y: player.y, radius: 14, startRadius: 14, maxRadius: pulseRadius, life: 0.9, maxLife: 0.9, color: '#00dfff' });
                shockwaves.push({ x: player.x, y: player.y, radius: 6, startRadius: 6, maxRadius: pulseRadius * 0.82, life: 0.68, maxLife: 0.68, color: '#a9ffff' });
                abilityScreenFx.classList.add('emp-active');
                playEmpPulseSound();
                updateAbilityUI();
            }

            function triggerPhaseShift() {
                if (!running || paused || dead || onlineMatchType === 'battle' || touchDeathActive || phaseCooldown > 0) return;
                phaseCooldown = 35;
                phaseShiftTimer = 5;
                updateAbilityEffects(0);
                playPhaseShiftSound();
                updateAbilityUI();
            }

            function triggerGrenade() {
                if (!running || paused || dead || onlineMatchType === 'battle' || touchDeathActive || explodeCooldown > 0) return;
                explodeCooldown = 30;
                if (mobileMode) {
                    const grenade = {
                        x: player.x,
                        y: player.y,
                        vx: 0,
                        vy: 0,
                        radius: 8,
                        color: '#ff9f1a',
                        isGrenade: true,
                        targetX: player.x,
                        targetY: player.y,
                        speed: 0
                    };
                    broadcastOnlineProjectile('grenade', grenade);
                    detonateGrenade(player.x, player.y);
                    updateExplodeCooldownUI();
                    return;
                }
                const targetX = Math.max(0, Math.min(canvas.width, aimX));
                const targetY = Math.max(0, Math.min(canvas.height, aimY));
                const dx = targetX - player.x;
                const dy = targetY - player.y;
                const distance = Math.hypot(dx, dy) || 1;
                const grenadeSpeed = 720;
                const grenade = {
                    x: player.x,
                    y: player.y,
                    vx: (dx / distance) * grenadeSpeed,
                    vy: (dy / distance) * grenadeSpeed,
                    radius: 8,
                    color: '#ff9f1a',
                    isGrenade: true,
                    targetX,
                    targetY,
                    speed: grenadeSpeed
                };
                bullets.push(grenade);
                broadcastOnlineProjectile('grenade', grenade);
                updateExplodeCooldownUI();
            }

            function detonateGrenade(x, y) {
                const explosionRadius = 155;
                let destroyed = 0;
                const enemySets = [
                    { enemies: greenSnipers, color: '#00ff66', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(greenSnipers) },
                    { enemies: redSnipers, color: '#ff0033', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(redSnipers) },
                    { enemies: orangeSnipers, color: '#ff9f1a', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(orangeSnipers) },
                    { enemies: purpleTriangleSnipers, color: '#a855f7', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(purpleTriangleSnipers) },
                    { enemies: blueSnipers, color: '#1d9bf0', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(blueSnipers) },
                    { enemies: yellowStarSnipers, color: '#facc15', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(yellowStarSnipers) }
                ];
                for (const { enemies: enemySet, color, rewardValue } of enemySets) {
                    for (let i = enemySet.length - 1; i >= 0; i--) {
                        const enemy = enemySet[i];
                        if (Math.hypot(enemy.x - x, enemy.y - y) <= explosionRadius + enemy.radius) {
                            spawnSniperFragments(enemy.x, enemy.y, enemy.radius, color);
                            spawnSniperRewardOrb(enemy, rewardValue);
                            enemySet.splice(i, 1);
                            destroyed++;
                        }
                    }
                }
                if (destroyed > 0) {
                    vibrateHit();
                    playHitSound();
                }
                playExplodeSound();
                spawnExplosionEffect(x, y, '#ff9f1a', 36);
                shockwaves.push({ x, y, radius: 3, startRadius: 3, maxRadius: 70, life: 0.24, maxLife: 0.24, color: '#fff1b8', lineWidth: 5 });
                shockwaves.push({ x, y, radius: 10, startRadius: 10, maxRadius: explosionRadius + 24, life: 0.52, maxLife: 0.52, color: '#ff9f1a', lineWidth: 5 });
                shockwaves.push({ x, y, radius: 16, startRadius: 16, maxRadius: explosionRadius + 65, life: 0.72, maxLife: 0.72, color: '#ff4b1f', lineWidth: 2 });
            }

            function updateSprint(dt) {
                if (onlineMatchType === 'battle') {
                    sprinting = false;
                    sprintHeld = false;
                    sprintToggleActive = false;
                    controllerSprintHeld = false;
                    mobileSprintHeld = false;
                    mobileSprintToggleEnabled = false;
                    stamina = maxStamina;
                    staminaDepletedLockout = false;
                    staminaBar.classList.remove('visible');
                    updateSprintButtonState();
                    return;
                }
                const joystickMoving = joystickActive && (Math.abs(joystickVector.x) > 0.08 || Math.abs(joystickVector.y) > 0.08);
                const mobileSprintRequested = mobileSprintToggleEnabled && joystickMoving;
                const sprintRequested = !battleEliminated
                    && (sprintHeld || sprintToggleActive || controllerSprintHeld || mobileSprintRequested);

                // Once exhausted, stamina stays empty until every sprint input is released.
                if (staminaDepletedLockout && !sprintRequested) {
                    staminaDepletedLockout = false;
                }

                const sprintRechargeThreshold = maxStamina * 0.1;
                const canSprint = !staminaDepletedLockout && stamina >= sprintRechargeThreshold;

                if (sprintRequested && canSprint) {
                    sprinting = true;
                    stamina = Math.max(0, stamina - dt);
                    if (stamina <= 0) {
                        staminaDepletedLockout = true;
                        sprinting = false;
                    }
                } else {
                    sprinting = false;
                    // Regeneration only happens while sprint is released.
                    if (!sprintRequested && !staminaDepletedLockout) {
                        stamina = Math.min(maxStamina, stamina + (maxStamina / 20) * dt);
                    }
                }
                const staminaRatio = stamina / maxStamina;
                staminaBarFill.style.width = (staminaRatio * 100) + '%';
                staminaBarFill.style.backgroundColor = staminaRatio > 0.75
                    ? '#00ff66'
                    : staminaRatio > 0.5
                        ? '#ffe600'
                        : staminaRatio > 0.25
                            ? '#ff9f1a'
                            : '#ff0033';
                staminaBar.classList.toggle('visible', sprinting || stamina < maxStamina);
                staminaBar.style.left = player.x + 'px';
                staminaBar.style.top = (player.y - player.radius - 10) + 'px';
                sprintButton.classList.toggle('active', mobileSprintToggleEnabled && joystickMoving);
                sprintButton.classList.toggle('enabled', mobileSprintToggleEnabled);
                sprintButton.classList.toggle('disabled', !mobileSprintToggleEnabled);
                sprintButton.setAttribute('aria-pressed', String(mobileSprintToggleEnabled));
            }

            function drawPlayerAvatar(x, y, avatarAngle, radius, options = {}) {
                const glowFactor = getGlowMultiplier();
                const teamColor = options.teamColor || null;
                const teamColors = teamColor === '#00aaff'
                    ? ['#ffffff', '#63d5ff', '#006bb3']
                    : ['#ffffff', '#7dffad', '#008a39'];
                ctx.save();
                ctx.translate(x, y);
                ctx.rotate(avatarAngle);
                if (options.phaseShift) {
                    const pulse = 0.5 + Math.sin(elapsedGameTime * 18) * 0.14;
                    ctx.globalAlpha = pulse;
                    ctx.strokeStyle = teamColor || (options.ally ? '#c4b5fd' : options.opposite ? '#ff72c6' : '#65ffd0');
                    ctx.shadowColor = teamColor || (options.ally ? '#3b82f6' : options.opposite ? '#ff00a8' : '#00eaff');
                    ctx.shadowBlur = 24 * glowFactor;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(0, 0, radius + 10 + Math.sin(elapsedGameTime * 12) * 2, 0, Math.PI * 2);
                    ctx.stroke();
                    ctx.globalAlpha = 0.48;
                }

                const electrocuting = options.touchDeathActive && options.touchDeathTimer < 3;
                const electroPulse = electrocuting
                    ? .5 + .5 * Math.sin(options.touchDeathTimer * 35 + Math.sin(options.touchDeathTimer * 8) * 2)
                    : 0;
                {
                    const grd = ctx.createRadialGradient(0, 0, 0, 0, 0, radius);
                    if (teamColor) {
                        const pulse = options.sprinting ? (Math.sin(elapsedGameTime * 20) + 1) / 2 : 0;
                        grd.addColorStop(0, pulse > 0.5 ? teamColors[0] : '#eaffff');
                        grd.addColorStop(0.5, teamColors[1]);
                        grd.addColorStop(1, teamColors[2]);
                    } else if (options.sprinting) {
                        const pulse = (Math.sin(elapsedGameTime * 20) + 1) / 2;
                        if (options.ally) {
                            grd.addColorStop(0, pulse > 0.5 ? '#ffffff' : '#e9d5ff');
                            grd.addColorStop(0.5, pulse > 0.5 ? '#a78bfa' : '#6366f1');
                            grd.addColorStop(1, '#1d4ed8');
                        } else if (options.opposite) {
                            grd.addColorStop(0, pulse > 0.5 ? '#c2ffff' : '#ffffff');
                            grd.addColorStop(0.5, pulse > 0.5 ? '#1affdf' : '#22b8ff');
                            grd.addColorStop(1, '#0033ff');
                        } else {
                            grd.addColorStop(0, pulse > 0.5 ? '#fff0c2' : '#ffffff');
                            grd.addColorStop(0.5, pulse > 0.5 ? '#ff9f1a' : '#ff4d22');
                            grd.addColorStop(1, '#ff0033');
                        }
                    } else {
                        grd.addColorStop(0, options.ally ? '#f5f3ff' : options.opposite ? '#aaaaff' : '#ffffaa');
                        grd.addColorStop(0.5, options.ally ? '#8b5cf6' : options.opposite ? '#3333ff' : '#ffee33');
                        grd.addColorStop(1, options.ally ? '#2563eb' : options.opposite ? '#ff00aa' : '#00ff66');
                    }
                    ctx.fillStyle = grd;
                    ctx.shadowColor = electrocuting
                        ? (electroPulse > .56 ? '#ffffff' : '#00dfff')
                        : teamColor || (options.ally
                            ? (options.sprinting ? '#2563eb' : '#7c3aed')
                            : options.opposite
                                ? (options.sprinting ? '#0033ff' : '#ff00aa')
                                : (options.sprinting ? '#ff0033' : '#00ff66'));
                    ctx.shadowBlur = (electrocuting ? 20 + electroPulse * 28 : options.sprinting ? 24 + Math.sin(elapsedGameTime * 20) * 8 : 18) * glowFactor;
                }

                ctx.beginPath();
                ctx.moveTo(0, -radius);
                for (let i = 0; i < 32; i++) {
                    const theta = (i / 32) * Math.PI * 2;
                    const pointRadius = radius * (0.7 + 0.3 * Math.sin(theta * 3 + avatarAngle * 2));
                    ctx.lineTo(Math.cos(theta) * pointRadius, Math.sin(theta) * pointRadius);
                }
                ctx.closePath();
                ctx.fill();
                if (electrocuting) {
                    ctx.globalAlpha = .2 + electroPulse * .42;
                    ctx.fillStyle = electroPulse > .72 ? '#ffffff' : '#a9faff';
                    ctx.shadowColor = '#00dfff';
                    ctx.shadowBlur = (22 + electroPulse * 24) * glowFactor;
                    ctx.fill();

                    for (let arc = 0; arc < 3; arc++) {
                        const startAngle = options.touchDeathTimer * (arc % 2 === 0 ? 8 : -6) + arc * 2.1;
                        const arcLength = .55 + .22 * Math.sin(options.touchDeathTimer * 17 + arc * 4);
                        const segments = 7;
                        ctx.beginPath();
                        for (let segment = 0; segment <= segments; segment++) {
                            const progress = segment / segments;
                            const angle = startAngle + progress * arcLength;
                            const jitter = Math.sin(options.touchDeathTimer * 47 + arc * 11 + segment * 7) * radius * .12;
                            const arcRadius = radius + 3 + jitter;
                            const px = Math.cos(angle) * arcRadius;
                            const py = Math.sin(angle) * arcRadius;
                            if (segment === 0) ctx.moveTo(px, py);
                            else ctx.lineTo(px, py);
                        }
                        ctx.strokeStyle = arc % 2 === 0 ? '#d9ffff' : '#ffe600';
                        ctx.lineWidth = 1.4 + electroPulse * 1.2;
                        ctx.globalAlpha = .45 + electroPulse * .5;
                        ctx.shadowColor = '#00dfff';
                        ctx.shadowBlur = (10 + electroPulse * 12) * glowFactor;
                        ctx.stroke();
                    }
                }
                ctx.restore();
            }

            function drawPlayer(dt) {
                if (!player.visible) return;
                const moving = Math.abs(player.vx) > 1 || Math.abs(player.vy) > 1 || Math.abs(player.knockVx) > 1 || Math.abs(player.knockVy) > 1;
                if (moving) player.swirlSpinSpeed = sprinting ? 48 : 8;
                else player.swirlSpinSpeed *= Math.pow(0.4, dt);
                player.swirlAngle += player.swirlSpinSpeed * dt;
                const localTeamId = onlinePlayerStates.get(onlinePlayerId)?.teamId;
                drawPlayerAvatar(player.x, player.y, player.swirlAngle, player.radius, {
                    teamColor: onlineMatchType === 'battle'
                        ? (onlineRequiredPlayers === 2
                            ? '#00ff66'
                            : (localTeamId === 1 ? '#00aaff' : '#00ff66'))
                        : null,
                    sprinting,
                    phaseShift: phaseShiftTimer > 0,
                    touchDeathActive,
                    touchDeathTimer
                });
            }

            function drawRemotePlayers() {
                if (!onlineMode) return;
                const renderTime = performance.now();
                for (const remote of onlinePlayerStates.values()) {
                    if (remote.id === onlinePlayerId || remote.alive === false) continue;
                    const interpolatedPosition = getInterpolatedRemotePosition(remote, renderTime);
                    let x = interpolatedPosition.x * canvas.width;
                    let y = interpolatedPosition.y * canvas.height;
                    const dx = x - player.x;
                    const dy = y - player.y;
                    if (onlineMatchType !== 'battle' && Math.hypot(dx, dy) < player.radius * 2.5) {
                        let hash = 0;
                        for (const character of remote.id) {
                            hash = (hash * 31 + character.charCodeAt(0)) >>> 0;
                        }
                        const angle = (hash / 0xffffffff) * Math.PI * 2;
                        x = player.x + Math.cos(angle) * player.radius * 2.8;
                        y = player.y + Math.sin(angle) * player.radius * 2.8;
                    }
                    const isBattle = onlineMatchType === 'battle';
                    const remoteTeamColor = onlineRequiredPlayers === 2
                        ? '#00aaff'
                        : (remote.teamId === 1 ? '#00aaff' : '#00ff66');
                    drawPlayerAvatar(
                        x,
                        y,
                        interpolatedPosition.angle,
                        player.radius * 1.2,
                        {
                            teamColor: isBattle ? remoteTeamColor : null,
                            ally: !isBattle,
                            opposite: isBattle,
                            sprinting: remote.sprinting === true,
                            phaseShift: remote.phaseShift === true,
                            touchDeathActive: remote.touchDeathActive === true,
                            touchDeathTimer: Number.isFinite(remote.touchDeathTimer) ? remote.touchDeathTimer : 0
                        }
                    );
                    if (isBattle) {
                        ctx.save();
                        ctx.font = 'bold 12px "Trebuchet MS", sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillStyle = remoteTeamColor;
                        ctx.shadowColor = remoteTeamColor;
                        ctx.shadowBlur = 8 * getGlowMultiplier();
                        ctx.fillText(
                            getOnlineText('battleHealth', { hp: remote.hp }),
                            x,
                            y - player.radius * 1.8
                        );
                        ctx.restore();
                    }
                }
            }

            function drawSnipers(dt) {
                const glowFactor = getGlowMultiplier();
                const drawHealth = (s, color) => {
                    const barWidth = 42;
                    const barHeight = 5;
                    const blockHeight = 18;
                    const gap = 4;
                    const healthRatio = Math.max(0, Math.min(1, s.hp / s.maxHp));
                    const aboveY = s.y - s.radius - gap - blockHeight;
                    const belowY = s.y + s.radius + gap;
                    const preferredY = aboveY < 4 ? belowY : aboveY;
                    const blockY = Math.max(4, Math.min(canvas.height - blockHeight - 4, preferredY));
                    const centerX = Math.max(barWidth / 2 + 4, Math.min(canvas.width - barWidth / 2 - 4, s.x));
                    const red = { r: 255, g: 38, b: 48 };
                    const base = {
                        r: parseInt(color.slice(1, 3), 16),
                        g: parseInt(color.slice(3, 5), 16),
                        b: parseInt(color.slice(5, 7), 16)
                    };
                    const fillColor = `rgb(${Math.round(red.r + (base.r - red.r) * healthRatio)}, ${Math.round(red.g + (base.g - red.g) * healthRatio)}, ${Math.round(red.b + (base.b - red.b) * healthRatio)})`;
                    const drawRoundedBar = (x, y, width, height, fill) => {
                        if (width <= 0) return;
                        const radius = Math.min(height / 2, width / 2);
                        ctx.beginPath();
                        ctx.moveTo(x + radius, y);
                        ctx.arcTo(x + width, y, x + width, y + height, radius);
                        ctx.arcTo(x + width, y + height, x, y + height, radius);
                        ctx.arcTo(x, y + height, x, y, radius);
                        ctx.arcTo(x, y, x + width, y, radius);
                        ctx.closePath();
                        ctx.fillStyle = fill;
                        ctx.fill();
                    };
                    ctx.save();
                    ctx.font = 'bold 10px "Trebuchet MS", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillStyle = '#ffffff';
                    ctx.shadowColor = fillColor;
                    ctx.shadowBlur = 5 * glowFactor;
                    ctx.fillText(`${s.hp} HP`, centerX, blockY + 9);
                    ctx.shadowBlur = 0;
                    drawRoundedBar(centerX - barWidth / 2, blockY + 13, barWidth, barHeight, 'rgba(0, 0, 0, 0.8)');
                    drawRoundedBar(centerX - barWidth / 2, blockY + 13, barWidth * healthRatio, barHeight, fillColor);
                    ctx.restore();
                };
                const drawEnemySet = (sniperSet, color) => {
                    for (const s of sniperSet) {
                        s.spawnProgress = Math.min(1, s.spawnProgress + dt / 0.45);
                        const spawnScale = 0.2 + 0.8 * (1 - Math.pow(1 - s.spawnProgress, 3));
                        ctx.save();
                        ctx.translate(s.x, s.y);
                        ctx.scale(spawnScale, spawnScale);
                        ctx.globalAlpha = s.spawnProgress;
                        const angle = getSniperFacingAngle(s);
                        ctx.rotate(angle);
                        ctx.strokeStyle = color;
                        ctx.lineWidth = 3;
                        ctx.shadowColor = color;
                        ctx.shadowBlur = 12 * glowFactor;
                        ctx.beginPath();
                        ctx.arc(0, 0, s.radius, 0, Math.PI * 2);
                        ctx.stroke();
                        ctx.beginPath();
                        ctx.moveTo(0, 0);
                        ctx.lineTo(s.radius + 10, 0);
                        ctx.stroke();
                        ctx.restore();
                        drawHealth(s, color);
                    }
                };

                const drawTriangleSet = (sniperSet, color) => {
                    for (const s of sniperSet) {
                        s.spawnProgress = Math.min(1, s.spawnProgress + dt / 0.45);
                        const spawnScale = 0.2 + 0.8 * (1 - Math.pow(1 - s.spawnProgress, 3));
                        ctx.save();
                        ctx.translate(s.x, s.y);
                        ctx.scale(spawnScale, spawnScale);
                        ctx.globalAlpha = s.spawnProgress;
                        const angle = getSniperFacingAngle(s);
                        ctx.rotate(angle);
                        ctx.strokeStyle = color;
                        ctx.fillStyle = 'rgba(168, 85, 247, 0.12)';
                        ctx.lineWidth = 3;
                        ctx.shadowColor = color;
                        ctx.shadowBlur = 16 * glowFactor;
                        ctx.beginPath();
                        ctx.moveTo(0, -s.radius);
                        ctx.lineTo(s.radius * 0.85, s.radius * 0.9);
                        ctx.lineTo(-s.radius * 0.85, s.radius * 0.9);
                        ctx.closePath();
                        ctx.fill();
                        ctx.stroke();
                        ctx.beginPath();
                        ctx.moveTo(0, 0);
                        ctx.lineTo(s.radius + 12, 0);
                        ctx.stroke();
                        ctx.restore();
                        drawHealth(s, color);
                    }
                };

                const drawStarSet = (sniperSet, color) => {
                    for (const s of sniperSet) {
                        s.spawnProgress = Math.min(1, s.spawnProgress + dt / 0.45);
                        const spawnScale = 0.2 + 0.8 * (1 - Math.pow(1 - s.spawnProgress, 3));
                        ctx.save();
                        ctx.translate(s.x, s.y);
                        ctx.scale(spawnScale, spawnScale);
                        ctx.globalAlpha = s.spawnProgress;
                        const angle = getSniperFacingAngle(s);
                        ctx.rotate(angle);
                        ctx.strokeStyle = color;
                        ctx.fillStyle = 'rgba(250, 204, 21, 0.15)';
                        ctx.lineWidth = 3;
                        ctx.shadowColor = color;
                        ctx.shadowBlur = 18 * glowFactor;
                        ctx.beginPath();
                        for (let i = 0; i < 10; i++) {
                            const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
                            const radius = i % 2 === 0 ? s.radius : s.radius * 0.48;
                            const px = Math.cos(a) * radius;
                            const py = Math.sin(a) * radius;
                            if (i === 0) ctx.moveTo(px, py);
                            else ctx.lineTo(px, py);
                        }
                        ctx.closePath();
                        ctx.fill();
                        ctx.stroke();
                        ctx.restore();
                        drawHealth(s, color);
                    }
                };

                drawEnemySet(greenSnipers, '#00ff66');
                drawEnemySet(redSnipers, '#ff0033');
                drawEnemySet(orangeSnipers, '#ff9f1a');
                drawTriangleSet(purpleTriangleSnipers, '#a855f7');
                drawEnemySet(blueSnipers, '#1d9bf0');
                drawStarSet(yellowStarSnipers, '#facc15');
                drawStunnedEnemyEffects(glowFactor);
            }

            function getSniperFacingAngle(sniper) {
                if (phaseShiftTimer > 0 || sniper.stunTimer > 0) {
                    return Math.atan2(sniper.vy || 0, sniper.vx || 1);
                }
                const target = getSniperTargetPosition(sniper);
                return Math.atan2(target.y - sniper.y, target.x - sniper.x);
            }

            function drawStunnedEnemyEffects(glowFactor) {
                const enemySets = [greenSnipers, redSnipers, orangeSnipers, purpleTriangleSnipers, blueSnipers, yellowStarSnipers];
                for (const enemySet of enemySets) {
                    for (const enemy of enemySet) {
                        if (!(enemy.stunTimer > 0)) continue;
                        ctx.save();
                        ctx.translate(enemy.x, enemy.y);
                        ctx.strokeStyle = '#73f7ff';
                        ctx.shadowColor = '#00dfff';
                        ctx.shadowBlur = 16 * glowFactor;
                        ctx.lineWidth = 2;
                        ctx.globalAlpha = 0.7 + Math.sin(elapsedGameTime * 24 + enemy.x) * 0.2;
                        ctx.beginPath();
                        ctx.arc(0, 0, enemy.radius + 7, 0, Math.PI * 2);
                        ctx.stroke();
                        for (let i = 0; i < 3; i++) {
                            const angle = elapsedGameTime * 8 + i * Math.PI * 2 / 3;
                            ctx.beginPath();
                            ctx.moveTo(Math.cos(angle) * (enemy.radius + 3), Math.sin(angle) * (enemy.radius + 3));
                            ctx.lineTo(Math.cos(angle + 0.25) * (enemy.radius + 10), Math.sin(angle + 0.25) * (enemy.radius + 10));
                            ctx.lineTo(Math.cos(angle - 0.08) * (enemy.radius + 15), Math.sin(angle - 0.08) * (enemy.radius + 15));
                            ctx.stroke();
                        }
                        ctx.restore();
                    }
                }
            }

            function drawOxygenOrbs(dt) {
                for (const orb of oxygenOrbs) {
                    orb.spawnProgress = Math.min(1, orb.spawnProgress + dt / 0.45);
                    let scale = 1;
                    let alpha = 0.9;
                    const spawnScale = 0.2 + 0.8 * (1 - Math.pow(1 - orb.spawnProgress, 3));
                    scale *= spawnScale;
                    alpha *= orb.spawnProgress;
                    if (orb.collected) {
                        orb.animTime += dt;
                        const t = orb.animTime;
                        if (t < 0.25) scale = 1 + t * 4;
                        else {
                            scale = Math.max(0, 2 - (t - 0.25) * 6);
                            alpha = Math.max(0, 1 - (t - 0.25) * 4);
                        }
                    }
                    if (orb.collected && orb.animTime > 0.6) continue;
                    const pulse = 0.2 * Math.sin(elapsedGameTime * 4 + orb.x * 0.01);
                    const r = orb.radius * (1 + pulse) * scale;
                    ctx.save();
                    ctx.translate(orb.x, orb.y);
                    const grd = ctx.createRadialGradient(0, 0, 0, 0, 0, r);
                    grd.addColorStop(0, 'rgba(0,255,120,' + alpha + ')');
                    grd.addColorStop(0.4, 'rgba(0,180,80,' + alpha + ')');
                    grd.addColorStop(1, 'rgba(0,40,20,0)');
                    ctx.fillStyle = grd;
                    ctx.beginPath();
                    ctx.arc(0, 0, r, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            function updateSniperRewardOrbs(dt) {
                for (let i = sniperRewardOrbs.length - 1; i >= 0; i--) {
                    const orb = sniperRewardOrbs[i];
                    orb.spawnProgress = Math.min(1, orb.spawnProgress + dt / 0.42);
                    orb.rotation += dt;
                    const pickupRadius = player.radius + orb.size * orb.scale * 0.45;
                    if (player.visible && dist2(player.x, player.y, orb.x, orb.y) < pickupRadius ** 2) {
                        sniperRewardOrbs.splice(i, 1);
                        spawnSniperRewardBurst(orb.x, orb.y, orb.value);
                        sniperOrbRewardPopups.push({
                            value: orb.value,
                            age: 0,
                            life: 1.4
                        });
                        playOxygenCollectSound();
                        vibrateCollect();
                    }
                }

                for (let i = sniperRewardBurstOrbs.length - 1; i >= 0; i--) {
                    const orb = sniperRewardBurstOrbs[i];
                    orb.age += dt;
                    if (orb.age >= orb.life) {
                        sniperRewardBurstOrbs.splice(i, 1);
                        continue;
                    }
                    orb.rotation += orb.spin * dt;
                    orb.vy += ORB_GRAVITY * dt;
                    orb.x += orb.vx * dt;
                    orb.y += orb.vy * dt;

                    const magnifyProgress = Math.min(1, orb.age / 0.45);
                    const magnifyEase = 1 + 2.70158 * Math.pow(magnifyProgress - 1, 3)
                        + 1.70158 * Math.pow(magnifyProgress - 1, 2);
                    orb.scale = 1 + 0.8 * magnifyEase;
                    const edgeInset = orb.size * orb.scale * 0.5;
                    if (orb.x < edgeInset) {
                        orb.x = edgeInset;
                        orb.vx = Math.abs(orb.vx) * 0.85;
                    } else if (orb.x > canvas.width - edgeInset) {
                        orb.x = canvas.width - edgeInset;
                        orb.vx = -Math.abs(orb.vx) * 0.85;
                    }
                    if (orb.y < edgeInset) {
                        orb.y = edgeInset;
                        if (orb.vy < 0) orb.vy = Math.abs(orb.vy) * 0.8;
                    } else if (orb.y > canvas.height - edgeInset) {
                        orb.y = canvas.height - edgeInset;
                        if (orb.vy > 12) {
                            orb.vy *= -0.72;
                            orb.vx *= 0.88;
                        } else {
                            orb.vy = 0;
                            orb.vx *= 0.96;
                        }
                    }
                }
            }

            function drawSniperRewardOrbs() {
                for (const orb of sniperRewardOrbs) {
                    if (!deathOrbImage.complete || !deathOrbImage.naturalWidth) continue;
                    const progress = orb.spawnProgress;
                    const easeBack = 1 + 2.70158 * Math.pow(progress - 1, 3)
                        + 1.70158 * Math.pow(progress - 1, 2);
                    const idlePulse = 1 + 0.08 * Math.sin(elapsedGameTime * 4 + orb.x * 0.01);
                    const scale = Math.max(0, orb.scale * easeBack * idlePulse);
                    const size = orb.size * scale;
                    ctx.save();
                    ctx.translate(orb.x, orb.y);
                    ctx.rotate(orb.rotation);
                    ctx.globalAlpha = orb.opacity;
                    ctx.shadowColor = '#39ff14';
                    ctx.shadowBlur = 20 * getGlowMultiplier() * scale;
                    ctx.drawImage(deathOrbImage, -size / 2, -size / 2, size, size);
                    ctx.restore();
                }

                if (!deathOrbImage.complete || !deathOrbImage.naturalWidth) return;
                for (const orb of sniperRewardBurstOrbs) {
                    const size = orb.size * orb.scale * Math.min(1, orb.age / 0.08);
                    const fade = Math.min(1, (orb.life - orb.age) / 0.35);
                    ctx.save();
                    ctx.translate(orb.x, orb.y);
                    ctx.rotate(orb.rotation);
                    ctx.globalAlpha = Math.max(0, fade);
                    ctx.shadowColor = '#39ff14';
                    ctx.shadowBlur = 12 * getGlowMultiplier();
                    ctx.drawImage(deathOrbImage, -size / 2, -size / 2, size, size);
                    ctx.restore();
                }
            }

            function drawSniperOrbRewardPopups(dt) {
                for (let i = sniperOrbRewardPopups.length - 1; i >= 0; i--) {
                    const popup = sniperOrbRewardPopups[i];
                    popup.age += dt;
                    const progress = Math.min(1, popup.age / popup.life);
                    if (progress >= 1) {
                        sniperOrbRewardPopups.splice(i, 1);
                        continue;
                    }

                    const introProgress = Math.min(1, popup.age / 0.35);
                    const scale = Math.max(0, 1 + 2.70158 * Math.pow(introProgress - 1, 3)
                        + 1.70158 * Math.pow(introProgress - 1, 2));
                    const alpha = Math.min(1, (1 - progress) * 2.5);
                    ctx.save();
                    ctx.globalAlpha = alpha;
                    ctx.translate(canvas.width / 2, canvas.height / 2);
                    ctx.scale(scale, scale);
                    ctx.font = `900 ${Math.min(96, canvas.width * 0.16)}px "Trebuchet MS", sans-serif`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.lineWidth = 4;
                    ctx.strokeStyle = 'rgba(0, 20, 8, 0.9)';
                    ctx.shadowColor = '#39ff14';
                    ctx.shadowBlur = 14 * getGlowMultiplier();
                    const rewardText = `+${getLocalizedNumber(popup.value, { maximumFractionDigits: 0 })}`;
                    ctx.strokeText(rewardText, 0, 0);
                    ctx.fillStyle = '#baffc7';
                    ctx.fillText(rewardText, 0, 0);
                    ctx.restore();
                }
            }

            function drawBullets() {
                const glowFactor = getGlowMultiplier();
                for (const b of bullets) {
                    ctx.save();
                    ctx.translate(b.x, b.y);
                    if (b.isGrenade) {
                        ctx.rotate(Math.atan2(b.vy, b.vx));
                        ctx.fillStyle = '#ff9f1a';
                        ctx.shadowColor = '#ff4b1f';
                        ctx.shadowBlur = 16 * glowFactor;
                        ctx.fillRect(-7, -5, 14, 10);
                        ctx.fillStyle = '#fff1b8';
                        ctx.fillRect(1, -3, 4, 6);
                        ctx.restore();
                        continue;
                    }
                    ctx.fillStyle = b.color || '#00ff66';
                    ctx.shadowColor = ctx.fillStyle;
                    ctx.shadowBlur = (b.remotePlayerShot ? 20 : 10) * glowFactor;
                    ctx.beginPath();
                    ctx.arc(0, 0, b.radius || 6, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            function renderCrosshair(context, x, y, scale, glow = 0) {
                const size = crosshairSize * scale;
                const gap = Math.min(crosshairGap * scale, size);
                const thickness = crosshairThickness * scale;
                const outlineThickness = crosshairOutlineThickness * scale;
                const color = crosshairColor;
                const radius = Math.max(thickness, size / 4);
                context.save();
                context.globalAlpha = crosshairOpacity / 100;
                context.strokeStyle = color;
                context.fillStyle = color;
                context.lineCap = 'round';
                context.lineJoin = 'round';
                context.shadowColor = color;
                context.shadowBlur = glow;

                if (crosshairStyle === 'dot') {
                    context.beginPath();
                    context.arc(x, y, radius, 0, Math.PI * 2);
                    if (crosshairOutline) {
                        context.lineWidth = outlineThickness * 2;
                        context.strokeStyle = '#000000';
                        context.stroke();
                    }
                    context.fillStyle = color;
                    context.fill();
                } else {
                    context.beginPath();
                    if (crosshairStyle === 'circle') {
                        context.arc(x, y, size, 0, Math.PI * 2);
                    } else {
                        context.moveTo(x - size, y);
                        context.lineTo(x - gap, y);
                        context.moveTo(x + gap, y);
                        context.lineTo(x + size, y);
                        context.moveTo(x, y - size);
                        context.lineTo(x, y - gap);
                        context.moveTo(x, y + gap);
                        context.lineTo(x, y + size);
                    }
                    if (crosshairOutline) {
                        context.lineWidth = thickness + outlineThickness * 2;
                        context.strokeStyle = '#000000';
                        context.stroke();
                    }
                    context.lineWidth = thickness;
                    context.strokeStyle = color;
                    context.stroke();
                    if (crosshairCenterDot) {
                        context.beginPath();
                        context.arc(x, y, Math.max(1, thickness * 0.8), 0, Math.PI * 2);
                        if (crosshairOutline) {
                            context.lineWidth = outlineThickness * 2;
                            context.strokeStyle = '#000000';
                            context.stroke();
                        }
                        context.fillStyle = color;
                        context.fill();
                    }
                }
                context.restore();
            }

            function drawCrosshairPreview() {
                if (!crosshairPreviewContext) return;
                const bounds = crosshairPreviewCanvas.getBoundingClientRect();
                if (!bounds.width || !bounds.height) return;
                const pixelRatio = window.devicePixelRatio || 1;
                const pixelWidth = Math.round(bounds.width * pixelRatio);
                const pixelHeight = Math.round(bounds.height * pixelRatio);
                if (crosshairPreviewCanvas.width !== pixelWidth || crosshairPreviewCanvas.height !== pixelHeight) {
                    crosshairPreviewCanvas.width = pixelWidth;
                    crosshairPreviewCanvas.height = pixelHeight;
                }
                crosshairPreviewContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
                crosshairPreviewContext.clearRect(0, 0, bounds.width, bounds.height);
                renderCrosshair(
                    crosshairPreviewContext,
                    bounds.width / 2,
                    bounds.height / 2,
                    Math.min(1.4, (bounds.height * 0.35) / Math.max(1, crosshairSize))
                );
            }
            window.addEventListener('resize', drawCrosshairPreview);

            function drawAimCrosshair() {
                if (!running || paused || dead || mobileMode) return;
                renderCrosshair(ctx, aimX, aimY, 1, 12 * getGlowMultiplier());
            }

            function drawDebris(dt) {
                const glowFactor = getGlowMultiplier();
                for (const p of debrisPieces) {
                    p.x += p.vx * dt;
                    p.y += p.vy * dt;
                    if (p.fragment) {
                        p.colorTransitionTime = Math.min(0.5, p.colorTransitionTime + dt);
                        const drag = Math.pow(0.08, dt);
                        p.vx *= drag;
                        p.vy *= drag;
                        p.rotation += p.rotationSpeed * dt;
                    }
                    p.life -= dt;
                }
                for (let i = debrisPieces.length - 1; i >= 0; i--) {
                    if (debrisPieces[i].life <= 0) debrisPieces.splice(i, 1);
                }
                for (const p of debrisPieces) {
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    const fadeProgress = p.fragment
                        ? Math.max(0, (p.shrinkDelay - p.life) / (p.maxLife - p.shrinkDelay))
                        : 1 - Math.max(0, p.life / p.maxLife);
                    ctx.globalAlpha = p.fragment
                        ? Math.max(0, 1 - fadeProgress)
                        : Math.max(0, p.life / p.maxLife);
                    if (p.fragment) {
                        const shrink = Math.max(0, 1 - fadeProgress);
                        const colorProgress = Math.min(1, p.colorTransitionTime / 0.5);
                        const startRed = parseInt(p.startColor.slice(1, 3), 16);
                        const startGreen = parseInt(p.startColor.slice(3, 5), 16);
                        const startBlue = parseInt(p.startColor.slice(5, 7), 16);
                        const endRed = parseInt(p.color.slice(1, 3), 16);
                        const endGreen = parseInt(p.color.slice(3, 5), 16);
                        const endBlue = parseInt(p.color.slice(5, 7), 16);
                        const fragmentColor = `rgb(${Math.round(startRed + (endRed - startRed) * colorProgress)}, ${Math.round(startGreen + (endGreen - startGreen) * colorProgress)}, ${Math.round(startBlue + (endBlue - startBlue) * colorProgress)})`;
                        ctx.rotate(p.rotation);
                        ctx.scale(shrink, shrink);
                        ctx.fillStyle = fragmentColor;
                        ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
                        ctx.lineWidth = 1.2;
                        ctx.shadowColor = fragmentColor;
                        ctx.shadowBlur = 10 * glowFactor;
                        ctx.beginPath();
                        ctx.moveTo(p.points[0].x, p.points[0].y);
                        for (let pointIndex = 1; pointIndex < p.points.length; pointIndex++) {
                            ctx.lineTo(p.points[pointIndex].x, p.points[pointIndex].y);
                        }
                        ctx.closePath();
                        ctx.fill();
                        ctx.stroke();
                        ctx.restore();
                        continue;
                    }
                    if (p.glow) {
                        ctx.strokeStyle = p.color;
                        ctx.lineWidth = 2.2;
                        ctx.shadowBlur = 14 * glowFactor;
                        ctx.shadowColor = p.color;
                        ctx.beginPath();
                        ctx.arc(0, 0, p.radius + 5, 0, Math.PI * 2);
                        ctx.stroke();
                    }
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(0, 0, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            function drawDamageNumbers(dt) {
                for (let i = damageNumbers.length - 1; i >= 0; i--) {
                    const number = damageNumbers[i];
                    number.x += number.vx * dt;
                    number.y += number.vy * dt;
                    number.life -= dt;
                    if (number.life <= 0) {
                        damageNumbers.splice(i, 1);
                        continue;
                    }
                    ctx.save();
                    ctx.globalAlpha = Math.min(1, number.life / 0.2);
                    ctx.font = 'bold 18px "Trebuchet MS", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.lineWidth = 3;
                    ctx.strokeStyle = 'rgba(0, 0, 0, 0.8)';
                    ctx.shadowColor = number.color;
                    ctx.shadowBlur = 10 * getGlowMultiplier();
                    ctx.strokeText(number.text, number.x, number.y);
                    ctx.fillStyle = '#ffffff';
                    ctx.fillText(number.text, number.x, number.y);
                    ctx.restore();
                }
            }

            function updateOxygenUI() {
                const clamped = Math.max(0, Math.min(100, oxygen));
                const labels = DISPLAY_LABELS[language] || DISPLAY_LABELS.en;
                oxygenBarFill.style.width = clamped + '%';
                oxygenText.textContent = `${labels.oxygen}: ${getLocalizedNumber(clamped, { maximumFractionDigits: 1, minimumFractionDigits: 1 })}%`;
                if (!onlineMode) {
                    oxygenBarContainer.style.top = mobileMode ? 'max(8px, env(safe-area-inset-top))' : 'auto';
                    oxygenBarContainer.style.bottom = mobileMode ? 'auto' : 'max(12px, env(safe-area-inset-bottom))';
                    oxygenBarContainer.style.left = 'max(10px, env(safe-area-inset-left))';
                    oxygenBarContainer.style.right = 'auto';
                    oxygenBarContainer.style.width = 'min(172px, 44vw)';
                    oxygenBarContainer.style.height = '18px';
                    oxygenBarContainer.style.transform = 'none';
                    survivedStopwatch.style.top = mobileMode ? '56px' : '2px';
                    survivedStopwatch.style.fontSize = mobileMode ? '1.15rem' : '1.35rem';
                } else if (mobileMode) {
                    oxygenBarContainer.style.top = '8px';
                    oxygenBarContainer.style.left = '50%';
                    oxygenBarContainer.style.right = 'auto';
                    oxygenBarContainer.style.bottom = 'auto';
                    oxygenBarContainer.style.width = 'min(82%, 560px)';
                    oxygenBarContainer.style.height = '40px';
                    oxygenBarContainer.style.transform = 'translateX(-50%)';
                    survivedStopwatch.style.top = '56px';
                    survivedStopwatch.style.fontSize = '1.15rem';
                } else {
                    oxygenBarContainer.style.top = 'auto';
                    oxygenBarContainer.style.bottom = '16px';
                    oxygenBarContainer.style.left = '50%';
                    oxygenBarContainer.style.right = 'auto';
                    oxygenBarContainer.style.width = '30%';
                    oxygenBarContainer.style.height = '22px';
                    oxygenBarContainer.style.transform = 'translateX(-50%)';
                    survivedStopwatch.style.top = '2px';
                    survivedStopwatch.style.fontSize = '1.35rem';
                }
            }

            function updateBattleHealthUI() {
                const health = Math.max(0, Math.min(100, onlineBattleHealth));
                battleHealthBarContainer.classList.toggle(
                    'hidden',
                    !onlineMode || onlineMatchType !== 'battle' || !running
                );
                battleHealthBarFill.style.width = `${health}%`;
                battleHealthText.textContent = getOnlineText('battleHealth', {
                    hp: getLocalizedNumber(health, { maximumFractionDigits: 0 })
                });
            }

            function sendOnlinePlayerState(timestamp) {
                if (!onlineMode || timestamp - lastOnlineStateSentAt < 100) return;
                lastOnlineStateSentAt = timestamp;
                sendOnlineMessage({
                    type: 'player-state',
                    x: canvas.width ? player.x / canvas.width : 0.5,
                    y: canvas.height ? player.y / canvas.height : 0.5,
                    angle: player.swirlAngle,
                    sprinting,
                    phaseShift: phaseShiftTimer > 0,
                    touchDeathActive,
                    touchDeathTimer,
                    alive: !dead && player.visible
                });
            }

            function updateSurvivedStopwatchUI() {
                survivedStopwatch.textContent = getLocalizedNumber(elapsedGameTime, {
                    maximumFractionDigits: 1,
                    minimumFractionDigits: 1
                });
            }

            function updateFPSUI() {
                const labels = DISPLAY_LABELS[language] || DISPLAY_LABELS.en;
                fpsDisplay.textContent = `${labels.fps}: ${getLocalizedNumber(fps, { maximumFractionDigits: 0 })}`;
                if (fps < 30) fpsDisplay.style.color = '#ff0033';
                else if (fps < 60) fpsDisplay.style.color = '#ffcc00';
                else fpsDisplay.style.color = '#00ff66';
                if (mobileMode) {
                    fpsDisplay.style.position = 'absolute';
                    fpsDisplay.style.top = '52px';
                    fpsDisplay.style.right = '8px';
                    fpsDisplay.style.left = 'auto';
                    fpsDisplay.style.fontSize = '0.72rem';
                } else {
                    fpsDisplay.style.position = 'absolute';
                    fpsDisplay.style.top = '8px';
                    fpsDisplay.style.left = '8px';
                    fpsDisplay.style.right = 'auto';
                    fpsDisplay.style.fontSize = '0.9rem';
                }
            }
            function updateFPSDescriptionVisibility() {
                if (!fpsDescription) return;
                if (fpsHiddenByTouch) {
                    fpsDescription.classList.add('hidden');
                    return;
                }
                if (!mobileMode && !controllerMode) {
                    fpsDescription.classList.remove('hidden');
                } else {
                    fpsDescription.classList.add('hidden');
                }
            }

            function gameLoop(timestamp) {
                if (!running || paused || dead || battleRoundPaused) return;
                const dtRaw = (timestamp - lastTime) / 1000;
                lastTime = timestamp;
                const dt = Math.min(0.05, dtRaw);
                fpsUpdateElapsed += dtRaw;
                fpsFrameCount++;
                if (fpsUpdateElapsed >= 0.3) {
                    const currentFPS = fpsFrameCount / fpsUpdateElapsed;
                    const smoothing = Math.pow(fpsSmoothing, fpsFrameCount);
                    fps = fps * smoothing + currentFPS * (1 - smoothing);
                    updateFPSUI();
                    fpsUpdateElapsed = 0;
                    fpsFrameCount = 0;
                }
                if (onlineMode) {
                    updateOnlineElapsed();
                } else {
                    elapsedGameTime += dt;
                }
                updateSurvivedStopwatchUI();
                playerShotCooldown = Math.max(0, playerShotCooldown - dt);
                explodeCooldown = Math.max(0, explodeCooldown - dt);
                empCooldown = Math.max(0, empCooldown - dt);
                phaseCooldown = Math.max(0, phaseCooldown - dt);
                updateAbilityEffects(dt);
                updateElectroFlash(dt);
                updateAbilityUI();
                updateSprint(dt);
                if (onlineMatchType !== 'battle') {
                    orbSpawnTimer += dt;
                    if (orbSpawnTimer >= 10) {
                        orbSpawnTimer -= 10;
                        spawnOxygenOrb();
                    }

                    greenSpawnTimer += dt;
                    redSpawnTimer += dt;
                    orangeSpawnTimer += dt;
                    purpleSpawnTimer += dt;
                    blueSpawnTimer += dt;
                    yellowSpawnTimer += dt;
                    if (greenSpawnTimer >= SNIPER_SPAWN_INTERVALS.green) {
                        greenSpawnTimer -= SNIPER_SPAWN_INTERVALS.green;
                        spawnGreenSniper();
                    }
                    if (redSpawnTimer >= SNIPER_SPAWN_INTERVALS.red) {
                        redSpawnTimer -= SNIPER_SPAWN_INTERVALS.red;
                        spawnRedSniper();
                    }
                    if (orangeSpawnTimer >= SNIPER_SPAWN_INTERVALS.orange) {
                        orangeSpawnTimer -= SNIPER_SPAWN_INTERVALS.orange;
                        spawnOrangeSniper();
                    }
                    if (purpleSpawnTimer >= SNIPER_SPAWN_INTERVALS.purpleTriangle) {
                        purpleSpawnTimer -= SNIPER_SPAWN_INTERVALS.purpleTriangle;
                        spawnPurpleTriangleSniper();
                    }
                    if (blueSpawnTimer >= SNIPER_SPAWN_INTERVALS.blue) {
                        blueSpawnTimer -= SNIPER_SPAWN_INTERVALS.blue;
                        spawnBlueSniper();
                    }
                    if (yellowSpawnTimer >= SNIPER_SPAWN_INTERVALS.yellowStar) {
                        yellowSpawnTimer -= SNIPER_SPAWN_INTERVALS.yellowStar;
                        spawnYellowStarSniper();
                    }
                    updateEnemyMovement(dt);

                    for (const s of greenSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 1) {
                            s.shootTimer -= 1;
                            spawnBullet(s.x, s.y, 'green', s.targetPlayerId);
                        }
                    }
                    for (const s of redSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 1) {
                            s.shootTimer -= 1;
                            spawnBullet(s.x, s.y, 'red', s.targetPlayerId);
                        }
                    }
                    for (const s of orangeSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 0.1) {
                            s.shootTimer -= 0.1;
                            spawnBullet(s.x, s.y, 'orange', s.targetPlayerId);
                        }
                    }
                    for (const s of purpleTriangleSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 3) {
                            s.shootTimer -= 3;
                            spawnBullet(s.x, s.y, 'purple', s.targetPlayerId);
                        }
                    }
                    for (const s of blueSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 5) {
                            s.shootTimer -= 5;
                            spawnBullet(s.x, s.y, 'blue', s.targetPlayerId);
                        }
                    }
                    for (const s of yellowStarSnipers) {
                        if (s.stunTimer > 0 || phaseShiftTimer > 0) continue;
                        s.shootTimer += dt;
                        if (s.shootTimer >= 2) {
                            s.shootTimer -= 2;
                            spawnYellowStarBurst(s.x, s.y);
                        }
                    }
                }

                if (mouseLeftDown && selectedAbility === 0 && playerShotCooldown <= 0
                    && !battleCountdownLocked) {
                    activateSelectedAbility();
                }
                if (onlineMatchType !== 'battle' && !onlineMode && !oxygenLoss && !touchDeathActive) {
                    oxygen -= 1 * dt;
                    if (oxygen <= 0) {
                        oxygen = 0;
                        enterOxygenLoss();
                    }
                } else if (oxygenLoss) {
                    const elapsedLoss = elapsedGameTime - oxygenLossStartTime;
                    fadeProgress = Math.min(1, elapsedLoss / 10);
                    fadeOverlay.style.opacity = fadeProgress.toString();
                    if (fadeProgress >= 1 && !deathTriggered && !touchDeathActive) {
                        triggerDeathFade();
                    }
                }

                if (!touchDeathActive && !battleEliminated) {
                    let moveX = 0, moveY = 0;
                    if (!battleCountdownLocked && joystickActive) {
                        moveX += joystickVector.x;
                        moveY += joystickVector.y;
                    }
                    if (!battleCountdownLocked && (keys['w'] || keys['arrowup'])) moveY -= 1;
                    if (!battleCountdownLocked && (keys['s'] || keys['arrowdown'])) moveY += 1;
                    if (!battleCountdownLocked && (keys['a'] || keys['arrowleft'])) moveX -= 1;
                    if (!battleCountdownLocked && (keys['d'] || keys['arrowright'])) moveX += 1;
                    const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
                    for (const gp of battleCountdownLocked ? [] : gamepads) {
                        if (!gp) continue;
                        const axX2 = gp.axes[0] || 0;
                        const axY2 = gp.axes[1] || 0;
                        if (Math.abs(axX2) > 0.2 || Math.abs(axY2) > 0.2) {
                            moveX += axX2;
                            moveY += axY2;
                        }
                    }
                    const moveLength = Math.hypot(moveX, moveY);
                    if (moveLength > 0.08) {
                        lastMoveDirX = moveX / moveLength;
                        lastMoveDirY = moveY / moveLength;
                    }
                    if (moveLength > 1) {
                        moveX /= moveLength;
                        moveY /= moveLength;
                    }
                    if (mobileShootHeld && playerShotCooldown <= 0 && !battleCountdownLocked) {
                        const battleTarget = onlineMatchType === 'battle'
                            ? [...onlinePlayerStates.values()]
                                .filter(remote => isBattleOpponent(remote)
                                    && remote.connected !== false
                                    && remote.hp > 0)
                                .sort((left, right) => {
                                    const leftX = left.x * canvas.width - player.x;
                                    const leftY = left.y * canvas.height - player.y;
                                    const rightX = right.x * canvas.width - player.x;
                                    const rightY = right.y * canvas.height - player.y;
                                    return leftX * leftX + leftY * leftY - rightX * rightX - rightY * rightY;
                                })[0]
                            : null;
                        aimX = battleTarget ? battleTarget.x * canvas.width : player.x + lastMoveDirX * 100;
                        aimY = battleTarget ? battleTarget.y * canvas.height : player.y + lastMoveDirY * 100;
                        fireWhitePlayerBullet(aimX, aimY);
                        playerShotCooldown = 0.06;
                    }
                    const movementSpeed = player.speed * (sprinting ? 1.75 : 1);
                    player.vx = moveX * movementSpeed;
                    player.vy = moveY * movementSpeed;

                    const knockDuration = player.knockDuration || 0.5;
                    let knockScale = 0;
                    if (player.knockTime < knockDuration) {
                        player.knockTime = Math.min(knockDuration, player.knockTime + dt);
                        if (knockDuration > 1) {
                            const ramp = Math.min(1, player.knockTime / 0.35);
                            const smoothRamp = ramp * ramp * (3 - 2 * ramp);
                            const fade = Math.max(0, 1 - player.knockTime / knockDuration);
                            const slipperyFade = Math.pow(fade, 0.65);
                            knockScale = smoothRamp * slipperyFade;
                        } else {
                            const t = player.knockTime / knockDuration;
                            const easeOut = 1 - Math.pow(1 - t, 3);
                            knockScale = 1 - easeOut;
                        }
                        player.knockVx = player.knockImpulseX * knockScale;
                        player.knockVy = player.knockImpulseY * knockScale;
                    } else {
                        player.knockVx = 0;
                        player.knockVy = 0;
                        player.knockImpulseX = 0;
                        player.knockImpulseY = 0;
                        player.knockTime = knockDuration;
                    }

                    const totalVx = player.vx + player.knockVx;
                    const totalVy = player.vy + player.knockVy;

                    player.x += totalVx * dt;
                    player.y += totalVy * dt;

                    const margin = 24;
                    if (player.x < margin || player.x > canvas.width - margin) {
                        player.x = Math.max(margin, Math.min(canvas.width - margin, player.x));
                        if ((player.x === margin && player.knockVx < 0) ||
                            (player.x === canvas.width - margin && player.knockVx > 0)) {
                            player.knockImpulseX *= knockDuration > 1 ? -0.94 : -0.82;
                            player.knockVx = player.knockImpulseX * knockScale;
                        }
                    }
                    if (player.y < margin || player.y > canvas.height - margin) {
                        player.y = Math.max(margin, Math.min(canvas.height - margin, player.y));
                        if ((player.y === margin && player.knockVy < 0) ||
                            (player.y === canvas.height - margin && player.knockVy > 0)) {
                            player.knockImpulseY *= knockDuration > 1 ? -0.94 : -0.82;
                            player.knockVy = player.knockImpulseY * knockScale;
                        }
                    }
                } else if (touchDeathActive) {
                    player.vx = 0;
                    player.vy = 0;
                    player.knockVx = 0;
                    player.knockVy = 0;
                    touchDeathTimer += dt;
                    if (touchDeathTimer >= 3 && !touchBreakTriggered) {
                        touchBreakTriggered = true;
                        player.visible = false;
                        spawnExplosionEffect(player.x, player.y, '#ffe600', 42);
                        shockwaves.push({ x: player.x, y: player.y, radius: 12, startRadius: 12, maxRadius: 210, life: 0.7, maxLife: 0.7, color: '#ff9f1a' });
                        const pieces = 24;
                        for (let i = 0; i < pieces; i++) {
                            const angle = (i / pieces) * Math.PI * 2;
                            const speed = 80 + Math.random() * 120;
                            debrisPieces.push({
                                x: player.x,
                                y: player.y,
                                vx: Math.cos(angle) * speed,
                                vy: Math.sin(angle) * speed,
                                radius: 3 + Math.random() * 4,
                                color: i % 2 === 0 ? '#ffffaa' : '#00ff66',
                                life: 0.8 + Math.random() * 0.4,
                                maxLife: 1.2
                            });
                        }
                    }
                    if (touchDeathTimer >= 3.8 && !deathTriggered) {
                        triggerDeathImmediate();
                    }
                } else {
                    player.vx = 0;
                    player.vy = 0;
                    player.knockVx = 0;
                    player.knockVy = 0;
                }

                for (const orb of oxygenOrbs) {
                    if (orb.collected) continue;
                    const r2 = (player.radius + orb.radius) ** 2;
                    if (dist2(player.x, player.y, orb.x, orb.y) < r2) {
                        orb.collected = true;
                        orb.animTime = 0;
                        if (onlineMode) {
                            applyOnlineOxygenChange(20);
                        } else {
                            oxygen = Math.min(100, oxygen + 20);
                        }
                        playOxygenCollectSound();
                        vibrateCollect();
                        if (!onlineMode && oxygen > 0 && oxygenLoss) cancelOxygenLoss();
                    }
                }
                for (let i = oxygenOrbs.length - 1; i >= 0; i--) {
                    if (oxygenOrbs[i].collected && oxygenOrbs[i].animTime > 0.6) {
                        oxygenOrbs.splice(i, 1);
                    }
                }

                for (let i = bullets.length - 1; i >= 0; i--) {
                    const b = bullets[i];
                    if (b.isGrenade) {
                        const remainingDistance = Math.hypot(b.targetX - b.x, b.targetY - b.y);
                        if (remainingDistance <= b.speed * dt) {
                            b.x = b.targetX;
                            b.y = b.targetY;
                            bullets.splice(i, 1);
                            detonateGrenade(b.x, b.y);
                        } else {
                            b.x += b.vx * dt;
                            b.y += b.vy * dt;
                        }
                        continue;
                    }
                    const previousX = b.x;
                    const previousY = b.y;
                    b.x += b.vx * dt;
                    b.y += b.vy * dt;
                    if (b.playerShot) {
                        const hitHorizontalWall = b.x < b.radius || b.x > canvas.width - b.radius;
                        const hitVerticalWall = b.y < b.radius || b.y > canvas.height - b.radius;
                        if (hitHorizontalWall || hitVerticalWall) {
                            if ((b.wallBounces || 0) >= 3) {
                                bullets.splice(i, 1);
                                continue;
                            }
                            b.x = Math.max(b.radius, Math.min(canvas.width - b.radius, b.x));
                            b.y = Math.max(b.radius, Math.min(canvas.height - b.radius, b.y));
                            if (hitHorizontalWall) b.vx *= -1;
                            if (hitVerticalWall) b.vy *= -1;
                            b.wallBounces = (b.wallBounces || 0) + 1;
                        }
                    }
                    if (b.x < -50 || b.x > canvas.width + 50 || b.y < -50 || b.y > canvas.height + 50) {
                        bullets.splice(i, 1);
                        continue;
                    }
                    if (b.playerShot) {
                        if (onlineMatchType === 'battle') {
                            if (b.remotePlayerShot) {
                                const shooter = onlinePlayerStates.get(b.shooterId);
                                const hitPlayer = shooter && [...onlinePlayerStates.values()].find(target => {
                                    if (target.id === b.shooterId || target.alive === false || target.hp <= 0) {
                                        return false;
                                    }
                                    if (onlineRequiredPlayers > 2 && target.teamId === shooter.teamId) {
                                        return false;
                                    }
                                    const targetPosition = target.id === onlinePlayerId
                                        ? { x: player.x, y: player.y }
                                        : getInterpolatedRemotePosition(target, performance.now());
                                    return segmentIntersectsCircle(
                                        previousX,
                                        previousY,
                                        b.x,
                                        b.y,
                                        targetPosition.x * (target.id === onlinePlayerId ? 1 : canvas.width),
                                        targetPosition.y * (target.id === onlinePlayerId ? 1 : canvas.height),
                                        player.radius * 1.35 + b.radius
                                    );
                                });
                                if (hitPlayer) bullets.splice(i, 1);
                                continue;
                            }
                            const hitPlayer = [...onlinePlayerStates.values()].find(remote =>
                                isBattleOpponent(remote)
                                && remote.alive !== false
                                && remote.hp > 0
                                && segmentIntersectsCircle(
                                    previousX,
                                    previousY,
                                    b.x,
                                    b.y,
                                    remote.x * canvas.width,
                                    remote.y * canvas.height,
                                    player.radius * 1.35 + b.radius
                                )
                            );
                            if (hitPlayer) {
                                if (b.shotId) {
                                    sendOnlineMessage({
                                        type: 'battle-hit',
                                        targetId: hitPlayer.id,
                                        shotId: b.shotId,
                                        hitRadius: Math.max(0.012, Math.min(0.05, (player.radius * 1.35 + b.radius) / Math.min(canvas.width, canvas.height)))
                                    });
                                }
                                bullets.splice(i, 1);
                                continue;
                            }
                        }
                        let hitEnemy = false;
                        const enemySets = [
                            { enemies: greenSnipers, color: '#00ff66', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(greenSnipers) },
                            { enemies: redSnipers, color: '#ff0033', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(redSnipers) },
                            { enemies: orangeSnipers, color: '#ff9f1a', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(orangeSnipers) },
                            { enemies: purpleTriangleSnipers, color: '#a855f7', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(purpleTriangleSnipers) },
                            { enemies: blueSnipers, color: '#1d9bf0', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(blueSnipers) },
                            { enemies: yellowStarSnipers, color: '#facc15', rewardValue: SNIPER_ORB_VALUES_BY_ARRAY.get(yellowStarSnipers) }
                        ];
                        for (const { enemies: enemySet, color, rewardValue } of enemySets) {
                            for (let j = enemySet.length - 1; j >= 0; j--) {
                                const enemy = enemySet[j];
                                if (segmentIntersectsCircle(
                                    previousX,
                                    previousY,
                                    b.x,
                                    b.y,
                                    enemy.x,
                                    enemy.y,
                                    b.radius + enemy.radius
                                )) {
                                    const dx = enemy.x - b.x;
                                    const dy = enemy.y - b.y;
                                    const len = Math.hypot(dx, dy) || 1;
                                    const force = 120;
                                    const pushX = (dx / len) * force;
                                    const pushY = (dy / len) * force;
                                    enemy.knockImpulseX = pushX;
                                    enemy.knockImpulseY = pushY;
                                    enemy.knockTime = 0;
                                    enemy.vx = pushX;
                                    enemy.vy = pushY;
                                    const damage = Number.isFinite(b.damage) && b.damage > 0 ? b.damage : 1;
                                    enemy.hp = Math.max(0, (Number.isFinite(enemy.hp) ? enemy.hp : 1) - damage);
                                    const previousDamageNumber = damageNumbers.find(number =>
                                        number.target === enemy && elapsedGameTime - number.lastHitTime < 0.75
                                    );
                                    if (previousDamageNumber) {
                                        previousDamageNumber.totalDamage += damage;
                                        previousDamageNumber.text = `-${previousDamageNumber.totalDamage}`;
                                        previousDamageNumber.lastHitTime = elapsedGameTime;
                                        previousDamageNumber.life = previousDamageNumber.maxLife;
                                        previousDamageNumber.x = enemy.x;
                                        previousDamageNumber.y = Math.max(22, enemy.y - enemy.radius - 8);
                                    } else {
                                        damageNumbers.push({
                                            target: enemy,
                                            x: enemy.x,
                                            y: Math.max(22, enemy.y - enemy.radius - 8),
                                            vx: (Math.random() - 0.5) * 8,
                                            vy: -52,
                                            text: `-${damage}`,
                                            totalDamage: damage,
                                            lastHitTime: elapsedGameTime,
                                            color,
                                            life: 0.75,
                                            maxLife: 0.75
                                        });
                                    }
                                    if (enemy.hp <= 0) {
                                        spawnSniperRewardOrb(enemy, rewardValue);
                                        spawnSniperFragments(enemy.x, enemy.y, enemy.radius, color);
                                        shockwaves.push({
                                            x: enemy.x,
                                            y: enemy.y,
                                            radius: 2,
                                            startRadius: 2,
                                            maxRadius: enemy.radius * 3,
                                            life: 0.36,
                                            maxLife: 0.36,
                                            color
                                        });
                                        shockwaves.push({
                                            x: enemy.x,
                                            y: enemy.y,
                                            radius: 1,
                                            startRadius: 1,
                                            maxRadius: enemy.radius * 2,
                                            life: 0.24,
                                            maxLife: 0.24,
                                            color: '#ffffff'
                                        });
                                        enemySet.splice(j, 1);
                                    }
                                    hitEnemy = true;
                                    break;
                                }
                            }
                            if (hitEnemy) break;
                        }
                        if (hitEnemy) {
                            bullets.splice(i, 1);
                        }
                        continue;
                    }
                    if (onlineMode && b.targetPlayerId && b.targetPlayerId !== onlinePlayerId) continue;
                    if (!touchDeathActive && player.visible && phaseShiftTimer <= 0) {
                        const r2 = (player.radius + b.radius) ** 2;
                        if (dist2(player.x, player.y, b.x, b.y) < r2) {
                            vibrateHit();
                            playHitSound();
                            const projectileType = b.projectileType || 'green';
                            const len = Math.hypot(b.vx, b.vy) || 1;
                            const kbStrength = projectileType === 'blue'
                                ? (b.knock || 3600)
                                : (b.knock || (b.isRed ? 420 : 260)) * 0.45;
                            const targetKnockX = (b.vx / len) * kbStrength;
                            const targetKnockY = (b.vy / len) * kbStrength;
                            player.knockImpulseX = targetKnockX;
                            player.knockImpulseY = targetKnockY;
                            player.knockVx = projectileType === 'blue' ? 0 : targetKnockX;
                            player.knockVy = projectileType === 'blue' ? 0 : targetKnockY;
                            player.knockTime = 0;
                            player.knockDuration = projectileType === 'blue' ? 5 : 0.9;

                            const oxygenDamage = projectileType === 'purple'
                                ? 100
                                : projectileType === 'blue'
                                    ? 30
                                    : projectileType === 'yellowStar'
                                        ? 10
                                        : projectileType === 'red'
                                            ? 100
                                            : projectileType === 'orange'
                                                ? 1
                                                : 5;
                            if (onlineMode) {
                                applyOnlineOxygenChange(-oxygenDamage);
                            } else {
                                oxygen = Math.max(0, oxygen - oxygenDamage);
                                if (oxygen <= 0) {
                                    oxygen = 0;
                                    enterOxygenLoss();
                                }
                            }
                            if (projectileType === 'purple') startTouchDeath();
                            bullets.splice(i, 1);
                        }
                    }
                }

                if (!touchDeathActive && player.visible && phaseShiftTimer <= 0) {
                    const enemySets = [greenSnipers, redSnipers, orangeSnipers, purpleTriangleSnipers, blueSnipers, yellowStarSnipers];
                    for (const enemySet of enemySets) {
                        for (const s of enemySet) {
                            const r2 = (player.radius + s.radius) ** 2;
                            if (dist2(player.x, player.y, s.x, s.y) < r2) {
                                vibrateHit();
                                playHitSound();
                                if (onlineMode) {
                                    applyOnlineOxygenChange(-100);
                                }
                                startTouchDeath();
                                break;
                            }
                        }
                        if (touchDeathActive) break;
                    }
                }

                updateSniperRewardOrbs(dt);
                updateOxygenUI();
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                drawBackground();
                drawOxygenOrbs(dt);
                drawSniperRewardOrbs();
                drawSnipers(dt);
                drawBullets();
                drawShockwaves(dt);
                drawPlayer(dt);
                drawRemotePlayers();
                sendOnlinePlayerState(timestamp);
                drawDebris(dt);
                drawDamageNumbers(dt);
                drawSniperOrbRewardPopups(dt);
                drawAimCrosshair();

                if (oxygenLoss && !touchDeathActive) {
                    if (mobileMode) {
                        oxygenWarningSkull.classList.remove('hidden');
                        oxygenWarningText.classList.add('hidden');
                    } else {
                        oxygenWarningText.classList.remove('hidden');
                        oxygenWarningSkull.classList.add('hidden');
                    }
                }

                if (running && !paused && !dead && !battleRoundPaused) requestGameFrame();
            }

            function showTutorialMessage() {
                const t = LANG[language] || LANG.en;
                let msg = t.tutKeyboard;
                if (lastInputMethod === 'touch') msg = t.tutTouch;
                else if (lastInputMethod === 'controller') msg = t.tutController;
                const [instruction = '', luck = ''] = msg.split('\n');
                const instructionElement = document.createElement('span');
                instructionElement.className = 'tutorialInstruction';
                instructionElement.textContent = instruction;
                const luckElement = document.createElement('span');
                luckElement.className = 'tutorialLuck';
                luckElement.textContent = luck ? ` ${luck}` : '';
                tutorialText.replaceChildren(instructionElement, luckElement);
                tutorialOverlay.classList.remove('tip-enter', 'tip-exit');
                tutorialOverlay.classList.remove('hidden');
                tutorialOverlay.style.opacity = '1';
                setTimeout(() => {
                    tutorialOverlay.classList.add('tip-enter');
                }, 0);
                setTimeout(() => {
                    tutorialOverlay.classList.remove('tip-enter');
                    tutorialOverlay.classList.add('tip-exit');
                }, 650);
                setTimeout(() => {
                    tutorialOverlay.style.opacity = '0';
                    setTimeout(() => {
                        tutorialOverlay.classList.add('hidden');
                        tutorialOverlay.classList.remove('tip-enter', 'tip-exit');
                    }, 500);
                }, 1100);
            }

            btnPlay.addEventListener('pointerdown', (e) => {
                if (e.pointerType === 'touch') {
                    lastInputMethod = 'touch';
                } else if (e.pointerType === 'mouse' || e.pointerType === '') {
                    setComputerInputMode();
                }
            });

            settingsScreen.addEventListener('touchstart', () => {
                fpsHiddenByTouch = true;
                updateFPSDescriptionVisibility();
            }, { passive: true });

            settingsScreen.addEventListener('mousemove', () => {
                fpsHiddenByTouch = false;
                updateFPSDescriptionVisibility();
            });

            window.addEventListener('pointermove', (e) => {
                if (e.pointerType === 'mouse' || e.pointerType === '') {
                    setComputerInputMode();
                }
            });

            window.addEventListener('pointerdown', (e) => {
                if (e.pointerType === 'mouse' || e.pointerType === '') {
                    setComputerInputMode();
                }
            });

            window.addEventListener('touchstart', () => {
                controllerMode = false;
                updateSettingsButtonsVisibility();
                updateFPSDescriptionVisibility();
            }, { passive: true });

            showMenu();
            applyLanguage();
            updateMenuFocus();
            updateFPSDescriptionVisibility();
            updateSettingsButtonsVisibility();
        })();
    </script>

    <style id="elemental-performance-and-pill-fix">
        /* Rounded, capsule-shaped play mode buttons, including the Back button. */
        #playModeOverlay .menuActionButtons .btn,
        #playModeOverlay #btnSoloMode,
        #playModeOverlay #btnOnlineMode,
        #playModeOverlay #btnCancelPlayMode {
            border-radius: 999px !important;
            min-height: 4.2rem;
            padding: 1rem 1.8rem;
        }

        #playModeOverlay .menuActionButtons .btn::before,
        #playModeOverlay .menuActionButtons .btn::after {
            border-radius: inherit;
        }

        /* Keep screen transitions GPU-friendly: no full-scene blur, filters or giant shadows. */
        #gameContainer.screenFading> :not(#screenTransition) {
            filter: none !important;
            transition: none !important;
        }

        .screenTransition[class*="transitionStyle"] {
            box-shadow: none !important;
            filter: none !important;
            will-change: transform, opacity;
            contain: paint;
            backface-visibility: hidden;
        }

        .screenTransition[class*="transitionStyle"]::before {
            filter: none !important;
            mix-blend-mode: normal !important;
            animation: elementalLiteDrift .46s ease-in-out both !important;
        }

        .screenTransition[class*="transitionStyle"].active {
            animation-duration: .46s !important;
        }

        .screenTransition[class*="transitionStyle"].leave {
            animation-duration: .52s !important;
        }

        @keyframes elementalLiteDrift {
            0% {
                transform: translate3d(0, 2%, 0) scale(1);
                opacity: .68;
            }

            55% {
                opacity: 1;
            }

            100% {
                transform: translate3d(0, -1%, 0) scale(1.025);
                opacity: .92;
            }
        }

        /* 1 FIRE â€” layered flame tongues, hot core and ember streaks. */
        .screenTransition.transitionStyle1 {
            background:
                radial-gradient(ellipse at 50% 110%, #fff7b0 0 4%, #ffb21a 12%, #e84408 30%, #75130a 52%, #16070a 78%, #030408 100%) !important;
        }

        .screenTransition.transitionStyle1::before {
            background:
                radial-gradient(ellipse at 18% 100%, rgba(255, 230, 93, .95) 0 5%, rgba(255, 79, 9, .8) 13%, transparent 31%),
                radial-gradient(ellipse at 42% 105%, rgba(255, 248, 181, .95) 0 4%, rgba(255, 115, 8, .88) 14%, transparent 33%),
                radial-gradient(ellipse at 67% 108%, rgba(255, 203, 49, .9) 0 5%, rgba(222, 39, 6, .8) 15%, transparent 34%),
                radial-gradient(ellipse at 88% 104%, rgba(255, 150, 23, .9) 0 4%, rgba(150, 22, 5, .8) 16%, transparent 35%),
                repeating-linear-gradient(174deg, transparent 0 9%, rgba(255, 177, 28, .18) 10%, transparent 12% 19%) !important;
            inset: -8% -2% !important;
        }

        /* 2 ICE â€” translucent ice sheets, crystalline fracture lines and cold blue depth. */
        .screenTransition.transitionStyle2 {
            background: radial-gradient(ellipse at 50% 40%, #efffff 0, #9befff 9%, #237da9 28%, #0b2c55 57%, #030914 100%) !important;
        }

        .screenTransition.transitionStyle2::before {
            background:
                linear-gradient(132deg, transparent 0 26%, rgba(238, 255, 255, .95) 26.2% 26.5%, rgba(73, 209, 255, .5) 26.8% 27.4%, transparent 27.8% 100%),
                linear-gradient(42deg, transparent 0 47%, rgba(222, 253, 255, .8) 47.2% 47.45%, transparent 47.8% 100%),
                linear-gradient(100deg, transparent 0 68%, rgba(163, 243, 255, .75) 68.2% 68.55%, transparent 69% 100%),
                repeating-linear-gradient(60deg, transparent 0 19%, rgba(205, 250, 255, .12) 19.2% 19.5%, transparent 20% 34%) !important;
        }

        /* 3 NATURE â€” deep forest green, leaf silhouettes and branching vines. */
        .screenTransition.transitionStyle3 {
            background: radial-gradient(ellipse at 50% 48%, #b7ee70 0, #2c9a43 16%, #0c4828 42%, #03180e 76%, #010603 100%) !important;
        }

        .screenTransition.transitionStyle3::before {
            background:
                radial-gradient(ellipse at 18% 22%, rgba(119, 231, 83, .9) 0 3%, transparent 4%),
                radial-gradient(ellipse at 24% 30%, rgba(39, 135, 51, .95) 0 5%, transparent 6%),
                radial-gradient(ellipse at 78% 68%, rgba(135, 226, 79, .85) 0 4%, transparent 5%),
                linear-gradient(68deg, transparent 0 39%, rgba(24, 91, 39, .9) 39.3% 40%, transparent 40.3% 100%),
                linear-gradient(112deg, transparent 0 61%, rgba(57, 143, 47, .88) 61.3% 61.8%, transparent 62.1% 100%),
                repeating-linear-gradient(72deg, transparent 0 18%, rgba(165, 255, 106, .14) 18.2% 18.6%, transparent 19% 32%) !important;
        }

        /* 4 LIGHTNING â€” dark storm clouds with sharply defined electric branches. */
        .screenTransition.transitionStyle4 {
            background: radial-gradient(ellipse at 50% 45%, #254c8a 0, #0b1d40 38%, #030817 75%, #01030a 100%) !important;
        }

        .screenTransition.transitionStyle4::before {
            background:
                linear-gradient(116deg, transparent 0 42%, #dfffff 42.2% 42.7%, #55dfff 43% 43.4%, transparent 43.8% 100%),
                linear-gradient(66deg, transparent 0 56%, rgba(222, 253, 255, .98) 56.2% 56.45%, #39bfff 56.7% 57%, transparent 57.4% 100%),
                linear-gradient(124deg, transparent 0 25%, rgba(123, 219, 255, .7) 25.2% 25.45%, transparent 25.8% 100%),
                radial-gradient(ellipse at 48% 45%, rgba(104, 202, 255, .3), transparent 40%) !important;
        }

        /* 5 SHADOW â€” layered black mist and a dim crimson tear in the void. */
        .screenTransition.transitionStyle5 {
            background: radial-gradient(ellipse at 52% 50%, #3a101d 0, #170b13 27%, #07060b 61%, #000 100%) !important;
        }

        .screenTransition.transitionStyle5::before {
            background:
                radial-gradient(ellipse at 50% 50%, transparent 0 20%, rgba(106, 10, 36, .48) 39%, transparent 62%),
                linear-gradient(95deg, transparent 0 46%, rgba(190, 22, 55, .55) 49%, rgba(255, 66, 80, .75) 50%, rgba(97, 0, 30, .55) 51%, transparent 55% 100%),
                radial-gradient(ellipse at 20% 80%, rgba(68, 36, 53, .45), transparent 38%),
                radial-gradient(ellipse at 85% 22%, rgba(43, 30, 52, .55), transparent 34%) !important;
        }

        /* 6 CRYSTAL â€” hard-edged facets and bright glints, with no expensive blend effects. */
        .screenTransition.transitionStyle6 {
            background: linear-gradient(130deg, #061a35 0%, #1d6e8a 17%, #b6fbff 26%, #3d5794 39%, #f4ffff 48%, #7b5eb4 60%, #142a52 78%, #020713 100%) !important;
        }

        .screenTransition.transitionStyle6::before {
            background:
                linear-gradient(45deg, transparent 0 28%, rgba(255, 255, 255, .75) 28.2% 28.5%, transparent 28.8% 100%),
                linear-gradient(135deg, transparent 0 53%, rgba(220, 255, 255, .68) 53.2% 53.5%, transparent 53.8% 100%),
                linear-gradient(75deg, transparent 0 70%, rgba(201, 226, 255, .55) 70.2% 70.6%, transparent 70.9% 100%),
                repeating-linear-gradient(45deg, transparent 0 22%, rgba(255, 255, 255, .12) 22.2% 22.6%, transparent 23% 39%) !important;
        }

        /* 7 TOXIC â€” luminous acidic liquid pockets and hazy green chemical glow. */
        .screenTransition.transitionStyle7 {
            background: radial-gradient(ellipse at 50% 46%, #dfff5c 0, #70d62c 12%, #21742d 33%, #092514 62%, #010602 100%) !important;
        }

        .screenTransition.transitionStyle7::before {
            background:
                radial-gradient(ellipse at 20% 32%, rgba(230, 255, 85, .88) 0 2%, rgba(122, 255, 41, .4) 5%, transparent 12%),
                radial-gradient(ellipse at 70% 24%, rgba(196, 255, 72, .85) 0 3%, rgba(74, 180, 30, .35) 7%, transparent 15%),
                radial-gradient(ellipse at 46% 72%, rgba(221, 255, 82, .78) 0 2%, rgba(102, 226, 35, .3) 6%, transparent 13%),
                radial-gradient(ellipse at 85% 82%, rgba(145, 255, 51, .65) 0 3%, transparent 11%),
                linear-gradient(110deg, transparent 20%, rgba(161, 255, 57, .16) 50%, transparent 80%) !important;
        }

        /* 8 OCEAN â€” layered dark water, aqua light rays and curved wave bands. */
        .screenTransition.transitionStyle8 {
            background: radial-gradient(ellipse at 50% 0%, #8cffff 0, #087fa0 18%, #034466 43%, #011a31 72%, #000610 100%) !important;
        }

        .screenTransition.transitionStyle8::before {
            background:
                repeating-radial-gradient(ellipse at 50% 120%, transparent 0 24px, rgba(117, 244, 255, .42) 25px 27px, transparent 29px 49px),
                linear-gradient(105deg, transparent 15%, rgba(88, 240, 255, .18) 36%, transparent 52%),
                linear-gradient(75deg, transparent 42%, rgba(160, 255, 255, .16) 56%, transparent 73%) !important;
        }

        /* 9 COSMIC â€” deep-space nebula with small stars and a violet gas cloud. */
        .screenTransition.transitionStyle9 {
            background: radial-gradient(ellipse at 56% 48%, #4a207f 0, #21134f 27%, #0b0b27 55%, #01020a 100%) !important;
        }

        .screenTransition.transitionStyle9::before {
