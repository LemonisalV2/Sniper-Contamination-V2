    <style id="sniper-cinematic-intro">
        /* SNIPER CONTAMINATION â€” arcade combat menu scene */
        #menu {
            isolation: isolate;
            overflow: hidden;
            background: transparent !important;
        }

        #menu::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background:
                radial-gradient(ellipse at 50% 48%, rgba(0, 26, 18, .30), rgba(0, 0, 0, .56) 58%, rgba(0, 0, 0, .82)),
                linear-gradient(rgba(35, 255, 145, .045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(35, 255, 145, .045) 1px, transparent 1px);
            background-size: auto, 44px 44px, 44px 44px;
            mask-image: linear-gradient(transparent, #000 12% 88%, transparent);
        }

        #menu.scIntroActive::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            transform-origin: top;
            background: linear-gradient(180deg, rgba(1, 10, 8, .96), rgba(0, 40, 24, .88) 65%, rgba(0, 255, 128, .5));
            box-shadow: 0 0 45px rgba(0, 255, 128, .55);
            animation: scMenuWipe 1.15s .08s cubic-bezier(.76, 0, .24, 1) both;
        }

        #scMenuCombatCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            display: block;
            background: transparent !important;
        }

        #menu> :not(#scMenuCombatCanvas) {
            z-index: 3;
        }

        #menu>#titleMain,
        #menu .sc-title-wrap {
            position: relative;
        }

        #menu .sc-title-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            isolation: isolate;
        }

        #menu .sc-title-wrap::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: -35px -70px -28px;
            pointer-events: none;
            background: radial-gradient(ellipse, rgba(0, 18, 12, .78), rgba(0, 8, 8, .32) 58%, transparent 76%);
            opacity: .9;
        }

        #menu .sc-intro-kicker {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 0 0 12px;
            color: #a7ffd0;
            font: 800 clamp(.58rem, 1.05vw, .78rem)/1.2 "Segoe UI", sans-serif;
            letter-spacing: .34em;
            text-transform: uppercase;
            text-shadow: 0 0 12px rgba(0, 255, 120, .8);
            opacity: .88;
        }

        #menu .sc-intro-kicker::before,
        #menu .sc-intro-kicker::after {
            content: "";
            width: clamp(22px, 5vw, 62px);
            height: 1px;
            background: linear-gradient(90deg, transparent, #00ff80);
            box-shadow: 0 0 9px #00ff80;
        }

        #menu .sc-intro-kicker::after {
            transform: rotate(180deg);
        }

        #menu #titleMain {
            position: relative;
            margin-top: 0;
            margin-bottom: 1.35rem;
            max-width: 94vw;
            line-height: 1.06;
            text-wrap: balance;
            font-size: clamp(2rem, 5.5vw, 4.25rem);
            letter-spacing: clamp(.07rem, .55vw, .34rem);
            color: #d9ffe7;
            -webkit-text-stroke: 1px rgba(0, 255, 120, .2);
            text-shadow:
                0 0 5px rgba(218, 255, 230, .8),
                0 0 16px rgba(0, 255, 102, .92),
                0 0 38px rgba(0, 255, 102, .48),
                0 5px 0 rgba(0, 35, 17, .9);
        }

        #menu .sc-intro-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: -7px 0 17px;
            color: rgba(190, 255, 218, .72);
            font: 700 .65rem/1.2 ui-monospace, Consolas, monospace;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

        #menu .sc-intro-status i {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #00ff75;
            box-shadow: 0 0 10px #00ff75;
            animation: scStatusBlink 1.1s steps(2, end) infinite;
        }

        #menu .buttonRow {
            gap: 1rem;
            margin-top: .4rem;
        }

        #menu .buttonRow .btn {
            min-width: 142px;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(5px);
        }

        #menu .buttonRow .btnPlay {
            box-shadow: 0 0 16px rgba(0, 255, 102, .85), 0 0 40px rgba(0, 255, 102, .35), inset 0 1px rgba(255, 255, 255, .5);
        }

        #menu .buttonRow .btnSettings {
            border: 1px solid rgba(255, 255, 255, .65);
            box-shadow: 0 0 16px rgba(220, 240, 255, .35), inset 0 1px rgba(255, 255, 255, .5);
        }

        #menu.scIntroActive .sc-intro-kicker {
            animation: scKickerEnter .8s .25s cubic-bezier(.16, 1, .3, 1) both;
        }

        #menu.scIntroActive #titleMain {
            animation: scTitleEnter 1.25s .55s cubic-bezier(.16, 1, .3, 1) both;
        }

        #menu.scIntroActive .sc-intro-status {
            animation: scStatusEnter .65s 1.35s ease-out both;
        }

        #menu.scIntroActive .buttonRow .btn {
            animation: scButtonEnter .8s cubic-bezier(.16, 1, .3, 1) both;
        }

        #menu.scIntroActive .buttonRow .btn:nth-child(1) {
            animation-delay: 1.65s;
        }

        #menu.scIntroActive .buttonRow .btn:nth-child(2) {
            animation-delay: 1.82s;
        }

        #menu.scIntroActive .buttonRow .btn:nth-child(3) {
            animation-delay: 1.95s;
        }

        #menu.scIntroActive #btnMenuQuit {
            animation: scQuitEnter .65s .9s cubic-bezier(.16, 1, .3, 1) both;
        }

        @keyframes scKickerEnter {
            from {
                opacity: 0;
                transform: translateY(-24px);
                letter-spacing: .8em;
                filter: blur(5px);
            }

            to {
                opacity: .88;
                transform: translateY(0);
                letter-spacing: .34em;
                filter: blur(0);
            }
        }

        @keyframes scTitleEnter {
            0% {
                opacity: 0;
                transform: perspective(700px) rotateX(48deg) translateY(42px) scale(.78);
                filter: blur(14px) brightness(2.5);
                clip-path: inset(0 50% 0 50%);
            }

            58% {
                opacity: 1;
                transform: perspective(700px) rotateX(-7deg) translateY(-5px) scale(1.035);
                filter: blur(0) brightness(1.65);
                clip-path: inset(0 -5% 0 -5%);
            }

            76% {
                transform: perspective(700px) rotateX(2deg) scale(.99);
                filter: brightness(1.1);
            }

            100% {
                opacity: 1;
                transform: perspective(700px) rotateX(0) translateY(0) scale(1);
                filter: brightness(1);
                clip-path: inset(0 -5% 0 -5%);
            }
        }

        @keyframes scStatusEnter {
            from {
                opacity: 0;
                transform: translateY(12px);
                letter-spacing: .4em;
            }

            to {
                opacity: 1;
                transform: translateY(0);
                letter-spacing: .18em;
            }
        }

        @keyframes scButtonEnter {
            0% {
                opacity: 0;
                transform: translateY(42px) scale(.82);
                filter: blur(8px);
            }

            72% {
                opacity: 1;
                transform: translateY(-5px) scale(1.045);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes scQuitEnter {
            from {
                opacity: 0;
                transform: translateX(-28px) rotate(-35deg) scale(.6);
            }

            to {
                opacity: 1;
                transform: translateX(0) rotate(0) scale(1);
            }
        }

        @keyframes scMenuWipe {
            from {
                transform: scaleY(1);
                opacity: 1;
            }

            to {
                transform: scaleY(0);
                opacity: .8;
            }
        }

        @keyframes scStatusBlink {
            50% {
                opacity: .35;
            }
        }

        @media (max-width: 650px) {
            #menu .buttonRow {
                gap: .65rem;
            }

            #menu .buttonRow .btn {
                min-width: 125px;
                padding: .75rem 1.3rem;
            }

            #menu .sc-intro-kicker {
                letter-spacing: .18em;
            }

            #menu .sc-intro-status {
                font-size: .55rem;
                letter-spacing: .1em;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            #menu.scIntroActive .sc-intro-kicker,
            #menu.scIntroActive #titleMain,
            #menu.scIntroActive .sc-intro-status,
            #menu.scIntroActive .buttonRow .btn,
            #menu.scIntroActive #btnMenuQuit,
            #menu.scIntroActive::after {
                animation-duration: .01ms !important;
                animation-delay: 0ms !important;
            }

            #menu .sc-intro-status i {
                animation: none;
            }
        }

        /* Mobile viewport and overflow corrections */
        @media (max-width: 700px) {

            html,
            body {
                width: 100%;
                min-width: 0;
                min-height: 100%;
                overscroll-behavior: none;
            }

            #gameContainer {
                width: 100%;
                height: 100vh;
                height: 100dvh;
                min-height: 0;
                overflow: hidden;
            }

            #settingsScreen {
                width: 100%;
                height: 100%;
                min-width: 0;
                box-sizing: border-box;
            }

            #settingsScreen .settingsPanel {
                box-sizing: border-box;
                width: 100%;
                height: 100%;
                min-height: 0;
                padding:
                    max(1rem, env(safe-area-inset-top)) max(.85rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(.85rem, env(safe-area-inset-left));
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
            }

            #menu {
                box-sizing: border-box;
                overflow-x: hidden;
                overflow-y: auto;
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
                padding:
                    max(5.25rem, calc(env(safe-area-inset-top) + 4.25rem)) max(1rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
            }

            #menu .sc-title-wrap {
                width: 100%;
                max-width: 42rem;
                min-width: 0;
                margin: auto;
            }

            #menu #titleMain {
