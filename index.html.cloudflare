            box-shadow: 0 0 0 3px rgba(180, 210, 255, 0.12), 0 0 18px rgba(100, 160, 255, 0.42), inset 0 0 14px rgba(220, 235, 255, 0.14);
            color: rgba(226, 239, 255, 0.9);
            -webkit-tap-highlight-color: transparent;
