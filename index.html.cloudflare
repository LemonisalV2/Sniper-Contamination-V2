                        <div id="onlineMatchTypeTitle" class="menuActionStatus">Choose your match type</div>
                        <div class="queueModeButtons">
                            <button id="btnBattleMode" class="btn">BATTLE MODE</button>
                            <button id="btnTeamMode" class="btn">TEAM MODE</button>
