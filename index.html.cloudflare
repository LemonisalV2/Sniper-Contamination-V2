        @media (max-width: 900px) and (pointer: coarse) {
            :root {
                --sc-mobile-control-size: clamp(54px, 15vw, 68px);
                --sc-mobile-control-gap: clamp(9px, 2.8vw, 14px);
                --sc-mobile-safe-bottom: max(14px, env(safe-area-inset-bottom));
                --sc-mobile-safe-right: max(12px, env(safe-area-inset-right));
                --sc-mobile-safe-left: max(12px, env(safe-area-inset-left));
            }

            .sprintButton,
            .explodeButton,
            .shootButton,
            .abilityButton {
                width: var(--sc-mobile-control-size);
                height: var(--sc-mobile-control-size);
                box-sizing: border-box;
            }

            .sprintButton {
                left: var(--sc-mobile-safe-left);
                top: max(54px, calc(env(safe-area-inset-top) + 44px));
            }

            .shootButton {
                right: var(--sc-mobile-safe-right);
                bottom: var(--sc-mobile-safe-bottom);
            }

            .explodeButton {
                right: var(--sc-mobile-safe-right);
                bottom: calc(var(--sc-mobile-safe-bottom) + var(--sc-mobile-control-size) + var(--sc-mobile-control-gap));
            }

            .empButton {
                right: calc(var(--sc-mobile-safe-right) + var(--sc-mobile-control-size) + var(--sc-mobile-control-gap));
                bottom: calc(var(--sc-mobile-safe-bottom) + var(--sc-mobile-control-size) + var(--sc-mobile-control-gap));
            }

            .phaseButton {
                right: var(--sc-mobile-safe-right);
                bottom: calc(var(--sc-mobile-safe-bottom) + (var(--sc-mobile-control-size) + var(--sc-mobile-control-gap)) * 2);
            }

            .joystickBase {
                width: 120px;
                height: 120px;
            }
        }

        @media (max-width: 900px) and (pointer: coarse) and (orientation: landscape) {
            :root {
                --sc-mobile-control-size: clamp(48px, 13vh, 58px);
                --sc-mobile-control-gap: 8px;
                --sc-mobile-safe-bottom: max(8px, env(safe-area-inset-bottom));
            }

            .sprintButton {
                top: max(42px, calc(env(safe-area-inset-top) + 34px));
            }

            .explodeCooldownDisplay {
                top: max(48px, calc(env(safe-area-inset-top) + 42px));
                font-size: .52rem;
            }

            .oxygenBarContainer,
            .battleHealthBarContainer {
                bottom: max(8px, env(safe-area-inset-bottom));
            }
        }

        @media (max-width: 380px) and (orientation: portrait) {
            #menu #titleMain {
                font-size: clamp(1.45rem, 7vw, 1.9rem);
            }

            #menu .buttonRow .btn {
                min-width: 0;
                padding-inline: .8rem;
            }

            .settingsGroup {
                padding: .8rem;
            }

            .settingsChoiceButtons {
                gap: .4rem;
            }

            .settingsChoiceButtons button {
                min-width: 0;
                padding-inline: .65rem;
                font-size: .82rem;
            }
        }
    </style>


    <script id="sniper-cinematic-menu-scene">
        (() => {
            "use strict";
            const menu = document.getElementById("menu");
            if (!menu || menu.dataset.scCinematicReady === "1") return;
            menu.dataset.scCinematicReady = "1";

            const canvas = document.createElement("canvas");
            canvas.id = "scMenuCombatCanvas";
            canvas.setAttribute("aria-hidden", "true");
            menu.insertBefore(canvas, menu.firstChild);
            const ctx = canvas.getContext("2d", { alpha: true });
            if (!ctx) {
                menu.classList.add("scIntroReady");
                return;
            }

            const reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            let width = 1, height = 1, dpr = 1, lastFrame = 0, elapsed = 0;
            let running = true;
            const rand = (a, b) => a + Math.random() * (b - a);
            const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
            const actors = [];
            const menuSnipers = [];
            const bullets = [];
            const particles = [];
            const impacts = [];
            const shapes = [];
            const MAX_PARTICLES = 55;

            function resize() {
                const rect = menu.getBoundingClientRect();
                width = Math.max(1, rect.width);
                height = Math.max(1, rect.height);
                dpr = Math.min(window.devicePixelRatio || 1, 1.5);
                canvas.width = Math.round(width * dpr);
                canvas.height = Math.round(height * dpr);
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                seedScene();
            }
            function seedScene() {
                actors.length = 0;
                const count = width < 600 ? 4 : 7;
                for (let i = 0; i < count; i++) {
                    actors.push({
                        x: rand(-width * .1, width * 1.1),
                        y: height * rand(.59, .88),
                        scale: rand(.65, 1.18),
                        speed: rand(13, 32) * (Math.random() < .5 ? -1 : 1),
                        phase: rand(0, Math.PI * 2),
                        dodgeAt: rand(1, 6),
                        dodge: 0,
                        variant: Math.random() < .7 ? 0 : (Math.random() < .5 ? 1 : 2)
                    });
                }
                // Menu characters use the same abstract orb avatars and sniper shapes
                // as the actual game: no invented human soldiers or rifle characters.
                menuSnipers.length = 0;
                const sniperKinds = [
                    { kind: "circle", color: "#00ff66" },
                    { kind: "circle", color: "#ff0033" },
                    { kind: "circle", color: "#ff9f1a" },
                    { kind: "triangle", color: "#a855f7" },
                    { kind: "circle", color: "#1d9bf0" },
                    { kind: "star", color: "#facc15" }
                ];
                for (let i = 0; i < (width < 600 ? 4 : 7); i++) {
                    const type = sniperKinds[i % sniperKinds.length];
                    menuSnipers.push({
                        ...type, x: rand(width * .08, width * .92),
                        y: rand(height * .22, height * .58), radius: rand(8, 13),
                        vx: rand(-22, 22), vy: rand(-12, 12),
                        phase: rand(0, Math.PI * 2), shotAt: rand(.4, 2.5),
                        target: i % Math.max(1, actors.length)
                    });
                }
                shapes.length = 0;
                for (let i = 0; i < 13; i++) {
                    shapes.push({ x: rand(0, width), y: rand(0, height), size: rand(5, 22), rot: rand(0, 6.28), spin: rand(-.25, .25), alpha: rand(.08, .22) });
                }
            }
            function line(x1, y1, x2, y2, color, alpha = 1, lw = 1) {
                ctx.globalAlpha = alpha;
                ctx.strokeStyle = color;
                ctx.lineWidth = lw;
                ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
                ctx.globalAlpha = 1;
            }
            function drawBackground(t) {
                const glow = ctx.createRadialGradient(width * .5, height * .53, 10, width * .5, height * .53, Math.max(width, height) * .72);
                glow.addColorStop(0, "rgba(0,65,37,.22)");
                glow.addColorStop(.55, "rgba(0,23,19,.12)");
                glow.addColorStop(1, "rgba(0,0,0,0)");
                ctx.fillStyle = glow; ctx.fillRect(0, 0, width, height);

                // Subtle perspective grid, kept faint so the menu remains readable.
                ctx.save();
                ctx.strokeStyle = "rgba(43,255,143,.10)";
                ctx.lineWidth = 1;
                const horizon = height * .58;
                for (let i = 0; i < 13; i++) {
                    const x = (i / 12) * width;
                    ctx.beginPath(); ctx.moveTo(width * .5, horizon); ctx.lineTo(x, height); ctx.stroke();
                }
                for (let i = 0; i < 7; i++) {
                    const p = (i / 6);
                    const y = horizon + p * p * (height - horizon);
                    ctx.globalAlpha = .08 + p * .08;
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
                }
                ctx.restore();

                // Floating wireframe fragments.
                for (const sh of shapes) {
                    sh.rot += sh.spin * .006;
                    ctx.save(); ctx.translate(sh.x, sh.y); ctx.rotate(sh.rot);
                    ctx.globalAlpha = sh.alpha;
                    ctx.strokeStyle = "#57ffad"; ctx.lineWidth = 1;
                    ctx.strokeRect(-sh.size / 2, -sh.size / 2, sh.size, sh.size);
                    ctx.beginPath(); ctx.moveTo(-sh.size * .7, 0); ctx.lineTo(sh.size * .7, 0); ctx.stroke();
                    ctx.restore();
                }
                ctx.globalAlpha = 1;

                // Distant architecture silhouettes.
                const base = height * .66;
                ctx.fillStyle = "rgba(1,10,12,.62)";
                for (let i = 0; i < 9; i++) {
                    const bw = width / 8;
                    const x = i * bw - 2;
                    const bh = height * (.08 + ((i * 37) % 9) / 100);
                    ctx.fillRect(x, base - bh, bw - 3, bh + height * .34);
                    ctx.fillStyle = "rgba(0,255,116,.12)";
                    for (let w = 0; w < 2; w++) for (let h = 0; h < 3; h++) {
                        ctx.fillRect(x + 8 + w * 12, base - bh + 10 + h * 14, 3, 5);
                    }
                    ctx.fillStyle = "rgba(1,10,12,.62)";
                }
                // Scan beam sweeps through the distant skyline.
                const scanX = ((t * .075) % (width + 180)) - 90;
                const beam = ctx.createLinearGradient(scanX - 55, 0, scanX + 55, 0);
                beam.addColorStop(0, "rgba(0,255,120,0)");
                beam.addColorStop(.5, "rgba(0,255,120,.055)");
                beam.addColorStop(1, "rgba(0,255,120,0)");
                ctx.fillStyle = beam; ctx.fillRect(scanX - 55, 0, 110, height);
            }
            function drawPlayerOrb(a, t) {
                // Faithful to drawPlayerAvatar() in the game: a glowing, irregular
                // circular energy player with the same green/blue/yellow palette.
                const bob = Math.sin(t * .004 + a.phase) * 2.2;
                const dodge = a.dodge > 0 ? Math.sin((1 - a.dodge) * Math.PI) * 17 : 0;
                const x = a.x, y = a.y + bob + dodge, r = 10.5 * a.scale;
                const sprintPulse = Math.sin(t * .02 + a.phase) > .35;
                ctx.save();
                ctx.translate(x, y);
                ctx.rotate(a.phase + t * .0007);
                const g = ctx.createRadialGradient(-r * .2, -r * .25, 1, 0, 0, r * 1.25);
                if (a.variant === 1) {
                    g.addColorStop(0, "#ffffff"); g.addColorStop(.5, "#7dffad"); g.addColorStop(1, "#008a39");
                } else if (a.variant === 2) {
                    g.addColorStop(0, "#ffffff"); g.addColorStop(.5, "#63d5ff"); g.addColorStop(1, "#006bb3");
                } else {
                    g.addColorStop(0, sprintPulse ? "#fff0c2" : "#ffffaa");
                    g.addColorStop(.5, sprintPulse ? "#ff9f1a" : "#ffee33");
                    g.addColorStop(1, "#00ff66");
                }
                ctx.fillStyle = g;
                ctx.shadowColor = a.variant === 2 ? "#00aaff" : "#00ff66";
                ctx.shadowBlur = 15;
                ctx.beginPath();
                for (let i = 0; i < 32; i++) {
                    const ang = i / 32 * Math.PI * 2;
                    const rr = r * (.7 + .3 * Math.sin(ang * 3 + a.phase * 2));
                    const px = Math.cos(ang) * rr, py = Math.sin(ang) * rr;
                    if (!i) ctx.moveTo(px, py); else ctx.lineTo(px, py);
                }
                ctx.closePath(); ctx.fill();
                ctx.shadowBlur = 0;
                ctx.strokeStyle = "rgba(235,255,245,.75)"; ctx.lineWidth = 1;
                ctx.stroke();
                ctx.restore();
            }
            function drawMenuSniper(s, t) {
                // Matches the in-game sniper silhouettes: outlined circle, triangle,
                // or star with a short aiming barrel extending from the centre.
                const wobble = Math.sin(t * .002 + s.phase) * .06;
                const target = actors[s.target % Math.max(1, actors.length)];
                const aim = target ? Math.atan2(target.y - s.y, target.x - s.x) : Math.atan2(s.vy, s.vx);
                ctx.save(); ctx.translate(s.x, s.y); ctx.rotate(aim + wobble);
                ctx.strokeStyle = s.color; ctx.fillStyle = s.kind === "triangle" ? "rgba(168,85,247,.13)" : s.kind === "star" ? "rgba(250,204,21,.14)" : "rgba(0,255,102,.07)";
                ctx.lineWidth = 2.2; ctx.shadowColor = s.color; ctx.shadowBlur = 12;
                ctx.beginPath();
                if (s.kind === "triangle") {
                    ctx.moveTo(0, -s.radius); ctx.lineTo(s.radius * .85, s.radius * .9); ctx.lineTo(-s.radius * .85, s.radius * .9); ctx.closePath();
                } else if (s.kind === "star") {
                    for (let i = 0; i < 10; i++) { const a = i / 10 * Math.PI * 2 - Math.PI / 2, rr = i % 2 === 0 ? s.radius : s.radius * .48; const x = Math.cos(a) * rr, y = Math.sin(a) * rr; if (!i) ctx.moveTo(x, y); else ctx.lineTo(x, y); } ctx.closePath();
                } else ctx.arc(0, 0, s.radius, 0, Math.PI * 2);
                ctx.fill(); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(s.radius + 8, 0); ctx.stroke();
                ctx.restore();
            }
            function spawnShot() {
                if (bullets.length > 8) return;
                const fromLeft = Math.random() < .5;
                const sx = fromLeft ? rand(15, width * .22) : rand(width * .78, width - 15);
                const sy = rand(height * .25, height * .67);
                const ex = fromLeft ? rand(width * .55, width * .92) : rand(width * .08, width * .45);
                const ey = sy + rand(-height * .19, height * .19);
                const dx = ex - sx, dy = ey - sy, len = Math.hypot(dx, dy) || 1;
                bullets.push({ x: sx, y: sy, vx: dx / len * rand(520, 850), vy: dy / len * rand(520, 850), life: 0, max: len / rand(520, 850), color: Math.random() < .7 ? "#a6ffbf" : "#9beaff", trail: [] });
            }
            function update(dt, t) {
                for (const a of actors) {
                    a.x += a.speed * dt;
                    if (a.x < -35) a.x = width + 30;
                    if (a.x > width + 35) a.x = -30;
                    if (t / 1000 > a.dodgeAt && a.dodge <= 0) {
                        a.dodge = 1; a.dodgeAt = t / 1000 + rand(3.5, 7);
                    }
                    if (a.dodge > 0) a.dodge = Math.max(0, a.dodge - dt * 1.65);
                }
                for (const sniper of menuSnipers) {
                    sniper.x += sniper.vx * dt;
                    sniper.y += sniper.vy * dt;
                    if (sniper.x < 18 || sniper.x > width - 18) sniper.vx *= -1;
                    if (sniper.y < height * .16 || sniper.y > height * .59) sniper.vy *= -1;
                    sniper.shotAt -= dt;
                    if (!reducedMotion && sniper.shotAt <= 0 && bullets.length < 10) {
                        const target = actors[sniper.target % Math.max(1, actors.length)];
                        if (target) {
                            const dx = target.x - sniper.x, dy = target.y - sniper.y, len = Math.hypot(dx, dy) || 1;
                            const speed = rand(380, 560);
                            bullets.push({ x: sniper.x + dx / len * (sniper.radius + 7), y: sniper.y + dy / len * (sniper.radius + 7), vx: dx / len * speed, vy: dy / len * speed, life: 0, max: Math.min(1.4, len / speed + .2), color: sniper.color, trail: [] });
                        }
                        sniper.shotAt = rand(1.4, 3.1);
                        sniper.target = (sniper.target + 1) % Math.max(1, actors.length);
                    }
                }
                if (!reducedMotion && Math.random() < dt * .35) spawnShot();
                for (let i = bullets.length - 1; i >= 0; i--) {
                    const b = bullets[i];
                    b.life += dt;
                    b.x += b.vx * dt; b.y += b.vy * dt;
                    b.trail.push({ x: b.x, y: b.y });
                    if (b.trail.length > 7) b.trail.shift();
                    if (b.life > b.max || b.x < 0 || b.x > width || b.y < 0 || b.y > height) {
                        impacts.push({ x: b.x, y: b.y, life: 0, max: .42, color: b.color });
                        bullets.splice(i, 1);
                    }
                }
                for (let i = impacts.length - 1; i >= 0; i--) {
                    impacts[i].life += dt;
                    if (impacts[i].life > impacts[i].max) impacts.splice(i, 1);
                }
                if (particles.length < MAX_PARTICLES && Math.random() < dt * 15) {
                    particles.push({ x: rand(0, width), y: rand(0, height), vx: rand(-5, 5), vy: rand(-13, -3), life: 0, max: rand(3, 7), r: rand(.7, 2) });
                }
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i]; p.life += dt; p.x += p.vx * dt; p.y += p.vy * dt;
                    if (p.life > p.max || p.y < -10) particles.splice(i, 1);
                }
            }
            function render(t) {
                ctx.clearRect(0, 0, width, height);
                drawBackground(t);
                // Particles drift in front of the skyline.
                for (const p of particles) {
                    ctx.globalAlpha = (1 - p.life / p.max) * .48;
                    ctx.fillStyle = "#8dffc0"; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
                }
                ctx.globalAlpha = 1;
                actors.sort((a, b) => a.y - b.y);
                for (const a of actors) drawPlayerOrb(a, t);
                for (const sniper of menuSnipers) drawMenuSniper(sniper, t);

                // Flying rounds and luminous tracers.
                for (const b of bullets) {
                    for (let i = 1; i < b.trail.length; i++) {
                        const p0 = b.trail[i - 1], p1 = b.trail[i];
                        line(p0.x, p0.y, p1.x, p1.y, b.color, (i / b.trail.length) * .45, 1.4);
                    }
                    line(b.x - b.vx * .018, b.y - b.vy * .018, b.x, b.y, "#eafff1", .95, 2.2);
                    ctx.fillStyle = b.color; ctx.shadowBlur = 12; ctx.shadowColor = b.color;
                    ctx.beginPath(); ctx.arc(b.x, b.y, 2, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 0;
                }
                for (const p of impacts) {
                    const k = p.life / p.max, r = 4 + k * 22;
                    ctx.globalAlpha = 1 - k;
                    ctx.strokeStyle = p.color; ctx.lineWidth = 2;
                    ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.stroke();
                    ctx.beginPath(); ctx.arc(p.x, p.y, r * .45, 0, Math.PI * 2); ctx.stroke();
                    ctx.globalAlpha = 1;
                }
                // Small tactical reticles on the outer edges.
                const pulse = .65 + Math.sin(t * .003) * .18;
                for (const [x, y] of [[width * .12, height * .3], [width * .88, height * .36]]) {
                    ctx.save(); ctx.translate(x, y); ctx.globalAlpha = .24 * pulse; ctx.strokeStyle = "#70ffae"; ctx.lineWidth = 1;
                    ctx.beginPath(); ctx.arc(0, 0, 13, 0, Math.PI * 2); ctx.stroke();
                    ctx.beginPath(); ctx.moveTo(-21, 0); ctx.lineTo(-7, 0); ctx.moveTo(7, 0); ctx.lineTo(21, 0); ctx.moveTo(0, -21); ctx.lineTo(0, -7); ctx.moveTo(0, 7); ctx.lineTo(0, 21); ctx.stroke();
                    ctx.restore();
                }
                // Vignette.
                const vg = ctx.createRadialGradient(width * .5, height * .48, Math.min(width, height) * .22, width * .5, height * .48, Math.max(width, height) * .76);
                vg.addColorStop(.55, "rgba(0,0,0,0)"); vg.addColorStop(1, "rgba(0,0,0,.55)");
                ctx.fillStyle = vg; ctx.fillRect(0, 0, width, height);
            }
            function frame(now) {
                if (!running) return;
                requestAnimationFrame(frame);
                if (document.hidden || menu.classList.contains("hidden")) return;
                if (now - lastFrame < 30) return; // cap menu scene to ~33 FPS
                const dt = Math.min(.045, (now - (lastFrame || now)) / 1000);
                lastFrame = now; elapsed += dt * 1000;
                update(dt, elapsed);
                render(elapsed);
            }
            resize();
            window.addEventListener("resize", resize, { passive: true });
            document.addEventListener("visibilitychange", () => { lastFrame = 0; });
            menu.classList.add("scIntroReady");
            menu.classList.add("scIntroActive");
            window.setTimeout(() => menu.classList.remove("scIntroActive"), 5200);
            requestAnimationFrame(frame);
        })();
    </script>

</body>

</html>
