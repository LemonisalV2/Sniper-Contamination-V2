        }

        .shootButton .mobileButtonLabel {
            bottom: 10px;
            font-size: 7px;
            letter-spacing: 0.08em;
        }

        .shootButton.visible {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .shootButton:active,
        .shootButton.active {
            transform: scale(0.92);
            border-color: rgba(225, 250, 255, 1);
            box-shadow: 0 0 0 3px rgba(120, 225, 255, 0.28), 0 0 28px rgba(0, 205, 255, 0.96), inset 0 0 16px rgba(200, 245, 255, 0.28);
        }

        .explodeButton.visible {
            display: block;
        }

        .explodeButton:active {
            transform: scale(0.92);
            box-shadow: 0 0 0 3px rgba(255, 220, 180, 0.3), 0 0 28px rgba(255, 80, 50, 1), 0 0 44px rgba(255, 45, 25, 0.72);
        }

        .explodeButton.cooling {
            filter: grayscale(0.2) brightness(0.8);
        }

        .explodeButton.selected {
            border-color: rgba(255, 255, 255, 0.98);
            filter: brightness(1.15);
        }

        .sprintButton:focus-visible,
        .explodeButton:focus-visible,
        .shootButton:focus-visible,
        .abilityButton:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 5px;
        }

        .sprintButton.active {
            transform: scale(1.06);
            animation: sprintButtonPulse 0.45s ease-in-out infinite alternate;
        }

        @keyframes sprintButtonPulse {
            from {
                transform: scale(1);
            }

            to {
                transform: scale(1.08);
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .sprintButton,
            .explodeButton,
            .shootButton,
            .abilityButton {
                transition: none;
            }

            .sprintButton.active {
                animation: none;
            }

            .pauseConfirmContent,
            .pauseConfirmContent.exiting,
            .savedRunConfirmContent,
            .savedRunConfirmContent.exiting {
                animation-duration: 0.01ms;
            }
        }

        .staminaBar {
            position: absolute;
            width: 58px;
            height: 6px;
            transform: translate(-50%, -100%);
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.7);
            box-shadow: 0 0 8px rgba(255, 159, 26, 0.7);
            overflow: hidden;
            pointer-events: none;
            z-index: 4;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .staminaBar.visible {
            opacity: 1;
        }

        .staminaBarFill {
            height: 100%;
            width: 100%;
            border-radius: inherit;
            background-color: #00ff66;
            transition: width 0.08s linear, background-color 0.45s ease;
        }

        .btnFocused {
            outline: 2px solid #ffffff;
            outline-offset: 4px;
        }

        #tutorialOverlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 0 1.25rem clamp(2rem, 8vh, 6rem);
            pointer-events: none;
            z-index: 12;
            opacity: 0;
            transition: opacity 0.5s ease-out;
        }

        #tutorialText {
            max-width: min(88vw, 900px);
            padding: 0.8rem 1.4rem;
            border: 1px solid rgba(100, 255, 220, 0.42);
            border-radius: 999px;
            background: linear-gradient(110deg, rgba(0, 18, 22, 0.82), rgba(0, 42, 40, 0.72), rgba(0, 18, 22, 0.82));
            box-shadow: 0 0 24px rgba(0, 255, 190, 0.2), inset 0 0 18px rgba(0, 255, 190, 0.08);
            backdrop-filter: blur(8px);
            font-size: clamp(1rem, 2.8vw, 1.8rem);
            font-weight: 700;
            line-height: 1.35;
            text-align: center;
            white-space: normal;
            color: #ffffff;
            text-shadow: 0 0 10px rgba(0, 255, 170, 0.85), 0 0 28px rgba(0, 255, 170, 0.45);
        }

        .tutorialInstruction {
            display: inline;
        }

        .tutorialLuck {
            display: inline;
            color: #caffef;
            font-weight: 900;
            text-shadow: 0 0 12px #00ffb3, 0 0 24px rgba(0, 255, 179, 0.9);
        }

        #tutorialOverlay.tip-enter #tutorialText {
            animation: tutorialTipEnter 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        #tutorialOverlay.tip-exit #tutorialText {
            animation: tutorialTipExit 0.42s ease-in both;
        }

        @keyframes tutorialTipEnter {
            0% {
                opacity: 0;
                transform: translateY(32px) scale(0.94);
                filter: blur(12px);
            }

            65% {
                opacity: 1;
                transform: translateY(-5px) scale(1.02);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes tutorialTipExit {
            to {
                opacity: 0;
                transform: translateY(-20px) scale(1.03);
                filter: blur(8px);
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .skullTransition::before,
            .cutsceneVisual,
            .cutsceneVisual::before,
            .cutsceneVisual::after,
            .cutsceneRing,
            .cutsceneCore,
            .cutsceneSpark {
                animation-duration: 12s;
            }

            #tutorialOverlay.tip-enter #tutorialText,
            #tutorialOverlay.tip-exit #tutorialText {
                animation-duration: 0.01ms;
            }
        }

        .controllerNotification {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translate(-50%, -150%);
            padding: 0.9rem 2.2rem;
            border-radius: 999px;
            background: rgba(0, 140, 255, 0.95);
            border: 2px solid #8ad4f7;
            color: #eaffff;
            font-size: 0.95rem;
            box-shadow: 0 0 22px rgba(126, 224, 237, 0.9);
            z-index: 12;
            opacity: 0;
            transition: transform 0.25s ease-out, opacity 0.25s ease-out;
            pointer-events: none;
            text-shadow: 0 0 8px #000;
            max-width: 90%;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .controllerNotification.show {
            transform: translate(-50%, 0%);
            opacity: 1;
            animation: notifIn 0.35s ease-out;
        }

        .screenTransition {
            position: absolute;
            top: -12%;
            bottom: -12%;
            left: -12%;
            width: 124%;
            z-index: 20;
            pointer-events: none;
            opacity: 0;
            overflow: hidden;
            transform: translateX(-110%) skewX(-12deg) scaleX(0.92);
            background: linear-gradient(100deg, rgba(0, 8, 14, 0.98) 0%, rgba(0, 65, 62, 0.98) 38%, #00ff66 49%, #d9ffe4 50%, #00aaff 52%, rgba(0, 16, 24, 0.98) 72%, rgba(0, 3, 7, 0.98) 100%);
            box-shadow: 0 0 34px #00ff66, 0 0 86px rgba(0, 170, 255, 0.85);
            will-change: transform, opacity;
        }

        #gameContainer.screenFading> :not(#screenTransition) {
            filter: brightness(0.18) saturate(0.45);
            transition: filter 0.4s ease;
        }

        .screenTransition::before {
            content: "";
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.2) 1px, transparent 1px, transparent 7px), repeating-linear-gradient(90deg, transparent 0, transparent 34px, rgba(0, 255, 102, 0.22) 35px, transparent 36px);
            mix-blend-mode: screen;
            opacity: 0.65;
            transform: translateX(-8%);
        }

        .screenTransition::after {
            content: "";
            position: absolute;
            top: -20%;
            bottom: -20%;
            right: 9%;
            width: 7px;
            background: #f1fff5;
            box-shadow: 0 0 10px #ffffff, 0 0 28px #00ff66, 0 0 58px #00aaff;
            opacity: 0.95;
            transform: skewX(12deg);
        }

        .screenTransition.active {
            opacity: 1;
            animation: screenWipeIn 0.75s cubic-bezier(0.72, 0, 0.25, 1) forwards;
        }

        .screenTransition.leave {
            opacity: 1;
            transform: translateX(0);
            animation: screenWipeOut 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes screenWipeIn {
            0% {
                opacity: 0;
                transform: translateX(-110%) skewX(-12deg) scaleX(0.92);
            }

            18% {
                opacity: 1;
            }

            100% {
                opacity: 1;
                transform: translateX(0) skewX(-4deg) scaleX(1.04);
            }
        }

        @keyframes screenWipeOut {
            0% {
                transform: translateX(0) skewX(-4deg) scaleX(1.04);
                opacity: 1;
            }

            100% {
                transform: translateX(110%) skewX(-12deg) scaleX(0.92);
                opacity: 0;
            }
        }

        /* Ten randomized cinematic transition styles. */
        .screenTransition[class*="transitionStyle"] {
            inset: -18%;
            top: -18%;
            bottom: -18%;
            left: -18%;
            width: 136%;
        }

        .screenTransition.transitionStyle1 {
            background: linear-gradient(110deg, transparent 0 18%, #00150b 28%, #00ff66 48%, #dffff0 50%, #00aaff 53%, #001018 75%, transparent 90%);
        }

        .screenTransition.transitionStyle2 {
            background: repeating-linear-gradient(0deg, #02040a 0 8px, #00ff66 9px 11px, #001018 12px 20px);
        }

        .screenTransition.transitionStyle3 {
            background: radial-gradient(circle at 50% 50%, #dffff0 0, #00ff66 8%, #003c2a 32%, #02040a 70%);
            border-radius: 50%;
        }

        .screenTransition.transitionStyle4 {
            background: linear-gradient(135deg, #00aaff 0 12%, #001018 25%, #00ff66 48%, #eafff0 50%, #003b27 52%, #02040a 78%);
        }

        .screenTransition.transitionStyle5 {
            background: repeating-linear-gradient(90deg, #02040a 0 12%, #00ff66 12.5% 13%, #001018 14% 25%);
        }

        .screenTransition.transitionStyle6 {
            background: conic-gradient(from 0deg at 50% 50%, #02040a, #00ff66, #dffff0, #00aaff, #02040a);
            border-radius: 50%;
        }

        .screenTransition.transitionStyle7 {
            background: linear-gradient(180deg, #02040a, #00ff66 45%, #dffff0 50%, #00aaff 54%, #02040a);
        }

        .screenTransition.transitionStyle8 {
            background: linear-gradient(45deg, transparent 20%, #00ff66 40%, #eafff0 50%, #00aaff 60%, transparent 80%);
        }

        .screenTransition.transitionStyle9 {
            background: repeating-linear-gradient(135deg, #02040a 0 18px, #003b27 19px 30px, #00ff66 31px 34px, #001018 35px 48px);
        }

        .screenTransition.transitionStyle10 {
            background: radial-gradient(ellipse at center, #eafff0 0, #00ff66 12%, #00452d 30%, #001018 60%, #02040a 80%);
        }

        .screenTransition[class*="transitionStyle"].active {
            animation-duration: .72s;
        }

        .screenTransition.transitionStyle2.active {
            animation-name: transitionGlitchIn;
        }

        .screenTransition.transitionStyle2.leave {
            animation-name: transitionGlitchOut;
        }

        .screenTransition.transitionStyle3.active,
        .screenTransition.transitionStyle6.active {
            animation-name: transitionPortalIn;
        }

        .screenTransition.transitionStyle3.leave,
        .screenTransition.transitionStyle6.leave {
            animation-name: transitionPortalOut;
        }

        .screenTransition.transitionStyle4.active,
        .screenTransition.transitionStyle8.active {
            animation-name: transitionDiagonalIn;
        }

        .screenTransition.transitionStyle4.leave,
        .screenTransition.transitionStyle8.leave {
            animation-name: transitionDiagonalOut;
        }

        .screenTransition.transitionStyle5.active,
        .screenTransition.transitionStyle9.active {
            animation-name: transitionBarsIn;
        }

        .screenTransition.transitionStyle5.leave,
        .screenTransition.transitionStyle9.leave {
            animation-name: transitionBarsOut;
        }

        .screenTransition.transitionStyle7.active {
            animation-name: transitionVerticalIn;
        }

        .screenTransition.transitionStyle7.leave {
            animation-name: transitionVerticalOut;
        }

        .screenTransition.transitionStyle10.active {
            animation-name: transitionPulseIn;
        }

        .screenTransition.transitionStyle10.leave {
            animation-name: transitionPulseOut;
        }

        @keyframes transitionGlitchIn {
            0% {
                opacity: 0;
                transform: translateX(-100%) skewX(-20deg)
            }

            35% {
                opacity: 1;
                transform: translateX(8%) skewX(8deg)
            }

            55% {
                transform: translateX(-3%) skewX(-3deg)
            }

            100% {
                opacity: 1;
                transform: translateX(0)
            }
        }

        @keyframes transitionGlitchOut {
            to {
                opacity: 0;
                transform: translateX(110%) skewX(20deg)
            }
        }

        @keyframes transitionPortalIn {
            0% {
                opacity: 0;
                transform: scale(.05) rotate(-35deg);
                border-radius: 50%
            }

            70% {
                opacity: 1;
                transform: scale(1.08) rotate(8deg);
                border-radius: 50%
            }

            100% {
                opacity: 1;
                transform: scale(1) rotate(0);
                border-radius: 0
            }
        }

        @keyframes transitionPortalOut {
            to {
                opacity: 0;
                transform: scale(.05) rotate(35deg);
                border-radius: 50%
            }
        }

        @keyframes transitionDiagonalIn {
            0% {
                opacity: 0;
                transform: translate(-100%, -30%) rotate(-12deg)
            }

            100% {
                opacity: 1;
                transform: translate(0, 0) rotate(0)
            }
        }

        @keyframes transitionDiagonalOut {
            to {
                opacity: 0;
                transform: translate(110%, 30%) rotate(12deg)
            }
        }

        @keyframes transitionBarsIn {
            0% {
                opacity: 0;
                transform: scaleX(0);
                filter: brightness(2)
            }

            100% {
                opacity: 1;
                transform: scaleX(1);
                filter: brightness(1)
            }
        }

        @keyframes transitionBarsOut {
            to {
                opacity: 0;
                transform: scaleX(0);
                filter: brightness(2)
            }
        }

        @keyframes transitionVerticalIn {
            0% {
                opacity: 0;
                transform: translateY(-110%)
            }

            100% {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @keyframes transitionVerticalOut {
            to {
                opacity: 0;
                transform: translateY(110%)
            }
        }

        @keyframes transitionPulseIn {
            0% {
                opacity: 0;
                transform: scale(1.8);
                filter: brightness(3)
            }

            100% {
                opacity: 1;
                transform: scale(1);
                filter: brightness(1)
            }
        }

        @keyframes transitionPulseOut {
            to {
                opacity: 0;
                transform: scale(.65);
                filter: brightness(2)
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .screenTransition[class*="transitionStyle"].active,
            .screenTransition[class*="transitionStyle"].leave {
                animation-duration: .01ms !important;
            }
        }

        .controllerNotification.disconnect {
            background: rgba(255, 0, 51, 0.95);
            border-color: #ff0033;
            box-shadow: 0 0 22px rgba(255, 0, 51, 0.9);
            color: #ffe5e5;
        }

        .controllerNotification.powerSaving {
            background: rgba(200, 20, 40, 0.95);
            border-color: #ff7a7a;
            box-shadow: 0 0 22px rgba(255, 70, 80, 0.9);
            color: #fff2f2;
            white-space: normal;
        }

        #onlineNotification {
            z-index: 30;
            max-width: min(88vw, 640px);
            white-space: normal;
        }

        #onlineNotification.battleResultNotification {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            top: 14px;
            left: 50%;
            width: max-content;
            min-height: 7.5rem;
            max-width: min(94vw, 48rem);
            padding: 1.05rem clamp(1.5rem, 5vw, 3rem);
            border: 2px solid currentColor;
            border-radius: 999px;
            font-size: clamp(1.6rem, 4vw, 2.25rem);
            font-weight: 900;
            letter-spacing: 0.04em;
            line-height: 1.05;
            text-shadow: 0 0 12px currentColor, 0 0 28px currentColor, 0 0 48px currentColor;
            white-space: pre-line;
            text-overflow: clip;
            text-align: center;
        }

        #onlineNotification.battleResultNotification>span {
            display: block;
            width: 100%;
            text-align: center;
        }

        #onlineNotification.battleResultNotification>#battleRoundNotificationScore {
            margin-top: 0.55rem;
            font-size: clamp(0.9rem, 2.5vw, 1.2rem);
            line-height: 1.3;
            letter-spacing: 0.02em;
            text-shadow: 0 0 8px currentColor;
        }

        #battleRoundNotificationScore[hidden] {
            display: none;
        }

        #onlineNotification.battleResultNotification.show {
            animation: battleResultNotifIn 0.4s ease-out;
        }

        @keyframes battleResultNotifIn {
            from {
                transform: translate(-50%, -150%) scale(0.78);
            }

            65% {
                transform: translate(-50%, 0%) scale(1.06);
            }

            to {
                transform: translate(-50%, 0%) scale(1);
            }
        }

        #onlineNotification.battleResultNotification.battleResultWon {
            background: rgba(0, 24, 10, 0.97);
            border-color: #00ff66;
            box-shadow: 0 0 36px rgba(0, 255, 102, 1), 0 0 70px rgba(0, 255, 102, 0.65), inset 0 0 24px rgba(0, 255, 102, 0.3);
            color: #9effc0;
        }

        #onlineNotification.battleResultNotification.battleResultLost {
            background: rgba(28, 0, 8, 0.97);
            border-color: #ff334f;
            box-shadow: 0 0 36px rgba(255, 51, 79, 1), 0 0 70px rgba(255, 51, 79, 0.65), inset 0 0 24px rgba(255, 51, 79, 0.3);
            color: #ff9aaa;
        }

        #onlineNotification.battleResultNotification.battleResultDraw {
            background: rgba(0, 12, 28, 0.97);
            border-color: #00aaff;
            box-shadow: 0 0 28px rgba(0, 170, 255, 0.9), inset 0 0 18px rgba(0, 170, 255, 0.2);
            color: #9de5ff;
        }

        .batteryStatusNotif {
            top: 12px;
            white-space: normal;
            max-width: min(88vw, 640px);
        }

        .batteryStatusNotif.green {
            background: rgba(0, 180, 80, 0.95);
            border-color: #9eff9e;
            box-shadow: 0 0 22px rgba(0, 255, 102, 0.9);
            color: #effff2;
        }

        .controllerNotification.green {
            background: rgba(0, 180, 80, 0.97);
            border-color: #9eff9e;
            box-shadow: 0 0 22px rgba(0, 255, 102, 0.9);
            color: #effff2;
        }

        .batteryStatusNotif.grey {
            background: rgba(140, 146, 152, 0.95);
            border-color: #dfe3e8;
            box-shadow: 0 0 22px rgba(160, 168, 176, 0.8);
            color: #f8f9fa;
        }

        /* Keep notification colours consistent, but restore the neon treatment in dark mode. */
        @media (prefers-color-scheme: dark) {
            .controllerNotification:not(.disconnect):not(.powerSaving):not(.green):not(.grey):not(.battleResultNotification) {
                background: rgba(0, 18, 32, 0.97);
                border-color: #00aaff;
                color: #c9f2ff;
                box-shadow: 0 0 12px rgba(0, 170, 255, 0.75), 0 0 30px rgba(0, 170, 255, 0.45), inset 0 0 14px rgba(0, 170, 255, 0.16);
                text-shadow: 0 0 8px rgba(0, 170, 255, 0.85);
            }

            .controllerNotification.green,
            .batteryStatusNotif.green {
                background: rgba(0, 24, 12, 0.97);
                border-color: #00ff66;
                color: #caffd9;
                box-shadow: 0 0 12px rgba(0, 255, 102, 0.8), 0 0 30px rgba(0, 255, 102, 0.48), inset 0 0 14px rgba(0, 255, 102, 0.16);
                text-shadow: 0 0 8px rgba(0, 255, 102, 0.85);
            }

            .controllerNotification.disconnect,
            .controllerNotification.powerSaving {
                background: rgba(30, 0, 8, 0.97);
                border-color: #ff334f;
                color: #ffd0d8;
                box-shadow: 0 0 12px rgba(255, 51, 79, 0.8), 0 0 30px rgba(255, 51, 79, 0.48), inset 0 0 14px rgba(255, 51, 79, 0.16);
                text-shadow: 0 0 8px rgba(255, 51, 79, 0.85);
            }

            .batteryStatusNotif.grey {
                background: rgba(18, 22, 28, 0.97);
                border-color: #c5d0dc;
                color: #f0f5fa;
                box-shadow: 0 0 12px rgba(190, 205, 220, 0.65), 0 0 28px rgba(190, 205, 220, 0.35), inset 0 0 14px rgba(190, 205, 220, 0.12);
                text-shadow: 0 0 8px rgba(220, 230, 240, 0.7);
            }
        }

        @keyframes notifIn {
            from {
                transform: translate(-50%, -120%) scaleX(0.6);
            }

            60% {
                transform: translate(-50%, 0%) scaleX(1.08);
            }

            to {
                transform: translate(-50%, 0%) scaleX(1);
            }
        }

        button {
            transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }

        button .buttonIcon {
            display: inline-block;
            width: 1em;
            height: 1em;
            margin-right: 0.42em;
            vertical-align: -0.16em;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            pointer-events: none;
            flex-shrink: 0;
        }

        .settingsChoiceButtons button .buttonIcon,
        .settingsToggleButton .buttonIcon,
        #btnResetCrosshair .buttonIcon {
            width: 1.15rem;
            height: 1.15rem;
            margin-right: 0.5rem;
            color: #92ffc0;
        }

        .settingsChoiceButtons button[data-setting-value="green"] .buttonIcon {
            color: #00ff66;
        }

        .settingsChoiceButtons button[data-setting-value="white"] .buttonIcon {
            color: #ffffff;
        }

        .settingsChoiceButtons button[data-setting-value="cyan"] .buttonIcon {
            color: #00ffff;
        }

        .settingsChoiceButtons button[data-setting-value="yellow"] .buttonIcon {
            color: #ffe600;
        }

        button .buttonIconControl {
            position: absolute;
            z-index: 1;
            top: 8px;
            left: 50%;
            width: 32px;
            height: 32px;
            margin: 0;
            transform: translateX(-50%);
        }

        .sprintButton::before,
        .abilityButton::after,
        .explodeButton::after,
        .shootButton::before {
            content: none;
        }

        .pauseButton .buttonIcon {
            margin: 0;
        }

        button:hover {
            transform: translateY(-3px) scale(1.04);
            filter: brightness(1.12) saturate(1.15);
            animation: allButtonsHover 0.8s ease-in-out infinite alternate, buttonWhiteFocusCycle 1.2s ease-in-out infinite;
        }

        button:active {
            animation-play-state: paused;
        }

        @keyframes allButtonsHover {
            from {
                filter: brightness(1.08) saturate(1.08);
            }

            to {
                filter: brightness(1.2) saturate(1.22);
            }
        }

        #gameContainer.controllerMode button.btnFocused:hover {
            animation: allButtonsHover 0.8s ease-in-out infinite alternate, buttonGreenFocusCycle 1.2s ease-in-out infinite;
        }
    </style>
    <style>
        /* ELEMENTAL TRANSITIONS â€” each randomized style has its own elemental identity */
        .screenTransition[class*="transitionStyle"] {
            background-size: 100% 100%;
            border-radius: 0 !important;
            overflow: hidden;
            will-change: transform, opacity, filter;
        }

        /* 1 â€” FIRE: rising flame tongues and embers */
        .screenTransition.transitionStyle1 {
            background:
                radial-gradient(ellipse at 18% 100%, #fff5a8 0 3%, #ffb000 8%, transparent 35%),
                radial-gradient(ellipse at 76% 110%, #fff0a0 0 4%, #ff4b00 13%, transparent 38%),
                repeating-linear-gradient(76deg, transparent 0 12%, rgba(255, 55, 0, .95) 13%, rgba(255, 190, 0, .7) 15%, transparent 21%),
                linear-gradient(0deg, #210400, #a51b00 36%, #ff5b00 58%, #180400 100%);
            filter: saturate(1.35);
        }

        .screenTransition.transitionStyle1::before {
            content: "";
            position: absolute;
            inset: -20%;
            background: repeating-radial-gradient(ellipse at 50% 100%, transparent 0 15px, rgba(255, 188, 0, .55) 17px 20px, transparent 24px 42px);
            animation: elementFire .65s ease-in-out infinite alternate;
        }

        /* 2 â€” ICE: frost shards and frozen blue light */
        .screenTransition.transitionStyle2 {
            background: radial-gradient(circle at 50% 45%, #f2ffff 0, #8df5ff 8%, #138bbd 33%, #05213e 68%, #010711 100%);
        }

        .screenTransition.transitionStyle2::before {
            content: "";
            position: absolute;
            inset: -15%;
            background: repeating-linear-gradient(52deg, transparent 0 8%, rgba(221, 255, 255, .9) 8.2% 8.5%, transparent 9% 17%), repeating-linear-gradient(128deg, transparent 0 13%, rgba(69, 222, 255, .7) 13.2% 13.6%, transparent 14% 25%);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
            animation: elementIce .72s ease-in-out infinite alternate;
        }

        /* 3 â€” NATURE: vines, leaves and emerald growth */
        .screenTransition.transitionStyle3 {
            background: radial-gradient(ellipse at center, #caff83 0, #32d94b 15%, #075d2b 42%, #01180b 78%);
        }

        .screenTransition.transitionStyle3::before {
            content: "";
            position: absolute;
            inset: -15%;
            background: repeating-linear-gradient(68deg, transparent 0 9%, rgba(117, 255, 93, .9) 9.3% 9.8%, transparent 10.2% 18%), repeating-linear-gradient(112deg, transparent 0 16%, rgba(4, 75, 27, .95) 16.5% 18%, transparent 18.5% 29%);
            animation: elementNature .8s ease-in-out infinite alternate;
        }

        /* 4 â€” LIGHTNING: electric bolts and white-hot flashes */
        .screenTransition.transitionStyle4 {
            background: repeating-linear-gradient(105deg, #03091a 0 18%, #132a6d 19%, #45cfff 20%, #e9ffff 20.5%, #10235c 21%, #020611 28%);
        }

        .screenTransition.transitionStyle4::before {
            content: "";
            position: absolute;
            inset: -5%;
            background: linear-gradient(112deg, transparent 42%, #bafaff 43%, #fff 44%, #4beaff 45%, transparent 47%), linear-gradient(72deg, transparent 57%, #e9ffff 58%, #50caff 59%, transparent 61%);
            filter: drop-shadow(0 0 12px #50dfff);
            animation: elementLightning .24s steps(2, end) infinite;
        }

        /* 5 â€” SHADOW: dark smoke and crimson rifts */
        .screenTransition.transitionStyle5 {
            background: radial-gradient(ellipse at 50% 50%, #451022 0, #160914 35%, #030208 72%, #000 100%);
        }

        .screenTransition.transitionStyle5::before {
            content: "";
            position: absolute;
            inset: -20%;
            background: repeating-radial-gradient(ellipse at 35% 60%, transparent 0 14px, rgba(120, 0, 39, .55) 22px 42px, transparent 55px 78px);
            filter: blur(5px);
            animation: elementShadow .8s ease-in-out infinite alternate;
        }

        /* 6 â€” CRYSTAL: prismatic glass facets */
        .screenTransition.transitionStyle6 {
            background: conic-gradient(from 30deg at 50% 50%, #092b55, #8bfaff, #ffffff, #d6a4ff, #3e54a8, #73ffd2, #092b55);
        }

        .screenTransition.transitionStyle6::before {
            content: "";
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(45deg, transparent 0 10%, rgba(255, 255, 255, .72) 10.2% 10.6%, transparent 11% 20%), repeating-linear-gradient(135deg, transparent 0 17%, rgba(255, 255, 255, .42) 17.2% 17.7%, transparent 18% 32%);
            mix-blend-mode: screen;
            animation: elementCrystal .65s linear infinite;
        }

        /* 7 â€” TOXIC: radioactive lime vapor and bubbling cells */
        .screenTransition.transitionStyle7 {
            background: radial-gradient(circle at 45% 45%, #eaff00 0, #76ff00 12%, #168000 34%, #05210b 68%, #010501 100%);
        }

        .screenTransition.transitionStyle7::before {
            content: "";
            position: absolute;
            inset: -12%;
            background: radial-gradient(circle at 20% 25%, rgba(218, 255, 0, .9) 0 2%, transparent 5%), radial-gradient(circle at 70% 30%, rgba(132, 255, 0, .85) 0 4%, transparent 7%), radial-gradient(circle at 42% 72%, rgba(218, 255, 0, .75) 0 3%, transparent 6%), radial-gradient(circle at 85% 80%, rgba(132, 255, 0, .8) 0 5%, transparent 8%);
            animation: elementToxic .6s ease-in-out infinite alternate;
        }

        /* 8 â€” OCEAN: deep water currents and aqua waves */
        .screenTransition.transitionStyle8 {
            background: repeating-linear-gradient(0deg, #00152b 0 10%, #004e70 12%, #00c9d8 14%, #00668d 16%, #00152b 23%);
        }

        .screenTransition.transitionStyle8::before {
            content: "";
            position: absolute;
            inset: -15%;
            background: repeating-radial-gradient(ellipse at 50% 120%, transparent 0 18px, rgba(107, 255, 255, .65) 20px 23px, transparent 25px 42px);
            animation: elementOcean .7s ease-in-out infinite alternate;
        }

        /* 9 â€” COSMIC: starfield, nebula and violet energy */
        .screenTransition.transitionStyle9 {
            background: radial-gradient(ellipse at 50% 50%, #6c2cff 0, #1c126b 25%, #07051d 63%, #000 100%);
        }

        .screenTransition.transitionStyle9::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 12% 24%, white 0 1px, transparent 2px), radial-gradient(circle at 28% 76%, #9dfbff 0 2px, transparent 3px), radial-gradient(circle at 71% 20%, white 0 1px, transparent 2px), radial-gradient(circle at 86% 65%, #ffb8ff 0 2px, transparent 3px), radial-gradient(circle at 54% 42%, white 0 1px, transparent 2px), radial-gradient(ellipse at 50% 50%, rgba(255, 63, 226, .42), transparent 55%);
            background-size: 100% 100%;
            animation: elementCosmic .7s linear infinite alternate;
        }

        /* 10 â€” SOLAR: golden plasma ring and radiant sunburst */
        .screenTransition.transitionStyle10 {
            background: radial-gradient(circle at 50% 50%, #fffde0 0, #ffdf4b 8%, #ff7b00 25%, #9b1b00 48%, #190400 76%, #000 100%);
        }

        .screenTransition.transitionStyle10::before {
            content: "";
            position: absolute;
            inset: -15%;
            background: repeating-conic-gradient(from 0deg at 50% 50%, rgba(255, 245, 154, .9) 0deg 2deg, transparent 3deg 15deg);
            mask-image: radial-gradient(circle at center, transparent 0 18%, #000 20% 72%, transparent 78%);
            animation: elementSolar .8s linear infinite;
        }

        @keyframes elementFire {
            from {
                transform: translateY(5%) scaleX(.94)
            }

            to {
                transform: translateY(-5%) scaleX(1.06)
            }
        }

        @keyframes elementIce {
            from {
                transform: scale(1) rotate(-2deg);
                opacity: .55
            }

            to {
                transform: scale(1.08) rotate(2deg);
                opacity: 1
            }
        }

        @keyframes elementNature {
            from {
                transform: translate(-2%, 2%) rotate(-2deg)
            }

            to {
                transform: translate(2%, -2%) rotate(2deg)
            }
        }

        @keyframes elementLightning {

            0%,
            100% {
                opacity: .35;
                transform: translateX(-2%)
            }

            45% {
                opacity: 1;
                transform: translateX(2%)
            }

            50% {
                opacity: .15
            }
        }

        @keyframes elementShadow {
            from {
                transform: translate(-3%, 2%) scale(1)
            }

            to {
                transform: translate(3%, -2%) scale(1.12)
            }
        }

        @keyframes elementCrystal {
            from {
                transform: translateX(-2%) rotate(0deg)
            }

            to {
                transform: translateX(2%) rotate(3deg)
            }
        }

        @keyframes elementToxic {
            from {
                transform: scale(.94) rotate(-2deg);
                filter: hue-rotate(-8deg)
            }

            to {
                transform: scale(1.08) rotate(2deg);
                filter: hue-rotate(8deg)
            }
        }

        @keyframes elementOcean {
            from {
                transform: translateY(4%) scaleY(.95)
            }

            to {
                transform: translateY(-4%) scaleY(1.05)
            }
        }

        @keyframes elementCosmic {
            from {
                transform: scale(.96) rotate(-1deg);
                opacity: .65
            }

            to {
                transform: scale(1.06) rotate(1deg);
                opacity: 1
            }
        }

        @keyframes elementSolar {
            from {
                transform: rotate(0deg) scale(1)
            }

            to {
                transform: rotate(35deg) scale(1.08)
            }
        }

        @media (prefers-reduced-motion:reduce) {
            .screenTransition[class*="transitionStyle"]::before {
                animation: none !important
            }
        }
    </style>
</head>

<body>
    <div id="gameContainer">
        <canvas id="gameCanvas"></canvas>

        <div id="menu" class="menu scIntroActive">
            <div class="batteryWidget" aria-label="Battery status">
                <div class="batteryBody">
                    <div class="batteryFill"></div>
                    <span class="batteryChargeIcon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.3 1.5L4.7 13h5.4L8.7 22.5l9.1-11.7h-5.5L13.3 1.5Z" />
                        </svg>
                    </span>
                </div>
                <span class="batteryPercent">--%</span>
            </div>
            <button id="btnMenuQuit" class="btn" type="button" aria-label="Quit"> </button>
            <div class="sc-title-wrap">
                <div class="sc-intro-kicker">TACTICAL RESPONSE UNIT</div>
                <h1 id="titleMain">SNIPER CONTAMINATION</h1>
                <div class="sc-intro-status"><i></i><span>CONTAINMENT BREACH // LIVE COMBAT ZONE</span></div>
                <div class="buttonRow">
                    <button id="btnPlay" class="btn btnPlay">Play</button>
                    <button id="btnRumbleTest" class="btn btnNeon hidden">Rumble Test</button>
                    <button id="btnMenuSettings" class="btn btnSettings">Settings</button>
                </div>
            </div>
            <div id="mainQuitConfirmOverlay" class="pauseConfirmOverlay hidden" aria-hidden="true">
                <div id="mainQuitConfirmContent" class="pauseConfirmContent" role="dialog" aria-modal="true"
                    aria-labelledby="mainQuitConfirmPrompt">
                    <div id="mainQuitConfirmPrompt" class="pauseConfirmPrompt">Are you sure you want to quit?</div>
                    <div class="pauseConfirmButtons">
                        <button id="btnConfirmMainQuit" class="btn btnNeonRed" type="button">Yes</button>
                        <button id="btnCancelMainQuit" class="btn btnNeonGrey" type="button">Cancel</button>
                    </div>
                </div>
            </div>
            <div id="savedRunConfirmOverlay" class="savedRunConfirmOverlay hidden" aria-hidden="true">
                <div id="savedRunConfirmContent" class="savedRunConfirmContent" role="dialog" aria-modal="true"
                    aria-labelledby="savedRunConfirmPrompt">
                    <div id="savedRunConfirmPrompt" class="savedRunConfirmPrompt"></div>
                    <div class="savedRunConfirmButtons">
                        <button id="btnLoadSavedRun" class="btn btnNeonSave">Yes</button>
                        <button id="btnStartNewRun" class="btn btnNeonRed">No, Start a new game</button>
                        <button id="btnCancelSavedRun" class="btn btnNeonGrey">Cancel</button>
                    </div>
                </div>
            </div>
            <div id="playModeOverlay" class="menuActionOverlay hidden" aria-hidden="true">
                <div class="menuActionContent" role="dialog" aria-modal="true" aria-labelledby="playModeTitle">
