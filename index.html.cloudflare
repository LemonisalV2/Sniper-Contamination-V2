<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <link rel="icon" type="image/x-icon" href="icon.ico">
    <title>Sniper Contamination</title>
    <style>
        html,
        body,
        #gameContainer {
            margin: 0;
            padding: 0;
            background: #02040a;
            color: #fff;
            font-family: "Trebuchet MS", "Segoe UI", sans-serif;
            font-weight: 600;
            overflow: hidden;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        input,
        textarea {
            user-select: text;
            -webkit-user-select: text;
        }

        #gameContainer {
            position: relative;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            background: radial-gradient(circle at center, #050810 0%, #000000 70%);
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #021010 0%, #000000 70%);
            z-index: 0;
            position: relative;
        }

        #gameContainer.playing,
        #gameContainer.playing canvas {
            cursor: none;
        }

        .hidden {
            display: none !important;
        }

        #menu.scIntroActive:not(.scIntroReady) {
            visibility: hidden;
        }

        h1 {
            font-size: 3rem;
            letter-spacing: 0.2rem;
            color: #9eff9e;
            text-shadow: 0 0 12px #00ff66, 0 0 24px #00ff66;
            margin-bottom: 2rem;
            text-align: center;
        }

        .btn {
            padding: 0.8rem 2.4rem;
            border-radius: 999px;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: bold;
            letter-spacing: 0.08rem;
            text-transform: uppercase;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
            transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
        }

        .btn:active {
            transform: scale(0.96);
            filter: brightness(0.9);
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.9);
        }

        .btnPlay {
            background: #00ff66;
            color: #001004;
            box-shadow: 0 0 16px #00ff66, 0 0 32px #00ff66;
        }

        .btnSettings {
            background: #bfbfbf;
            color: #050505;
            box-shadow: 0 0 16px #bfbfbf, 0 0 32px #bfbfbf;
        }

        .btnNeon {
            background: #00aaff;
            color: #001018;
            box-shadow: 0 0 16px #00aaff, 0 0 32px #00aaff;
            margin: 0.25rem;
            padding: 0.5rem 1.4rem;
            border-radius: 999px;
        }

        .btnNeonGreen {
            background: #00ff66;
            color: #001004;
            box-shadow: 0 0 16px #00ff66, 0 0 32px #00ff66;
            margin: 0.25rem;
            padding: 0.5rem 1.4rem;
            border-radius: 999px;
        }

        .btnNeonGrey {
            background: #cfd3da;
            color: #050608;
            box-shadow: 0 0 16px #cfd3da, 0 0 32px #cfd3da;
            margin: 0.25rem;
            padding: 0.5rem 1.4rem;
            border-radius: 999px;
        }

        .btnBlue {
            background: #00aaff;
            color: #001018;
            box-shadow: 0 0 16px #00aaff, 0 0 32px #00aaff;
        }

        .btnNeonRed {
            background: #ff0033;
            color: #fff;
            box-shadow: 0 0 16px #ff0033, 0 0 32px #ff0033;
        }

        .btnNeonSave {
            background: #00ff66;
            color: #001004;
            box-shadow: 0 0 16px #00ff66, 0 0 32px #00ff66;
        }

        .btnNeonYellow {
            background: #ffe600;
            color: #302000;
            box-shadow: 0 0 16px #ffe600, 0 0 32px #ffe600;
        }

        @keyframes buttonWhiteFocusCycle {

            0%,
            100% {
                outline-color: rgba(255, 255, 255, 0.55);
                box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.16), 0 0 12px rgba(255, 255, 255, 0.38);
            }

            50% {
                outline-color: #ffffff;
                box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.42), 0 0 24px rgba(255, 255, 255, 0.82);
            }
        }

        @keyframes buttonGreenFocusCycle {

            0%,
            100% {
                outline-color: rgba(0, 255, 102, 0.55);
                box-shadow: 0 0 0 2px rgba(0, 255, 102, 0.18), 0 0 12px rgba(0, 255, 102, 0.4);
            }

            50% {
                outline-color: #00ff66;
                box-shadow: 0 0 0 4px rgba(0, 255, 102, 0.45), 0 0 26px rgba(0, 255, 102, 0.9);
            }
        }

        button:hover:not(.btnFocused),
        button:focus-visible:not(.btnFocused) {
            outline: 2px solid rgba(255, 255, 255, 0.7);
            outline-offset: 3px;
            animation: allButtonsHover 0.8s ease-in-out infinite alternate, buttonWhiteFocusCycle 1.2s ease-in-out infinite;
        }

        #gameContainer.controllerMode button.btnFocused {
            position: relative;
            z-index: 1;
            outline: 2px solid rgba(0, 255, 102, 0.7);
            outline-offset: 3px;
            animation: buttonGreenFocusCycle 1.2s ease-in-out infinite;
        }

        .menu .btnPlay,
        .menu #btnRumbleTest,
        .menu .savedRunConfirmOverlay .btnNeonSave,
        .menu .savedRunConfirmOverlay .btnNeonRed,
        .menu .savedRunConfirmOverlay .btnNeonGrey,
        .pauseOverlay .btnBlue,
        .pauseOverlay .btnNeonRed,
        .pauseOverlay .btnNeonSave,
        .pauseOverlay .btnNeonGrey,
        .deathOverlay .btnNeonRed,
        .deathOverlay .btnNeonYellow,
        .pauseButton,
        .menu .btnPlay.btnFocused,
        .menu #btnRumbleTest.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonSave.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonRed.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonGrey.btnFocused,
        .pauseOverlay .btnBlue.btnFocused,
        .pauseOverlay .btnNeonRed.btnFocused,
        .pauseOverlay .btnNeonSave.btnFocused,
        .pauseOverlay .btnNeonGrey.btnFocused,
        .deathOverlay .btnNeonRed.btnFocused,
        .deathOverlay .btnNeonYellow.btnFocused,
        .pauseButton.btnFocused {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.65);
            border-radius: 999px;
            letter-spacing: 0.14rem;
            box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.45), 0 0 18px currentColor, inset 0 0 16px rgba(255, 255, 255, 0.2);
            transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }

        .menu .btnPlay::after,
        .menu #btnRumbleTest::after,
        .menu .btnSettings::after,
        .menu .savedRunConfirmOverlay .btnNeonSave::after,
        .menu .savedRunConfirmOverlay .btnNeonRed::after,
        .menu .savedRunConfirmOverlay .btnNeonGrey::after,
        .pauseOverlay .btnBlue::after,
        .pauseOverlay .btnNeonRed::after,
        .pauseOverlay .btnNeonSave::after,
        .pauseOverlay .btnNeonGrey::after,
        .deathOverlay .btnNeonRed::after,
        .deathOverlay .btnNeonYellow::after,
        .pauseButton::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, transparent 25%, rgba(255, 255, 255, 0.55) 48%, transparent 70%);
            transform: translateX(-130%);
            transition: transform 0.45s ease;
            pointer-events: none;
        }

        .menu .btnPlay:hover,
        .menu #btnRumbleTest:hover,
        .menu .btnSettings:hover,
        .menu .savedRunConfirmOverlay .btnNeonSave:hover,
        .menu .savedRunConfirmOverlay .btnNeonRed:hover,
        .menu .savedRunConfirmOverlay .btnNeonGrey:hover,
        .pauseOverlay .btnBlue:hover,
        .pauseOverlay .btnNeonRed:hover,
        .pauseOverlay .btnNeonSave:hover,
        .pauseOverlay .btnNeonGrey:hover,
        .deathOverlay .btnNeonRed:hover,
        .deathOverlay .btnNeonYellow:hover,
        .pauseButton:hover,
        .menu .btnPlay.btnFocused,
        .menu #btnRumbleTest.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonSave.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonRed.btnFocused,
        .menu .savedRunConfirmOverlay .btnNeonGrey.btnFocused,
        .pauseOverlay .btnBlue.btnFocused,
        .pauseOverlay .btnNeonRed.btnFocused,
        .pauseOverlay .btnNeonSave.btnFocused,
        .pauseOverlay .btnNeonGrey.btnFocused,
        .deathOverlay .btnNeonRed.btnFocused,
        .deathOverlay .btnNeonYellow.btnFocused,
        .pauseButton.btnFocused {
            transform: translateY(-3px) scale(1.04);
            filter: brightness(1.14) saturate(1.2);
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.35), 0 0 26px currentColor, inset 0 0 20px rgba(255, 255, 255, 0.28);
        }

        .menu .btnPlay:hover::after,
        .menu #btnRumbleTest:hover::after,
        .menu .btnSettings:hover::after,
        .menu .savedRunConfirmOverlay .btnNeonSave:hover::after,
        .menu .savedRunConfirmOverlay .btnNeonRed:hover::after,
        .menu .savedRunConfirmOverlay .btnNeonGrey:hover::after,
        .pauseOverlay .btnBlue:hover::after,
        .pauseOverlay .btnNeonRed:hover::after,
        .pauseOverlay .btnNeonSave:hover::after,
        .pauseOverlay .btnNeonGrey:hover::after,
        .deathOverlay .btnNeonRed:hover::after,
        .deathOverlay .btnNeonYellow:hover::after,
        .pauseButton:hover::after,
        .menu .btnPlay.btnFocused::after,
        .menu #btnRumbleTest.btnFocused::after,
        .menu .savedRunConfirmOverlay .btnNeonSave.btnFocused::after,
        .menu .savedRunConfirmOverlay .btnNeonRed.btnFocused::after,
        .menu .savedRunConfirmOverlay .btnNeonGrey.btnFocused::after,
        .pauseOverlay .btnBlue.btnFocused::after,
        .pauseOverlay .btnNeonRed.btnFocused::after,
        .pauseOverlay .btnNeonSave.btnFocused::after,
        .pauseOverlay .btnNeonGrey.btnFocused::after,
        .deathOverlay .btnNeonRed.btnFocused::after,
        .deathOverlay .btnNeonYellow.btnFocused::after,
        .pauseButton.btnFocused::after {
            transform: translateX(130%);
        }

        .menu .btnSettings {
            position: relative;
            overflow: hidden;
        }

        .menu .btnSettings:hover {
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.35), 0 0 26px #bfbfbf, inset 0 0 20px rgba(255, 255, 255, 0.28);
        }

        .menu #btnMenuQuit {
            position: absolute;
            top: 18px;
            left: 22px;
            z-index: 1;
            display: grid;
            width: 3.25rem;
            height: 3.25rem;
            place-items: center;
            padding: 0;
            border: 1px solid rgba(255, 190, 200, 0.8);
            border-radius: 50%;
            background: linear-gradient(145deg, #ff415c, #a90026);
            color: #fff;
            box-shadow: 0 0 16px rgba(255, 0, 51, 0.8), inset 0 1px rgba(255, 255, 255, 0.38);
        }

        .menu #btnMenuQuit .buttonIcon {
            width: 1.45rem;
            height: 1.45rem;
            margin: 0;
            stroke-width: 2.6;
        }

        .menu,
        .settings,
        .pauseOverlay,
        .deathOverlay {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, rgba(0, 40, 20, 0.9), rgba(0, 0, 0, 0.95));
            pointer-events: auto;
            z-index: 10;
        }

        /* Settings becomes a full-screen interface instead of a narrow popup. */
        #settingsScreen {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            max-width: none;
            max-height: none;
            padding: 0;
            align-items: stretch;
            justify-content: stretch;
            overflow: hidden;
            background:
                radial-gradient(ellipse at 18% 0%, rgba(0, 255, 102, 0.12), transparent 48%),
                radial-gradient(ellipse at 100% 100%, rgba(0, 170, 255, 0.08), transparent 42%),
                rgba(0, 5, 3, 0.98);
        }

        .menu.menuSceneEntering>div:not(.savedRunConfirmOverlay):not(.menuActionOverlay):not(#mainQuitConfirmOverlay) {
            animation: mainMenuSceneEnter 0.72s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .settings.menuSceneEntering .settingsPanel {
            animation:
                settingsSceneEnter 0.72s cubic-bezier(0.16, 1, 0.3, 1) both,
                settingsShockwave 3s ease-in-out infinite;
        }

        @keyframes mainMenuSceneEnter {
            0% {
                opacity: 0;
                transform: translate3d(-42px, 0, 0) scale(0.96);
                filter: blur(8px);
            }

            68% {
                opacity: 1;
                transform: translate3d(5px, 0, 0) scale(1.01);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: translate3d(0, 0, 0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes settingsSceneEnter {
            0% {
                opacity: 0;
                transform: translate3d(48px, 10px, 0) scale(0.94) rotateY(-5deg);
                filter: blur(10px);
            }

            68% {
                opacity: 1;
                transform: translate3d(-5px, 0, 0) scale(1.01) rotateY(1deg);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: translate3d(0, 0, 0) scale(1) rotateY(0);
                filter: blur(0);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .menu.menuSceneEntering>div:not(.savedRunConfirmOverlay):not(.menuActionOverlay):not(#mainQuitConfirmOverlay) {
                animation: mainMenuSceneEnter 0.01ms linear both;
            }

            .settings.menuSceneEntering .settingsPanel {
                animation: settingsSceneEnter 0.01ms linear both, settingsShockwave 3s ease-in-out infinite;
            }
        }

        .batteryWidget {
            position: absolute;
            top: 18px;
            right: 22px;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            color: #9eff9e;
            font-size: 0.78rem;
            font-variant-numeric: tabular-nums;
            text-shadow: 0 0 8px currentColor;
            z-index: 1;
            pointer-events: none;
        }

        .batteryBody {
            position: relative;
            width: 42px;
            height: 19px;
            padding: 2px;
            border: 2px solid currentColor;
            border-radius: 7px;
            box-sizing: border-box;
            box-shadow: 0 0 10px currentColor, inset 0 0 6px currentColor;
        }

        .batteryBody::after {
            content: "";
            position: absolute;
            top: 5px;
            right: -5px;
            width: 3px;
            height: 7px;
            border-radius: 0 2px 2px 0;
            background: currentColor;
            box-shadow: 0 0 5px currentColor;
        }

        .batteryFill {
            width: 100%;
            height: 100%;
            border-radius: 3px;
            background: currentColor;
            box-shadow: 0 0 8px currentColor;
            transition: width 0.25s ease, background-color 0.25s ease;
        }

        .batteryWidget.battery-yellow {
            color: #ffe600;
        }

        .batteryWidget.battery-orange {
            color: #ff9f1a;
        }

        .batteryWidget.battery-red {
            color: #ff3355;
        }

        .batteryWidget.charging {
            color: #00ff66;
        }

        .batteryChargeIcon {
            display: none;
            position: absolute;
            inset: 0;
            align-items: center;
            justify-content: center;
            color: #001004;
            line-height: 1;
            text-shadow: none;
            pointer-events: none;
        }

        .batteryChargeIcon svg {
            width: 18px;
            height: 18px;
            display: block;
            fill: #00ff66;
            stroke: #000000;
            stroke-width: 1.2;
            stroke-linejoin: round;
            stroke-linecap: round;
            filter: drop-shadow(0 0 6px rgba(0, 255, 102, 0.7));
        }

        .batteryWidget.charging .batteryChargeIcon {
            display: flex;
        }

        .gameBatteryWidget {
            display: none;
            top: 18px;
            right: 22px;
        }

        .gameBatteryWidget.visible {
            display: flex;
        }

        .gameBatteryWidget.mobilePosition {
            top: auto;
            right: auto;
            left: 22px;
            bottom: 18px;
        }

        .buttonRow {
            display: flex;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .settingsPanel {
            position: relative;
            box-sizing: border-box;
            background: linear-gradient(160deg, rgba(5, 16, 18, 0.98), rgba(0, 0, 0, 0.97));
            border: 2px solid #00ff66;
            border-radius: 0;
            padding: clamp(1rem, 2.4vw, 2.25rem);
            box-shadow: 0 0 22px rgba(0, 255, 102, 0.22), inset 0 0 24px rgba(0, 255, 102, 0.06);
            width: 100%;
            max-width: none;
            height: 100%;
            max-height: none;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
            animation: settingsShockwave 3s ease-in-out infinite;
        }

        /* Wide settings layout uses the available screen space. */
        #settingsScreen .settingsPanel>* {
            max-width: 1500px;
            margin-left: auto;
            margin-right: auto;
        }

        @media (max-width: 700px) {
            #settingsScreen .settingsPanel {
                padding: 1rem 0.85rem;
            }
        }

        .settingsPanel::-webkit-scrollbar {
            width: 0;
            height: 0;
            display: none;
        }

        @keyframes settingsShockwave {

            0%,
            100% {
                box-shadow: 0 0 12px rgba(0, 255, 102, 0.25), inset 0 0 12px rgba(0, 255, 102, 0.05);
                border-color: rgba(0, 255, 102, 0.85);
            }

            25% {
                box-shadow: 0 0 16px rgba(0, 255, 102, 0.34), inset 0 0 14px rgba(0, 255, 102, 0.07);
                border-color: rgba(107, 255, 157, 0.9);
            }

            50% {
                box-shadow: 0 0 20px rgba(0, 255, 102, 0.4), inset 0 0 16px rgba(0, 255, 102, 0.09);
                border-color: rgba(184, 255, 202, 0.95);
            }

            75% {
                box-shadow: 0 0 16px rgba(0, 255, 102, 0.34), inset 0 0 14px rgba(0, 255, 102, 0.07);
                border-color: rgba(107, 255, 157, 0.9);
            }
        }

        .settingsPanel h2 {
            text-align: center;
            margin-top: 0;
            margin-bottom: 1.1rem;
            color: #dcffe9;
            text-shadow: 0 0 10px rgba(0, 255, 102, 0.55);
        }

        .settingsGroup {
            margin-bottom: 0.8rem;
            padding: 1rem;
            border: 1px solid rgba(126, 255, 184, 0.2);
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(12, 34, 29, 0.72), rgba(5, 13, 16, 0.86));
            box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
        }

        .settingsGroupTitle {
            font-size: 1.1rem;
            margin-bottom: 0.4rem;
            color: #e3fff0;
            text-shadow: 0 0 7px rgba(0, 255, 102, 0.32);
        }

        .settingsSectionHeading {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            margin-bottom: 0.85rem;
        }

        .settingsSectionHeading .settingsGroupTitle {
            margin: 0;
        }

        .settingsSectionIcon {
            display: grid;
            place-items: center;
            flex: 0 0 2.35rem;
            width: 2.35rem;
            height: 2.35rem;
            border: 1px solid rgba(0, 255, 102, 0.42);
            border-radius: 0.7rem;
            background: rgba(0, 255, 102, 0.1);
            color: #85ffb4;
            box-shadow: 0 0 12px rgba(0, 255, 102, 0.12);
        }

        .settingsSectionIcon svg {
            width: 1.25rem;
            height: 1.25rem;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        #labelGameplaySettings {
            display: table;
            margin: 0 auto 0.8rem;
            color: #ffe600;
            font-size: 1.55rem;
            line-height: 1.3;
            text-decoration: underline;
            text-decoration-thickness: 2px;
            text-underline-offset: 0.22em;
            text-shadow: 0 0 9px rgba(255, 230, 0, 0.75);
        }

        .settingsChoiceButtons {
            display: flex;
            flex-wrap: wrap;
            gap: 0.55rem;
        }

        .settingsChoiceButtons button,
        .settingsToggleButton {
            min-height: 2.75rem;
            padding: 0.5rem 0.9rem;
            border: 1px solid rgba(126, 255, 184, 0.3);
            border-radius: 0.8rem;
            background: rgba(4, 20, 16, 0.9);
            color: #e4fff0;
            cursor: pointer;
        }

        .settingsChoiceButtons button.selected,
        .settingsToggleButton[aria-pressed="true"] {
            background: rgba(0, 255, 102, 0.18);
            border-color: #65ff9e;
            color: #effff4;
            box-shadow: inset 0 0 0 1px rgba(101, 255, 158, 0.22), 0 0 12px rgba(0, 255, 102, 0.2);
        }

        .settingsToggleButton {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            width: 100%;
            text-align: left;
        }

        .settingsToggleValue {
            font-weight: bold;
            text-transform: uppercase;
        }

        .settingsColorRow {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.7rem;
            margin-top: 0.85rem;
        }

        .settingsColorRow input[type="color"] {
            width: 3rem;
            height: 2.5rem;
            padding: 0.2rem;
            border: 1px solid rgba(0, 255, 102, 0.7);
            border-radius: 0.5rem;
            background: rgba(0, 35, 18, 0.85);
            cursor: pointer;
        }

        .crosshairPreview {
            position: relative;
            display: block;
            height: 128px;
            margin: 0.65rem 0 1rem;
            overflow: hidden;
            border: 1px solid rgba(124, 255, 178, 0.32);
            border-radius: 14px;
            background:
                linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
                radial-gradient(ellipse at center, rgba(20, 40, 37, 0.85), rgba(3, 8, 12, 0.98));
            background-size: 20px 20px, 20px 20px, auto;
            box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.45);
        }

        .crosshairPreview canvas {
            position: absolute;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            background: transparent;
        }

        .settingsColorCode {
            width: 7.5rem;
            min-height: 2rem;
            padding: 0.35rem 0.55rem;
            border: 1px solid rgba(0, 255, 102, 0.55);
            border-radius: 0.45rem;
            background: rgba(0, 12, 8, 0.95);
            color: #d9ffe7;
            font: 600 0.95rem ui-monospace, Consolas, monospace;
            text-transform: uppercase;
        }

        .settingsColorCode[aria-invalid="true"] {
            border-color: #ff4b5c;
            box-shadow: 0 0 8px rgba(255, 75, 92, 0.5);
        }

        .crosshairEditorActions {
            display: flex;
            justify-content: flex-end;
            margin-top: 0.7rem;
        }

        .settingsSubsection {
            margin-top: 0.75rem;
            padding: 0.9rem;
            border: 1px solid rgba(126, 255, 184, 0.15);
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.2);
        }

        .settingsSubsectionTitle {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            margin: 0 0 0.75rem;
            color: #aaf7c7;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.035em;
        }

        .settingsSubsectionTitle svg {
            flex: 0 0 1.15rem;
            width: 1.15rem;
            height: 1.15rem;
            fill: none;
            stroke: #77ffad;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .crosshairPreviewHeader {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-top: 0.9rem;
            color: #b9fbd0;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .settingsMiniIcon {
            display: inline-grid;
            place-items: center;
            color: #7dffad;
        }

        .settingsMiniIcon svg {
            width: 1.05rem;
            height: 1.05rem;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .settingsControlRow {
            margin-bottom: 0.85rem;
        }

        .settingsControlRow:last-of-type {
            margin-bottom: 0.5rem;
        }

        .settingsControlRow .settingsGroupTitle {
            margin: 0 0 0.3rem;
            font-size: 0.95rem;
            text-shadow: none;
        }

        .settingsSubsection .volumeRow {
            margin: 0;
        }

        .settingsSubsection .volumeRow span {
            min-width: 2.25rem;
            text-align: center;
            color: #a9cbbc;
            font-variant-numeric: tabular-nums;
        }

        .settingsToggleButton+.settingsControlRow {
            margin-top: 0.85rem;
        }

        .settingsGameplayExtras .settingsToggleButton+.settingsToggleButton {
            margin-top: 0.55rem;
        }

        .settingsSectionHeading #labelGameplaySettings {
            display: block;
            margin: 0;
        }

        .fpsDescription {
            font-size: 0.75rem;
            opacity: 0.8;
            margin-top: 0.3rem;
            color: #9fd;
        }

        .perfNote {
            font-size: 0.75rem;
            opacity: 0.8;
            margin-top: 0.3rem;
            color: #fdd;
        }

        .volumeRow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 0.3rem 0;
            gap: 0.6rem;
            font-size: 0.9rem;
            color: #cfe;
        }

        .volumeRow span {
            min-width: 3.5rem;
        }

        .volumeRow input[type="range"] {
            flex: 1;
            min-width: 0;
            -webkit-appearance: none;
            appearance: none;
            height: 6px;
            border-radius: 999px;
            background: #022028;
            outline: none;
            box-shadow: 0 0 8px #00aaff;
        }

        .volumeRow input[type="range"].btnFocused {
            background: #ffffff;
            box-shadow: 0 0 10px #ffffff, 0 0 22px #00aaff;
            animation: focusedSliderPulse 0.8s ease-in-out infinite alternate;
        }

        .volumeRow input[type="range"].btnFocused::-webkit-slider-thumb {
            background: #ffffff;
            box-shadow: 0 0 10px #ffffff, 0 0 20px #00aaff;
        }

        .volumeRow input[type="range"].btnFocused::-moz-range-thumb {
            background: #ffffff;
            box-shadow: 0 0 10px #ffffff, 0 0 20px #00aaff;
        }

        @keyframes focusedSliderPulse {
            from {
                filter: brightness(0.95);
            }

            to {
                filter: brightness(1.35);
            }
        }

        .volumeRow input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #00ffcc;
            box-shadow: 0 0 10px #00ffcc;
            cursor: pointer;
        }

        .volumeRow input[type="range"]::-moz-range-thumb {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #00ffcc;
            box-shadow: 0 0 10px #00ffcc;
            cursor: pointer;
        }

        .topUI {
            position: absolute;
            top: 8px;
            left: 8px;
            right: 8px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            pointer-events: none;
            font-size: 0.9rem;
            z-index: 8;
        }

        .fpsDisplay {
            pointer-events: none;
            text-shadow: 0 0 6px #000;
            font-weight: bold;
            font-size: 0.9rem;
            letter-spacing: 0.04em;
        }

        .networkStatus {
            position: absolute;
            top: 30px;
            left: 8px;
            color: #c8f1ff;
            font-size: 0.75rem;
            line-height: 1.35;
            font-variant-numeric: tabular-nums;
            font-weight: bold;
            text-shadow: 0 0 6px #000, 0 0 10px currentColor;
            pointer-events: none;
        }

        .survivedStopwatch {
            position: absolute;
            top: 2px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
            color: #00ff66;
            font-size: 1.35rem;
            font-variant-numeric: tabular-nums;
            text-shadow: 0 0 8px #00ff66, 0 0 18px rgba(0, 255, 102, 0.8);
            font-weight: bold;
        }

        .pauseButton {
            pointer-events: auto;
            padding: 0.52rem 0.95rem;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.75);
            background: linear-gradient(135deg, #ffe779 0%, #ffc700 25%, #ff8a00 100%);
            color: #1d1200;
            font-weight: 800;
            letter-spacing: 0.16rem;
            box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.45), 0 0 18px rgba(255, 204, 0, 0.8), 0 0 28px rgba(255, 153, 0, 0.65), inset 0 0 18px rgba(255, 255, 255, 0.28);
            cursor: pointer;
            position: absolute;
            overflow: hidden;
            top: 8px;
            right: 8px;
            left: auto;
            z-index: 9;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
        }

        .explodeCooldownDisplay {
            position: absolute;
            right: 12px;
            bottom: 32px;
            z-index: 8;
            color: rgba(255, 255, 255, 0.96);
            font-family: "Trebuchet MS", "Segoe UI", sans-serif;
            font-size: 0.72rem;
            font-weight: 400;
            letter-spacing: 0.12rem;
            text-transform: uppercase;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.9), 0 0 18px rgba(255, 255, 255, 0.8);
            pointer-events: none;
            transition: bottom 0.45s ease;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }

        .abilityCooldownLine {
            padding: 2px 5px;
            border-radius: 4px;
            opacity: 0.72;
            transition: opacity 0.15s ease, background-color 0.15s ease, text-shadow 0.15s ease;
        }

        .abilityCooldownLine.selected {
            opacity: 1;
            background: rgba(0, 255, 102, 0.12);
            text-shadow: 0 0 8px currentColor, 0 0 18px currentColor;
        }

        .oxygenBarContainer {
            position: absolute;
            left: 8px;
            bottom: 16px;
            right: auto;
            top: auto;
            height: 22px;
            border-radius: 999px;
            border: 2px solid #00aaff;
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 10px rgba(0, 170, 255, 0.7);
            overflow: hidden;
            pointer-events: none;
            z-index: 8;
        }

        .oxygenBarContainer.soloOxygenBar {
            width: min(172px, 44vw);
            height: 22px;
        }

        .oxygenBarFill {
            height: 100%;
            width: 35.5%;
            background: linear-gradient(90deg, #ffffff, #e0f8ff);
            border-radius: 999px;
            transition: width 0.15s linear;
        }

        .oxygenBarFlash {
            animation: oxyFlash 0.6s infinite alternate;
            box-shadow: 0 0 16px #ff0033, 0 0 32px #ff0033;
            border-color: #ff0033 !important;
        }

        @keyframes oxyFlash {
            from {
                background-color: rgba(255, 0, 0, 0.1);
            }

            to {
                background-color: rgba(255, 0, 0, 0.4);
            }
        }

        .oxygenText {
            position: absolute;
            width: 100%;
            text-align: center;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.8rem;
            text-shadow: 0 0 6px #000;
            pointer-events: none;
        }

        .battleHealthBarContainer {
            position: absolute;
            left: 50%;
            bottom: max(12px, env(safe-area-inset-bottom));
            width: min(30%, 420px);
            min-width: min(172px, 82vw);
            height: 22px;
            transform: translateX(-50%);
            border: 2px solid #ff334f;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 10px rgba(255, 51, 79, 0.7);
            overflow: hidden;
            pointer-events: none;
            z-index: 8;
        }

        .battleHealthBarFill {
            width: 100%;
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, #ff334f, #ff8b9b);
            transition: width 0.15s linear;
        }

        .battleHealthText {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            font-size: 0.8rem;
            text-shadow: 0 0 6px #000;
            pointer-events: none;
        }

        .oxygenWarningText {
            position: absolute;
            bottom: 12px;
            right: 12px;
            font-size: 0.9rem;
            color: #ff0033;
            text-shadow: 0 0 10px #ff0033;
            pointer-events: none;
            animation: oxygenPulse 1s infinite alternate;
            z-index: 8;
        }

        @keyframes oxygenPulse {
            from {
                transform: scale(1);
                color: #ff0033;
                text-shadow: 0 0 10px #ff0033;
            }

            to {
                transform: scale(1.08);
                color: #ff5555;
                text-shadow: 0 0 18px #ff5555;
            }
        }

        .oxygenWarningSkull {
            position: absolute;
            bottom: 12px;
            right: 12px;
            font-size: 2rem;
            text-shadow: 0 0 10px #ff0033;
            pointer-events: none;
            animation: rotateSkull 1s linear infinite;
            z-index: 8;
        }

        @keyframes rotateSkull {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .fadeOverlay {
            position: absolute;
            inset: 0;
            background: #000;
            opacity: 0;
            pointer-events: none;
            z-index: 5;
            transition: opacity 0.2s linear;
        }

        .electroFlash {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 7;
            opacity: 0;
            background:
                radial-gradient(circle at var(--electro-x, 50%) var(--electro-y, 50%), rgba(235, 255, 255, .34), rgba(77, 233, 255, .14) 10%, transparent 34%),
                radial-gradient(ellipse at center, transparent 38%, rgba(32, 190, 255, .08) 100%);
        }

        .abilityScreenFx {
            position: absolute;
            inset: 0;
            z-index: 7;
            overflow: hidden;
            pointer-events: none;
        }

        .abilityScreenFx.emp-active::before,
        .abilityScreenFx.phase-active::after {
            content: "";
            position: absolute;
            inset: 0;
        }

        .abilityScreenFx.emp-active::before {
            background:
                repeating-linear-gradient(0deg, transparent 0 5px, rgba(76, 240, 255, 0.12) 6px 7px),
                linear-gradient(90deg, rgba(0, 210, 255, 0.16), transparent 12% 88%, rgba(0, 210, 255, 0.16));
            animation: empScreenGlitch 0.11s steps(2, end) 4;
        }

        .abilityScreenFx.phase-active::after {
            box-shadow: inset 0 0 42px rgba(0, 255, 160, 0.35), inset 0 0 100px rgba(0, 220, 255, 0.16);
            background: linear-gradient(90deg, rgba(0, 255, 160, 0.1), transparent 18% 82%, rgba(0, 255, 220, 0.1));
            animation: phaseScreenDistortion 1s ease-in-out infinite alternate;
        }

        @keyframes empScreenGlitch {
            0% {
                transform: translateX(-4px);
                opacity: 0.55;
            }

            50% {
                transform: translateX(4px);
                opacity: 1;
            }

            100% {
                transform: translateX(0);
                opacity: 0.72;
            }
        }

        @keyframes phaseScreenDistortion {
            from {
                opacity: 0.45;
            }

            to {
                opacity: 0.9;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .abilityScreenFx.emp-active::before,
            .abilityScreenFx.phase-active::after {
                animation: none;
            }
        }

        .oxygenVignette {
            position: absolute;
            inset: 0;
            z-index: 6;
            pointer-events: none;
            opacity: 0;
            background: radial-gradient(circle at center, transparent 62%, rgba(120, 0, 0, 0.12) 78%, rgba(255, 0, 35, 0.7) 100%);
            transition: opacity 0.9s ease-in-out;
        }

        .oxygenVignette::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, transparent 64%, rgba(255, 30, 45, 0.75) 100%);
            opacity: 0.35;
            animation: oxygenVignettePulse 0.3s ease-in-out infinite;
        }

        .oxygenVignette.active {
            opacity: 1;
        }

        @keyframes oxygenVignettePulse {

            0%,
            100% {
                opacity: 0.24;
                transform: scale(0.98);
            }

            50% {
                opacity: 0.78;
                transform: scale(1.03);
            }
        }

        .skullTransition {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at center, rgba(6, 68, 64, 0.8), rgba(0, 0, 0, 1) 62%),
                linear-gradient(180deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.9));
            pointer-events: none;
            z-index: 11;
            overflow: hidden;
        }

        .skullTransition::before,
        .skullTransition::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .skullTransition::before {
            background: repeating-linear-gradient(to bottom,
                    rgba(0, 255, 180, 0.045) 0,
                    rgba(0, 255, 180, 0.045) 1px,
                    transparent 1px,
                    transparent 5px);
            mix-blend-mode: screen;
            animation: cutsceneScan 5s linear infinite;
        }

        .skullTransition::after {
            inset: 8% 10%;
            border: 1px solid rgba(0, 255, 180, 0.12);
            clip-path: polygon(0 0, 18% 0, 18% 1px, 82% 1px, 82% 0, 100% 0, 100% 18%, calc(100% - 1px) 18%, calc(100% - 1px) 82%, 100% 82%, 100% 100%, 82% 100%, 82% calc(100% - 1px), 18% calc(100% - 1px), 18% 100%, 0 100%, 0 82%, 1px 82%, 1px 18%, 0 18%);
            box-shadow: inset 0 0 50px rgba(0, 255, 180, 0.07);
        }

        .skullIcon {
            position: relative;
            width: min(70vw, 460px);
            aspect-ratio: 1;
            opacity: 0;
            transform: scale(0.45) rotate(-18deg);
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease-out;
            filter: drop-shadow(0 0 24px rgba(0, 255, 190, 0.35));
        }

        .cutsceneVisual {
            position: absolute;
            inset: 8%;
            display: grid;
            place-items: center;
            border: 1px solid rgba(101, 255, 221, 0.28);
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 255, 190, 0.13), transparent 62%);
            box-shadow: inset 0 0 38px rgba(0, 255, 190, 0.1), 0 0 42px rgba(0, 255, 190, 0.12);
            animation: cutscenePulse 2.4s ease-in-out infinite;
        }

        .cutsceneVisual::before,
        .cutsceneVisual::after {
            content: "";
            position: absolute;
            inset: 10%;
            border: 1px solid rgba(112, 255, 229, 0.45);
            border-radius: 50%;
        }

        .cutsceneVisual::before {
            border-left-color: transparent;
            border-right-color: transparent;
            animation: cutsceneOrbit 4s linear infinite;
        }

        .cutsceneVisual::after {
            inset: 23%;
            border-color: rgba(112, 255, 229, 0.3);
            border-top-color: transparent;
            border-bottom-color: transparent;
            animation: cutsceneOrbit 2.8s linear infinite reverse;
        }

        .cutsceneRing {
            position: absolute;
            inset: 1%;
            border: 1px dashed rgba(112, 255, 229, 0.42);
            border-radius: 50%;
            animation: cutsceneOrbit 14s linear infinite;
        }

        .cutsceneCore {
            width: 24%;
            aspect-ratio: 1;
            border: 1px solid rgba(215, 255, 248, 0.9);
            background: radial-gradient(circle, #eafffa 0, #59ffe0 12%, rgba(0, 255, 190, 0.55) 38%, transparent 72%);
            box-shadow: 0 0 20px #54ffdf, 0 0 60px rgba(0, 255, 190, 0.9), 0 0 120px rgba(0, 255, 190, 0.42);
            transform: rotate(45deg);
            animation: cutsceneCore 1.8s ease-in-out infinite alternate;
        }

        .cutsceneBeam {
            position: absolute;
            left: 50%;
            top: 0;
            width: 1px;
            height: 100%;
            background: linear-gradient(transparent, rgba(164, 255, 239, 0.65), transparent);
            transform: rotate(45deg);
            box-shadow: 0 0 12px rgba(0, 255, 190, 0.7);
        }

        .cutsceneSpark {
            position: absolute;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #c8fff5;
            box-shadow: 0 0 12px 3px rgba(75, 255, 218, 0.8);
            animation: cutsceneSpark 2.4s ease-in-out infinite;
        }

        .cutsceneSpark:nth-child(4) {
            top: 17%;
            left: 24%;
            animation-delay: -0.6s;
        }

        .cutsceneSpark:nth-child(5) {
            top: 69%;
            right: 18%;
            animation-delay: -1.2s;
        }

        .cutsceneSpark:nth-child(6) {
            bottom: 13%;
            left: 33%;
            animation-delay: -1.8s;
        }

        @keyframes cutsceneScan {
            from {
                transform: translateY(-5px);
            }

            to {
                transform: translateY(5px);
            }
        }

        @keyframes cutsceneOrbit {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes cutscenePulse {
            50% {
                box-shadow: inset 0 0 54px rgba(0, 255, 190, 0.18), 0 0 70px rgba(0, 255, 190, 0.2);
            }
        }

        @keyframes cutsceneCore {
            to {
                transform: rotate(225deg) scale(0.78);
                filter: brightness(1.5);
            }
        }

        @keyframes cutsceneSpark {

            0%,
            100% {
                opacity: 0.2;
                transform: scale(0.6);
            }

            50% {
                opacity: 1;
                transform: scale(1.5);
            }
        }

        .skullIcon.show {
            opacity: 1;
            transform: scale(1) rotate(0);
        }

        .skullIcon.fade {
            opacity: 0;
            transform: scale(1.5) rotate(12deg);
        }

        .pauseOverlayContent,
        .deathOverlayContent {
            text-align: center;
            animation: zoomIn 0.4s ease-out;
        }

        .pauseOverlay:not(.hidden) {
            background: radial-gradient(circle at center, rgba(0, 90, 120, 0.34), rgba(0, 0, 0, 0.94) 72%);
            animation: pauseBackdrop 3.5s ease-in-out infinite;
        }

        .pauseOverlay::before {
            content: "";
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent 0, transparent 6px, rgba(0, 210, 255, 0.07) 7px, transparent 8px);
            opacity: 0.45;
            pointer-events: none;
            animation: pauseScan 5s linear infinite;
        }

        .pauseOverlayContent {
            position: relative;
            z-index: 1;
            padding: 2rem 2.5rem;
            border: 1px solid rgba(0, 210, 255, 0.55);
            border-radius: 28px;
            background: rgba(2, 12, 22, 0.72);
            box-shadow: 0 0 30px rgba(0, 170, 255, 0.28), inset 0 0 24px rgba(0, 170, 255, 0.12);
            animation: pauseContentIn 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.2), pauseContentFloat 4s ease-in-out 0.55s infinite;
        }

        .pauseOverlayContent .btnQuit {
            display: block;
            margin: 0.9rem auto 0;
        }

        .pauseOverlayContent #btnPauseSettings {
            display: block;
            margin: 0.9rem auto 0;
        }

        .pauseConfirmOverlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: radial-gradient(circle at center, rgba(80, 0, 14, 0.78), rgba(0, 0, 0, 0.96) 76%);
        }

        .pauseConfirmContent {
            max-width: min(92vw, 36rem);
            padding: 2rem 2.5rem;
            border: 1px solid rgba(255, 50, 75, 0.72);
            border-radius: 28px;
            background: rgba(26, 5, 12, 0.94);
            box-shadow: 0 0 30px rgba(255, 0, 51, 0.34), inset 0 0 24px rgba(255, 0, 51, 0.14);
            text-align: center;
            animation: pauseConfirmIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.2) both;
        }

        .pauseConfirmContent.exiting {
            animation: pauseConfirmOut 0.22s ease-in both;
        }

        .savedRunConfirmOverlay {
            position: absolute;
            inset: 0;
            z-index: 12;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: radial-gradient(circle at center, rgba(0, 70, 32, 0.82), rgba(0, 0, 0, 0.96) 76%);
        }

        .savedRunConfirmContent {
            max-width: min(92vw, 42rem);
            padding: 2rem 2.5rem;
            border: 1px solid rgba(0, 255, 102, 0.68);
            border-radius: 28px;
            background: rgba(2, 22, 12, 0.96);
            box-shadow: 0 0 30px rgba(0, 255, 102, 0.3), inset 0 0 24px rgba(0, 255, 102, 0.12);
            text-align: center;
            animation: pauseConfirmIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.2) both;
        }

        .savedRunConfirmContent.exiting {
            animation: pauseConfirmOut 0.22s ease-in both;
        }

        .savedRunConfirmPrompt {
            margin-bottom: 1.4rem;
            color: #d9ffe5;
            font-size: 1.2rem;
            line-height: 1.5;
            text-shadow: 0 0 12px rgba(0, 255, 102, 0.7);
            white-space: pre-line;
        }

        .savedRunConfirmButtons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
        }

        .savedRunConfirmButtons .btn {
            margin: 0.2rem;
        }

        .menuActionOverlay {
            position: absolute;
            inset: 0;
            z-index: 13;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: radial-gradient(circle at center, rgba(0, 36, 65, 0.9), rgba(0, 0, 0, 0.97) 76%);
        }

        .menuActionContent {
            width: min(92vw, 40rem);
            padding: 2rem;
            border: 1px solid rgba(0, 170, 255, 0.72);
            border-radius: 24px;
            background: rgba(2, 12, 25, 0.97);
            box-shadow: 0 0 30px rgba(0, 170, 255, 0.3), inset 0 0 24px rgba(0, 170, 255, 0.12);
            text-align: center;
        }

        .menuActionTitle {
            margin-bottom: 1rem;
            color: #c8f1ff;
            font-size: 1.35rem;
            text-shadow: 0 0 12px rgba(0, 170, 255, 0.75);
        }

        #playModeOverlay .menuActionContent {
            position: relative;
            overflow: hidden;
            width: min(92vw, 46rem);
            padding: clamp(1.5rem, 4vw, 3rem);
            border: 1px solid rgba(0, 255, 102, .72);
            border-radius: 28px;
            background: radial-gradient(ellipse at 50% 0%, rgba(0, 255, 102, .15), transparent 60%), linear-gradient(145deg, rgba(3, 18, 16, .98), rgba(1, 5, 12, .99));
            box-shadow: 0 0 0 1px rgba(0, 255, 102, .12), 0 0 45px rgba(0, 255, 102, .22), inset 0 0 35px rgba(0, 170, 255, .07);
            animation: playCardReveal .55s cubic-bezier(.16, 1, .3, 1) both;
        }

        #playModeOverlay .menuActionContent::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: .22;
            background: linear-gradient(rgba(0, 255, 102, .12) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 255, 102, .12) 1px, transparent 1px);
            background-size: 24px 24px;
            mask-image: linear-gradient(to bottom, black, transparent 85%);
        }

        #playModeTitle {
            position: relative;
            font-size: clamp(1.5rem, 4vw, 2.2rem);
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #eafff0;
            text-shadow: 0 0 10px #00ff66, 0 0 28px rgba(0, 255, 102, .5);
            margin-bottom: 1.8rem;
        }

        #playModeOverlay .menuActionButtons {
            position: relative;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin-top: 0;
        }

        #playModeOverlay .menuActionButtons .btn {
            position: relative;
            min-height: 5.2rem;
            margin: 0;
            padding: 1rem 1.2rem;
            border-radius: 16px;
            font-size: 1.05rem;
            letter-spacing: .12em;
            border: 1px solid rgba(255, 255, 255, .35);
            overflow: hidden;
            transition: transform .22s cubic-bezier(.2, .9, .25, 1.2), box-shadow .22s ease, filter .22s ease;
        }

        #playModeOverlay #btnSoloMode {
            background: linear-gradient(135deg, #a5ffbf, #00ff66 55%, #008c3b);
            color: #00190a;
            box-shadow: 0 0 22px rgba(0, 255, 102, .3), inset 0 1px rgba(255, 255, 255, .7);
        }

        #playModeOverlay #btnOnlineMode {
            background: linear-gradient(135deg, #9beaff, #00aaff 55%, #0054b8);
            color: #00121c;
            box-shadow: 0 0 22px rgba(0, 170, 255, .3), inset 0 1px rgba(255, 255, 255, .65);
        }

        #playModeOverlay #btnCancelPlayMode {
            grid-column: 1/-1;
            min-height: 3.2rem;
            background: rgba(200, 220, 225, .08);
            color: #d9f7ff;
            border: 1px solid rgba(200, 240, 255, .25);
            box-shadow: none;
        }

        #playModeOverlay .menuActionButtons .btn:hover,
        #playModeOverlay .menuActionButtons .btn.btnFocused {
            transform: translateY(-5px) scale(1.025);
            filter: brightness(1.13);
        }

        #playModeOverlay .menuActionButtons .btn::after {
            content: "";
            position: absolute;
            inset: -40% auto -40% -60%;
            width: 35%;
            transform: skewX(-20deg);
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .65), transparent);
            transition: left .55s ease;
            pointer-events: none;
        }

        #playModeOverlay .menuActionButtons .btn:hover::after,
        #playModeOverlay .menuActionButtons .btn.btnFocused::after {
            left: 130%;
        }

        @keyframes playCardReveal {
            from {
                opacity: 0;
                transform: translateY(24px) scale(.94);
                filter: blur(8px)
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0)
            }
        }

        @media(max-width:520px) {
            #playModeOverlay .menuActionButtons {
                grid-template-columns: 1fr;
            }

            #playModeOverlay #btnCancelPlayMode {
                grid-column: auto;
            }
        }

        .menuActionStatus {
            min-height: 1.5em;
            margin: 0.5rem 0 1rem;
            color: #d9f7ff;
            line-height: 1.5;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .onlineRoomCodeDisplay {
            display: grid;
            gap: 0.25rem;
            margin: 0.75rem 0;
            color: #d9f7ff;
            font-size: 0.95rem;
        }

        .onlineRoomCodeValue {
            color: #ffffff;
            font-size: clamp(2rem, 8vw, 3rem);
            font-weight: 900;
            letter-spacing: 0.28em;
            line-height: 1.2;
            text-shadow: 0 0 10px #00aaff, 0 0 24px rgba(0, 170, 255, 0.8);
        }

        .menuActionButtons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.4rem;
            margin-top: 0.75rem;
        }

        .queueModeButtons,
        .queueSizeButtons {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
            gap: 0.75rem;
            margin: 1.25rem 0;
        }

        .queueModeButtons .btn,
        .queueSizeButtons .btn {
            min-height: 3.5rem;
            margin: 0;
            border: 1px solid rgba(180, 245, 255, 0.65);
            background: linear-gradient(135deg, rgba(0, 170, 255, 0.96), rgba(0, 72, 150, 0.96));
            color: #effcff;
            box-shadow: 0 0 18px rgba(0, 170, 255, 0.48), inset 0 1px rgba(255, 255, 255, 0.24);
        }

        .queueModeButtons .btn:hover,
        .queueSizeButtons .btn:hover {
            box-shadow: 0 0 24px rgba(0, 255, 102, 0.7), inset 0 1px rgba(255, 255, 255, 0.4);
        }

        .matchLoadingOverlay {
            position: absolute;
            inset: 0;
            z-index: 25;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: radial-gradient(circle at center, rgba(0, 38, 48, 0.96), rgba(0, 3, 8, 0.99) 75%);
            text-align: center;
        }

        .matchLoadingContent {
            width: min(92vw, 38rem);
            padding: clamp(1.5rem, 5vw, 3rem);
            border: 1px solid rgba(0, 255, 102, 0.7);
            border-radius: 24px;
            background: rgba(2, 12, 25, 0.94);
            box-shadow: 0 0 34px rgba(0, 255, 102, 0.24), inset 0 0 28px rgba(0, 170, 255, 0.12);
        }

        .matchLoadingTitle {
            margin: 0 0 1rem;
            color: #b9ffd2;
            font-size: clamp(1.5rem, 5vw, 2.2rem);
            letter-spacing: 0.12em;
            text-shadow: 0 0 18px rgba(0, 255, 102, 0.72);
        }

        .matchLoadingStatus {
            min-height: 3em;
            color: #d9f7ff;
            line-height: 1.6;
            white-space: pre-line;
        }

        .matchLoadingSpinner {
            width: 3.5rem;
            height: 3.5rem;
            margin: 1.5rem auto;
            border: 4px solid rgba(0, 170, 255, 0.25);
            border-top-color: #00ff66;
            border-radius: 50%;
            box-shadow: 0 0 18px rgba(0, 255, 102, 0.5);
            animation: matchSpinner 0.9s linear infinite;
        }

        .matchLoadingCountdown {
            color: #00ff66;
            font-size: clamp(3rem, 15vw, 6rem);
            font-weight: 900;
            line-height: 1;
            text-shadow: 0 0 18px #00ff66, 0 0 40px rgba(0, 255, 102, 0.7);
        }

        .battleRoundCountdown {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 26;
            transform: translate(-50%, -50%);
            color: #f1fff5;
            font-size: clamp(5rem, 22vw, 10rem);
            font-weight: 900;
            line-height: 1;
            text-shadow: 0 0 18px #00ff66, 0 0 42px #00ff66, 0 0 84px rgba(0, 255, 102, 0.9);
            pointer-events: none;
            animation: battleCountdownPulse 0.9s ease-in-out infinite alternate;
        }

        @keyframes battleCountdownPulse {
            to {
                transform: translate(-50%, -50%) scale(1.12);
            }
        }

        @keyframes matchSpinner {
            to {
                transform: rotate(360deg);
            }
        }

        .matchHud {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 22;
            transform: translate(-50%, -50%);
            width: min(92vw, 34rem);
            max-height: min(78vh, 42rem);
            overflow-y: auto;
            padding: 0.9rem;
            border: 1px solid rgba(0, 170, 255, 0.8);
            border-radius: 18px;
            background: rgba(0, 8, 16, 0.94);
            box-shadow: 0 0 28px rgba(0, 170, 255, 0.5), inset 0 0 20px rgba(0, 170, 255, 0.12);
            color: #d9f7ff;
            font-size: 1rem;
            text-align: center;
            pointer-events: none;
            white-space: pre-line;
        }

        .battleHud {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: 1fr;
        }

        #battleHudRound {
            color: #e9fbff;
            font-size: 1.2rem;
            font-weight: 900;
            text-shadow: 0 0 12px rgba(0, 170, 255, 0.8);
        }

        .battleHudTeams {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.65rem;
            text-align: left;
        }

        .battleHudTeam {
            min-width: 0;
            padding: 0.65rem 0.8rem;
            border: 1px solid var(--team-color);
            border-radius: 12px;
            color: var(--team-color);
            box-shadow: 0 0 12px var(--team-color);
        }

        .battleHudTeamHeader {
            display: flex;
            justify-content: space-between;
            gap: 0.4rem;
            margin-bottom: 0.45rem;
            font-weight: 900;
        }

        .battleHudTeamPlayers {
            display: grid;
            gap: 0.3rem;
            color: #f4fbff;
            font-size: 0.9rem;
        }

        .battleHudPlayer {
            display: inline-flex;
            align-items: center;
            gap: 0.15rem;
            white-space: nowrap;
        }

        .battleHudPlayer.eliminated {
            opacity: 0.48;
            text-decoration: line-through;
        }

        .battleDisconnectIcon {
            width: 0.95rem;
            height: 0.95rem;
            color: #ff6275;
            filter: drop-shadow(0 0 4px #ff0033);
        }

        .battleEliminatedNotice {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 20;
            width: min(90vw, 34rem);
            padding: 1rem 1.4rem;
            transform: translate(-50%, -50%);
            border: 1px solid rgba(255, 51, 79, 0.8);
            border-radius: 14px;
            background: rgba(10, 0, 5, 0.88);
            box-shadow: 0 0 24px rgba(255, 51, 79, 0.4);
            color: #ff6275;
            text-align: center;
            pointer-events: none;
        }

        .battleEliminatedTitle {
            margin: 0 0 0.35rem;
            font-size: clamp(1.1rem, 4vw, 1.7rem);
            font-weight: 900;
        }

        .battleEliminatedWaiting {
            color: #ffe8eb;
            font-size: clamp(0.85rem, 3vw, 1rem);
        }

        .battleResultOverlay {
            position: absolute;
            inset: 0;
            z-index: 24;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(0, 4, 10, 0.88);
            text-align: center;
        }

        .battleResultContent {
            width: min(92vw, 36rem);
            padding: clamp(1.5rem, 5vw, 3rem);
            border: 2px solid currentColor;
            border-radius: 24px;
            background: rgba(2, 12, 25, 0.98);
            box-shadow: 0 0 36px currentColor, inset 0 0 24px rgba(0, 170, 255, 0.12);
            color: #f5f7fa;
        }

        .battleResultContent.won {
            color: #00ff66;
            box-shadow: 0 0 36px rgba(0, 255, 102, 0.55), inset 0 0 24px rgba(0, 255, 102, 0.12);
        }

        .battleResultContent.lost {
            color: #ff334f;
            box-shadow: 0 0 36px rgba(255, 51, 79, 0.55), inset 0 0 24px rgba(255, 51, 79, 0.12);
        }

        .battleResultTitle {
            margin: 0 0 1rem;
            color: currentColor;
            font-size: clamp(2rem, 8vw, 4rem);
            font-weight: 900;
            letter-spacing: 0.08em;
            text-shadow: 0 0 20px currentColor;
        }

        .battleResultScore {
            margin: 0 0 1.5rem;
            color: #eafff2;
            font-size: 1.25rem;
            line-height: 1.6;
            white-space: pre-line;
        }

        .roomCodeInput {
            width: min(16rem, 70vw);
            padding: 0.8rem 1rem;
            border: 1px solid #00aaff;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.72);
            color: #fff;
            font-size: 1.2rem;
            letter-spacing: 0.2rem;
            text-align: center;
            text-transform: uppercase;
        }

        #gameContainer.controllerMode .roomCodeInput.btnFocused {
            outline: 2px solid rgba(0, 255, 102, 0.7);
            outline-offset: 3px;
            box-shadow: 0 0 0 2px rgba(0, 255, 102, 0.18), 0 0 16px rgba(0, 255, 102, 0.65);
        }

        .pauseConfirmPrompt {
            margin-bottom: 1.4rem;
            color: #ffe5e9;
            font-size: 1.35rem;
            text-shadow: 0 0 12px rgba(255, 0, 51, 0.8);
        }

        .pauseConfirmButtons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
        }

        .pauseConfirmButtons .btn {
            margin: 0.2rem;
        }

        @keyframes pauseBackdrop {

            0%,
            100% {
                background-position: 50% 50%;
                filter: brightness(0.92);
            }

            50% {
                background-position: 50% 42%;
                filter: brightness(1.08);
            }
        }

        @keyframes pauseScan {
            from {
                transform: translateY(-12px);
            }

            to {
                transform: translateY(12px);
            }
        }

        @keyframes pauseContentIn {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.9);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes pauseContentFloat {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        @keyframes pauseConfirmIn {
            from {
                opacity: 0;
                transform: scale(0.72);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes pauseConfirmOut {
            from {
                opacity: 1;
                transform: scale(1);
            }

            to {
                opacity: 0;
                transform: scale(0.72);
            }
        }

        @keyframes zoomIn {
            from {
                transform: scale(0.7);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .pauseTitle {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #b8f3ff;
            text-shadow: 0 0 10px #00aaff, 0 0 28px #00aaff;
            animation: pauseTitlePulse 1.8s ease-in-out infinite;
        }

        @keyframes pauseTitlePulse {

            0%,
            100% {
                letter-spacing: 0.12rem;
                opacity: 0.88;
            }

            50% {
                letter-spacing: 0.24rem;
                opacity: 1;
            }
        }

        .progressText {
            font-size: 1rem;
            margin-bottom: 1rem;
            color: #b9eaff;
            opacity: 0.86;
        }

        .deathTitle {
            position: relative;
            display: inline-block;
            max-width: 92vw;
            padding: .16em .42em;
            font-size: clamp(2.35rem, 7vw, 4.5rem);
            line-height: .98;
            text-wrap: balance;
            color: #ff0033;
            text-shadow: 0 0 14px #ff0033, 0 0 34px #ff0033, 0 0 70px rgba(255, 0, 51, .5);
            margin: 0 0 .75rem;
            letter-spacing: .06em;
            opacity: 0;
            transform: translateY(34px) scale(.72);
            filter: blur(12px);
        }

        .deathTitle::before,
        .deathTitle::after {
            content: "";
            position: absolute;
            top: 50%;
            width: .34em;
            height: .34em;
            border: 2px solid currentColor;
            pointer-events: none;
        }

        .deathTitle::before {
            left: 0;
            border-right: 0;
            border-bottom: 0;
            transform: translate(-35%, -50%);
        }

        .deathTitle::after {
            right: 0;
            border-left: 0;
            border-top: 0;
            transform: translate(35%, -50%);
        }

        .deathTitle.show {
            opacity: 1;
            animation:
                deathTitleEnter 1.15s .08s cubic-bezier(.16, 1, .3, 1) both,
                deathTitleGlow 1.5s 1.25s ease-in-out infinite alternate;
        }

        .deathTitle.electrocuted {
            color: #ffe600;
            text-shadow: 0 0 10px #fff, 0 0 22px #ffe600, 0 0 52px #00d9ff;
        }

        .deathTitle.electrocuted::before,
        .deathTitle.electrocuted::after {
            top: -.24em;
            left: -.22em;
            width: calc(100% + .44em);
            height: calc(100% + .48em);
            opacity: 0;
            border: 0;
            background:
                radial-gradient(circle, #fff 0 1px, #79f5ff 1.5px, transparent 4px) 2% 18% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #79f5ff 1.5px, transparent 4px) 18% 0 / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #ffe600 1.5px, transparent 4px) 44% 4% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #79f5ff 1.5px, transparent 4px) 72% 0 / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #ffe600 1.5px, transparent 4px) 98% 20% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #79f5ff 1.5px, transparent 4px) 100% 76% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #ffe600 1.5px, transparent 4px) 70% 100% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #79f5ff 1.5px, transparent 4px) 28% 100% / 8px 8px no-repeat,
                radial-gradient(circle, #fff 0 1px, #ffe600 1.5px, transparent 4px) 0 74% / 8px 8px no-repeat;
            filter: drop-shadow(0 0 5px #fff) drop-shadow(0 0 12px #00d9ff);
        }

        .deathTitle.electrocuted::before {
            animation: deathTextSpark .38s steps(2, end) infinite;
        }

        .deathTitle.electrocuted::after {
            transform: scale(.88) rotate(12deg);
            animation: deathTextSpark .31s .13s steps(2, end) infinite reverse;
        }

        .deathOverlay::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0;
            background:
                radial-gradient(ellipse at center, rgba(28, 0, 6, .18), rgba(0, 0, 0, .94) 76%),
                radial-gradient(circle at center, transparent 0 12%, rgba(255, 0, 51, .24) 12.3% 12.6%, transparent 13% 28%, rgba(255, 0, 51, .12) 28.3% 28.5%, transparent 29%);
        }

        .deathOverlay:not(.hidden)::before {
            animation: deathBackdropEnter .85s ease-out both;
        }

        .deathOverlay.electrocutedDeath::before {
            background:
                radial-gradient(ellipse at center, rgba(14, 24, 21, .22), rgba(0, 0, 0, .94) 76%),
                radial-gradient(circle at center, transparent 0 12%, rgba(0, 217, 255, .36) 12.3% 12.6%, transparent 13% 28%, rgba(255, 230, 0, .18) 28.3% 28.5%, transparent 29%);
        }

        .deathSurvived {
            font-size: 1.2rem;
            margin-bottom: 1rem;
            color: #9eff9e;
            text-shadow: 0 0 12px #00ff66, 0 0 24px #00ff66;
            opacity: 0;
            transform: scale(0.9);
            text-align: center;
            animation: deathSurvivedPulse 1.2s infinite alternate;
            transition: opacity 0.4s ease-out, transform 0.4s ease-out;
        }

        .deathSurvived.show {
            opacity: 1;
            transform: scale(1);
        }

        .deathOrbReward {
            min-height: 1.5em;
            margin: -0.65rem 0 1.1rem;
            color: #a8fff0;
            font-size: 1.25rem;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-align: center;
            text-shadow: 0 0 12px #00ffcc, 0 0 28px rgba(0, 255, 204, 0.9);
            opacity: 0;
            transform: translateY(-4px);
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        .deathOrbReward.show {
            opacity: 1;
            transform: translateY(0);
        }

        .deathOrbCanvas {
            position: absolute;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .deathOverlayContent {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .deathOverlay:not(.hidden) .deathOverlayContent {
            animation: deathPanelEnter .8s .04s cubic-bezier(.16, 1, .3, 1) both;
        }

        @keyframes deathSurvivedPulse {
            from {
                transform: scale(1);
                text-shadow: 0 0 12px #00ff66, 0 0 24px #00ff66;
            }

            to {
                transform: scale(1.06);
                text-shadow: 0 0 20px #00ff66, 0 0 36px #00ff66;
            }
        }

        .deathButtons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 1rem;
            opacity: 1;
            transform: none;
        }

        .deathOverlay:not(.hidden) .deathButtons .btn {
            opacity: 0;
            animation: deathButtonEnter .68s cubic-bezier(.16, 1, .3, 1) both;
        }

        .deathOverlay:not(.hidden) .deathButtons .btn:nth-child(1) {
            animation-delay: .75s;
        }

        .deathOverlay:not(.hidden) .deathButtons .btn:nth-child(2) {
            animation-delay: .9s;
        }

        .deathOverlay:not(.hidden) .deathButtons .btn:nth-child(3) {
            animation-delay: 1.05s;
        }

        @keyframes deathBackdropEnter {
            0% {
                opacity: 0;
                transform: scale(1.12);
            }

            55% {
                opacity: 1;
                transform: scale(.99);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes deathPanelEnter {
            0% {
                opacity: 0;
                transform: perspective(900px) translateY(42px) rotateX(10deg) scale(.88);
                filter: blur(10px);
            }

            65% {
                opacity: 1;
                transform: perspective(900px) translateY(-5px) rotateX(-1deg) scale(1.015);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: perspective(900px) translateY(0) rotateX(0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes deathTitleEnter {
            0% {
                opacity: 0;
                transform: perspective(700px) rotateX(42deg) translateY(38px) scale(.7);
                filter: blur(14px) brightness(2.4);
                clip-path: inset(0 50% 0 50%);
            }

            58% {
                opacity: 1;
                transform: perspective(700px) rotateX(-6deg) translateY(-5px) scale(1.055);
                filter: blur(0) brightness(1.8);
                clip-path: inset(-8% -6% -8% -6%);
            }

            78% {
                transform: perspective(700px) rotateX(2deg) scale(.99);
                filter: brightness(1.12);
            }

            100% {
                opacity: 1;
                transform: perspective(700px) rotateX(0) translateY(0) scale(1);
                filter: brightness(1);
                clip-path: inset(-8% -6% -8% -6%);
            }
        }

        @keyframes deathTitleGlow {
            from {
                text-shadow: 0 0 12px currentColor, 0 0 28px currentColor;
            }

            to {
                text-shadow: 0 0 22px currentColor, 0 0 48px currentColor, 0 0 80px rgba(255, 0, 51, .38);
            }
        }

        @keyframes deathButtonEnter {
            0% {
                opacity: 0;
                transform: translateY(34px) scale(.82);
                filter: blur(7px);
            }

            72% {
                opacity: 1;
                transform: translateY(-4px) scale(1.04);
                filter: blur(0);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes deathTextSpark {

            0%,
            62%,
            100% {
                opacity: 0;
            }

            14%,
            28% {
                opacity: 1;
            }
        }

        @media (max-width: 650px) {
            .deathTitle {
                font-size: clamp(1.9rem, 8vw, 3.2rem);
            }

            .deathButtons {
                gap: .55rem;
                flex-wrap: wrap;
                padding: 0 1rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .deathOverlay:not(.hidden)::before,
            .deathOverlay:not(.hidden) .deathOverlayContent,
            .deathOverlay:not(.hidden) .deathButtons .btn,
            .deathTitle.show,
            .deathTitle.electrocuted::before,
            .deathTitle.electrocuted::after {
                animation-duration: .01ms !important;
                animation-delay: 0ms !important;
            }

            .deathOverlay:not(.hidden)::before {
                opacity: 1;
                transform: none;
            }

            .deathTitle.show,
            .deathOverlay:not(.hidden) .deathButtons .btn {
                opacity: 1;
                filter: none;
                clip-path: none;
            }
        }

        .joystickBase,
        .joystickStick {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            z-index: 9;
