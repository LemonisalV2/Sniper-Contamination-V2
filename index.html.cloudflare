        .shootButton {
            position: absolute;
            right: 18px;
            bottom: 38px;
            z-index: 10;
            display: none;
            width: 72px;
            height: 72px;
            padding: 0;
            border: 2px solid rgba(190, 240, 255, 0.82);
            border-radius: 50%;
            background: radial-gradient(circle at 32% 24%, rgba(225, 250, 255, 0.3), rgba(8, 75, 105, 0.94) 46%, rgba(2, 17, 30, 0.98) 100%);
            box-shadow: 0 0 0 3px rgba(120, 225, 255, 0.16), 0 0 20px rgba(0, 190, 255, 0.68), inset 0 0 14px rgba(200, 245, 255, 0.18);
            color: #d6f8ff;
            -webkit-tap-highlight-color: transparent;
