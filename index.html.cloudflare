                crosshairReset: [btnResetCrosshair],
                toggleSprint: [btnToggleSprintSetting],
                showBatteryInGame: [btnShowBatterySetting]
            };

            const GAME_SAVE_STORAGE_KEY = 'sniper-contamination-saved-run';
            const SAVED_ENTITY_ARRAYS = {
                greenSnipers,
                redSnipers,
                orangeSnipers,
                purpleTriangleSnipers,
                blueSnipers,
                yellowStarSnipers,
                oxygenOrbs,
                sniperRewardOrbs,
                sniperRewardBurstOrbs,
                bullets,
                debrisPieces,
                shockwaves
            };

            function isValidSavedRun(savedRun) {
                return savedRun
                    && (savedRun.version === 1 || savedRun.version === 2 || savedRun.version === 3 || savedRun.version === 4)
                    && savedRun.player
                    && Object.keys(player).every(key => typeof savedRun.player[key] === typeof player[key]
                        && (typeof player[key] !== 'number' || Number.isFinite(savedRun.player[key])))
                    && savedRun.entities
                    && Object.keys(SAVED_ENTITY_ARRAYS).every(key => (
                        savedRun.version < 3 && key === 'sniperRewardOrbs' && savedRun.entities[key] === undefined
                    ) || (
                            savedRun.version < 4 && key === 'sniperRewardBurstOrbs' && savedRun.entities[key] === undefined
                        ) || (
                            Array.isArray(savedRun.entities[key])
                            && savedRun.entities[key].every(item => item && typeof item === 'object' && !Array.isArray(item))
                        ))
                    && (!savedRun.sniperCounts || (
                        Object.values(savedRun.sniperCounts).every(count => Number.isInteger(count) && count >= 0)
                        && savedRun.sniperCounts.green === savedRun.entities.greenSnipers.length
                        && savedRun.sniperCounts.red === savedRun.entities.redSnipers.length
                        && savedRun.sniperCounts.orange === savedRun.entities.orangeSnipers.length
                        && savedRun.sniperCounts.purpleTriangle === savedRun.entities.purpleTriangleSnipers.length
                        && savedRun.sniperCounts.blue === savedRun.entities.blueSnipers.length
                        && savedRun.sniperCounts.yellowStar === savedRun.entities.yellowStarSnipers.length
                    ))
                    && savedRun.timers
                    && Object.values(savedRun.timers).every(Number.isFinite)
                    && savedRun.values
                    && [
                        'oxygen', 'oxygenLossStartTime', 'fadeProgress', 'elapsedGameTime', 'stamina',
                        'playerShotCooldown', 'explodeCooldown', 'aimX', 'aimY', 'lastMoveDirX',
                        'lastMoveDirY', 'touchDeathTimer', 'electroFlashTimer'
                    ].every(key => Number.isFinite(savedRun.values[key]))
                    && ['empCooldown', 'phaseCooldown', 'phaseShiftTimer', 'empScreenTimer']
                        .every(key => savedRun.values[key] === undefined || Number.isFinite(savedRun.values[key]))
                    && (savedRun.values.selectedAbility === undefined
                        || (Number.isInteger(savedRun.values.selectedAbility)
                            && savedRun.values.selectedAbility >= 0
                            && savedRun.values.selectedAbility <= (savedRun.version === 1 ? 2 : 3)))
                    && (savedRun.values.oxygenLossElapsed === undefined
                        || Number.isFinite(savedRun.values.oxygenLossElapsed))
                    && ['oxygenLoss', 'sprinting', 'mobileSprintToggleEnabled', 'controllerAimActive',
                        'touchDeathActive', 'touchBreakTriggered'].every(key => typeof savedRun.values[key] === 'boolean')
                    && typeof savedRun.values.deathCause === 'string'
                    && Number.isFinite(savedRun.canvasWidth)
                    && Number.isFinite(savedRun.canvasHeight)
                    && savedRun.canvasWidth > 0
                    && savedRun.canvasHeight > 0
                    && typeof savedRun.mobileMode === 'boolean'
                    && typeof savedRun.inputMethod === 'string';
            }

            function getSavedRun() {
                let serialized;
                try {
                    serialized = localStorage.getItem(GAME_SAVE_STORAGE_KEY);
                } catch (error) {
                    console.error('Unable to read the saved run.', error);
                    return null;
                }
                if (!serialized) return null;

                try {
                    const savedRun = JSON.parse(serialized);
                    if (isValidSavedRun(savedRun)) {
                        if (savedRun.version === 1) {
                            savedRun.values.selectedAbility = (savedRun.values.selectedAbility ?? 0) + 1;
                            savedRun.version = 2;
                        }
                        if (savedRun.version === 2) {
                            savedRun.entities.sniperRewardOrbs = [];
                            savedRun.version = 3;
                        }
                        if (savedRun.version === 3) {
                            savedRun.entities.sniperRewardBurstOrbs = [];
                            savedRun.version = 4;
                        }
                        if (!Number.isFinite(savedRun.values.oxygenLossElapsed)) {
                            savedRun.values.oxygenLossElapsed = savedRun.values.oxygenLoss
                                ? savedRun.values.elapsedGameTime - savedRun.values.oxygenLossStartTime
                                : 0;
                        }
                        return savedRun;
                    }
                    console.error('The saved run has an unsupported or invalid format.');
                } catch (error) {
                    console.error('Unable to parse the saved run.', error);
                }
                try {
                    localStorage.removeItem(GAME_SAVE_STORAGE_KEY);
                } catch (error) {
                    console.error('Unable to remove the invalid saved run.', error);
                }
                return null;
            }

            function captureGameState() {
                return {
                    version: 4,
                    canvasWidth: canvas.width,
                    canvasHeight: canvas.height,
                    player: { ...player },
                    entities: Object.fromEntries(Object.entries(SAVED_ENTITY_ARRAYS).map(([key, items]) => [
                        key,
                        items.map(item => ({ ...item }))
                    ])),
                    sniperCounts: {
                        green: greenSnipers.length,
                        red: redSnipers.length,
                        orange: orangeSnipers.length,
                        purpleTriangle: purpleTriangleSnipers.length,
                        blue: blueSnipers.length,
                        yellowStar: yellowStarSnipers.length
                    },
                    timers: {
                        greenSpawnTimer,
                        redSpawnTimer,
                        orangeSpawnTimer,
                        purpleSpawnTimer,
                        blueSpawnTimer,
                        yellowSpawnTimer,
                        orbSpawnTimer
                    },
                    values: {
                        oxygen,
                        oxygenLoss,
                        oxygenLossStartTime,
                        oxygenLossElapsed: oxygenLoss ? elapsedGameTime - oxygenLossStartTime : 0,
                        fadeProgress,
                        deathCause,
                        elapsedGameTime,
                        stamina,
                        sprinting,
                        mobileSprintToggleEnabled,
                        playerShotCooldown,
                        explodeCooldown,
                        empCooldown,
                        phaseCooldown,
                        phaseShiftTimer,
                        empScreenTimer,
                        selectedAbility,
                        aimX,
                        aimY,
                        controllerAimActive,
                        lastMoveDirX,
                        lastMoveDirY,
                        touchDeathActive,
                        touchDeathTimer,
                        touchBreakTriggered,
                        electroFlashTimer
                    },
                    mobileMode,
                    inputMethod: lastInputMethod
                };
            }

            function saveCurrentRun() {
                try {
                    localStorage.setItem(GAME_SAVE_STORAGE_KEY, JSON.stringify(captureGameState()));
                    return true;
                } catch (error) {
                    console.error('Unable to save the current run.', error);
                    const message = (QUIT_TEXT[language] || QUIT_TEXT.en)[5];
                    window.alert(message);
                    return false;
                }
            }

            function clearSavedRun() {
                try {
                    localStorage.removeItem(GAME_SAVE_STORAGE_KEY);
                    return true;
                } catch (error) {
                    console.error('Unable to remove the saved run.', error);
                    window.alert((QUIT_TEXT[language] || QUIT_TEXT.en)[5]);
                    return false;
                }
            }

            function restoreGameState(savedRun) {
                Object.assign(player, savedRun.player);
                const scaleX = canvas.width / savedRun.canvasWidth;
                const scaleY = canvas.height / savedRun.canvasHeight;
                player.x *= scaleX;
                player.y *= scaleY;
                player.vx *= scaleX;
                player.vy *= scaleY;
                player.knockVx *= scaleX;
                player.knockVy *= scaleY;
                player.knockImpulseX *= scaleX;
                player.knockImpulseY *= scaleY;
                Object.entries(SAVED_ENTITY_ARRAYS).forEach(([key, items]) => {
                    const savedItems = savedRun.entities[key].map(item => {
                        const restored = { ...item };
                        if (Number.isFinite(restored.x)) restored.x *= scaleX;
                        if (Number.isFinite(restored.y)) restored.y *= scaleY;
                        if (Number.isFinite(restored.vx)) restored.vx *= scaleX;
                        if (Number.isFinite(restored.vy)) restored.vy *= scaleY;
                        const maxHp = SNIPER_MAX_HP_BY_ENTITY_KEY[key];
                        if (maxHp) {
                            const previousMaxHp = Number.isFinite(restored.maxHp) && restored.maxHp > 0
                                ? restored.maxHp
                                : maxHp;
                            const previousHp = Number.isFinite(restored.hp) ? restored.hp : previousMaxHp;
                            restored.maxHp = maxHp;
                            restored.hp = Math.max(1, Math.min(maxHp, Math.ceil(previousHp / previousMaxHp * maxHp)));
                        }
                        return restored;
                    });
                    items.splice(0, items.length, ...savedItems);
                });
                greenSpawnTimer = savedRun.timers.greenSpawnTimer;
                redSpawnTimer = savedRun.timers.redSpawnTimer;
                orangeSpawnTimer = savedRun.timers.orangeSpawnTimer;
                purpleSpawnTimer = savedRun.timers.purpleSpawnTimer;
                blueSpawnTimer = savedRun.timers.blueSpawnTimer;
                yellowSpawnTimer = savedRun.timers.yellowSpawnTimer;
                orbSpawnTimer = savedRun.timers.orbSpawnTimer;
                oxygen = savedRun.values.oxygen;
                oxygenLoss = savedRun.values.oxygenLoss;
                elapsedGameTime = savedRun.values.elapsedGameTime;
                oxygenLossStartTime = oxygenLoss
                    ? elapsedGameTime - savedRun.values.oxygenLossElapsed
                    : savedRun.values.oxygenLossStartTime;
                fadeProgress = savedRun.values.fadeProgress;
                deathCause = savedRun.values.deathCause;
                stamina = savedRun.values.stamina;
                sprinting = savedRun.values.sprinting;
                mobileSprintToggleEnabled = savedRun.values.mobileSprintToggleEnabled;
                playerShotCooldown = savedRun.values.playerShotCooldown;
                explodeCooldown = savedRun.values.explodeCooldown;
                empCooldown = Number.isFinite(savedRun.values.empCooldown) ? savedRun.values.empCooldown : 0;
                phaseCooldown = Number.isFinite(savedRun.values.phaseCooldown) ? savedRun.values.phaseCooldown : 0;
                phaseShiftTimer = Number.isFinite(savedRun.values.phaseShiftTimer) ? savedRun.values.phaseShiftTimer : 0;
                empScreenTimer = Number.isFinite(savedRun.values.empScreenTimer) ? savedRun.values.empScreenTimer : 0;
                selectedAbility = Number.isInteger(savedRun.values.selectedAbility) ? savedRun.values.selectedAbility : 0;
                aimX = savedRun.values.aimX * scaleX;
                aimY = savedRun.values.aimY * scaleY;
                controllerAimActive = savedRun.values.controllerAimActive;
                lastMoveDirX = savedRun.values.lastMoveDirX;
                lastMoveDirY = savedRun.values.lastMoveDirY;
                touchDeathActive = savedRun.values.touchDeathActive;
                touchDeathTimer = savedRun.values.touchDeathTimer;
                touchBreakTriggered = savedRun.values.touchBreakTriggered;
                electroFlashTimer = savedRun.values.electroFlashTimer;
                mobileMode = savedRun.mobileMode;
                lastInputMethod = savedRun.inputMethod;
            }

            function updateCursorVisibility() {
                const showingBattleMatchResult = !battleResultOverlay.classList.contains('hidden');
                gameContainer.classList.toggle('playing', running && !paused && !dead && !showingBattleMatchResult);
            }

            function getLocalizedNumber(value, options = {}) {
                const locale = language === 'ar' ? 'ar-EG' : 'en-US';
                const numericValue = Number(value);
                const defaultMax = Number.isInteger(numericValue) ? 0 : 1;
                const defaultMin = Number.isInteger(numericValue) ? 0 : 1;
                const maximumFractionDigits = Number.isFinite(options.maximumFractionDigits)
                    ? Math.min(20, Math.max(0, Number(options.maximumFractionDigits)))
                    : defaultMax;
                const minimumFractionDigits = Number.isFinite(options.minimumFractionDigits)
                    ? Math.min(maximumFractionDigits, Math.max(0, Number(options.minimumFractionDigits)))
                    : Math.min(maximumFractionDigits, defaultMin);

                return new Intl.NumberFormat(locale, {
                    ...options,
                    maximumFractionDigits,
                    minimumFractionDigits
                }).format(numericValue);
            }

            function getBatteryStatusMessage(type, percent) {
                const t = LANG[language] || LANG.en;
                const template = type === 'charging'
                    ? (t.batteryCharging || LANG.en.batteryCharging)
                    : (t.batteryChargerRemoved || LANG.en.batteryChargerRemoved);
                return template.replace('{percent}', getLocalizedNumber(percent, { maximumFractionDigits: 0 }));
            }

            function isLocalGameHost(hostname) {
                if (!hostname) return false;
                const host = hostname.toLowerCase();
                if (host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0' || host === '::1') return true;
                return host.startsWith('10.') || host.startsWith('192.168.') || host.startsWith('172.16.') || host.startsWith('172.17.') || host.startsWith('172.18.') || host.startsWith('172.19.') || host.startsWith('172.20.') || host.startsWith('172.21.') || host.startsWith('172.22.') || host.startsWith('172.23.') || host.startsWith('172.24.') || host.startsWith('172.25.') || host.startsWith('172.26.') || host.startsWith('172.27.') || host.startsWith('172.28.') || host.startsWith('172.29.') || host.startsWith('172.30.') || host.startsWith('172.31.') || host.startsWith('172.32.');
            }

            function getOnlineText(key, params = {}) {
                const translations = ONLINE_TEXT[language] || ONLINE_TEXT.en;
                const modeText = ONLINE_MODE_TEXT[language];
                const modeTextIndex = ONLINE_MODE_TEXT_KEYS.indexOf(key);
                const queueText = ONLINE_QUEUE_TEXT[language];
                const queueTextIndex = ONLINE_QUEUE_TEXT_KEYS.indexOf(key);
                const queueErrorText = ONLINE_QUEUE_ERROR_TEXT[language];
                const queueErrorTextIndex = ONLINE_QUEUE_ERROR_TEXT_KEYS.indexOf(key);
                let template = (BATTLE_TEXT[language] && BATTLE_TEXT[language][key])
                    || (modeTextIndex >= 0 && modeText && modeText[modeTextIndex])
                    || (queueTextIndex >= 0 && queueText && queueText[queueTextIndex])
                    || (queueErrorTextIndex >= 0 && queueErrorText && queueErrorText[queueErrorTextIndex])
                    || translations[key] || ONLINE_TEXT.en[key] || key;
                if (key === 'battleMainMenu' && !(BATTLE_TEXT[language] && BATTLE_TEXT[language][key])) {
                    template = (LANG[language] || LANG.en).mainMenu || ONLINE_TEXT.en.battleMainMenu;
                } else if (key === 'battleFinalScore'
                    && !(BATTLE_TEXT[language] && BATTLE_TEXT[language][key])) {
                    template = '{you} â€” {opponent}';
                }
                return template.replace(/\{(\w+)\}/g, (match, name) =>
                    Object.prototype.hasOwnProperty.call(params, name) ? params[name] : match);
            }

            const MENU_BRANDING_TRANSLATIONS = {
