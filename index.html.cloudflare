            const SETTINGS_STORAGE_KEY = 'sniper-contamination-settings';
            function saveSettings() {
                try {
                    localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify({
                        language,
                        performanceMode,
                        volLow,
                        volMid,
                        volHigh,
                        graphicsQuality,
                        crosshairStyle,
                        crosshairColor,
                        crosshairSize,
                        crosshairThickness,
                        crosshairGap,
                        crosshairOpacity,
                        crosshairOutline,
                        crosshairOutlineThickness,
                        crosshairCenterDot,
                        toggleSprint,
                        showBatteryInGame
                    }));
                } catch (error) { }
            }
            function loadSettings() {
                try {
                    const saved = JSON.parse(localStorage.getItem(SETTINGS_STORAGE_KEY) || '{}');
                    if (saved.language && LANG[saved.language]) language = saved.language;
                    if (saved.performanceMode === 'power' || saved.performanceMode === 'performance') {
                        performanceMode = saved.performanceMode;
                    }
                    if (['cross', 'dot', 'circle'].includes(saved.crosshairStyle)) crosshairStyle = saved.crosshairStyle;
                    const legacyCrosshairColors = {
                        green: '#00ff66',
                        white: '#ffffff',
                        cyan: '#00ffff',
                        yellow: '#ffe600'
                    };
                    if (typeof saved.crosshairColor === 'string'
                        && (/^#[\da-f]{6}$/i.test(saved.crosshairColor) || legacyCrosshairColors[saved.crosshairColor])) {
                        crosshairColor = legacyCrosshairColors[saved.crosshairColor] || saved.crosshairColor;
                    }
                    if (Number.isFinite(saved.crosshairSize)) {
                        crosshairSize = Math.max(8, Math.min(32, Math.round(saved.crosshairSize)));
                    }
                    if (Number.isFinite(saved.crosshairThickness)) crosshairThickness = Math.max(1, Math.min(8, Math.round(saved.crosshairThickness)));
                    if (Number.isFinite(saved.crosshairGap)) crosshairGap = Math.max(0, Math.min(12, Math.round(saved.crosshairGap)));
                    if (Number.isFinite(saved.crosshairOpacity)) crosshairOpacity = Math.max(20, Math.min(100, Math.round(saved.crosshairOpacity / 5) * 5));
                    if (typeof saved.crosshairOutline === 'boolean') crosshairOutline = saved.crosshairOutline;
                    if (Number.isFinite(saved.crosshairOutlineThickness)) crosshairOutlineThickness = Math.max(1, Math.min(6, Math.round(saved.crosshairOutlineThickness)));
                    if (typeof saved.crosshairCenterDot === 'boolean') crosshairCenterDot = saved.crosshairCenterDot;
                    if (typeof saved.toggleSprint === 'boolean') toggleSprint = saved.toggleSprint;
                    if (typeof saved.showBatteryInGame === 'boolean') showBatteryInGame = saved.showBatteryInGame;
                    crosshairSizeSlider.value = String(crosshairSize);
                    crosshairThicknessSlider.value = String(crosshairThickness);
                    crosshairGapSlider.value = String(crosshairGap);
                    crosshairOpacitySlider.value = String(crosshairOpacity);
                    crosshairOutlineThicknessSlider.value = String(crosshairOutlineThickness);
                    crosshairColorPicker.value = crosshairColor;
                    crosshairColorCode.value = crosshairColor.toUpperCase();
                    [
                        [volLowSlider, 'volLow'],
                        [volMidSlider, 'volMid'],
                        [volHighSlider, 'volHigh'],
                        [graphicsQualitySlider, 'graphicsQuality']
                    ].forEach(([slider, key]) => {
                        if (Number.isFinite(saved[key])) slider.value = Math.max(0, Math.min(1, saved[key])).toFixed(2);
                    });
                    volLow = parseFloat(volLowSlider.value);
                    volMid = parseFloat(volMidSlider.value);
                    volHigh = parseFloat(volHighSlider.value);
                    graphicsQuality = parseFloat(graphicsQualitySlider.value);
                } catch (error) { }
            }
            loadSettings();

            function updateGameplaySettingsUI(text = {
                ...baseText,
                ...CROSSHAIR_EXTRA_TRANSLATIONS.en,
                ...(GAMEPLAY_SETTINGS_TRANSLATIONS[language] || {}),
                ...(CROSSHAIR_EXTRA_TRANSLATIONS[language] || {})
            }) {
                const presetColorNames = {
                    green: '#00ff66',
                    white: '#ffffff',
                    cyan: '#00ffff',
                    yellow: '#ffe600'
                };
                const selectedColorName = Object.keys(presetColorNames)
                    .find(name => presetColorNames[name] === crosshairColor.toLowerCase()) || '';
                const selectedValues = {
                    crosshairStyle,
                    crosshairColor: selectedColorName
                };
                gameplayChoiceButtons.forEach(button => {
                    const selected = selectedValues[button.dataset.settingGroup] === button.dataset.settingValue;
                    button.classList.toggle('selected', selected);
                    button.setAttribute('aria-pressed', String(selected));
                });
                btnToggleSprintSetting.setAttribute('aria-pressed', String(toggleSprint));
                btnShowBatterySetting.setAttribute('aria-pressed', String(showBatteryInGame));
                btnCrosshairOutlineSetting.setAttribute('aria-pressed', String(crosshairOutline));
                btnCrosshairCenterDotSetting.setAttribute('aria-pressed', String(crosshairCenterDot));
                crosshairColorPicker.value = /^#[\da-f]{6}$/i.test(crosshairColor) ? crosshairColor : '#00ff66';
                crosshairColorCode.value = crosshairColorPicker.value.toUpperCase();
                document.getElementById('valueCrosshairOutline').textContent = crosshairOutline ? text.enabled : text.disabled;
                document.getElementById('valueCrosshairCenterDot').textContent = crosshairCenterDot ? text.enabled : text.disabled;
                document.getElementById('valueToggleSprint').textContent = toggleSprint ? text.enabled : text.disabled;
                document.getElementById('valueShowBatteryInGame').textContent = showBatteryInGame ? text.enabled : text.disabled;
                gameBatteryWidget.classList.toggle('visible', running && showBatteryInGame);
                drawCrosshairPreview();
            }

            function resetCrosshairSettings() {
                crosshairStyle = 'cross';
                crosshairColor = '#00ff66';
                crosshairSize = 12;
                crosshairThickness = 3;
                crosshairGap = 3;
                crosshairOpacity = 100;
                crosshairOutline = true;
                crosshairOutlineThickness = 2;
                crosshairCenterDot = false;
                crosshairSizeSlider.value = String(crosshairSize);
                crosshairThicknessSlider.value = String(crosshairThickness);
                crosshairGapSlider.value = String(crosshairGap);
                crosshairOpacitySlider.value = String(crosshairOpacity);
                crosshairOutlineThicknessSlider.value = String(crosshairOutlineThickness);
                crosshairColorPicker.value = crosshairColor;
                crosshairColorCode.removeAttribute('aria-invalid');
            }

            updateGameplaySettingsUI();

            function getGlowMultiplier() {
                return Math.max(0, Math.min(1, graphicsQuality));
            }

            function requestGameFrame() {
                if (performanceMode === 'power') {
                    setTimeout(() => requestAnimationFrame(gameLoop), 1000 / 30);
                } else {
                    requestAnimationFrame(gameLoop);
                }
            }

