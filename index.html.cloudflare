            const LANGUAGE_ORDER = Object.keys(LANG);

            function renderLanguageButtons() {
                languageButtons.innerHTML = '';
                LANGUAGE_ORDER.forEach(code => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btnNeon';
                    button.dataset.lang = code;
                    button.textContent = LANGUAGE_LABELS[code] || code.toUpperCase();
                    languageButtons.appendChild(button);
                });
            }

