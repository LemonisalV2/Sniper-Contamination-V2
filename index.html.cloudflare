    <script>
        (function () {
            const baseText = {
                titleMain: "SNIPER CONTAMINATION",
                settingsTitle: "Settings",
                labelLanguage: "Language",
                labelFPS: "Performance Mode",
                labelEQ: "Volume Control",
                labelVolLow: "60 Hz",
                labelVolMid: "200 Hz",
                labelVolHigh: "20 kHz",
                fpsDescription: "Your FPS is the same as your computer's refresh rate.",
                perfNote: "Can't be changed with controllers",
                oxygenWarning: "You are running out of oxygen...",
                paused: "PAUSED",
                resume: "Resume",
                youDied: "YOU DIED",
                deathSurvived: "You survived {s} seconds",
                restart: "Restart",
                settings: "Settings",
                mainMenu: "Main Menu",
                play: "Play",
                menuSettings: "Settings",
                back: "Back",
                progress: "Progress: {s} seconds survived",
                tutKeyboard: "Move by pressing WASD or arrow keys.\nGood luck!",
