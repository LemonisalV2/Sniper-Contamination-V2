{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bypass Policy and Start NPM",
      "type": "shell",
      "command": "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process; npm start",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-Command"]
        }
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
