            function showBatteryStatusNotification(type, percent) {
                const chargingMessage = getBatteryStatusMessage('charging', percent);
                const removedMessage = getBatteryStatusMessage('removed', percent);
                const greenNotif = document.getElementById('batteryChargingNotif');
                const greyNotif = document.getElementById('batteryRemovedNotif');

                if (type === 'charging') {
                    greenNotif.querySelector('span').textContent = chargingMessage;
                    greenNotif.classList.remove('hidden');
                    greenNotif.classList.add('show');
                    greyNotif.classList.remove('show');
                    greyNotif.classList.add('hidden');
                    setTimeout(() => {
                        greenNotif.classList.remove('show');
                        setTimeout(() => greenNotif.classList.add('hidden'), 250);
                    }, 1800);
                    return;
                }

                greyNotif.querySelector('span').textContent = removedMessage;
                greyNotif.classList.remove('hidden');
                greyNotif.classList.add('show');
                greenNotif.classList.remove('show');
                greenNotif.classList.add('hidden');
                setTimeout(() => {
                    greyNotif.classList.remove('show');
                    setTimeout(() => greyNotif.classList.add('hidden'), 250);
                }, 1800);
            }

            function showLowBatteryPowerSavingNotification() {
                const t = LANG[language] || LANG.en;
                const message = t.lowBatteryPowerSavingNotice || t.powerSavingNotice || LANG.en.lowBatteryPowerSavingNotice || LANG.en.powerSavingNotice;
                const notif = document.getElementById('powerSavingNotif');
                if (!notif) return;
                notif.querySelector('span').textContent = message;
                notif.classList.remove('hidden');
                notif.classList.add('show');
                setTimeout(() => {
                    notif.classList.remove('show');
                    setTimeout(() => notif.classList.add('hidden'), 250);
                }, 2200);
            }

            let lastBatteryChargingState = null;
            function updateBatteryWidgets(level, charging) {
                batteryLevel = level;
                batteryCharging = charging;
                const percentage = Math.round(Math.max(0, Math.min(1, level)) * 100);
                batteryWidgets.forEach(widget => {
                    widget.classList.toggle('battery-orange', !charging && percentage >= 20 && percentage <= 50);
                    widget.classList.toggle('battery-yellow', !charging && percentage > 50 && percentage < 75);
                    widget.classList.toggle('battery-red', !charging && percentage < 20);
                    widget.classList.toggle('charging', charging);
                    widget.querySelector('.batteryFill').style.width = `${percentage}%`;
                    widget.querySelector('.batteryPercent').textContent = `${getLocalizedNumber(percentage, { maximumFractionDigits: 0 })}%`;
                    widget.setAttribute('aria-label', `Battery ${getLocalizedNumber(percentage, { maximumFractionDigits: 0 })}%${charging ? ', charging' : ''}`);
                });
                if (gameBatteryWidget) {
                    gameBatteryWidget.classList.toggle('mobilePosition', lastInputMethod === 'touch' && mobileMode);
                }
                if (lastBatteryChargingState === null) {
                    lastBatteryChargingState = charging;
                } else if (lastBatteryChargingState !== charging) {
                    showBatteryStatusNotification(charging ? 'charging' : 'removed', percentage);
                    lastBatteryChargingState = charging;
                }
                applyBatteryPerformanceMode();
            }

            function syncPerformanceButtonSelection() {
                const buttons = [...performanceButtons.querySelectorAll('button')];
                buttons.forEach((button) => {
                    const isSelected = (button.dataset.perf || 'performance') === performanceMode;
                    button.style.outline = isSelected ? '2px solid #ffffff' : 'none';
                });
            }

            function applyBatteryPerformanceMode() {
                if (!batteryManager) return;

                const percentage = Math.round(Math.max(0, Math.min(1, batteryLevel)) * 100);

                if (batteryCharging) {
                    if (performanceMode !== 'performance') {
                        performanceMode = 'performance';
                        saveSettings();
                    }
                    syncPerformanceButtonSelection();
                    return;
                }

                if (percentage < 20 && performanceMode !== 'power') {
                    performanceMode = 'power';
                    saveSettings();
                    showLowBatteryPowerSavingNotification();
                }

                syncPerformanceButtonSelection();
            }

            let batteryManager = null;
            let batteryUpdateInterval = null;

            async function initializeBattery() {
                if (!navigator.getBattery) {
                    console.warn("Battery API is not supported by this browser.");
                    return;
                }

                try {
                    batteryManager = await navigator.getBattery();

                    const refreshBattery = () => {
                        if (!batteryManager) return;

                        updateBatteryWidgets(
                            batteryManager.level,
                            batteryManager.charging
                        );
                    };

                    refreshBattery();
                    batteryManager.addEventListener('levelchange', refreshBattery);
                    batteryManager.addEventListener('chargingchange', refreshBattery);

                    if (batteryUpdateInterval) {
                        clearInterval(batteryUpdateInterval);
                    }
                    batteryUpdateInterval = setInterval(refreshBattery, 1000);
                } catch (error) {
                    console.warn("Could not access battery information:", error);
                }
            }

            initializeBattery();


