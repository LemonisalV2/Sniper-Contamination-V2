                padding:
                    max(.75rem, env(safe-area-inset-top)) max(.75rem, env(safe-area-inset-right)) max(.75rem, env(safe-area-inset-bottom)) max(.75rem, env(safe-area-inset-left));
            }

            .menuActionContent,
            .pauseConfirmContent,
            .savedRunConfirmContent,
            .matchLoadingContent,
            .battleResultContent {
