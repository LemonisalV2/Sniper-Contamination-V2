                        <button id="btnCancelPlayMode" class="btn btnNeonGrey">Back</button>
                    </div>
                </div>
            </div>
            <div id="onlineLobbyOverlay" class="menuActionOverlay hidden" aria-hidden="true">
                <div class="menuActionContent" role="dialog" aria-modal="true" aria-labelledby="onlineLobbyTitle">
                    <div id="onlineLobbyTitle" class="menuActionTitle">Choose an online mode</div>
