                crosshairStyle: gameplayChoiceButtons.filter(button => button.dataset.settingGroup === 'crosshairStyle'),
                crosshairColor: gameplayChoiceButtons.filter(button => button.dataset.settingGroup === 'crosshairColor'),
                crosshairCustomColor: [crosshairColorPicker],
