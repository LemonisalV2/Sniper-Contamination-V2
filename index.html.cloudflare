                letter-spacing: clamp(.035rem, .65vw, .14rem);
                overflow-wrap: anywhere;
                text-wrap: balance;
            }

            #menu .sc-intro-kicker {
                max-width: 100%;
                font-size: clamp(.58rem, 2.5vw, .78rem);
                letter-spacing: .14em;
                text-align: center;
            }

            #menu .sc-intro-status {
                max-width: 100%;
                line-height: 1.5;
                text-align: center;
                overflow-wrap: anywhere;
            }

            #menu .buttonRow {
                width: 100%;
