                    shootButton: 'shoot'
                };
                if (idIcons[button.id]) return idIcons[button.id];
                return 'default';
            }

            function addButtonIcon(button) {
                if (button.querySelector('.buttonIcon')) return;
                const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                icon.setAttribute('class', `buttonIcon${button.matches('.abilityButton, .explodeButton, .shootButton, .sprintButton') ? ' buttonIconControl' : ''}`);
                icon.setAttribute('viewBox', '0 0 24 24');
                icon.setAttribute('aria-hidden', 'true');
                icon.setAttribute('focusable', 'false');
                icon.innerHTML = BUTTON_ICON_PATHS[getButtonIconName(button)] || BUTTON_ICON_PATHS.default;
                if (button.id === 'pauseButton') {
                    button.setAttribute('aria-label', 'Pause');
                    button.replaceChildren(icon);
                } else {
                    button.insertBefore(icon, button.firstChild);
                }
            }

            function addButtonIcons(root) {
                if (root.matches && root.matches('button')) addButtonIcon(root);
                root.querySelectorAll('button').forEach(addButtonIcon);
            }

            const gameContainer = document.getElementById('gameContainer');
