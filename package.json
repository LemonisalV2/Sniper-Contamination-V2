{
  "name": "sniper-contamination-game",
  "productName": "Sniper Contamination",
  "version": "1.0.1",
  "private": true,
  "description": "Sniper Contamination",
  "author": "LemonisalV2",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --ext js,html,css,json --exec \"node server.js & electron .\"",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:fast": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.yourname.snipercontaminationgame",
    "productName": "Sniper Contamination",
    "directories": {
      "output": "C:/SniperBuildNew"
    },
    "asarUnpack": [
      "server.js",
      "index.html",
      "*.png",
      "*.mp3",
      "*.svg",
      "*.css",
      "node_modules/ws/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "*.png",
      "*.mp3",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "png-to-ico": "^3.0.2"
  }
}