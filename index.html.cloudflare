        .joystickStick {
            width: 60px;
            height: 60px;
            background: rgba(0, 255, 102, 0.8);
            box-shadow: 0 0 16px rgba(0, 255, 102, 1);
            transform: translate(-50%, -50%);
            opacity: 0.1;
            transition: opacity 0.2s ease;
